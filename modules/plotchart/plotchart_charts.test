test Plotchart-309.3 {3D ribbon chart area: ribbon with a filled front} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::create3DRibbonChart .c {S1 S2} {0 10 5} {0 10 5}]
    set new [newItems {$p area {0 2 5 8 10 4} #00c000}]
    list [llength $new] [lsort -unique [lmap i $new {.c type $i}]] [.c itemcget [lindex $new end] -fill]
} -cleanup {
    cleanupPlot
