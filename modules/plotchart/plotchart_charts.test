    mkCanvas 400 400
} -body {
    set p [::Plotchart::createWindRose .c {30 10}]
    $p plot [lrepeat 16 5] green
    list [llength [items data_0]] [R [.c itemcget [lindex [items data_0] 0] -extent] 2]
} -cleanup {
