test Plotchart-309.4 {3D ribbon chart: the second series is drawn in front} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::create3DRibbonChart .c {S1 S2} {0 10 5} {0 10 5}]
    set first [newItems {$p line {0 5 10 5} red}]
    set second [newItems {$p line {0 5 10 5} blue}]
    lassign [.c bbox {*}$first] x1 y1
    lassign [.c bbox {*}$second] x2 y2
    # Further away means more to the right and higher on the screen
    list [expr {$x2 < $x1}] [expr {$y2 > $y1}]
} -cleanup {
    cleanupPlot
} -result {1 1}

# -------------------------------------------------------------------------
# Boxplots

test Plotchart-310.1 {boxplot: horizontal (default), labels on the y-axis} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createBoxplot .c {0 10 2} {A B C}]
    $p plot s B {1 2 3 4 5 6 7 8 9}
    set rect [items {data_s type=rectangle}]
    lassign [.c coords $rect] x1 y1 x2 y2
    lassign [::Plotchart::pixelToCoords [$p canvas] $x1 $y1] wx1 wy1
    lassign [::Plotchart::pixelToCoords [$p canvas] $x2 $y2] wx2 wy2
    list [string match boxplot_* $p] [itemTexts yaxis] [itemTexts xaxis] \
	[R [list $wx1 $wx2] 1] [R [expr {($wy1+$wy2)/2.0}] 1]
} -cleanup {
    cleanupPlot
} -result {1 {A B C} {0 2 4 6 8 10} {2.5 7.5} 2.0}

test Plotchart-310.2 {boxplot: vertical, labels on the x-axis} -constraints {
    knownBug
} -setup {
    mkCanvas
} -body {
    # Fails with: wrong # args: should be "DrawXlabels w xlabels noseries arguments"
    set p [::Plotchart::createBoxplot .c {A B C} {0 10 2} vertical]
    $p plot s C {1 2 3 4 5 6 7 8 9}
    set rect [items {data_s type=rectangle}]
    lassign [.c coords $rect] x1 y1 x2 y2
    lassign [::Plotchart::pixelToCoords [$p canvas] $x1 $y1] wx1 wy1
    lassign [::Plotchart::pixelToCoords [$p canvas] $x2 $y2] wx2 wy2
    list [itemTexts xaxis] [itemTexts yaxis] [R [lsort -real [list $wy1 $wy2]] 1] [R [expr {($wx1+$wx2)/2.0}] 1]
} -cleanup {
    cleanupPlot
} -result {{A B C} {0 2 4 6 8 10} {2.5 7.5} 3.0}

test Plotchart-310.3 {boxplot: explicit horizontal orientation} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createBoxplot .c {0 10 2} {A B} horizontal]
    itemTexts yaxis
} -cleanup {
    cleanupPlot
} -result {A B}

test Plotchart-310.4 {boxplot plot: unknown label} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createBoxplot .c {0 10 2} {A B}]
    list [$p plot s X {1 2 3}] [llength [items data_s]]
} -cleanup {
    cleanupPlot
} -result {{Label X not found on axis} 0}

test Plotchart-310.5 {boxplot: dataconfig options} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createBoxplot .c {0 10 2} {A B}]
    $p dataconfig s -fillcolour yellow -colour blue -boxwidth 20
    $p plot s A {1 2 3 4 5 6 7 8 9}
    set rect [items {data_s type=rectangle}]
    lassign [.c coords $rect] x1 y1 x2 y2
    list [.c itemcget $rect -fill] [.c itemcget $rect -outline] [R [expr {$y2-$y1}] 0]
} -cleanup {
    cleanupPlot
} -result {yellow blue 20}

test Plotchart-310.6 {boxplot violin} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createBoxplot .c {0 10 2} {A B}]
    $p dataconfig v -fillcolour pink
    set new [newItems {$p violin v B {2 3 3 4 4 4 5 5 6 8}}]
    set ys [lmap {x y} [.c coords [lindex $new 0]] {set y}]
    set yc [expr {([tcl::mathfunc::min {*}$ys] + [tcl::mathfunc::max {*}$ys])/2.0}]
    list [llength $new] [.c type $new] [.c itemcget $new -fill] \
	[R [lindex [::Plotchart::pixelToCoords [$p canvas] 0 $yc] 1] 1] \
	[$p violin v X {1 2 3}]
} -cleanup {
    cleanupPlot
} -result {1 polygon pink 2.0 {Label X not found on axis}}

test Plotchart-310.7 {boxplot: step size zero} -setup {
    mkCanvas
} -body {
    ::Plotchart::createBoxplot .c {0 10 0} {A B}
} -cleanup {
    cleanupPlot
} -returnCodes error -result {Step size can not be zero}

test Plotchart-310.8 {boxplot: general methods} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createBoxplot .c {0 10 2} {A B}]
    $p plot s A {1 2 3 4 5 6 7 8 9}
    $p legend s "Data"
    $p xticklines grey
    $p xtext "Values"
    list [itemTexts legend] [llength [items xtickline]] [itemTexts xtext]
} -cleanup {
    cleanupPlot
} -result {Data 6 Values}

# -------------------------------------------------------------------------
# Timecharts

test Plotchart-311.1 {timechart period: bar from begin to end with a text} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createTimechart .c "1 january 2004" "31 december 2004" 4]
    set ids [$p period "Spring" "1 march 2004" "1 june 2004" green]
    set bar [items {below type=rectangle}]
    lassign [.c coords $bar] x1 y1 x2 y2
    lassign [::Plotchart::coordsToPixel .c [clock scan "1 march 2004"] 0] px1
    lassign [::Plotchart::coordsToPixel .c [clock scan "1 june 2004"] 0] px2
    list [string match timechart_* $p] [expr {$ids eq $bar}] [.c itemcget $bar -fill] \
	[approx $x1 $px1 0.5] [approx $x2 $px2 0.5] [itemTexts above]
} -cleanup {
    cleanupPlot
} -result {1 1 green 1 1 Spring}

test Plotchart-311.2 {timechart: rows from top to bottom} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createTimechart .c "1 january 2004" "31 december 2004" 4]
    $p period "Spring" "1 march 2004" "1 june 2004" green
    $p period "Summer" "1 june 2004" "1 september 2004" yellow
    lassign [items {below type=rectangle}] b1 b2
    list [expr {[lindex [.c coords $b2] 1] > [lindex [.c coords $b1] 1]}] \
	[llength [items item_4]] [llength [items item_3]]
} -cleanup {
    cleanupPlot
} -result {1 2 2}

test Plotchart-311.3 {timechart period: default colour black} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createTimechart .c "1 january 2004" "31 december 2004" 4]
    $p period "Spring" "1 march 2004" "1 june 2004"
    itemOption {below type=rectangle} -fill
} -cleanup {
    cleanupPlot
} -result {black}

test Plotchart-311.4 {timechart addperiod: same row, no new text} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createTimechart .c "1 january 2004" "31 december 2004" 4]
    $p period "Seasons" "1 march 2004" "1 june 2004" green
    $p addperiod "1 september 2004" "1 december 2004" orange
    lassign [items {below type=rectangle}] b1 b2
    list [llength [items above]] [.c itemcget $b2 -fill] \
	[samePixels [list [lindex [.c coords $b1] 1] [lindex [.c coords $b1] 3]] \
	     [list [lindex [.c coords $b2] 1] [lindex [.c coords $b2] 3]] 0.01]
} -cleanup {
    cleanupPlot
} -result {1 orange 1}

test Plotchart-311.5 {timechart milestone: point-down triangle} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createTimechart .c "1 january 2004" "31 december 2004" 4]
    set ids [$p milestone "Longest day" "21 june 2004" red]
    set tri [items {below type=polygon}]
    lassign [.c coords $tri] x1 y1 x2 y2 x3 y3
    lassign [::Plotchart::coordsToPixel .c [clock scan "21 june 2004"] 0] px
    list [llength $ids] [.c itemcget $tri -fill] [expr {$y1 > $y2 && $y2 == $y3}] [approx $x1 $px 0.5] \
	[itemTexts above]
} -cleanup {
    cleanupPlot
} -result {2 red 1 1 {{Longest day}}}

test Plotchart-311.6 {timechart addmilestone: same row} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createTimechart .c "1 january 2004" "31 december 2004" 4]
    $p milestone "Days" "21 june 2004"
    $p addmilestone "21 december 2004" blue
    lassign [items {below type=polygon}] t1 t2
    list [llength [items above]] [.c itemcget $t1 -fill] [.c itemcget $t2 -fill] \
	[approx [lindex [.c coords $t1] 1] [lindex [.c coords $t2] 1] 0.01]
} -cleanup {
    cleanupPlot
} -result {1 black blue 1}

test Plotchart-311.7 {timechart vertline: line with a text at the top} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createTimechart .c "1 january 2004" "31 december 2004" 4]
    $p vertline "1 jul" "1 july 2004" red
    set l [items {tline type=line}]
    lassign [.c coords $l] x1 y1 x2 y2
    lassign [::Plotchart::coordsToPixel .c [clock scan "1 july 2004"] 0] px
    list [.c itemcget $l -fill] [expr {$x1 == $x2}] [approx $x1 $px 0.5] [itemTexts timeline]
} -cleanup {
    cleanupPlot
} -result {red 1 1 {{1 jul}}}

test Plotchart-311.8 {timechart: -barheight determines the spacing} -constraints {
    knownBug
} -setup {
    mkCanvas
} -body {
    # The number of bars is computed from the width of the plot
    set p [::Plotchart::createTimechart .c "1 january 2004" "31 december 2004" -barheight 20]
    $p period "A" "1 march 2004" "1 june 2004"
    $p period "B" "1 march 2004" "1 june 2004"
    lassign [items {below type=rectangle}] b1 b2
    R [expr {[lindex [.c coords $b2] 1] - [lindex [.c coords $b1] 1]}] 0
} -cleanup {
    cleanupPlot
} -result {20}

test Plotchart-311.9 {timechart: -ylabelwidth reserves space for the labels} -setup {
    mkCanvas
} -body {
    set p1 [::Plotchart::createTimechart .c "1 january 2004" "31 december 2004" 4 -ylabelwidth 50]
    set x1 $::Plotchart::scaling(.c,pxmin)
    cleanupPlot
    mkCanvas
    set p2 [::Plotchart::createTimechart .c "1 january 2004" "31 december 2004" 4 -ylabelwidth 200]
    set x2 $::Plotchart::scaling(.c,pxmin)
    expr {$x2 > $x1}
} -cleanup {
    cleanupPlot
} -result 1

test Plotchart-311.10 {timechart: scrollbars} -setup {
    mkCanvas
    scrollbar .y -orient vertical
    scrollbar .x -orient horizontal
} -body {
    set s [::Plotchart::createTimechart .c "1 january 2004" "31 december 2004" 4]
    $s period "Spring" "1 march 2004" "1 june 2004" green
    $s vscroll .y
    $s hscroll .x
    set r [list [.y get] [.x get]]
    foreach i {1 2 3 4 5} {
	$s milestone "Longest day $i" "21 july 2004"
    }
    $s vertline "1 jul" "1 july 2005"
    $s period "Autumn" "1 september 2004" "1 december 2004" orange
    lappend r [R [.y get] 3] [expr {[lindex [.x get] 1] < 1.0}]
} -cleanup {
    cleanupPlot
    destroy .x .y
} -result {{0.0 1.0} {0.0 1.0} {0.000 0.571} 1}

test Plotchart-311.10a {timechart: scrollbars connected to an empty chart} -constraints {
    knownBug
} -setup {
    mkCanvas
    scrollbar .x -orient horizontal
} -body {
    # Fails with: can't read "xmax": no such variable
    set s [::Plotchart::createTimechart .c "1 january 2004" "31 december 2004" 4]
    $s hscroll .x
    .x get
} -cleanup {
    cleanupPlot
    destroy .x
} -result {0.0 1.0}

test Plotchart-311.11 {timechart: vertical scrolling moves the rows} -setup {
    mkCanvas
    scrollbar .y -orient vertical
} -body {
    set s [::Plotchart::createTimechart .c "1 january 2004" "31 december 2004" 2]
    $s vscroll .y
    foreach i {1 2 3 4} {
	$s period "Item $i" "1 march 2004" "1 june 2004" green
    }
    set y0 [lindex [.c coords [lindex [items {below type=rectangle}] 0]] 1]
    ::Plotchart::VertScrollChart .c moveto 0.5
    set y1 [lindex [.c coords [lindex [items {below type=rectangle}] 0]] 1]
    expr {$y1 < $y0}
} -cleanup {
    cleanupPlot
    destroy .y
} -result 1

test Plotchart-311.12 {timechart: invalid time} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createTimechart .c "1 january 2004" "31 december 2004" 4]
    $p period "Bad" "no such date" "1 june 2004"
} -cleanup {
    cleanupPlot
} -returnCodes error -match glob -result {unable to convert date-time string "no such date"*}

test Plotchart-311.13 {timechart: wrong # args} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createTimechart .c "1 january 2004" "31 december 2004" 4]
    $p period "Spring" "1 march 2004"
} -cleanup {
    cleanupPlot
} -returnCodes error -result {wrong # args: should be "DrawTimePeriod w text time_begin time_end ?colour?"}

# -------------------------------------------------------------------------
# Gantt charts

test Plotchart-312.1 {ganttchart task: description, completed part, rest and percentage} -setup {
    mkCanvas 500 300
} -body {
    set p [::Plotchart::createGanttchart .c "1 january 2004" "31 december 2004" 4]
    set ids [$p task "Spring" "1 march 2004" "1 june 2004" 30]
    lassign $ids desc comp left perc
    lassign [.c coords $comp] cx1 cy1 cx2 cy2
    lassign [.c coords $left] lx1 ly1 lx2 ly2
    set tb [clock scan "1 march 2004"]
    set te [clock scan "1 june 2004"]
    lassign [::Plotchart::coordsToPixel .c $tb 0] px1
    lassign [::Plotchart::coordsToPixel .c [expr {$tb + 0.3*($te-$tb)}] 0] pxc
    lassign [::Plotchart::coordsToPixel .c $te 0] px2
    list [string match ganttchart_* $p] [llength $ids] [.c itemcget $desc -text] [.c itemcget $perc -text] \
	[.c itemcget $comp -fill] [.c itemcget $left -fill] \
	[approx $cx1 $px1 0.5] [approx $cx2 $pxc 0.5] [approx $lx1 $pxc 0.5] [approx $lx2 $px2 0.5] \
	[lsort [.c gettags $desc]] [lsort [.c gettags $comp]]
} -cleanup {
    cleanupPlot
} -result {1 4 Spring 30% lightblue white 1 1 1 1 {above description vertscroll} {below completed horizscroll vertscroll}}

test Plotchart-312.2 {ganttchart: odd and even rows} -setup {
    mkCanvas 500 300
} -body {
    set p [::Plotchart::createGanttchart .c "1 january 2004" "31 december 2004" 4]
    list [llength [items odd]] [llength [items even]] [itemOption odd -fill] [itemOption even -fill]
} -cleanup {
    cleanupPlot
} -result {2 2 white lightgrey}

test Plotchart-312.3 {ganttchart milestone} -setup {
    mkCanvas 500 300
} -body {
    set p [::Plotchart::createGanttchart .c "1 january 2004" "31 december 2004" 4]
    set ids [$p milestone "Halfway" "1 july 2004" red]
    lassign $ids desc tri
    lassign [.c coords $tri] x1 y1 x2 y2 x3 y3
    list [.c itemcget $desc -text] [.c type $tri] [.c itemcget $tri -fill] [expr {$y1 > $y2 && $y2 == $y3}]
} -cleanup {
    cleanupPlot
} -result {Halfway polygon red 1}

test Plotchart-312.4 {ganttchart vertline} -setup {
    mkCanvas 500 300
} -body {
    set p [::Plotchart::createGanttchart .c "1 january 2004" "31 december 2004" 4]
    $p vertline "1 jul" "1 july 2004"
    set l [items {tline type=line}]
    lassign [.c coords $l] x1 y1 x2 y2
    lassign [::Plotchart::coordsToPixel .c [clock scan "1 july 2004"] 0] px
    list [expr {$x1 == $x2}] [approx $x1 $px 0.5] [itemTexts timeline] [itemOption {timeline type=text} -font]
} -cleanup {
    cleanupPlot
} -result {1 1 {{1 jul}} {{times 7}}}

test Plotchart-312.5 {ganttchart connect: arrow from one task to another} -setup {
    mkCanvas 500 300
} -body {
    set p [::Plotchart::createGanttchart .c "1 january 2004" "31 december 2004" 4]
    set t1 [$p task "Spring" "1 march 2004" "1 june 2004" 30]
    set t2 [$p task "Summer" "1 june 2004" "1 september 2004" 0]
    set a [$p connect $t1 $t2]
    set c [.c coords $a]
    lassign [.c coords [lindex $t1 2]] f1 - f2 -
    lassign [.c coords [lindex $t2 1]] g1 - g2 -
    list [.c type $a] [.c itemcget $a -arrow] [approx [lindex $c 0] $f2 0.01] [approx [lindex $c end-1] $g1 0.01]
} -cleanup {
    cleanupPlot
} -result {line last 1 1}

test Plotchart-312.6 {ganttchart summary: bar over the tasks, tasks shifted down} -setup {
    mkCanvas 500 300
} -body {
    set p [::Plotchart::createGanttchart .c "1 january 2004" "31 december 2004" 5]
    set t1 [$p task "Spring" "1 march 2004" "1 june 2004" 30]
    set t2 [$p task "Summer" "1 june 2004" "1 september 2004" 0]
    set y0 [lindex [.c coords [lindex $t1 1]] 1]
    set ids [$p summary "Seasons" $t1 $t2]
    lassign $ids text bar
    lassign [.c bbox $bar] bx1 by1 bx2 by2
    lassign [.c coords [lindex $t1 1]] x1
    lassign [.c coords [lindex $t2 2]] - - x2
    list [.c itemcget $text -text] [.c type $bar] [.c itemcget $bar -fill] \
	[expr {[lindex [.c coords [lindex $t1 1]] 1] > $y0}] \
	[expr {$bx1 <= $x1 && $bx2 >= $x2}] [lsort [.c gettags $text]]
} -cleanup {
    cleanupPlot
} -result {Seasons polygon black 1 1 {above summary vertscroll}}

test Plotchart-312.7 {ganttchart color: completed, left, odd, even and summarybar} -setup {
    mkCanvas 500 300
} -body {
    set p [::Plotchart::createGanttchart .c "1 january 2004" "31 december 2004" 4]
    $p color completed green
    $p color left yellow
    $p colour summarybar red
    $p color odd pink
    $p color even grey
    set t1 [$p task "Spring" "1 march 2004" "1 june 2004" 30]
    set s [$p summary "Sum" $t1]
    list [.c itemcget [lindex $t1 1] -fill] [.c itemcget [lindex $t1 2] -fill] \
	[.c itemcget [lindex $s 1] -fill] [itemOption odd -fill] [itemOption even -fill]
} -cleanup {
    cleanupPlot
} -result {green yellow red pink grey}

test Plotchart-312.8 {ganttchart color: existing tasks are updated} -setup {
    mkCanvas 500 300
} -body {
    set p [::Plotchart::createGanttchart .c "1 january 2004" "31 december 2004" 4]
    set t1 [$p task "Spring" "1 march 2004" "1 june 2004" 30]
    $p color completed green
    $p color left yellow
    list [.c itemcget [lindex $t1 1] -fill] [.c itemcget [lindex $t1 2] -fill]
} -cleanup {
    cleanupPlot
} -result {green yellow}

test Plotchart-312.9 {ganttchart color: description and summary text} -constraints {
    knownBug
} -setup {
    mkCanvas 500 300
} -body {
    # Fails with: unknown option "-foreground"
    set p [::Plotchart::createGanttchart .c "1 january 2004" "31 december 2004" 4]
    set t1 [$p task "Spring" "1 march 2004" "1 june 2004" 30]
    set s [$p summary "Sum" $t1]
    $p color description blue
    $p color summary red
    list [.c itemcget [lindex $t1 0] -fill] [.c itemcget [lindex $s 0] -fill]
} -cleanup {
    cleanupPlot
} -result {blue red}

test Plotchart-312.10 {ganttchart font: description and summary} -setup {
    mkCanvas 500 300
} -body {
    set p [::Plotchart::createGanttchart .c "1 january 2004" "31 december 2004" 4]
    set t1 [$p task "Spring" "1 march 2004" "1 june 2004" 30]
    set s [$p summary "Sum" $t1]
    set r [list [.c itemcget [lindex $t1 0] -font] [.c itemcget [lindex $s 0] -font]]
    $p font description {Courier 12}
    $p font summary {Courier 14 bold}
    $p font scale {Courier 8}
    $p vertline "1 jul" "1 july 2004"
    set t2 [$p task "Summer" "1 june 2004" "1 september 2004" 0]
    lappend r [.c itemcget [lindex $t1 0] -font] [.c itemcget [lindex $s 0] -font] \
	[.c itemcget [lindex $t2 0] -font] [itemOption {timeline type=text} -font]
} -cleanup {
    cleanupPlot
} -result {{times 10} {times 10 bold} {Courier 12} {Courier 14 bold} {Courier 12} {{Courier 8}}}

test Plotchart-312.11 {ganttchart: number of items and width of the text} -setup {
    mkCanvas 500 300
} -body {
    set p1 [::Plotchart::createGanttchart .c "1 january 2004" "31 december 2004" 4 10]
    set x1 $::Plotchart::scaling(.c,pxmin)
    set n1 [llength [items odd]]
    cleanupPlot
    mkCanvas 500 300
    set p2 [::Plotchart::createGanttchart .c "1 january 2004" "31 december 2004" 6 30]
    set x2 $::Plotchart::scaling(.c,pxmin)
    set n2 [llength [items odd]]
    list $n1 $n2 [expr {$x2 > $x1}]
} -cleanup {
    cleanupPlot
} -result {2 3 1}

test Plotchart-312.12 {ganttchart: -barheight} -constraints {
    knownBug
} -setup {
    mkCanvas 500 300
} -body {
    # The number of bars is computed from the width of the plot
    set p [::Plotchart::createGanttchart .c "1 january 2004" "31 december 2004" -barheight 40]
    $p task "A" "1 march 2004" "1 june 2004" 10
    $p task "B" "1 march 2004" "1 june 2004" 10
    lassign [items completed] c1 c2
    R [expr {[lindex [.c coords $c2] 1] - [lindex [.c coords $c1] 1]}] 0
} -cleanup {
    cleanupPlot
} -result {40}

test Plotchart-312.12a {ganttchart: -ylabelwidth} -setup {
    mkCanvas 500 300
} -body {
    set p [::Plotchart::createGanttchart .c "1 january 2004" "31 december 2004" 4 -ylabelwidth 50]
    set x1 $::Plotchart::scaling(.c,pxmin)
    cleanupPlot
    mkCanvas 500 300
    set p [::Plotchart::createGanttchart .c "1 january 2004" "31 december 2004" 4 -ylabelwidth 200]
    set x2 $::Plotchart::scaling(.c,pxmin)
    expr {$x2 > $x1}
} -cleanup {
    cleanupPlot
} -result 1

test Plotchart-312.13 {ganttchart: scrollbars} -setup {
    mkCanvas 500 300
    scrollbar .y -orient vertical
    scrollbar .x -orient horizontal
} -body {
    set p [::Plotchart::createGanttchart .c "1 january 2004" "31 december 2004" 2]
    foreach i {1 2 3 4 5} {
	$p task "Task $i" "1 march 2004" "1 june 2004" 50
    }
    $p vertline "1 jul" "1 july 2005"
    $p vscroll .y
    $p hscroll .x
    list [R [.y get] 1] [expr {[lindex [.x get] 1] < 1.0}]
} -cleanup {
    cleanupPlot
    destroy .x .y
} -result {{0.0 0.4} 1}

test Plotchart-312.13a {ganttchart: scrollbars updated for new tasks} -constraints {
    knownBug
} -setup {
    mkCanvas 500 300
    scrollbar .y -orient vertical
} -body {
    # The scrollbar is only updated when it is connected
    set p [::Plotchart::createGanttchart .c "1 january 2004" "31 december 2004" 2]
    $p task "Task 0" "1 march 2004" "1 june 2004" 50
    $p vscroll .y
    foreach i {1 2 3 4} {
	$p task "Task $i" "1 march 2004" "1 june 2004" 50
    }
    R [.y get] 1
} -cleanup {
    cleanupPlot
    destroy .y
} -result {0.0 0.4}

test Plotchart-312.14 {ganttchart task: wrong # args} -setup {
    mkCanvas 500 300
} -body {
    set p [::Plotchart::createGanttchart .c "1 january 2004" "31 december 2004" 4]
    $p task "A" "1 march 2004" "1 june 2004"
} -cleanup {
    cleanupPlot
} -returnCodes error -result {wrong # args: should be "DrawGanttPeriod w text time_begin time_end completed"}

# -------------------------------------------------------------------------
# Table charts

test Plotchart-313.1 {tablechart: header row and frame} -setup {
    mkCanvas 400 300
} -body {
    set t [::Plotchart::createTableChart .c {"Column 1" "Column 2" "Column 3"}]
    set texts [lmap i [.c find all] {expr {[.c type $i] eq "text" ? [.c itemcget $i -text] : [continue]}}]
    list [string match table_* $t] $texts [llength [items cellbg]] [itemTypes frame]
} -cleanup {
    cleanupPlot
} -result {1 {{Column 1} {Column 2} {Column 3}} 3 line}

test Plotchart-313.2 {tablechart row: cell texts centred in the columns} -setup {
    mkCanvas 400 300
} -body {
    set t [::Plotchart::createTableChart .c {A B C} 80]
    $t row {1 2 3}
    $t row {4 5 6}
    set cells [items celltext]
    set xs [lmap c $cells {lindex [.c coords $c] 0}]
    list [itemTexts celltext] [R [expr {[lindex $xs 1]-[lindex $xs 0]}] 0] [R [expr {[lindex $xs 2]-[lindex $xs 1]}] 0] \
	[expr {[lindex [.c coords [lindex $cells 3]] 1] > [lindex [.c coords [lindex $cells 0]] 1]}] \
	[itemOption celltext -anchor]
} -cleanup {
    cleanupPlot
} -result {{1 2 3 4 5 6} 80 80 1 n}

test Plotchart-313.3 {tablechart: widths per column} -setup {
    mkCanvas 400 300
} -body {
    set t [::Plotchart::createTableChart .c {A B C} {50 100 150}]
    $t row {1 2 3}
    set xs [lmap c [items celltext] {lindex [.c coords $c] 0}]
    list [R [expr {[lindex $xs 1]-[lindex $xs 0]}] 0] [R [expr {[lindex $xs 2]-[lindex $xs 1]}] 0]
} -cleanup {
    cleanupPlot
} -result {75 125}

test Plotchart-313.4 {tablechart: default width spread over the canvas} -setup {
    mkCanvas 400 300
} -body {
    set t [::Plotchart::createTableChart .c {A B}]
    $t row {1 2}
    set xs [lmap c [items celltext] {lindex [.c coords $c] 0}]
    list [expr {[lindex $xs 0] < 200 && [lindex $xs 1] > 200}] [expr {[lindex $xs 1] - [lindex $xs 0] > 50}]
} -cleanup {
    cleanupPlot
} -result {1 1}

test Plotchart-313.5 {tablechart: too few widths} -setup {
    mkCanvas 400 300
} -body {
    ::Plotchart::createTableChart .c {A B C} {50 100}
} -cleanup {
    cleanupPlot
} -returnCodes error -result {Number of widths should be at least the number of columns}

test Plotchart-313.6 {tablechart row: too few values} -setup {
    mkCanvas 400 300
} -body {
    set t [::Plotchart::createTableChart .c {A B C}]
    $t row {1 2}
} -cleanup {
    cleanupPlot
} -returnCodes error -result {Too few values to fill the row}

test Plotchart-313.7 {tablechart separator: horizontal line} -setup {
    mkCanvas 400 300
} -body {
    set t [::Plotchart::createTableChart .c {A B} {100 100}]
    $t row {1 2}
    set new [newItems {$t separator}]
    lassign [.c coords $new] x1 y1 x2 y2
    list [llength $new] [.c type $new] [expr {$y1 == $y2}] [R [expr {$x2-$x1}] 0] [.c gettags $new]
} -cleanup {
    cleanupPlot
} -result {1 line 1 200 frame}

test Plotchart-313.8 {tablechart formatcommand and cellconfigure} -setup {
    mkCanvas 400 300
    proc setColor {table widget row col value} {
	$table cellconfigure -background white -color black
	if { $value < 2.0 } {
	    $table cellconfigure -background red -color white
	}
	if { $value > 6.0 } {
	    $table cellconfigure -background green
	}
	return [format "%6.3f" $value]
    }
} -body {
    set t [::Plotchart::createTableChart .c {A B C} 80]
    $t formatcommand setColor
    $t row {1 4 7}
    set r {}
    foreach c [items celltext] {
	lappend r [list [.c itemcget $c -text] [.c itemcget $c -fill]]
    }
    set bgs [lrange [items cellbg] 3 end]
    list $r [lmap b $bgs {.c itemcget $b -fill}]
} -cleanup {
    cleanupPlot
    rename setColor {}
} -result {{{{ 1.000} white} {{ 4.000} black} {{ 7.000} black}} {red white green}}

test Plotchart-313.9 {tablechart formatcommand: arguments} -setup {
    mkCanvas 400 300
    set ::fmtArgs {}
    proc fmtCmd {table widget row col value} {
	lappend ::fmtArgs [list [string match table_* $table] $row $col $value]
	return "<$value>"
    }
} -body {
    set t [::Plotchart::createTableChart .c {A B} 80]
    $t formatcommand fmtCmd
    $t row {x y}
    $t row {z w}
    list $::fmtArgs [itemTexts celltext]
} -cleanup {
    cleanupPlot
    rename fmtCmd {}
    unset ::fmtArgs
} -result {{{1 1 0 x} {1 1 1 y} {1 2 0 z} {1 2 1 w}} {<x> <y> <z> <w>}}

test Plotchart-313.10 {tablechart formatcommand: unknown procedure} -setup {
    mkCanvas 400 300
} -body {
    set t [::Plotchart::createTableChart .c {A B} 80]
    $t formatcommand nosuchproc
} -cleanup {
    cleanupPlot
} -returnCodes error -result {No such command or procedure: nosuchproc}

test Plotchart-313.11 {tablechart cellconfigure: -font and -anchor} -setup {
    mkCanvas 400 300
} -body {
    set t [::Plotchart::createTableChart .c {A B} 100]
    $t cellconfigure -font {Courier 12} -anchor left
    $t row {1 2}
    set c [lindex [items celltext] 0]
    list [.c itemcget $c -font] [.c itemcget $c -anchor] \
	[expr {[lindex [.c coords $c] 0] < [lindex [.c coords [lindex [items cellbg] 0]] 0] + 10}]
} -cleanup {
    cleanupPlot
} -result {{Courier 12} nw 1}

test Plotchart-313.12 {tablechart cellconfigure: -cell sets the foreground colour} -constraints {
    knownBug
} -setup {
    mkCanvas 400 300
} -body {
    # Fails with: Unknown cell property: -cell (-color works)
    set t [::Plotchart::createTableChart .c {A B} 100]
    $t cellconfigure -cell red
    $t row {1 2}
    itemOption celltext -fill
} -cleanup {
    cleanupPlot
} -result {red}

test Plotchart-313.13 {tablechart cellconfigure: -justify for multiline text} -constraints {
    knownBug
} -setup {
    mkCanvas 400 300
} -body {
    # The -justify option is stored but not used
    set t [::Plotchart::createTableChart .c {A B} 100]
    $t cellconfigure -justify right
    $t row {"Line\nLonger line" 2}
    itemOption celltext -justify
} -cleanup {
    cleanupPlot
} -result {right}

test Plotchart-313.14 {tablechart cellconfigure: unknown property} -setup {
    mkCanvas 400 300
} -body {
    set t [::Plotchart::createTableChart .c {A B} 100]
    $t cellconfigure -size 3
} -cleanup {
    cleanupPlot
} -returnCodes error -result {Unknown cell property: -size}

test Plotchart-313.15 {tablechart: frame and header configuration} -setup {
    ::Plotchart::plotconfig table frame outerwidth 3
    ::Plotchart::plotconfig table frame color red
    ::Plotchart::plotconfig table header background yellow
    ::Plotchart::plotconfig table header color blue
    mkCanvas 400 300
} -body {
    set t [::Plotchart::createTableChart .c {A B} 100]
    $t row {1 2}
    set head [lmap i [.c find all] {expr {[.c type $i] eq "text" && "celltext" ni [.c gettags $i] ? $i : [continue]}}]
    list [itemOption frame -fill] [lsort -unique [lmap i [items frame] {.c itemcget $i -width}]] \
	[.c itemcget [lindex [items cellbg] 0] -fill] [lsort -unique [lmap h $head {.c itemcget $h -fill}]]
} -cleanup {
    cleanupPlot
    foreach {comp prop} {frame outerwidth frame color header background header color} {
	::Plotchart::plotconfig table $comp $prop default
    }
} -result {red {1.0 3.0} yellow blue}

test Plotchart-313.16 {tablechart: title} -setup {
    mkCanvas 400 300
} -body {
    set t [::Plotchart::createTableChart .c {A B} 100]
    $t title "Table title"
    itemTexts title
} -cleanup {
    cleanupPlot
} -result {{Table title}}

# -------------------------------------------------------------------------
# Ternary diagrams

test Plotchart-314.1 {ternary: triangle with labels 0 to 100} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createTernaryDiagram .c]
    set labels [lsort -unique -real [itemTexts ternaryaxis]]
    list [string match ternary_* $p] $labels [llength [items {ternaryaxis type=line}]]
} -cleanup {
    cleanupPlot
} -result {1 {0 20 40 60 80 100} 21}

test Plotchart-314.2 {ternary plot: point with a label} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createTernaryDiagram .c]
    $p dataconfig s -colour red -symbol up
    $p plot s 100 0 0 "Corner" w
    $p plot s 0 0 100 "Top" s
    set syms [items {data_s type=polygon}]
    set texts [items {data_s type=text}]
    lassign [.c coords [lindex [items {ternaryaxis type=line}] 0]] tx ty lx ly
    lassign [.c bbox [lindex $syms 0]] a1 b1 a2 b2
    lassign [.c bbox [lindex $syms 1]] c1 d1 c2 d2
    list [lmap t $texts {.c itemcget $t -text}] [lmap t $texts {.c itemcget $t -anchor}] \
	[itemOption {data_s type=polygon} -outline] \
	[approx [expr {($a1+$a2)/2.0}] $lx 1] [approx [expr {($c1+$c2)/2.0}] $tx 1] \
	[expr {($d1+$d2)/2.0 < ($b1+$b2)/2.0}]
} -cleanup {
    cleanupPlot
} -result {{Corner Top} {w s} red 1 1 1}

test Plotchart-314.3 {ternary plot: coordinates are normalised} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createTernaryDiagram .c]
    $p plot s 1 1 1 "A"
    $p plot t 20 20 20 "B"
    set s [items {data_s type=oval}]
    set t [items {data_t type=oval}]
    samePixels [.c coords $s] [.c coords $t] 0.01
} -cleanup {
    cleanupPlot
} -result 1

test Plotchart-314.4 {ternary line and fill} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createTernaryDiagram .c]
    $p dataconfig l -colour blue -smooth 1
    $p dataconfig f -colour green
    $p line l {100 0 0 0 100 0 0 0 100}
    $p fill f {50 50 0 0 50 50 50 0 50}
    set l [items data_l]
    set f [items data_f]
    list [.c type $l] [.c itemcget $l -fill] [.c itemcget $l -smooth] [llength [.c coords $l]] \
	[.c type $f] [.c itemcget $f -fill] [llength [.c coords $f]]
} -cleanup {
    cleanupPlot
} -result {line blue true 6 polygon green 6}

