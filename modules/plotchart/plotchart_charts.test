# -------------------------------------------------------------------------
# Vertical barcharts

proc barGeometry {bar p} {
    # World coordinates of the bar: xleft xright ybottom ytop
    lassign [.c coords $bar] x1 y1 x2 y2
    set w [$p canvas]
    lassign [::Plotchart::pixelToCoords $w $x1 $y1] wx1 wy1
    lassign [::Plotchart::pixelToCoords $w $x2 $y2] wx2 wy2
    R [list [expr {min($wx1,$wx2)}] [expr {max($wx1,$wx2)}] [expr {min($wy1,$wy2)}] [expr {max($wy1,$wy2)}]] 2
}

test Plotchart-306.1 {barchart: labels on the x-axis, numeric y-axis} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createBarchart .c {A B C} {0 10 2} 1]
    list [string match barchart_* $p] [itemTexts xaxis] [itemTexts yaxis]
} -cleanup {
    cleanupPlot
} -result {1 {A B C} {0 2 4 6 8 10}}

test Plotchart-306.2 {barchart plot: one bar per label} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createBarchart .c {A B C} {0 10 2} 1]
    $p plot s {2 4 6} red
    set bars [items data_s]
    list [llength $bars] [itemTypes data_s] [itemOption data_s -fill] [itemOption data_s -outline] \
	[lmap b $bars {barGeometry $b $p}]
} -cleanup {
    cleanupPlot
} -result {3 rectangle red black {{0.60 1.40 0.00 2.00} {1.60 2.40 0.00 4.00} {2.60 3.40 0.00 6.00}}}

test Plotchart-306.3 {barchart plot: several series side by side} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createBarchart .c {A B} {0 10 2} 2]
    $p plot s1 {2 4} red
    $p plot s2 {3 5} blue
    list [lmap b [items data_s1] {barGeometry $b $p}] [lmap b [items data_s2] {barGeometry $b $p}]
} -cleanup {
    cleanupPlot
} -result {{{0.60 1.00 0.00 2.00} {1.60 2.00 0.00 4.00}} {{1.00 1.40 0.00 3.00} {2.00 2.40 0.00 5.00}}}

test Plotchart-306.4 {barchart plot: stacked series} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createBarchart .c {A B} {0 10 2} stacked]
    $p plot s1 {2 4} red
    $p plot s2 {3 5} blue
    list [lmap b [items data_s1] {barGeometry $b $p}] [lmap b [items data_s2] {barGeometry $b $p}]
} -cleanup {
    cleanupPlot
} -result {{{0.60 1.40 0.00 2.00} {1.60 2.40 0.00 4.00}} {{0.60 1.40 2.00 5.00} {1.60 2.40 4.00 9.00}}}

test Plotchart-306.5 {barchart: fractional number of series leaves a gap} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createBarchart .c {A B} {0 10 2} 2.5]
    $p plot s1 {2 4} red
    $p plot s2 {3 5} blue
    set b1 [barGeometry [lindex [items data_s1] 0] $p]
    set b2 [barGeometry [lindex [items data_s2] 0] $p]
    list [R [expr {[lindex $b1 1] - [lindex $b1 0]}] 2] [lindex $b2 0] [expr {[lindex $b2 1] < 1.4}]
} -cleanup {
    cleanupPlot
} -result {0.32 0.92 1}

test Plotchart-306.6 {barchart plot: gradient colours} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createBarchart .c {A B} {0 10 2} 1]
    $p plot s1 {4 8} #008000 top-down
    set rects [items background]
    set top {}
    set bottom {}
    foreach i $rects {
	lassign [.c coords $i] x1 y1 x2 y2
	set y [expr {($y1+$y2)/2.0}]
	if {$top eq "" || $y < [lindex $top 0]} {set top [list $y [.c itemcget $i -fill]]}
	if {$bottom eq "" || $y > [lindex $bottom 0]} {set bottom [list $y [.c itemcget $i -fill]]}
    }
    list [expr {[llength $rects] > 10}] [llength [items data_s1]] \
	[expr {[brightness [lindex $bottom 1]] != [brightness [lindex $top 1]]}]
} -cleanup {
    cleanupPlot
} -result {1 0 1}

test Plotchart-306.7 {barchart plot: gradient bright and dark} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createBarchart .c {A B} {0 10 2} 1]
    $p plot s1 {8 8} #008000 bottom-up bright
    set b [lmap i [items background] {brightness [.c itemcget $i -fill]}]
    .c delete background
    $p plot s2 {8 8} #008000 bottom-up dark
    set d [lmap i [items background] {brightness [.c itemcget $i -fill]}]
    set g [brightness #008000]
    list [expr {[tcl::mathfunc::max {*}$b] > $g}] [expr {[tcl::mathfunc::min {*}$b] >= $g}] \
	[expr {[tcl::mathfunc::min {*}$d] < $g}] [expr {[tcl::mathfunc::max {*}$d] <= $g}]
} -cleanup {
    cleanupPlot
} -result {1 1 1 1}

test Plotchart-306.8 {barchart plot: colours cycle when no colour given} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createBarchart .c {A B C} {0 10 2} 1]
    $p colours red green
    $p plot s1 {2 4 6} {}
    itemOption data_s1 -fill
} -cleanup {
    cleanupPlot
} -result {green red}

test Plotchart-306.9 {barchart config: show values above the bars} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createBarchart .c {A B} {0 10 2} 1]
    $p config -showvalues 1 -valuecolour blue -valueformat %.1f -valuefont {Courier 10}
    $p plot s {2 4} red
    set texts [items {data_s type=text}]
    set bars [items {data_s type=rectangle}]
    list [lmap t $texts {.c itemcget $t -text}] [itemOption {data_s type=text} -fill] \
	[itemOption {data_s type=text} -font] \
	[expr {[lindex [.c bbox [lindex $texts 0]] 3] <= [lindex [.c bbox [lindex $bars 0]] 1]}]
} -cleanup {
    cleanupPlot
} -result {{2.0 4.0} blue {{Courier 10}} 1}

test Plotchart-306.10 {barchart config: -valuecolor synonym, values off by default} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createBarchart .c {A B} {0 10 2} 1]
    $p plot s1 {2 4} red
    set n [llength [items {data_s1 type=text}]]
    $p config -showvalues 1 -valuecolor green
    $p plot s2 {2 4} red
