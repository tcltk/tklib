# -------------------------------------------------------------------------
# 3D barcharts

test Plotchart-308.1 {3D barchart: platform, bars with three faces, labels and values} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::create3DBarchart .c {0 10 2} 3]
    $p plot A 4 red
    $p plot B 8 green
    set texts [lmap i [.c find all] {expr {[.c type $i] eq "text" && "yaxis" ni [.c gettags $i] ? [.c itemcget $i -text] : [continue]}}]
    list [string match 3dbarchart_* $p] [llength [items platform]] [llength [items u]] \
	[lsort $texts] [itemTexts yaxis]
} -cleanup {
    cleanupPlot
} -result {1 1 6 {4 8 A B} {0 2 4 6 8 10}}

test Plotchart-308.2 {3D barchart: height of the bars and colours of the faces} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::create3DBarchart .c {0 10 2} 3]
    $p plot A 4 #ff0000
    $p plot B 8 #ff0000
    set fronts [lmap i [items u] {expr {[.c type $i] eq "rectangle" ? $i : [continue]}}]
    set heights {}
    foreach f $fronts {
	lassign [.c coords $f] x1 y1 x2 y2
	lappend heights [expr {abs($y2-$y1)}]
    }
    set faces [lsort -unique [lmap i [items u] {.c itemcget $i -fill}]]
    list [llength $fronts] [approx [lindex $heights 1] [expr {2*[lindex $heights 0]}] 1] \
	[llength $faces] [expr {"#ff0000" in $faces}]
} -cleanup {
    cleanupPlot
} -result {2 1 3 1}

test Plotchart-308.3 {3D barchart: negative values are tagged d} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::create3DBarchart .c {-10 10 5} 2]
    $p plot A -4 red
    list [llength [items d]] [llength [items u]]
} -cleanup {
    cleanupPlot
} -result {2 1}

