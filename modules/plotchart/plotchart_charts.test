# -*- tcl -*-
# plotchart_charts.test --
#
#	Tests for the Plotchart package: charts other than XY plots
#	(piecharts, spiral pies, radial charts, polar plots, wind roses,
#	vertical, horizontal and 3D barcharts, 3D ribbon charts, boxplots,
#	timecharts, Gantt charts, table charts, ternary diagrams, status
#	timelines and dendrograms).
#
# The output of Plotchart is drawn on a canvas, so the tests check the
# canvas items (types, tags, coordinates relative to each other, colours
# and texts), not pixels.
#
# The tests in this file are numbered Plotchart-301.M to Plotchart-399.M
# (plotchart.test uses the numbers below 100).

if {![package vsatisfies [package provide Tcl] 8.5-]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring Tcl 8.5, have [package present Tcl]"
    return
}

if {[catch { package require Tk 8.5- } msg]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring Tk 8.5, $msg"
    return
}

if {[lsearch [namespace children] ::tcltest] == -1} {
    package require tcltest 2.2
    namespace import ::tcltest::*
}

::tcltest::testConstraint tk 1

source [file join [file dirname [file normalize [info script]]] plotchart.tcl]

# -------------------------------------------------------------------------
# Helpers
#
# Plotchart keeps its state in namespace arrays keyed by the name of the
# canvas (or of its per-plot alias, "00.c", "01.c", ...).  The canvases
# are normally not mapped, so that the size of the plot is determined by
# the -width and -height options only.

# Collect background errors instead of showing a dialog
set ::bgErrors {}
proc ::testBgError {msg opts} {
    lappend ::bgErrors $msg
}
set ::oldBgError [interp bgerror {}]
interp bgerror {} ::testBgError

set ::oldRootState [wm state .]

proc mkCanvas {{width 400} {height 300} {c .c}} {
    canvas $c -width $width -height $height -background white \
	-highlightthickness 0 -borderwidth 0
    return $c
}

proc cleanupPlot {{c .c}} {
    if {[winfo exists $c]} {
	::Plotchart::clearcanvas $c
	destroy $c
    }
    set pat [string map {. \\.} $c]
    foreach a [interp aliases {}] {
	if {[regexp "^(.+_)?r?\[0-9\]\[0-9\]$pat\$" $a] ||
	    [regexp "^\[a-z0-9\]+_$pat\$" $a]} {
	    interp alias {} $a {}
	}
    }
    foreach v {scaling config data_series legend settings packing} {
	if {[info exists ::Plotchart::$v]} {
	    array unset ::Plotchart::$v *$c,*
	}
    }
}

# Return the item ids having all given tags, in display order.
# An element "type=T" selects only items of type T, "notype=T" excludes
# items of type T.
proc items {tags {c .c}} {
    set t {}
    set type {}
    set notype {}
    foreach x $tags {
	if {[string match type=* $x]} {
	    set type [string range $x 5 end]
	} elseif {[string match notype=* $x]} {
	    set notype [string range $x 7 end]
	} else {
	    lappend t $x
	}
    }
    set ids {}
    foreach i [$c find withtag [join $t " && "]] {
	if {($type eq "" || [$c type $i] eq $type) &&
	    ($notype eq "" || [$c type $i] ne $notype)} {
	    lappend ids $i
	}
    }
    return $ids
}

# Return the types of the items having all given tags, sorted and unique
proc itemTypes {tags {c .c}} {
    set types {}
    foreach i [items $tags $c] {
	lappend types [$c type $i]
    }
    lsort -unique $types
}

# Return the texts of the text items having all given tags
proc itemTexts {tags {c .c}} {
    set texts {}
    foreach i [items $tags $c] {
	if {[$c type $i] eq "text"} {
	    lappend texts [$c itemcget $i -text]
	}
    }
    return $texts
}

# Return the given option for all items having the given tags (unique)
proc itemOption {tags option {c .c}} {
    set values {}
    foreach i [items $tags $c] {
	lappend values [$c itemcget $i $option]
    }
    lsort -unique $values
}

# Round the numbers in a list to the given number of decimals
proc R {value {digits 1}} {
    set r {}
    foreach v $value {
	if {[string is double -strict $v]} {
	    set v [format %.${digits}f $v]
	    if {$v == 0} {set v [format %.${digits}f 0]}
	}
	lappend r $v
    }
    return $r
}

# Centre of the bounding box of the items with the given tags
proc centre {tags {c .c}} {
    lassign [$c bbox [join $tags " && "]] x1 y1 x2 y2
    list [expr {($x1+$x2)/2.0}] [expr {($y1+$y2)/2.0}]
}

# Pixel coordinates of a world point in the given plot
proc pix {p x y} {
    ::Plotchart::coordsToPixel [$p canvas] $x $y
}

proc approx {a b {eps 1.0}} {
    expr {abs($a-$b) <= $eps}
}

proc restoreRoot {} {
    if {$::oldRootState eq "withdrawn"} {
	wm withdraw .
    }
}

proc samePixels {a b {eps 0.51}} {
    if {[llength $a] != [llength $b]} {
	return 0
    }
    foreach u $a v $b {
	if {abs($u-$v) > $eps} {
	    return 0
	}
    }
    return 1
}

proc brightness {colour} {
    lassign [winfo rgb . $colour] r g b
    expr {$r + $g + $b}
}

# Items created by a script
proc newItems {script} {
    set before [.c find all]
    uplevel 1 $script
    set new {}
    foreach i [.c find all] {
	if {$i ni $before} {lappend new $i}
    }
    return $new
}

# Pixel coordinates of the plot area (from the scaling information)
proc plotArea {p} {
    set w [$p canvas]
    list $::Plotchart::scaling($w,pxmin) $::Plotchart::scaling($w,pymin) \
	$::Plotchart::scaling($w,pxmax) $::Plotchart::scaling($w,pymax)
}

# Direction of a point relative to a centre: n, ne, e, ...
proc direction {x y xc yc} {
    set h [expr {$x < $xc - 1 ? "w" : ($x > $xc + 1 ? "e" : "")}]
    set v [expr {$y < $yc - 1 ? "n" : ($y > $yc + 1 ? "s" : "")}]
    return $v$h
}

# -------------------------------------------------------------------------
# Piecharts

test Plotchart-301.1 {piechart: one segment per value} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createPiechart .c]
    $p plot {A 1 B 1 C 2}
    set arcs [items {data type=arc}]
    set r {}
    foreach a $arcs {
	lappend r [R [.c itemcget $a -extent] 0]
    }
    list [string match piechart_* $p] [llength $arcs] $r \
	[lsort -unique [lmap a $arcs {.c itemcget $a -style}]] \
	[lmap a $arcs {.c itemcget $a -fill}] \
	[itemTexts segment_0] [itemTexts segment_1] [itemTexts segment_2]
} -cleanup {
    cleanupPlot
} -result {1 3 {90 90 180} pieslice {blue lightblue green} A B C}

test Plotchart-301.2 {piechart: segments are contiguous, starting at angle 0} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createPiechart .c]
    $p plot {A 1 B 1 C 2}
    lmap a [items {data type=arc}] {R [.c itemcget $a -start] 0}
} -cleanup {
    cleanupPlot
} -result {0 90 180}

test Plotchart-301.3 {piechart: default direction is clockwise} -constraints {
    knownBug
} -setup {
    mkCanvas 400 400
} -body {
    # The segments are drawn counter-clockwise
    set p [::Plotchart::createPiechart .c]
    $p plot {A 1 B 1 C 2}
    lassign [plotArea $p] x1 y1 x2 y2
    lassign [centre {segment_0 type=arc}] x y
    direction $x $y [expr {($x1+$x2)/2.0}] [expr {($y1+$y2)/2.0}]
} -cleanup {
    cleanupPlot
} -result {se}

test Plotchart-301.4 {piechart: labels outside the circle} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createPiechart .c]
    $p plot {A 1 B 1 C 2}
    lassign [plotArea $p] x1 y1 x2 y2
    set xc [expr {($x1+$x2)/2.0}]
    set yc [expr {($y1+$y2)/2.0}]
    set r [expr {($x2-$x1)/2.0}]
    set out {}
    foreach seg {0 1 2} {
	set t [items [list segment_$seg type=text]]
	lassign [.c coords $t] x y
	lappend out [expr {hypot($x-$xc, $y-$yc) > $r}]
    }
    set out
} -cleanup {
    cleanupPlot
} -result {1 1 1}

test Plotchart-301.5 {piechart: colours} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createPiechart .c]
    $p colours red green blue
    $p plot {A 1 B 1 C 1}
    lmap a [items {data type=arc}] {.c itemcget $a -fill}
} -cleanup {
    cleanupPlot
} -result {red green blue}

test Plotchart-301.5a {piechart: colours are reused for more segments} -constraints {
    knownBug
} -setup {
    mkCanvas 400 400
} -body {
    # The fourth segment is not filled
    set p [::Plotchart::createPiechart .c]
    $p colours red green blue
    $p plot {A 1 B 1 C 1 D 1}
    expr {"" ni [lmap a [items {data type=arc}] {.c itemcget $a -fill}]}
} -cleanup {
    cleanupPlot
} -result 1

test Plotchart-301.6 {piechart: one value gives a full circle} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createPiechart .c]
    $p plot {Everything 10}
    set new [.c find all]
    list [lsort [lmap i $new {.c type $i}]] [lmap i $new {expr {[.c type $i] eq "text" ? [.c itemcget $i -text] : [continue]}}]
} -cleanup {
    cleanupPlot
} -result {{oval text} Everything}

test Plotchart-301.7 {piechart: explode a segment} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createPiechart .c]
    $p plot {A 1 B 1 C 2}
    set c0 [.c coords [items {segment_0 type=arc}]]
    set c1 [.c coords [items {segment_1 type=arc}]]
    $p explode 0
    set d0 [.c coords [items {segment_0 type=arc}]]
    # Segment 0 (0-90 degrees) moves to the upper right
    set r [list [expr {[lindex $d0 0] > [lindex $c0 0]}] [expr {[lindex $d0 1] < [lindex $c0 1]}] \
	       [expr {$c1 eq [.c coords [items {segment_1 type=arc}]]}]]
    # Exploding another segment moves the first back
    $p explode 2
    lappend r [samePixels [.c coords [items {segment_0 type=arc}]] $c0 0.01] \
	[expr {[.c coords [items {segment_2 type=arc}]] ne $c0}]
    # Exploding the same segment again moves it back
    $p explode 2
    lappend r [expr {[lindex [.c coords [items {segment_2 type=arc}]] 0] == [lindex $c0 0]}]
} -cleanup {
    cleanupPlot
} -result {1 1 1 1 1 1}

test Plotchart-301.8 {piechart: explode auto, click on a segment} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createPiechart .c]
    $p plot {A 1 B 1 C 2}
    set w [$p canvas]
    set c1 [.c coords [items {segment_1 type=arc}]]
    # Without "auto" a click does nothing
    ::Plotchart::PieExplodeSegment $w 1 1
    set r [list [expr {$c1 eq [.c coords [items {segment_1 type=arc}]]}]]
    $p explode auto
    ::Plotchart::PieExplodeSegment $w 1 1
    lappend r [expr {$c1 ne [.c coords [items {segment_1 type=arc}]]}]
} -cleanup {
    cleanupPlot
} -result {1 1}

test Plotchart-301.9 {piechart: labels and slice configuration} -setup {
    ::Plotchart::plotconfig piechart labels textcolor red
    ::Plotchart::plotconfig piechart labels font {Courier 12}
    ::Plotchart::plotconfig piechart labels shownumbers 1
    ::Plotchart::plotconfig piechart slice outline blue
    ::Plotchart::plotconfig piechart slice outlinewidth 3
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createPiechart .c]
    $p plot {A 1 B 3}
    list [itemTexts data] [lsort -unique [lmap t [items {all type=text}] {.c itemcget $t -fill}]] \
	[lsort -unique [lmap t [items {all type=text}] {.c itemcget $t -font}]] \
	[itemOption {data type=arc} -outline] [itemOption {data type=arc} -width]
} -cleanup {
    cleanupPlot
    foreach {comp prop} {labels textcolor labels font labels shownumbers slice outline slice outlinewidth} {
	::Plotchart::plotconfig piechart $comp $prop default
    }
} -result {{} red {{Courier 12}} blue 3.0}

test Plotchart-301.10 {piechart: shownumbers with format and formatright} -setup {
    ::Plotchart::plotconfig piechart labels shownumbers 1
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createPiechart .c]
    $p plot {A 1 B 3}
    set r [list [lmap s {0 1} {itemTexts segment_$s}]]
    cleanupPlot
    ::Plotchart::plotconfig piechart labels format "%s: %g"
    ::Plotchart::plotconfig piechart labels formatright "%g = %s"
    mkCanvas 400 400
    set p [::Plotchart::createPiechart .c]
    $p plot {A 1 B 3}
    lappend r [lmap s {0 1} {itemTexts segment_$s}]
} -cleanup {
    cleanupPlot
    foreach prop {shownumbers format formatright} {
	::Plotchart::plotconfig piechart labels $prop default
    }
} -result {{{{A (1)}} {{B (3)}}} {{{1 = A}} {{B: 3}}}}

test Plotchart-301.11 {piechart: labels sorted and placed inside} -setup {
    ::Plotchart::plotconfig piechart labels sorted 1
    ::Plotchart::plotconfig piechart labels placement in
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createPiechart .c]
    $p plot {A 3 B 1 C 2}
    lassign [plotArea $p] x1 y1 x2 y2
    set xc [expr {($x1+$x2)/2.0}]
    set yc [expr {($y1+$y2)/2.0}]
    set r [expr {($x2-$x1)/2.0}]
    set in {}
    foreach seg {0 1 2} {
	lassign [.c coords [items [list segment_$seg type=text]]] x y
	lappend in [expr {hypot($x-$xc, $y-$yc) < $r}]
    }
    list [lmap s {0 1 2} {itemTexts segment_$s}] $in [itemOption {all type=text} -anchor]
} -cleanup {
    cleanupPlot
    ::Plotchart::plotconfig piechart labels sorted default
    ::Plotchart::plotconfig piechart labels placement default
} -result {{B C A} {1 1 1} center}

test Plotchart-301.12 {piechart: start angle and direction} -setup {
    ::Plotchart::plotconfig piechart slice startangle 90
    ::Plotchart::plotconfig piechart slice direction -
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createPiechart .c]
    $p plot {A 1 B 1}
    lmap a [items {data type=arc}] {list [R [.c itemcget $a -start] 0] [R [.c itemcget $a -extent] 0]}
} -cleanup {
    cleanupPlot
    ::Plotchart::plotconfig piechart slice startangle default
    ::Plotchart::plotconfig piechart slice direction default
} -result {{90 -180} {270 -180}}

test Plotchart-301.13 {piechart: wrong # args} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createPiechart .c]
    $p plot
} -cleanup {
    cleanupPlot
} -returnCodes error -result {wrong # args: should be "DrawPie w data"}

# -------------------------------------------------------------------------
# Spiral pies

test Plotchart-302.1 {spiralpie: equal angles, radius from the value} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createSpiralPie .c]
    $p plot {A 4 B 1 C 9}
    set arcs [items {data type=arc}]
    set radii {}
    foreach a $arcs {
	lassign [.c coords $a] x1 y1 x2 y2
	lappend radii [expr {($x2-$x1)/2.0}]
    }
    list [string match spiralpie_* $p] [llength $arcs] \
	[lmap a $arcs {R [.c itemcget $a -extent] 0}] \
	[expr {[lindex $radii 1] < [lindex $radii 0] && [lindex $radii 0] < [lindex $radii 2]}]
} -cleanup {
    cleanupPlot
} -result {1 3 {120 120 120} 1}

test Plotchart-302.2 {spiralpie: data sorted by default} -constraints {
    knownBug
} -setup {
    mkCanvas 400 400
} -body {
    # The data are only sorted if "plotconfig spiralpie labels sorted 1"
    set p [::Plotchart::createSpiralPie .c]
    $p plot {A 4 B 1 C 9}
    lmap s {0 1 2} {itemTexts segment_$s}
} -cleanup {
    cleanupPlot
} -result {B A C}

test Plotchart-302.3 {spiralpie: sorted via plotconfig, colours} -setup {
    ::Plotchart::plotconfig spiralpie labels sorted 1
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createSpiralPie .c]
    $p colours red green blue
    $p plot {A 4 B 1 C 9}
    list [lmap s {0 1 2} {itemTexts segment_$s}] [lmap a [items {data type=arc}] {.c itemcget $a -fill}]
} -cleanup {
    cleanupPlot
    ::Plotchart::plotconfig spiralpie labels sorted default
} -result {{B A C} {red green blue}}

# -------------------------------------------------------------------------
# Radial charts

test Plotchart-303.1 {radialchart: spokes with names} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createRadialchart .c {A B LongerName C} 10]
    set texts [lmap i [.c find all] {expr {[.c type $i] eq "text" ? [.c itemcget $i -text] : [continue]}}]
    set lines [lmap i [.c find all] {expr {[.c type $i] eq "line" ? $i : [continue]}}]
    list [string match radialchart_* $p] $texts [llength $lines]
} -cleanup {
    cleanupPlot
} -result {1 {A B LongerName C} 4}

test Plotchart-303.2 {radialchart plot: polyline through the spokes} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createRadialchart .c {A B C D} 10]
    $p plot {10 5 0 5} red 2
    set d [items data]
    lassign [plotArea $p] x1 y1 x2 y2
    set xc [expr {($x1+$x2)/2.0}]
    set yc [expr {($y1+$y2)/2.0}]
    set r [expr {($x2-$x1)/2.0}]
    list [.c type $d] [.c itemcget $d -outline] [.c itemcget $d -fill] [.c itemcget $d -width] \
	[samePixels [.c coords $d] [list [expr {$xc+$r}] $yc $xc [expr {$yc-$r/2}] $xc $yc $xc [expr {$yc+$r/2}]] 1]
} -cleanup {
    cleanupPlot
} -result {polygon red {} 2.0 1}

test Plotchart-303.3 {radialchart plot: default thickness 1} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createRadialchart .c {A B C} 10]
    $p plot {1 2 3} green
    itemOption data -width
} -cleanup {
    cleanupPlot
} -result {1.0}

test Plotchart-303.4 {radialchart cumulative: data accumulated} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createRadialchart .c {A B C D} 10 cumulative]
    $p plot {2 2 2 2} red
    $p plot {3 3 3 3} blue
    lassign [plotArea $p] x1 y1 x2 y2
    set xc [expr {($x1+$x2)/2.0}]
    set r [expr {($x2-$x1)/2.0}]
    lassign [items data] d1 d2
    list [R [expr {([lindex [.c coords $d1] 0]-$xc)/$r}] 2] [R [expr {([lindex [.c coords $d2] 0]-$xc)/$r}] 2] \
	[.c itemcget $d2 -fill]
} -cleanup {
    cleanupPlot
} -result {0.50 0.20 {}}

test Plotchart-303.5 {radialchart filled: filled polygons, accumulated} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createRadialchart .c {A B C D} 10 filled]
    $p plot {2 2 2 2} red
    $p plot {3 3 3 3} blue
    lassign [plotArea $p] x1 y1 x2 y2
    set xc [expr {($x1+$x2)/2.0}]
    set r [expr {($x2-$x1)/2.0}]
    set ds [items data]
    list [lmap d $ds {.c itemcget $d -fill}] \
	[lmap d $ds {R [expr {([lindex [.c coords $d] 0]-$xc)/$r}] 2}]
} -cleanup {
    cleanupPlot
} -result {{blue red} {0.50 0.20}}

test Plotchart-303.6 {radialchart lines: independent polylines (default)} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createRadialchart .c {A B C D} 10 lines]
    $p plot {2 2 2 2} red
    $p plot {3 3 3 3} blue
    lassign [plotArea $p] x1 y1 x2 y2
    set xc [expr {($x1+$x2)/2.0}]
    set r [expr {($x2-$x1)/2.0}]
    lsort [lmap d [items data] {R [expr {([lindex [.c coords $d] 0]-$xc)/$r}] 2}]
} -cleanup {
    cleanupPlot
} -result {0.20 0.30}

test Plotchart-303.7 {radialchart plot: wrong number of data} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createRadialchart .c {A B C D} 10]
    $p plot {1 2 3} red
} -cleanup {
    cleanupPlot
} -returnCodes error -result {Incorrect number of data given - should be 4}

# -------------------------------------------------------------------------
# Polar plots

test Plotchart-304.1 {polarplot: circles and radial lines} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createPolarplot .c {3.0 1.0}]
    set circles [items {polar type=oval}]
    set labels [itemTexts polar]
    list [string match polarplot_* $p] [llength $circles] \
	[lrange $labels 0 11] [lrange $labels 12 end] \
	[llength [lmap i [.c find all] {expr {[.c type $i] eq "line" ? $i : [continue]}}]] \
	[lsort -unique [lmap i $circles {.c itemcget $i -outline}]]
} -cleanup {
    cleanupPlot
} -result {1 3 {0.0 30.0 60.0 90.0 120.0 150.0 180.0 210.0 240.0 270.0 300.0 330.0} {1.0 2.0 3.0} 12 gray}

test Plotchart-304.2 {polarplot: the plot area is square} -setup {
    mkCanvas 500 300
} -body {
    set p [::Plotchart::createPolarplot .c {3.0 1.0}]
    lassign [plotArea $p] x1 y1 x2 y2
    approx [expr {$x2-$x1}] [expr {$y2-$y1}] 1
} -cleanup {
    cleanupPlot
} -result 1

test Plotchart-304.3 {polarplot plot: radius and angle in degrees} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createPolarplot .c {3.0 1.0}]
    $p plot s 2 0
    $p plot s 2 90
    lassign [plotArea $p] x1 y1 x2 y2
    set xc [expr {($x1+$x2)/2.0}]
    set yc [expr {($y1+$y2)/2.0}]
    set r3 [expr {($x2-$x1)/2.0}]
    set l [items data_s]
    samePixels [.c coords $l] [list [expr {$xc+2*$r3/3}] $yc $xc [expr {$yc-2*$r3/3}]] 1
} -cleanup {
    cleanupPlot
} -result 1

test Plotchart-304.4 {polarplot: dataconfig and legend} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createPolarplot .c {3.0 1.0}]
    $p dataconfig s -colour red -type both -symbol circle
    $p plot s 1 0
    $p plot s 2 45
    $p legend s "Spiral"
    list [lsort [itemTypes data_s]] [itemOption {data_s type=line} -fill] [itemTexts legend]
} -cleanup {
    cleanupPlot
} -result {{line oval} red Spiral}

test Plotchart-304.5 {polarplot: invalid radius data} -setup {
    mkCanvas 400 400
} -body {
    list [catch {::Plotchart::createPolarplot .c {3.0 0}} m1] $m1 \
	[catch {::Plotchart::createPolarplot .c {-1 1}} m2] $m2
} -cleanup {
    cleanupPlot
} -result {1 {Step size can not be zero or negative} 1 {Maximum radius can not be zero or negative}}

test Plotchart-304.6 {polarplot: documented name createPolarPlot} -constraints {
    knownBug
} -setup {
    mkCanvas 400 400
} -body {
    # The command is called createPolarplot
    set p [::Plotchart::createPolarPlot .c {3.0 1.0}]
    string match polarplot_* $p
} -cleanup {
    cleanupPlot
} -result 1

test Plotchart-304.7 {polarplot: axis configuration} -setup {
    ::Plotchart::plotconfig polarplot axis color red
    ::Plotchart::plotconfig polarplot axis textcolor blue
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createPolarplot .c {3.0 1.0}]
    list [itemOption {polar type=oval} -outline] [itemOption {polar type=text} -fill]
} -cleanup {
    cleanupPlot
    ::Plotchart::plotconfig polarplot axis color default
    ::Plotchart::plotconfig polarplot axis textcolor default
} -result {red blue}

# -------------------------------------------------------------------------
# Wind roses

test Plotchart-305.1 {windrose: circles and compass directions} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createWindRose .c {30 10} 4]
    set texts [lmap i [.c find all] {expr {[.c type $i] eq "text" ? [.c itemcget $i -text] : [continue]}}]
    list [string match windrose_* $p] $texts \
	[llength [lmap i [.c find all] {expr {[.c type $i] eq "oval" ? $i : [continue]}}]]
} -cleanup {
    cleanupPlot
} -result {1 {North West South East 10 20 30} 3}

test Plotchart-305.2 {windrose plot: sectors clockwise from north} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createWindRose .c {30 10} 4]
    $p plot {20 10 5 3} red
    set arcs [items data_0]
    set w [$p canvas]
    lassign [::Plotchart::PolarToPixelPriv $w 0 0] xc yc
    set r {}
    foreach a $arcs {
	set start [.c itemcget $a -start]
	set ext [.c itemcget $a -extent]
	lappend r [R [expr {fmod($start + $ext/2.0 + 720.0, 360.0)}] 0]
    }
    list [llength $arcs] $r [itemOption data_0 -fill] [itemOption data_0 -style]
} -cleanup {
    cleanupPlot
} -match glob -output * -result {4 {90 0 270 180} red pieslice}

test Plotchart-305.3 {windrose plot: radius from the data, accumulated} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createWindRose .c {30 10} 4]
    $p plot {20 10 5 3} red
    $p plot {10 10 10 3} blue
    set w [$p canvas]
    lassign [::Plotchart::PolarToPixelPriv $w 0 0] xc yc
    lassign [::Plotchart::PolarToPixelPriv $w 10 0] x10 yc
    set unit [expr {($x10-$xc)/10.0}]
    set r {}
    foreach tag {data_0 data_1} {
	foreach a [items $tag] {
	    lassign [.c coords $a] x1 y1 x2 y2
	    lappend r [R [expr {($x2-$x1)/2.0/$unit}] 0]
	}
    }
    list $r [itemOption data_1 -fill] \
	[expr {[lsearch [.c find all] [lindex [items data_1] 0]] < [lsearch [.c find all] [lindex [items data_0] 0]]}]
} -cleanup {
    cleanupPlot
} -match glob -output * -result {{20 10 5 3 30 20 15 6} blue 1}

test Plotchart-305.4 {windrose plot: no output on stdout} -constraints {
    knownBug
} -setup {
    mkCanvas 400 400
} -body {
    # A debugging statement prints the coordinates
    set p [::Plotchart::createWindRose .c {30 10} 4]
    $p plot {20 10 5 3} red
} -cleanup {
    cleanupPlot
} -output {} -result {}

