# -------------------------------------------------------------------------
# Status timelines

test Plotchart-315.1 {statustimeline: labels and axis} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createStatusTimeline .c {0 10 2} {A B C}]
    list [string match statustimeline_* $p] [itemTexts yaxis] [itemTexts xaxis]
} -cleanup {
    cleanupPlot
} -result {1 {A B C} {0 2 4 6 8 10}}

test Plotchart-315.2 {statustimeline: -xaxis no} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createStatusTimeline .c {0 10 2} {A B C} -xaxis no]
    list [itemTexts yaxis] [itemTexts xaxis]
} -cleanup {
    cleanupPlot
} -result {{A B C} {}}

test Plotchart-315.3 {statustimeline plot: documented arguments} -constraints {
    knownBug
} -setup {
    mkCanvas
} -body {
    # The item argument is not implemented: wrong # args
    set p [::Plotchart::createStatusTimeline .c {0 10 2} {A B C}]
    $p plot s1 item1 0 4 red
    itemOption {below type=rectangle} -fill
} -cleanup {
    cleanupPlot
} -result {red}

test Plotchart-315.4 {statustimeline plot: one row per series from the top} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createStatusTimeline .c {0 10 2} {A B C}]
    $p plot s1 0 4 red
    $p plot s2 2 5
    set bars [items {below type=rectangle}]
    set geo {}
    foreach b $bars {
	lassign [.c coords $b] x1 y1 x2 y2
	lassign [::Plotchart::pixelToCoords [$p canvas] $x1 $y1] wx1 wy1
	lassign [::Plotchart::pixelToCoords [$p canvas] $x2 $y2] wx2 wy2
	lappend geo [list [.c itemcget $b -fill] [R [list $wx1 $wx2] 0] [R [expr {($wy1+$wy2)/2.0}] 1]]
    }
    set geo
} -cleanup {
    cleanupPlot
} -result {{red {0 4} 3.2} {black {2 5} 2.2}}

test Plotchart-315.4a {statustimeline plot: more bars in the same row} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createStatusTimeline .c {0 10 2} {A B C}]
    $p plot s1 0 4 red
    $p plot s1 4 7 green
    lassign [items {below type=rectangle}] b1 b2
    list [lindex [.c coords $b1] 1] [lindex [.c coords $b1] 3] [.c itemcget $b2 -fill] \
	[expr {[lindex [.c coords $b1] 1] == [lindex [.c coords $b2] 1]}]
} -cleanup {
    cleanupPlot
} -match glob -result {* * green 1}

test Plotchart-315.4b {statustimeline plot: next series in the next row} -constraints {
    knownBug
} -setup {
    mkCanvas
} -body {
    # Each plot call moves to the next row, even for an existing series
    set p [::Plotchart::createStatusTimeline .c {0 10 2} {A B C}]
    $p plot s1 0 4 red
    $p plot s1 4 7 green
    $p plot s2 2 5
    lassign [items {below type=rectangle}] b1 b2 b3
    lassign [.c coords $b3] x1 y1 x2 y2
    R [lindex [::Plotchart::pixelToCoords [$p canvas] $x1 [expr {($y1+$y2)/2.0}]] 1] 1
} -cleanup {
    cleanupPlot
} -result {2.2}

test Plotchart-315.4c {statustimeline plot: items drawn from bottom to top} -constraints {
    knownBug
} -setup {
    mkCanvas
} -body {
    # The first item is drawn at the top
    set p [::Plotchart::createStatusTimeline .c {0 10 2} {A B C}]
    $p plot s1 0 4 red
    $p plot s2 2 5
    lassign [items {below type=rectangle}] b1 b2
    expr {[lindex [.c coords $b1] 1] > [lindex [.c coords $b2] 1]}
} -cleanup {
    cleanupPlot
} -result 1

test Plotchart-315.5 {statustimeline vertline: line with text and options} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createStatusTimeline .c {0 10 2} {A B C}]
    $p vertline "Now" 5 -fill red -width 2
    set l [items {tline type=line}]
    lassign [.c coords $l] x1 y1 x2 y2
    list [.c itemcget $l -fill] [.c itemcget $l -width] [expr {$x1 == $x2}] \
	[approx $x1 [lindex [pix $p 5 1] 0] 0.5] [itemTexts timeline]
} -cleanup {
    cleanupPlot
} -result {red 2.0 1 1 Now}

test Plotchart-315.6 {statustimeline: dates as x values} -setup {
    mkCanvas
} -body {
    set t0 [clock scan "2020-01-01" -gmt 1]
    set t1 [clock scan "2020-01-11" -gmt 1]
    set p [::Plotchart::createStatusTimeline .c [list $t0 $t1 86400] {A B} -xaxis 0]
    $p plot s "2020-01-03" "2020-01-05" blue
    set b [items {below type=rectangle}]
    lassign [.c coords $b] x1
    approx $x1 [lindex [pix $p [clock scan "2020-01-03"] 1] 0] 0.5
} -cleanup {
    cleanupPlot
} -result 1

# -------------------------------------------------------------------------
# Dendrograms

proc dendroTexts {} {
    lmap i [.c find all] {expr {[.c type $i] eq "text" ? [.c itemcget $i -text] : [continue]}}
}
proc dendroLabels {} {
    set r {}
    foreach i [.c find all] {
	if {[.c type $i] eq "text" && "title" ni [.c gettags $i]} {
	    lappend r [list [.c itemcget $i -text] {*}[R [.c coords $i] 0] [.c itemcget $i -angle] [.c itemcget $i -anchor]]
	}
    }
    return $r
}

test Plotchart-316.1 {dendrogram: labels at the leaves} -setup {
    mkCanvas 500 500
} -body {
    set p [::Plotchart::createDendrogram .c]
    $p plot s {{"Label1" "Label2"} {F {A B} {C {D E}}}}
    list [string match dendrogram_* $p] [dendroTexts] \
	[expr {[llength [lmap i [.c find all] {expr {[.c type $i] eq "line" ? $i : [continue]}}]] > 8}]
} -cleanup {
    cleanupPlot
} -result {1 {Label1 Label2 F A B C D E} 1}

test Plotchart-316.2 {dendrogram: top-bottom (default), labels vertical at the same level} -setup {
    mkCanvas 500 500
} -body {
    set p [::Plotchart::createDendrogram .c]
    $p plot s {{"Label1" "Label2"} {F {A B} {C {D E}}}}
    set labels [dendroLabels]
    list [lsort -unique [lmap l $labels {lindex $l 2}]] [lsort -unique [lmap l $labels {lindex $l 3}]] \
	[lsort -unique [lmap l $labels {lindex $l 4}]]
} -cleanup {
    cleanupPlot
} -match glob -result {[0-9]* 90.0 e}

test Plotchart-316.3 {dendrogram: -extend 0, labels where the branch ends} -setup {
    mkCanvas 500 500
} -body {
    set p [::Plotchart::createDendrogram .c -extend 0]
    $p plot s {{"Label1" "Label2"} {F {A B} {C {D E}}}}
    set labels [dendroLabels]
    expr {[llength [lsort -unique [lmap l $labels {lindex $l 2}]]] > 1}
} -cleanup {
    cleanupPlot
} -result 1

test Plotchart-316.4 {dendrogram: directions} -setup {
    mkCanvas 500 500
} -body {
    set r {}
    foreach dir {left-right right-left top-bottom bottom-top} {
	set p [::Plotchart::createDendrogram .c -direction $dir]
	$p plot s {{A B} {C D}}
	set labels [dendroLabels]
	set xs [lsort -unique [lmap l $labels {lindex $l 1}]]
	set ys [lsort -unique [lmap l $labels {lindex $l 2}]]
	lappend r $dir [llength $xs] [llength $ys] [lsort -unique [lmap l $labels {lindex $l 4}]]
	cleanupPlot
	mkCanvas 500 500
    }
    set r
} -cleanup {
    cleanupPlot
} -result {left-right 1 4 w right-left 1 4 e top-bottom 4 1 e bottom-top 4 1 w}

test Plotchart-316.5 {dendrogram: left-right puts the labels at the right} -setup {
    mkCanvas 500 500
} -body {
    set r {}
    foreach dir {left-right right-left} {
	set p [::Plotchart::createDendrogram .c -direction $dir]
	$p plot s {{A B} {C D}}
	lappend r [expr {[lindex [dendroLabels] 0 1] > 250 ? "right" : "left"}]
	cleanupPlot
	mkCanvas 500 500
    }
    set r
} -cleanup {
    cleanupPlot
} -result {right left}

test Plotchart-316.6 {dendrogram: LEAF for a label with several words} -constraints {
    knownBug
} -setup {
    mkCanvas 500 500
} -body {
    # The label is drawn as {Label 1}
    set p [::Plotchart::createDendrogram .c]
    $p plot s {{LEAF "Label 1"} {F {A B} {C {D E}}}}
    dendroTexts
} -cleanup {
    cleanupPlot
} -result {{Label 1} F A B C D E}

test Plotchart-316.6a {dendrogram: all elements of a LEAF list are leaves} -constraints {
    knownBug
} -setup {
    mkCanvas 500 500
} -body {
    # The elements are drawn as a single label
    set p [::Plotchart::createDendrogram .c]
    $p plot s {{LEAF "Label 1" "Label 2"} {F {A B} {C {D E}}}}
    dendroTexts
} -cleanup {
    cleanupPlot
} -result {{Label 1} {Label 2} F A B C D E}

test Plotchart-316.7 {dendrogram: colours and font of the series} -setup {
    mkCanvas 500 500
} -body {
    set p [::Plotchart::createDendrogram .c]
    $p dataconfig s -colour red -labelcolour blue -labelfont {Courier 10}
    $p plot s {{A B} {C D}}
    list [lsort -unique [lmap i [.c find all] {expr {[.c type $i] eq "line" ? [.c itemcget $i -fill] : [continue]}}]] \
	[lsort -unique [lmap i [.c find all] {expr {[.c type $i] eq "text" ? [.c itemcget $i -fill] : [continue]}}]] \
	[lsort -unique [lmap i [.c find all] {expr {[.c type $i] eq "text" ? [.c itemcget $i -font] : [continue]}}]]
} -cleanup {
    cleanupPlot
} -result {red blue {{Courier 10}}}

test Plotchart-316.8 {dendrogram: -color and -labelcolor synonyms} -setup {
    mkCanvas 500 500
} -body {
    set p [::Plotchart::createDendrogram .c]
    $p dataconfig s -color green -labelcolor orange
    $p plot s {{A B} {C D}}
    list [lsort -unique [lmap i [.c find all] {expr {[.c type $i] eq "line" ? [.c itemcget $i -fill] : [continue]}}]] \
	[lsort -unique [lmap i [.c find all] {expr {[.c type $i] eq "text" ? [.c itemcget $i -fill] : [continue]}}]]
} -cleanup {
    cleanupPlot
} -result {green orange}

test Plotchart-316.9 {dendrogram: unknown direction} -setup {
    mkCanvas 500 500
} -body {
    ::Plotchart::createDendrogram .c -direction up-down
} -cleanup {
    cleanupPlot
} -returnCodes error -result {Unknown direction: up-down}

# -------------------------------------------------------------------------
interp bgerror {} $::oldBgError
restoreRoot
test Plotchart-399.1 {no background errors} -body {
    set ::bgErrors
} -result {}
::tcltest::cleanupTests
