    set texts [itemTexts axis3d]
    list [string match 3dribbon_* $p] [expr {"Series1" in $texts && "Series2" in $texts}]
} -cleanup {
    cleanupPlot
} -result {1 1}

test Plotchart-309.2 {3D ribbon chart line: one polygon per segment} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::create3DRibbonChart .c {S1 S2} {0 10 5} {0 10 5}]
    set new [newItems {$p line {0 2 5 8 10 4} #00c000}]
    list [llength $new] [lsort -unique [lmap i $new {.c type $i}]] \
	[expr {[llength [lsort -unique [lmap i $new {.c itemcget $i -fill}]]] >= 1}]
} -cleanup {
    cleanupPlot
