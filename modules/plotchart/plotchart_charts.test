    knownBug
} -setup {
    mkCanvas 400 400
} -body {
    # The width is used as the colour
    set p [::Plotchart::createTernaryDiagram .c]
    $p dataconfig l -colour blue -width 3
    $p line l {100 0 0 0 100 0 0 0 100}
    list [itemOption data_l -fill] [itemOption data_l -width]
} -cleanup {
    cleanupPlot
} -result {blue 3.0}

test Plotchart-314.6 {ternary text: texts at the corners} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createTernaryDiagram .c]
    $p text "Sand" "Clay" "Silt"
    set ts [items ternarytext]
    list [lmap t $ts {.c itemcget $t -text}] [lmap t $ts {.c itemcget $t -anchor}]
} -cleanup {
