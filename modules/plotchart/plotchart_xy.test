test Plotchart-210.7 {dotconfig -3deffect: highlights in the dot} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p dotconfig d -3deffect 1 -colour #0000c0
    $p dot d 5 5 10
    set ids [items data_d]
    set big [lindex $ids 0]
    lassign [.c bbox $big] bx1 by1 bx2 by2
    set inside 1
    foreach i [lrange $ids 1 end] {
	lassign [.c bbox $i] x1 y1 x2 y2
	if {$x1 < $bx1 || $y1 < $by1 || $x2 > $bx2 || $y2 > $by2} {set inside 0}
    }
    list [expr {[llength $ids] > 1}] $inside \
	[expr {[brightness [.c itemcget [lindex $ids end] -fill]] > [brightness #0000c0]}]
} -cleanup {
    cleanupPlot
} -result {1 1 1}

