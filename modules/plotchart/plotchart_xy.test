} -returnCodes error -result {Minimum and maximum for y-axis must be positive}

test Plotchart-215.4 {createLogXYPlot: logarithmic x-axis} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createLogXYPlot .c {1 1000} {0 10 2}]
    $p plot s 10 2
    $p plot s 100 8
    list [string match logxyplot_* $p] [itemTexts xaxis] [itemTexts yaxis] \
	[samePixels [.c coords [items data_s]] [pixList $p {10 2 100 8}]]
} -cleanup {
