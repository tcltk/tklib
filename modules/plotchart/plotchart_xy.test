    knownBug
} -setup {
    mkCanvas 400 400
} -body {
    # Fails with: domain error: argument not in valid range
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    ::Plotchart::colorMap hot
    set new [newItems {
	$p contourlines $gridX $gridY $gridF {5 10 15}
    }]
    checkLevels $p $new {5 10 15}
} -cleanup {
    cleanupPlot
    ::Plotchart::colorMap jet
} -result {5 10 15}

test Plotchart-211.14 {colorMap: grey map is grey from dark to light} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    ::Plotchart::colorMap grey
    set new [newItems {
	$p contourlines $gridX $gridY $gridF {5 10 15}
    }]
    set r {}
    set levels {}
    foreach i $new {
	lassign [winfo rgb . [.c itemcget $i -fill]] red green blue
	lappend r [expr {$red == $green && $green == $blue}]
	lassign [::Plotchart::pixelToCoords [$p canvas] {*}[lrange [.c coords $i] 0 1]] x y
	lappend levels [list [expr {round($x+$y)}] $red]
    }
    set levels [lsort -unique -index 0 -integer $levels]
    list [lsort -unique $r] [expr {[lindex $levels 0 1] < [lindex $levels end 1]}]
} -cleanup {
    cleanupPlot
    ::Plotchart::colorMap jet
} -result {1 1}

test Plotchart-211.14a {colorMap: unknown map name uses jet} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    ::Plotchart::colorMap jet
    set new [newItems {$p contourlines $gridX $gridY $gridF {5 10 15}}]
    set c1 [lmap i $new {.c itemcget $i -fill}]
    .c delete {*}$new
    ::Plotchart::colorMap nosuchmap
    set new [newItems {$p contourlines $gridX $gridY $gridF {5 10 15}}]
    expr {$c1 eq [lmap i $new {.c itemcget $i -fill}]}
} -cleanup {
    cleanupPlot
    ::Plotchart::colorMap jet
} -output "Colormap : Unknown colorMapType, nosuchmap.  Using JET\n" -result 1

