# -------------------------------------------------------------------------
# Contours, grid, colour maps and their legends

# A 3x3 grid with f = x + y
set gridX {{0 5 10} {0 5 10} {0 5 10}}
set gridY {{0 0 0} {5 5 5} {10 10 10}}
set gridF {{0 5 10} {5 10 15} {10 15 20}}

# Items created by a script
proc newItems {script} {
    set before [.c find all]
    uplevel 1 $script
    set new {}
    foreach i [.c find all] {
	if {$i ni $before} {lappend new $i}
    }
    return $new
}

# Check that all lines lie on one of the levels of f = x + y, that each
# level has a single colour and that different levels have different
# colours.  Returns the list of levels found.
proc checkLevels {p ids levels} {
    set colourOf {}
    set found {}
    foreach i $ids {
	set col [.c itemcget $i -fill]
	set lev {}
	foreach {px py} [.c coords $i] {
	    lassign [::Plotchart::pixelToCoords [$p canvas] $px $py] x y
	    set l [lsearch -inline -all [lmap v $levels {expr {abs($x+$y-$v) < 0.1 ? $v : [continue]}}] *]
	    if {[llength $l] != 1} {return "point not on a level"}
	    lappend lev [lindex $l 0]
	}
	set lev [lsort -unique $lev]
	if {[llength $lev] != 1} {return "line on several levels"}
	if {[dict exists $colourOf $lev] && [dict get $colourOf $lev] ne $col} {
	    return "several colours for level $lev"
	}
	dict set colourOf $lev $col
	lappend found $lev
    }
    if {[llength [lsort -unique [dict values $colourOf]]] != [dict size $colourOf]} {
	return "same colour for different levels"
    }
    lsort -unique -real $found
}

test Plotchart-211.1 {contourlines: lines on the given levels} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    set new [newItems {
	$p contourlines $gridX $gridY $gridF {5 10 15}
    }]
    list [lsort -unique [lmap i $new {.c type $i}]] [checkLevels $p $new {5 10 15}]
} -cleanup {
    cleanupPlot
} -result {line {5 10 15}}

test Plotchart-211.1a {contourlines: classes with their colours} -constraints {
    knownBug
} -setup {
    mkCanvas 400 400
} -body {
    # The colours of the classes are ignored, the colour map is used
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    set new [newItems {
	$p contourlines $gridX $gridY $gridF {{5 red} {10 green} {15 blue}}
    }]
    set ok 1
    foreach i $new {
	set col [.c itemcget $i -fill]
	if {![dict exists {red 5 green 10 blue 15} $col]} {set ok 0; break}
	set level [dict get {red 5 green 10 blue 15} $col]
	foreach {px py} [.c coords $i] {
	    lassign [::Plotchart::pixelToCoords [$p canvas] $px $py] x y
	    if {abs($x + $y - $level) > 0.1} {set ok 0}
	}
    }
    list [lsort -unique [lmap i $new {.c itemcget $i -fill}]] $ok
} -cleanup {
    cleanupPlot
} -result {{blue green red} 1}


test Plotchart-211.3 {contourlines: missing values skip the cell} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    set f {{0 5 10} {5 {} 15} {10 15 20}}
    set new [newItems {
	$p contourlines $gridX $gridY $f {5 10 15}
    }]
    llength $new
} -cleanup {
    cleanupPlot
} -result 0

test Plotchart-211.4 {contourlinesfunctionvalues: same as contourlines} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    set c1 [newItems {
	$p contourlines $gridX $gridY $gridF {5 10 15}
    }]
    set c1 [lmap i $c1 {list [.c itemcget $i -fill] [R [.c coords $i] 1]}]
    .c delete {*}[lmap i [.c find all] {expr {[.c gettags $i] eq "" ? $i : ""}}]
    set c2 [newItems {
	$p contourlinesfunctionvalues {0 5 10} {0 5 10} $gridF {5 10 15}
    }]
    set c2 [lmap i $c2 {list [.c itemcget $i -fill] [R [.c coords $i] 1]}]
    list [expr {[llength $c1] > 0}] [expr {$c1 eq $c2}]
} -cleanup {
    cleanupPlot
} -result {1 1}

test Plotchart-211.5 {contourlinesfunctionvalues: different number of x and y values} -constraints {
    knownBug
} -setup {
    mkCanvas 400 400
} -body {
    # The number of rows is taken from xvec
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    set new [newItems {
	$p contourlinesfunctionvalues {0 10} {0 5 10} {{0 10} {5 15} {10 20}} {5 10 15}
    }]
    list [expr {[llength $new] > 0}] [checkLevels $p $new {5 10 15}]
} -cleanup {
    cleanupPlot
} -result {1 {5 10 15}}

