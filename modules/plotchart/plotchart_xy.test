test Plotchart-211.8 {contourfill: filled polygons in the colours of the map} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    set new [newItems {
	$p contourfill $gridX $gridY $gridF {0 5 10 15 20}
    }]
    set polys [lmap i $new {expr {[.c type $i] eq "polygon" ? $i : [continue]}}]
    list [expr {[llength $polys] > 0}] [lsort -unique [lmap i $new {.c type $i}]] \
	[expr {[llength [lsort -unique [lmap i $polys {.c itemcget $i -fill}]]] >= 4}]
} -cleanup {
    cleanupPlot
} -result {1 {line polygon} 1}

