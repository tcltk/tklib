test Plotchart-210.10 {dot: logarithmic and polar plots} -setup {
    mkCanvas 400 400
} -body {
    set r {}
    foreach cmd {
	{::Plotchart::createXLogYPlot .c {0 10 2} {1 1000}}
	{::Plotchart::createLogXYPlot .c {1 1000} {0 10 2}}
	{::Plotchart::createLogXLogYPlot .c {1 1000} {1 1000}}
	{::Plotchart::createPolarplot .c {10 2}}
    } {
	set p [{*}$cmd]
	$p dot d 5 5 3
	set i [items data_d]
	lassign [.c coords $i] x1 y1 x2 y2
	lappend r [samePixels [list [expr {($x1+$x2)/2}] [expr {($y1+$y2)/2}]] [pix $p 5 5] 0.01]
	cleanupPlot
	mkCanvas 400 400
    }
    set r
} -cleanup {
    cleanupPlot
} -result {1 1 1 1}

