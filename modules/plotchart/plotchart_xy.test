test Plotchart-211.9 {contourbox: one quadrangle per cell, colour of the average} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    set new [newItems {
	$p contourbox $gridX $gridY $gridF {{0 red} {8 green} {12 blue}}
    }]
    # Averages of the cells: 5, 10, 10, 15
    set cells {}
    foreach i $new {
	set xs {}
	set ys {}
	foreach {px py} [.c coords $i] {
	    lassign [::Plotchart::pixelToCoords [$p canvas] $px $py] x y
	    lappend xs $x
	    lappend ys $y
	}
	lappend cells [list [R [expr {([tcl::mathfunc::min {*}$xs] + [tcl::mathfunc::max {*}$xs])/2.0}] 1] \
			    [R [expr {([tcl::mathfunc::min {*}$ys] + [tcl::mathfunc::max {*}$ys])/2.0}] 1] \
			    [.c itemcget $i -fill]]
    }
    lsort -index 1 -real [lsort -index 0 -real $cells]
} -cleanup {
    cleanupPlot
} -result {{2.5 2.5 red} {7.5 2.5 green} {2.5 7.5 green} {7.5 7.5 blue}}

