    set new [newItems {
	$p grid $gridX $gridY
    }]
    list [llength $new] [lsort -unique [lmap i $new {.c type $i}]] \
	[samePixels [.c coords [lindex $new 0]] [pixList $p {0 0 5 0 10 0}]] \
	[samePixels [.c coords [lindex $new 3]] [pixList $p {0 0 0 5 0 10}]]
} -cleanup {
    cleanupPlot
} -result {6 line 1 1}

