test Plotchart-211.12 {colorMap: list of colours via the namespace command} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    ::Plotchart::colorMap {red green blue yellow}
    set new [newItems {
	$p contourlines $gridX $gridY $gridF {5 10 15}
    }]
    list [checkLevels $p $new {5 10 15}] \
	[expr {[llength [lmap i $new {expr {[.c itemcget $i -fill] in {red green blue yellow} ? $i : [continue]}}]] == [llength $new]}]
} -cleanup {
    cleanupPlot
    ::Plotchart::colorMap jet
} -result {{5 10 15} 1}

test Plotchart-211.12a {colorMap: colours are interpolated} -constraints {
    knownBug
} -setup {
    mkCanvas 400 400
} -body {
    # The colours are used as they are, so that two colours are not
    # enough for three contour levels
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    ::Plotchart::colorMap {red blue}
    set new [newItems {
	$p contourlines $gridX $gridY $gridF {5 10 15}
    }]
    checkLevels $p $new {5 10 15}
} -cleanup {
    cleanupPlot
    ::Plotchart::colorMap jet
} -result {5 10 15}

test Plotchart-211.13 {colorMap: predefined maps} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    set r {}
    set levels {2 4 6 8 10 12 14 16 18}
    foreach map {grey gray jet hot cool} {
	::Plotchart::colorMap $map
	set new [newItems {
	    $p contourlines $gridX $gridY $gridF $levels
	}]
	lappend r [expr {[checkLevels $p $new $levels] eq $levels}]
	.c delete {*}$new
    }
    set r
} -cleanup {
    cleanupPlot
    ::Plotchart::colorMap jet
} -result {1 1 1 1 1}

