# -------------------------------------------------------------------------
# xband, yband and labeldot

test Plotchart-212.1 {xband: grey band over the full x-axis} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p xband 3 6
    set b [items band]
    list [.c type $b] [.c itemcget $b -fill] \
	[samePixels [lsort -real [.c coords $b]] [lsort -real [pixList $p {0 3 10 6}]]]
} -cleanup {
    cleanupPlot
} -result {rectangle grey70 1}

test Plotchart-212.2 {yband: grey band over the full y-axis} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p yband 2 4
    set b [items band]
    list [.c type $b] [.c itemcget $b -fill] \
	[samePixels [lsort -real [.c coords $b]] [lsort -real [pixList $p {2 0 4 10}]]]
} -cleanup {
    cleanupPlot
} -result {rectangle grey70 1}

test Plotchart-212.3 {xband/yband: below the data} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p plot s 0 0
    $p plot s 10 10
    $p xband 3 6
    $p yband 2 4
    set all [.c find all]
    set d [lsearch $all [items data_s]]
    list [expr {[lsearch $all [lindex [items band] 0]] < $d}] [expr {[lsearch $all [lindex [items band] 1]] < $d}]
} -cleanup {
    cleanupPlot
} -result {1 1}

test Plotchart-212.4 {labeldot: grey label and a symbol} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p labeldot 5 5 "Label"
    set t [items {data type=text}]
    set s [items data_labeldot]
    lassign [.c bbox $s] x1 y1 x2 y2
    list [.c itemcget $t -text] [.c itemcget $t -fill] [.c itemcget $t -anchor] \
	[expr {[lindex [.c coords $t] 0] < [lindex [pix $p 5 5] 0]}] \
	[.c type $s] [.c itemcget $s -fill] \
	[samePixels [list [expr {($x1+$x2)/2.0}] [expr {($y1+$y2)/2.0}]] [pix $p 5 5] 1]
} -cleanup {
    cleanupPlot
} -result {Label grey e 1 oval red 1}

test Plotchart-212.5 {labeldot: orientations} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    lassign [pix $p 5 5] px py
    set r {}
    foreach orient {w e n s W} {
	.c delete data
	$p labeldot 5 5 "Label" $orient
	set t [items {data type=text}]
	lassign [.c coords $t] x y
	set h [expr {$x < $px - 1 ? "w" : ($x > $px + 1 ? "e" : "")}]
	set v [expr {$y < $py - 1 ? "n" : ($y > $py + 1 ? "s" : "")}]
	lappend r $orient [.c itemcget $t -anchor] $v$h
    }
    set r
} -cleanup {
    cleanupPlot
} -result {w e w e w e n s n s n s W e w}

test Plotchart-212.6 {labeldot: appearance via dataconfig labeldot} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p dataconfig labeldot -colour blue -symbol up
    $p labeldot 5 5 "Label"
    set s [items data_labeldot]
    list [.c type $s] [.c itemcget $s -outline]
} -cleanup {
    cleanupPlot
} -result {polygon blue}

test Plotchart-212.7 {labeldot: logarithmic and polar plots} -setup {
    mkCanvas 400 400
} -body {
    set r {}
    foreach cmd {
	{::Plotchart::createXLogYPlot .c {0 10 2} {1 1000}}
	{::Plotchart::createLogXYPlot .c {1 1000} {0 10 2}}
	{::Plotchart::createLogXLogYPlot .c {1 1000} {1 1000}}
	{::Plotchart::createPolarplot .c {10 2}}
    } {
	set p [{*}$cmd]
	$p labeldot 5 5 "Label"
	lappend r [itemTexts data] [llength [items data_labeldot]]
	cleanupPlot
	mkCanvas 400 400
    }
    set r
} -cleanup {
    cleanupPlot
} -result {Label 1 Label 1 Label 1 Label 1}

test Plotchart-212.8 {xband: wrong # args} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p xband 3
} -cleanup {
    cleanupPlot
} -returnCodes error -result {wrong # args: should be "DrawXband w ymin ymax"}

# -------------------------------------------------------------------------
# createStripchart

test Plotchart-213.1 {createStripchart: like an XY plot} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createStripchart .c {0 100 20} {0 50 10}]
    $p plot s 10 10
    $p plot s 50 40
    list [string match stripchart_* $p] [itemTexts xaxis] [llength [items data_s]] \
	[samePixels [.c coords [items data_s]] [pixList $p {10 10 50 40}]]
} -cleanup {
    cleanupPlot
} -result {1 {0 20 40 60 80 100} 1 1}

test Plotchart-213.2 {createStripchart: x-axis shifts when the maximum is exceeded} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createStripchart .c {0 100 20} {0 50 10}]
    $p plot s 10 10
    $p plot s 90 20
    $p plot s 130 30
    set lines [items data_s]
    list [itemTexts xaxis] [llength $lines] \
	[samePixels [.c coords [lindex $lines end]] [pixList $p {90 20 130 30}] 1.5] \
	[samePixels [.c coords [lindex $lines 0]] [pixList $p {10 10 90 20}] 1.5]
} -cleanup {
    cleanupPlot
} -result {{40 60 80 100 120 140} 2 1 1}

test Plotchart-213.3 {createStripchart: -xlabels is invalid} -setup {
    mkCanvas
} -body {
    ::Plotchart::createStripchart .c {0 100 {}} {0 50 10} -xlabels {A B}
} -cleanup {
    cleanupPlot
} -returnCodes error -result {The option "-xlabels" is invalid - use "-timeformat" if you want date/time labels}

test Plotchart-213.4 {createStripchart: -timeformat labels follow the shift} -setup {
    mkCanvas 500 300
} -body {
    set start [clock scan "2020-01-01 00:00" -gmt 1]
    set stop  [clock scan "2020-01-01 10:00" -gmt 1]
    set s [::Plotchart::createStripchart .c [list $start $stop 7200] {0 10 1} \
	-timeformat "%H:%M" -gmt 1]
    set r [list [itemTexts xaxis]]
    foreach {x y} {0 0 2 5 5 2 9 9 12 10} {
	$s plot a [expr {$start + 3600 * $x}] $y
    }
    lappend r [itemTexts xaxis]
} -cleanup {
    cleanupPlot
} -result {{00:00 02:00 04:00 06:00 08:00 10:00} {02:00 04:00 06:00 08:00 10:00 12:00}}

test Plotchart-213.5 {createStripchart: dataconfig and yconfig} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createStripchart .c {0 100 20} {0 50 10}]
    $p dataconfig s -colour red
    $p plot s 10 10
    $p plot s 50 40
    $p yconfig -format %.1f
    list [itemOption data_s -fill] [lindex [itemTexts yaxis] end]
} -cleanup {
    cleanupPlot
} -result {red 50.0}

# -------------------------------------------------------------------------
# createTXPlot

test Plotchart-214.1 {createTXPlot: time axis with dates} -setup {
    mkCanvas 500 300
} -body {
    set p [::Plotchart::createTXPlot .c {2006-01-01 2006-01-11 2} {0 10 2}]
    list [string match txplot_* $p] [itemTexts taxis] [itemTexts yaxis]
} -cleanup {
    cleanupPlot
} -result {1 {2006-01-01 2006-01-03 2006-01-05 2006-01-07 2006-01-09 2006-01-11} {0 2 4 6 8 10}}

test Plotchart-214.2 {createTXPlot: plot takes date/time strings} -setup {
    mkCanvas 500 300
} -body {
    set p [::Plotchart::createTXPlot .c {2006-01-01 2006-01-11 2} {0 10 2}]
    $p plot s 2006-01-02 3
    $p plot s "2006-01-05 12:00" 7
    samePixels [.c coords [items data_s]] \
	[pixList $p [list [clock scan 2006-01-02] 3 [clock scan "2006-01-05 12:00"] 7]]
} -cleanup {
    cleanupPlot
} -result 1

test Plotchart-214.3 {createTXPlot: format of the time labels via xconfig} -setup {
    mkCanvas 500 300
} -body {
    set p [::Plotchart::createTXPlot .c {2006-01-01 2006-01-11 5} {0 10 2}]
    $p xconfig -format "%d/%m"
    itemTexts taxis
} -cleanup {
    cleanupPlot
} -result {01/01 06/01 11/01}

test Plotchart-214.4 {createTXPlot: invalid date} -setup {
    mkCanvas 500 300
} -body {
    set p [::Plotchart::createTXPlot .c {2006-01-01 2006-01-11 2} {0 10 2}]
    $p plot s "no such date" 3
} -cleanup {
    cleanupPlot
} -returnCodes error -match glob -result {unable to convert date-time string "no such date"*}

test Plotchart-214.5 {createTXPlot: step size zero} -setup {
    mkCanvas 500 300
} -body {
    ::Plotchart::createTXPlot .c {2006-01-01 2006-01-11 2} {0 10 0}
} -cleanup {
    cleanupPlot
} -returnCodes error -result {Step size can not be zero}

# -------------------------------------------------------------------------
# Logarithmic plots

test Plotchart-215.1 {createXLogYPlot: logarithmic y-axis} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXLogYPlot .c {0 10 2} {1 1000}]
    set w [$p canvas]
    lassign [pix $p 0 1] x y1
    lassign [pix $p 0 10] x y10
    lassign [pix $p 0 100] x y100
    list [string match xlogyplot_* $p] [itemTexts yaxis] [itemTexts xaxis] \
	[approx [expr {$y1-$y10}] [expr {$y10-$y100}] 0.01]
} -cleanup {
    cleanupPlot
} -result {1 {1 10 100 1000} {0 2 4 6 8 10} 1}

test Plotchart-215.2 {createXLogYPlot: data given as linear values} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXLogYPlot .c {0 10 2} {1 1000}]
    $p plot s 2 10
    $p plot s 8 100
    samePixels [.c coords [items data_s]] [pixList $p {2 10 8 100}]
} -cleanup {
    cleanupPlot
} -result 1

test Plotchart-215.3 {createXLogYPlot: y extremes must be positive} -setup {
    mkCanvas
} -body {
    ::Plotchart::createXLogYPlot .c {0 10 2} {0 1000}
} -cleanup {
