# -*- tcl -*-
# plotchart_xy.test --
#
#	Tests for the Plotchart package: XY plots and their relatives
#	(stripcharts, time-x plots, logarithmic plots, isometric plots,
#	histograms, right axes and normal plots) and the methods to draw
#	data in them (plot, plotlist, region, minmax, plotcumulative,
#	trend, rchart, interval, box-and-whiskers, violin, vector, dot,
#	contours, grid, bands, labeldot and dataconfig).
#
# The output of Plotchart is drawn on a canvas, so the tests check the
# canvas items (types, tags, coordinates relative to each other, colours
# and texts), not pixels.
#
# The tests in this file are numbered Plotchart-201.M to Plotchart-299.M
# (plotchart.test uses the numbers below 100).

if {![package vsatisfies [package provide Tcl] 8.5-]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring Tcl 8.5, have [package present Tcl]"
    return
}

if {[catch { package require Tk 8.5- } msg]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring Tk 8.5, $msg"
    return
}

if {[lsearch [namespace children] ::tcltest] == -1} {
    package require tcltest 2.2
    namespace import ::tcltest::*
}

::tcltest::testConstraint tk 1

source [file join [file dirname [file normalize [info script]]] plotchart.tcl]

# -------------------------------------------------------------------------
# Helpers
#
# Plotchart keeps its state in namespace arrays keyed by the name of the
# canvas (or of its per-plot alias, "00.c", "01.c", ...).  The canvases
# are normally not mapped, so that the size of the plot is determined by
# the -width and -height options only.

# Collect background errors instead of showing a dialog
set ::bgErrors {}
proc ::testBgError {msg opts} {
    lappend ::bgErrors $msg
}
set ::oldBgError [interp bgerror {}]
interp bgerror {} ::testBgError

set ::oldRootState [wm state .]

proc mkCanvas {{width 400} {height 300} {c .c}} {
    canvas $c -width $width -height $height -background white \
	-highlightthickness 0 -borderwidth 0
    return $c
}

proc cleanupPlot {{c .c}} {
    if {[winfo exists $c]} {
	::Plotchart::clearcanvas $c
	destroy $c
    }
    set pat [string map {. \\.} $c]
    foreach a [interp aliases {}] {
	if {[regexp "^(.+_)?r?\[0-9\]\[0-9\]$pat\$" $a] ||
	    [regexp "^\[a-z0-9\]+_$pat\$" $a]} {
	    interp alias {} $a {}
	}
    }
    foreach v {scaling config data_series legend settings packing} {
	if {[info exists ::Plotchart::$v]} {
	    array unset ::Plotchart::$v *$c,*
	}
    }
}

# Return the item ids having all given tags, in display order.
# An element "type=T" selects only items of type T, "notype=T" excludes
# items of type T.
proc items {tags {c .c}} {
    set t {}
    set type {}
    set notype {}
    foreach x $tags {
	if {[string match type=* $x]} {
	    set type [string range $x 5 end]
	} elseif {[string match notype=* $x]} {
	    set notype [string range $x 7 end]
	} else {
	    lappend t $x
	}
    }
    set ids {}
    foreach i [$c find withtag [join $t " && "]] {
	if {($type eq "" || [$c type $i] eq $type) &&
	    ($notype eq "" || [$c type $i] ne $notype)} {
	    lappend ids $i
	}
    }
    return $ids
}

# Return the types of the items having all given tags, sorted and unique
proc itemTypes {tags {c .c}} {
    set types {}
    foreach i [items $tags $c] {
	lappend types [$c type $i]
    }
    lsort -unique $types
}

# Return the texts of the text items having all given tags
proc itemTexts {tags {c .c}} {
    set texts {}
    foreach i [items $tags $c] {
	if {[$c type $i] eq "text"} {
	    lappend texts [$c itemcget $i -text]
	}
    }
    return $texts
}

# Return the given option for all items having the given tags (unique)
proc itemOption {tags option {c .c}} {
    set values {}
    foreach i [items $tags $c] {
	lappend values [$c itemcget $i $option]
    }
    lsort -unique $values
}

# Round the numbers in a list to the given number of decimals
proc R {value {digits 1}} {
    set r {}
    foreach v $value {
	if {[string is double -strict $v]} {
	    set v [format %.${digits}f $v]
	    if {$v == 0} {set v [format %.${digits}f 0]}
	}
	lappend r $v
    }
    return $r
}

# Centre of the bounding box of the items with the given tags
proc centre {tags {c .c}} {
    lassign [$c bbox [join $tags " && "]] x1 y1 x2 y2
    list [expr {($x1+$x2)/2.0}] [expr {($y1+$y2)/2.0}]
}

# Pixel coordinates of a world point in the given plot
proc pix {p x y} {
    ::Plotchart::coordsToPixel [$p canvas] $x $y
}

proc approx {a b {eps 1.0}} {
    expr {abs($a-$b) <= $eps}
}

proc restoreRoot {} {
    if {$::oldRootState eq "withdrawn"} {
	wm withdraw .
    }
}

::tcltest::testConstraint normalplot \
    [llength [info commands ::Plotchart::createNormalPlot]]

# Pixel coordinates of a list of world points
proc pixList {p coords} {
    set r {}
    foreach {x y} $coords {
	lappend r {*}[pix $p $x $y]
    }
    return $r
}

# Compare two lists of pixel coordinates with a tolerance
proc samePixels {a b {eps 0.51}} {
    if {[llength $a] != [llength $b]} {
	return 0
    }
    foreach u $a v $b {
	if {abs($u-$v) > $eps} {
	    return 0
	}
    }
    return 1
}

# -------------------------------------------------------------------------
# createXYPlot

test Plotchart-201.1 {createXYPlot: axes with ticks and labels} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 100 20} {0 50 10}]
    list [string match xyplot_* $p] [itemTexts xaxis] [itemTexts yaxis] \
	[itemTypes xaxis] [itemTypes yaxis] [llength [items mask]]
} -cleanup {
    cleanupPlot
} -result {1 {0 20 40 60 80 100} {0 10 20 30 40 50} {line text} {line text} 4}

test Plotchart-201.2 {createXYPlot: plot area fills the canvas minus the margins} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 100 20} {0 50 10}]
    lassign [pix $p 0 0] x0 y0
    lassign [pix $p 100 50] x1 y1
    list [expr {$x0 > 0 && $x0 < 200}] [expr {$x1 > 200 && $x1 < 400}] \
	[expr {$y1 > 0 && $y1 < 150}] [expr {$y0 > 150 && $y0 < 300}] \
	[samePixels [lrange [.c coords [lindex [items xaxis] 0]] 0 3] [list $x0 $y0 $x1 $y0]]
} -cleanup {
    cleanupPlot
} -result {1 1 1 1 1}

test Plotchart-201.3 {createXYPlot: inverted axes} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {100 0 -20} {50 0 -10}]
    lassign [pix $p 100 50] x0 y0
    lassign [pix $p 0 0] x1 y1
    # The maximum appears at the left and at the bottom
    list [expr {$x0 < $x1}] [expr {$y0 > $y1}] [lsort -integer [itemTexts xaxis]] \
	[lsort -integer [itemTexts yaxis]]
} -cleanup {
    cleanupPlot
} -result {1 1 {0 20 40 60 80 100} {0 10 20 30 40 50}}

test Plotchart-201.4 {createXYPlot: inverted axis with a positive step} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {100 0 20} {0 50 10}]
    lassign [pix $p 100 0] x0
    lassign [pix $p 0 0] x1
    list [expr {$x0 < $x1}] [lsort -integer [itemTexts xaxis]]
} -cleanup {
    cleanupPlot
} -result {1 {0 20 40 60 80 100}}

test Plotchart-201.5 {createXYPlot: step size zero} -setup {
    mkCanvas
} -body {
    ::Plotchart::createXYPlot .c {0 100 0} {0 50 10}
} -cleanup {
    cleanupPlot
} -returnCodes error -result {Step size can not be zero}

test Plotchart-201.6 {createXYPlot: equal extremes} -setup {
    mkCanvas
} -body {
    ::Plotchart::createXYPlot .c {0 0 10} {0 50 10}
} -cleanup {
    cleanupPlot
} -returnCodes error -result {Minimum and maximum must differ for world coordinates}

test Plotchart-201.7 {createXYPlot: wrong # args} -body {
    ::Plotchart::createXYPlot .c {0 100 10}
} -returnCodes error -result {wrong # args: should be "::Plotchart::createXYPlot w xscale yscale ?arg ...?"}

test Plotchart-201.8 {createXYPlot: -xlabels with numeric labels} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 100 {}} {0 50 10} -xlabels {0 10 50 100}]
    set xs {}
    foreach t [items {xaxis type=text}] {
	lappend xs [R [lindex [::Plotchart::pixelToCoords [$p canvas] {*}[.c coords $t]] 0] 0]
    }
    list [itemTexts xaxis] $xs
} -cleanup {
    cleanupPlot
} -result {{0 10 50 100} {0 10 50 100}}

test Plotchart-201.9 {createXYPlot: -xlabels with text labels at equal distances} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 90 {}} {0 50 10} -xlabels {Jan Feb Mar Apr}]
    set xs {}
    foreach t [items {xaxis type=text}] {
	lappend xs [R [lindex [::Plotchart::pixelToCoords [$p canvas] {*}[.c coords $t]] 0] 0]
    }
    list [itemTexts xaxis] $xs
} -cleanup {
    cleanupPlot
} -result {{Jan Feb Mar Apr} {0 30 60 90}}

test Plotchart-201.10 {createXYPlot: -ylabels} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 100 20} {0 2 {}} -ylabels {Low Medium High}]
    set ys {}
    foreach t [items {yaxis type=text}] {
	lappend ys [R [lindex [::Plotchart::pixelToCoords [$p canvas] {*}[.c coords $t]] 1] 0]
    }
    list [itemTexts yaxis] $ys [itemTexts xaxis]
} -cleanup {
    cleanupPlot
} -result {{Low Medium High} {0 1 2} {0 20 40 60 80 100}}

test Plotchart-201.11 {createXYPlot: unknown option with custom labels} -setup {
    mkCanvas
} -body {
    ::Plotchart::createXYPlot .c {0 100 {}} {0 50 10} -xlabels {A B} -colour red
} -cleanup {
    cleanupPlot
} -returnCodes error -result {Argument -colour not recognized}

test Plotchart-201.12 {createXYPlot: -timeformat for the x labels} -setup {
    mkCanvas
} -body {
    set start [clock scan "2020-01-01 00:00" -gmt 1]
    set stop  [clock scan "2020-01-01 10:00" -gmt 1]
    set p [::Plotchart::createXYPlot .c [list $start $stop 7200] {0 10 2} \
	-timeformat "%H:%M" -gmt 1]
    itemTexts xaxis
} -cleanup {
    cleanupPlot
} -result {00:00 02:00 04:00 06:00 08:00 10:00}

test Plotchart-201.13 {createXYPlot: -timeformat and -locale} -setup {
    mkCanvas
} -body {
    set start [clock scan "2020-01-01" -gmt 1]
    set stop  [clock scan "2020-03-01" -gmt 1]
    set p [::Plotchart::createXYPlot .c [list $start $stop [expr {31*86400}]] {0 10 2} \
	-timeformat "%b" -gmt 1 -locale C]
    itemTexts xaxis
} -cleanup {
    cleanupPlot
} -result {Jan Feb}

test Plotchart-201.14 {createXYPlot: -axestozero draws the axes through the origin} -constraints {
    knownBug
} -setup {
    mkCanvas
} -body {
    # The implemented option is called -axesatzero
    set p [::Plotchart::createXYPlot .c {-10 10 5} {-10 10 5} -axestozero 1]
    lassign [pix $p 0 0] x0 y0
    set xaxle [lindex [items xaxis] 0]
    set yaxle [lindex [items yaxis] 0]
    list [approx [lindex [.c coords $xaxle] 1] $y0 0.5] [approx [lindex [.c coords $yaxle] 0] $x0 0.5]
} -cleanup {
    cleanupPlot
} -result {1 1}

test Plotchart-201.15 {createXYPlot: -axesatzero draws the axes through the origin} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {-10 10 5} {-10 10 5} -axesatzero 1]
    lassign [pix $p 0 0] x0 y0
    set xaxle [lindex [items xaxis] 0]
    set yaxle [lindex [items yaxis] 0]
    list [approx [lindex [.c coords $xaxle] 1] $y0 0.5] [approx [lindex [.c coords $yaxle] 0] $x0 0.5]
} -cleanup {
    cleanupPlot
} -result {1 1}

test Plotchart-201.16 {createXYPlot: -axesatzero 0 keeps the axes at the sides} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {-10 10 5} {-10 10 5} -axesatzero 0]
    lassign [pix $p -10 -10] x0 y0
    set xaxle [lindex [items xaxis] 0]
    approx [lindex [.c coords $xaxle] 1] $y0 0.5
} -cleanup {
    cleanupPlot
} -result 1

test Plotchart-201.17 {createXYPlot: -isometric 1} -setup {
    mkCanvas 400 300
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2} -isometric 1]
    lassign [pix $p 0 0] x0 y0
    lassign [pix $p 1 1] x1 y1
    approx [expr {$x1-$x0}] [expr {$y0-$y1}] 0.01
} -cleanup {
    cleanupPlot
} -result 1

test Plotchart-201.18 {createXYPlot: -isometric 0 (default) uses the extremes} -setup {
    mkCanvas 400 300
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2} -isometric 0]
    lassign [pix $p 0 0] x0 y0
    lassign [pix $p 1 1] x1 y1
    approx [expr {$x1-$x0}] [expr {$y0-$y1}] 0.01
} -cleanup {
    cleanupPlot
} -result 0

# -------------------------------------------------------------------------
# plot method and dataconfig

test Plotchart-202.1 {plot: line segments between consecutive points} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 100 20} {0 100 20}]
    foreach {x y} {0 32 10 50 25 60 78 11} {
	$p plot series1 $x $y
    }
    set lines [items data_series1]
    set coords {}
    foreach l $lines {lappend coords {*}[.c coords $l]}
    list [llength $lines] [itemTypes data_series1] [itemOption data_series1 -fill] \
	[samePixels $coords [pixList $p {0 32 10 50 10 50 25 60 25 60 78 11}]] \
	[expr {[llength [items data]] == 3}]
} -cleanup {
    cleanupPlot
} -result {3 line black 1 1}

test Plotchart-202.2 {plot: data below the axes and the mask} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 100 20} {0 100 20}]
    $p plot s 0 0
    $p plot s 50 150
    set all [.c find all]
    list [expr {[lsearch $all [items data]] < [lsearch $all [lindex [items mask] 0]]}] \
	[expr {[lsearch $all [items data]] < [lsearch $all [lindex [items xaxis] 0]]}]
} -cleanup {
    cleanupPlot
} -result {1 1}

test Plotchart-202.3 {plot: several series are independent} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 100 20} {0 100 20}]
    $p dataconfig a -colour red
    $p dataconfig b -colour blue
    $p plot a 0 0
    $p plot b 0 100
    $p plot a 100 100
    $p plot b 100 0
    list [llength [items data_a]] [llength [items data_b]] [itemOption data_a -fill] \
	[itemOption data_b -fill] [samePixels [.c coords [items data_b]] [pixList $p {0 100 100 0}]]
} -cleanup {
    cleanupPlot
} -result {1 1 red blue 1}

test Plotchart-202.4 {dataconfig -type symbol: symbols only} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 100 20} {0 100 20}]
    $p dataconfig s -type symbol
    $p plot s 10 10
    $p plot s 20 20
    list [itemTypes data_s] [llength [items data_s]] [itemOption data_s -fill]
} -cleanup {
    cleanupPlot
} -result {oval 2 black}

test Plotchart-202.5 {dataconfig -type both: lines and symbols} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 100 20} {0 100 20}]
    $p dataconfig s -type both -colour green
    $p plot s 10 10
    $p plot s 20 20
    list [itemTypes data_s] [llength [items data_s]] [itemOption {data_s type=line} -fill]
} -cleanup {
    cleanupPlot
} -result {{line oval} 3 green}

test Plotchart-202.6 {dataconfig -symbol: all symbol types} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 100 20} {0 100 20}]
    set r {}
    foreach sym {plus cross circle up down dot upfilled downfilled} {
	$p dataconfig $sym -type symbol -symbol $sym -colour red
	$p plot $sym 50 50
	set i [items data_$sym]
	set fill [.c itemcget $i -fill]
	set outline [expr {[.c type $i] eq "line" ? "-" : [.c itemcget $i -outline]}]
	lappend r [list $sym [.c type $i] $fill $outline]
    }
    join $r \n
} -cleanup {
    cleanupPlot
} -result {plus line red -
cross line red -
circle oval {} red
up polygon {} red
down polygon {} red
dot oval red red
upfilled polygon red red
downfilled polygon red red}

test Plotchart-202.7 {dataconfig -symbol: shapes and orientation} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 100 20} {0 100 20}]
    lassign [pix $p 50 50] px py
    set r {}
    foreach sym {up down} {
	$p dataconfig $sym -type symbol -symbol $sym
	$p plot $sym 50 50
	set c [.c coords [items data_$sym]]
	# y-coordinate of the apex (third vertex) relative to the centre
	lappend r [expr {[lindex $c 5] < $py ? "above" : "below"}]
    }
    set r
} -cleanup {
    cleanupPlot
} -result {above below}

test Plotchart-202.8 {dataconfig -radius: size of the symbols (default 4)} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 100 20} {0 100 20}]
    $p dataconfig a -type symbol -symbol circle
    $p dataconfig b -type symbol -symbol circle -radius 10
    $p plot a 20 20
    $p plot b 60 60
    lassign [.c coords [items data_a]] x1 y1 x2 y2
    lassign [.c coords [items data_b]] u1 v1 u2 v2
    list [R [expr {$x2-$x1}] 0] [R [expr {$u2-$u1}] 0] \
	[samePixels [list [expr {($u1+$u2)/2}] [expr {($v1+$v2)/2}]] [pix $p 60 60]]
} -cleanup {
    cleanupPlot
} -result {8 20 1}

test Plotchart-202.9 {dataconfig -width: width of the line} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 100 20} {0 100 20}]
    $p dataconfig s -width 3
    $p plot s 10 10
    $p plot s 20 20
    itemOption data_s -width
} -cleanup {
    cleanupPlot
} -result {3.0}

test Plotchart-202.10 {dataconfig -filled up/down with -fillcolour} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 100 20} {0 100 20}]
    $p dataconfig u -filled up -fillcolour yellow
    $p dataconfig d -filled down -fillcolor green
    $p plot u 10 40
    $p plot u 20 60
    $p plot d 10 40
    $p plot d 20 60
    lassign [pix $p 0 100] xtop ytop
    lassign [pix $p 0 0] xbot ybot
    set pu [items {data_u type=polygon}]
    set pd [items {data_d type=polygon}]
    set yu [lmap {x y} [.c coords $pu] {set y}]
    set yd [lmap {x y} [.c coords $pd] {set y}]
    list [.c itemcget $pu -fill] [.c itemcget $pd -fill] \
	[approx [tcl::mathfunc::min {*}$yu] $ytop 0.5] [approx [tcl::mathfunc::max {*}$yd] $ybot 0.5] \
	[llength [items {data_u type=line}]]
} -cleanup {
    cleanupPlot
} -result {yellow green 1 1 1}

test Plotchart-202.11 {dataconfig: -color is a synonym of -colour} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 100 20} {0 100 20}]
    $p dataconfig s -color magenta
    $p plot s 10 10
    $p plot s 20 20
    itemOption data_s -fill
} -cleanup {
    cleanupPlot
} -result {magenta}

test Plotchart-202.12 {dataconfig: unknown option} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 100 20} {0 100 20}]
    $p dataconfig s -size 3
} -cleanup {
    cleanupPlot
} -returnCodes error -result {Unknown or invalid option: -size (value: 3)}

test Plotchart-202.13 {dataconfig: invalid value for -type} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 100 20} {0 100 20}]
    $p dataconfig s -type dots
} -cleanup {
    cleanupPlot
} -returnCodes error -result {Unknown or invalid value: dots for option -type - line symbol both rectangle}

test Plotchart-202.14 {dataconfig: invalid value for -symbol} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 100 20} {0 100 20}]
    $p dataconfig s -symbol star
} -cleanup {
    cleanupPlot
} -returnCodes error -result {Unknown or invalid value: star for option -symbol - plus cross circle up down dot upfilled downfilled}

test Plotchart-202.15 {dataconfig: invalid value for -filled} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 100 20} {0 100 20}]
    $p dataconfig s -filled left
} -cleanup {
    cleanupPlot
} -returnCodes error -result {Unknown or invalid value: left for option -filled - no up down}

test Plotchart-202.16 {dataconfig: wrong # args} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 100 20} {0 100 20}]
    $p dataconfig
} -cleanup {
    cleanupPlot
} -returnCodes error -result {wrong # args: should be "DataConfig w series ?arg ...?"}

test Plotchart-202.17 {plot: wrong # args} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 100 20} {0 100 20}]
    $p plot s 1
} -cleanup {
    cleanupPlot
} -returnCodes error -result {wrong # args: should be "DrawData w series xcrd ycrd"}

test Plotchart-202.18 {plot: missing x-coordinate also causes a gap} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 100 20} {0 100 20}]
    foreach {x y} {0 10 10 20 {} 30 40 40 50 50} {
	$p plot s $x $y
    }
    llength [items data_s]
} -cleanup {
    cleanupPlot
} -result 2

# -------------------------------------------------------------------------
# plotlist

test Plotchart-203.1 {plotlist: one line for the whole series} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 100 20} {0 100 20}]
    $p plotlist s {0 10 20 30} {5 15 10 20}
    set l [items data_s]
    list [llength $l] [.c type $l] [samePixels [.c coords $l] [pixList $p {0 5 10 15 20 10 30 20}]]
} -cleanup {
    cleanupPlot
} -result {1 line 1}

test Plotchart-203.2 {plotlist: symbols every Nth point} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 100 20} {0 100 20}]
    $p dataconfig s -type symbol -symbol circle
    set xs {}
    set ys {}
    for {set i 0} {$i < 20} {incr i} {lappend xs [expr {$i*5}]; lappend ys 50}
    $p plotlist s $xs $ys 5
    set n1 [llength [items data_s]]
    .c delete data
    $p dataconfig t -type symbol -symbol circle
    $p plotlist t $xs $ys
    list $n1 [llength [items data_t]]
} -cleanup {
    cleanupPlot
} -result {4 5}

test Plotchart-203.3 {plotlist: less than 10 points, a symbol for every point} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 100 20} {0 100 20}]
    $p dataconfig s -type both
    $p plotlist s {0 10 20 30 40} {1 2 3 4 5}
    list [llength [items {data_s type=line}]] [llength [items {data_s type=oval}]]
} -cleanup {
    cleanupPlot
} -result {1 5}

test Plotchart-203.4 {plotlist: missing values split the line} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 100 20} {0 100 20}]
    $p plotlist s {0 10 20 30 40 50} {5 15 {} 20 25 30}
    set l [items data_s]
    list [llength $l] [samePixels [.c coords [lindex $l 0]] [pixList $p {0 5 10 15}]] \
	[samePixels [.c coords [lindex $l 1]] [pixList $p {30 20 40 25 50 30}]]
} -cleanup {
    cleanupPlot
} -result {2 1 1}

test Plotchart-203.5 {plotlist: logarithmic plots} -setup {
    mkCanvas
} -body {
    set r {}
    foreach cmd {
	{::Plotchart::createXLogYPlot .c {0 100 20} {1 1000}}
	{::Plotchart::createLogXYPlot .c {1 1000} {0 100 20}}
	{::Plotchart::createLogXLogYPlot .c {1 1000} {1 1000}}
    } {
	set p [{*}$cmd]
	$p plotlist s {1 10 100} {1 10 100}
	lappend r [samePixels [.c coords [items data_s]] [pixList $p {1 1 10 10 100 100}]]
	cleanupPlot
	mkCanvas
    }
    set r
} -cleanup {
    cleanupPlot
} -result {1 1 1}

test Plotchart-203.6 {plotlist: wrong # args} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 100 20} {0 100 20}]
    $p plotlist s {1 2}
} -cleanup {
    cleanupPlot
} -returnCodes error -result {wrong # args: should be "DrawDataList w series xlist ylist ?every?"}

# -------------------------------------------------------------------------
# region and minmax

test Plotchart-204.1 {region: filled polygon with the series options} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 100 20} {0 100 20}]
    $p dataconfig r -fillcolour pink -colour red -width 2
    $p region r {10 50 90} {10 90 10}
    set i [items data_r]
    list [.c type $i] [.c itemcget $i -fill] [.c itemcget $i -outline] [.c itemcget $i -width] \
	[samePixels [.c coords $i] [pixList $p {10 10 50 90 90 10}]]
} -cleanup {
    cleanupPlot
} -result {polygon pink red 2.0 1}

test Plotchart-204.2 {region: empty -colour means no boundary} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 100 20} {0 100 20}]
    $p dataconfig r -fillcolour pink -colour {}
    $p region r {10 50 90} {10 90 10}
    itemOption data_r -outline
} -cleanup {
    cleanupPlot
} -result {{}}

test Plotchart-204.3 {minmax: strip between minimum and maximum} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 100 20} {0 100 20}]
    $p dataconfig m -fillcolour lightblue -colour blue
    $p minmax m 10 20 40
    $p minmax m 50 30 60
    $p minmax m 90 10 50
    set i [items data_m]
    list [llength $i] [.c type $i] [.c itemcget $i -fill] [.c itemcget $i -outline] \
	[samePixels [lrange [.c coords $i] 2 end-2] [pixList $p {10 20 50 30 90 10 90 50 50 60 10 40}]]
} -cleanup {
    cleanupPlot
} -result {1 polygon lightblue blue 1}

test Plotchart-204.4 {minmax: both empty starts a new strip} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 100 20} {0 100 20}]
    $p minmax m 10 20 40
    $p minmax m 20 30 50
    $p minmax m 30 {} {}
    $p minmax m 60 20 40
    $p minmax m 70 30 50
    llength [items data_m]
} -cleanup {
    cleanupPlot
} -result 2

test Plotchart-204.5 {minmax: one empty value adds a vertex on one side only} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 100 20} {0 100 20}]
    $p minmax m 10 20 40
    set n1 [llength [.c coords [items data_m]]]
    $p minmax m 20 30 {}
    set n2 [llength [.c coords [items data_m]]]
    $p minmax m 30 {} 50
    set n3 [llength [.c coords [items data_m]]]
    list [expr {$n2-$n1}] [expr {$n3-$n2}]
} -cleanup {
    cleanupPlot
} -result {2 2}

test Plotchart-204.6 {region and minmax: logarithmic and polar plots} -setup {
    mkCanvas 400 400
} -body {
    set r {}
    foreach cmd {
	{::Plotchart::createXLogYPlot .c {0 100 20} {1 1000}}
	{::Plotchart::createLogXYPlot .c {1 1000} {0 100 20}}
	{::Plotchart::createLogXLogYPlot .c {1 1000} {1 1000}}
	{::Plotchart::createPolarplot .c {10 2}}
    } {
	set p [{*}$cmd]
	$p region r {1 5 9} {1 5 1}
	$p minmax m 1 2 4
	$p minmax m 5 3 6
	lappend r [llength [items data_r]] [llength [items data_m]]
	cleanupPlot
	mkCanvas 400 400
    }
    set r
} -cleanup {
    cleanupPlot
} -result {1 1 1 1 1 1 1 1}

# -------------------------------------------------------------------------
# trend and rchart

test Plotchart-205.1 {trend: least-squares line over the full x-axis} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 20 5}]
    $p trend t 1 3
    $p trend t 2 5
    $p trend t 3 7
    set l [items data_t]
    list [llength $l] [samePixels [.c coords $l] [pixList $p {0 1 10 21}] 0.01]
} -cleanup {
    cleanupPlot
} -result {1 1}

test Plotchart-205.2 {trend: single point gives a horizontal line} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 20 5}]
    $p dataconfig t -colour red
    $p trend t 4 6
    set l [items data_t]
    list [samePixels [.c coords $l] [pixList $p {0 6 10 6}] 0.01] [.c itemcget $l -fill]
} -cleanup {
    cleanupPlot
} -result {1 red}

test Plotchart-205.4 {rchart: data with lines at +/- 3 stdev} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 20 5}]
    foreach {x y} {1 9 2 10 3 11} {
	$p rchart r $x $y
    }
    # mean 10, standard deviation 1: lines at 7 and 13
    set horiz {}
    set data 0
    foreach l [items data_r] {
	lassign [.c coords $l] x1 y1 x2 y2
	if {$y1 == $y2 && [llength [.c coords $l]] == 4 && [approx $x1 [lindex [pix $p 0 0] 0] 0.01]} {
	    lappend horiz [R [lindex [::Plotchart::pixelToCoords [$p canvas] $x1 $y1] 1] 1]
	} else {
	    incr data
	}
    }
    list [lsort -real $horiz] $data
} -cleanup {
    cleanupPlot
} -result {{7.0 13.0} 2}

# -------------------------------------------------------------------------
# interval

test Plotchart-206.1 {interval: vertical line with end marks} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 20 5}]
    $p dataconfig i -colour blue
    $p interval i 5 4 12
    set l [items data_i]
    lassign [pix $p 5 4] x0 y0
    lassign [pix $p 5 12] x1 y1
    list [llength $l] [itemTypes data_i] [itemOption data_i -fill] \
	[samePixels [.c coords [lindex $l 0]] [list $x0 $y0 $x1 $y1]] \
	[approx [lindex [.c coords [lindex $l 1]] 1] $y0 0.01] \
	[approx [lindex [.c coords [lindex $l 2]] 1] $y1 0.01]
} -cleanup {
    cleanupPlot
} -result {3 line blue 1 1 1}

test Plotchart-206.2 {interval: symbol at the centre value} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 20 5}]
    $p dataconfig i -symbol up
    $p interval i 5 4 12 8
    set sym [items {data_i type=polygon}]
    lassign [.c bbox $sym] x1 y1 x2 y2
    list [llength [items data_i]] [samePixels [list [expr {($x1+$x2)/2.0}] [expr {($y1+$y2)/2.0}]] [pix $p 5 8] 1.5]
} -cleanup {
    cleanupPlot
} -result {4 1}

test Plotchart-206.4 {interval: time-x plot} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createTXPlot .c {2006-01-01 2006-01-11 2} {0 10 2}]
    $p interval i [clock scan 2006-01-05] 2 8
    llength [items data_i]
} -cleanup {
    cleanupPlot
} -result 3

test Plotchart-206.5 {interval: wrong # args} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 20 5}]
    $p interval i 5 4
} -cleanup {
    cleanupPlot
} -returnCodes error -result {wrong # args: should be "DrawInterval w series xcrd ymin ymax ?ycentr?"}

# -------------------------------------------------------------------------
# box-and-whiskers

# Data with quartiles 3 and 7 (IQR 4), whiskers to 1.5 IQR (-3 and 13)
set bwData {1 2 3 4 5 6 7 8 9}

test Plotchart-207.1 {box-and-whiskers: vertical box from a list of y values} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p box-and-whiskers b 5 $bwData
    set rect [items {data_b type=rectangle}]
    lassign [.c coords $rect] x1 y1 x2 y2
    lassign [::Plotchart::pixelToCoords [$p canvas] $x1 $y1] wx1 wy1
    lassign [::Plotchart::pixelToCoords [$p canvas] $x2 $y2] wx2 wy2
    lassign [pix $p 5 0] xc
    list [R [lsort -real [list $wy1 $wy2]]] [R [expr {$x2-$x1}] 0] [approx [expr {($x1+$x2)/2}] $xc 0.01] \
	[itemTypes data_b] [llength [items {data_b type=line}]]
} -cleanup {
    cleanupPlot
} -result {{2.5 7.5} 10 1 {line rectangle} 5}

test Plotchart-207.2 {box-and-whiskers: median and whiskers} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p box-and-whiskers b 5 $bwData
    set ys {}
    foreach l [items {data_b type=line}] {
	lassign [.c coords $l] x1 y1 x2 y2
	if {$y1 == $y2} {
	    # Horizontal lines: whisker ends and median
	    lappend ys [R [lindex [::Plotchart::pixelToCoords [$p canvas] $x1 $y1] 1] 1]
	}
    }
    lsort -real $ys
} -cleanup {
    cleanupPlot
} -result {1.0 5.0 9.0}

test Plotchart-207.3 {box-and-whiskers: horizontal box from a list of x values} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p box-and-whiskers b $bwData 5
    set rect [items {data_b type=rectangle}]
    lassign [.c coords $rect] x1 y1 x2 y2
    lassign [::Plotchart::pixelToCoords [$p canvas] $x1 $y1] wx1
    lassign [::Plotchart::pixelToCoords [$p canvas] $x2 $y2] wx2
    list [R [lsort -real [list $wx1 $wx2]]] [R [expr {$y2-$y1}] 0]
} -cleanup {
    cleanupPlot
} -result {{2.5 7.5} 10}

test Plotchart-207.4 {box-and-whiskers: both or neither are lists} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p box-and-whiskers b {1 2 3} {4 5 6}
} -cleanup {
    cleanupPlot
} -returnCodes error -result {Use either a list of x values or a list of y values - not both}

test Plotchart-207.5 {box-and-whiskers: -boxwidth, -fillcolour, -colour, -mediancolour} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p dataconfig b -boxwidth 30 -fillcolour yellow -colour blue -mediancolour red \
	-medianwidth 3 -whiskerwidth 2
    $p box-and-whiskers b 5 $bwData
    set rect [items {data_b type=rectangle}]
    lassign [.c coords $rect] x1 y1 x2 y2
    set median {}
    set whiskers {}
    foreach l [items {data_b type=line}] {
	if {[.c itemcget $l -fill] eq "red"} {
	    lappend median [.c itemcget $l -width]
	} else {
	    lappend whiskers [.c itemcget $l -fill] [.c itemcget $l -width]
	}
    }
    list [R [expr {$x2-$x1}] 0] [.c itemcget $rect -fill] [.c itemcget $rect -outline] \
	$median [lsort -unique $whiskers]
} -cleanup {
    cleanupPlot
} -result {30 yellow blue 3.0 {2.0 blue}}

test Plotchart-207.6 {box-and-whiskers: default median line width is 1} -constraints {
    knownBug
} -setup {
    mkCanvas 400 400
} -body {
    # The default width is 2
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p dataconfig b -mediancolour red
    $p box-and-whiskers b 5 $bwData
    itemOption {data_b type=line} -width
} -cleanup {
    cleanupPlot
} -result {1.0}

test Plotchart-207.7 {box-and-whiskers: outliers as dots and stars (IQR)} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createXYPlot .c {0 30 5} {0 30 5}]
    # Quartiles 3 and 9: dots between 1.5 and 3 IQR (18..27), stars beyond 27
    $p box-and-whiskers b 5 {1 2 3 4 5 6 7 8 9 21 40}
    list [llength [items {data_b type=oval}]] [itemTexts data_b]
} -cleanup {
    cleanupPlot
} -result {1 *}

test Plotchart-207.8 {box-and-whiskers: -whisker iqr shows no outliers} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createXYPlot .c {0 30 5} {0 30 5}]
    $p dataconfig b -whisker iqr
    $p box-and-whiskers b 5 {1 2 3 4 5 6 7 8 9 21 40}
    list [llength [items {data_b type=oval}]] [itemTexts data_b]
} -cleanup {
    cleanupPlot
} -result {0 {}}

test Plotchart-207.9 {box-and-whiskers: -whisker extremes and none} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createXYPlot .c {0 30 5} {0 30 5}]
    $p dataconfig e -whisker extremes
    $p dataconfig n -whisker none
    $p box-and-whiskers e 5 {1 2 3 4 5 6 7 8 9 15 25}
    $p box-and-whiskers n 10 {1 2 3 4 5 6 7 8 9 15 25}
    set ys {}
    foreach l [items {data_e type=line}] {
	lassign [.c coords $l] x1 y1 x2 y2
	if {$y1 == $y2} {
	    lappend ys [R [lindex [::Plotchart::pixelToCoords [$p canvas] $x1 $y1] 1] 0]
	}
    }
    list [lsort -real $ys] [llength [items {data_n type=line}]] [itemTypes data_n]
} -cleanup {
    cleanupPlot
} -result {{1 6 25} 1 {line rectangle}}

test Plotchart-207.10 {box-and-whiskers: documented option -whiskers} -constraints {
    knownBug
} -setup {
    mkCanvas 400 400
} -body {
    # The implemented option is called -whisker
    set p [::Plotchart::createXYPlot .c {0 30 5} {0 30 5}]
    $p dataconfig n -whiskers none
    $p box-and-whiskers n 10 {1 2 3 4 5 6 7 8 9 15 25}
    llength [items {data_n type=line}]
} -cleanup {
    cleanupPlot
} -result 1

test Plotchart-207.11 {box-and-whiskers: invalid -whisker value} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 30 5} {0 30 5}]
    $p dataconfig n -whisker all
} -cleanup {
    cleanupPlot
} -returnCodes error -result {Unknown or invalid value: all for option -whisker - IQR iqr extremes none}

# -------------------------------------------------------------------------
# violin

# Find the violin polygons (they have no tags)
proc violins {} {
    set r {}
    foreach i [.c find all] {
	if {[.c type $i] eq "polygon" && [.c itemcget $i -smooth] ne "0"} {
	    lappend r $i
	}
    }
    return $r
}

test Plotchart-208.1 {violin: vertical violin, default width 50 pixels} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p violin v 5 {2 3 3 4 4 4 5 5 6 8}
    set v [violins]
    set xs [lmap {x y} [.c coords $v] {set x}]
    set x1 [tcl::mathfunc::min {*}$xs]
    set x2 [tcl::mathfunc::max {*}$xs]
    lassign [.c bbox $v] - y1 - y2
    lassign [pix $p 5 0] xc
    list [llength $v] [.c itemcget $v -fill] [.c itemcget $v -outline] \
	[approx [expr {$x2-$x1}] 50 2] [approx [expr {($x1+$x2)/2.0}] $xc 1] \
	[expr {$y1 < [lindex [pix $p 5 8] 1] && $y2 > [lindex [pix $p 5 2] 1]}]
} -cleanup {
    cleanupPlot
} -result {1 {} black 1 1 1}

test Plotchart-208.2 {violin: horizontal violin with colours} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p dataconfig v -colour blue -fillcolour lightblue
    $p violin v {2 3 3 4 4 4 5 5 6 8} 5
    set v [violins]
    lassign [.c bbox $v] x1 - x2 -
    set ys [lmap {x y} [.c coords $v] {set y}]
    set y1 [tcl::mathfunc::min {*}$ys]
    set y2 [tcl::mathfunc::max {*}$ys]
    list [.c itemcget $v -fill] [.c itemcget $v -outline] [approx [expr {$y2-$y1}] 50 2] \
	[expr {$x2-$x1 > $y2-$y1}]
} -cleanup {
    cleanupPlot
} -result {lightblue blue 1 1}

test Plotchart-208.3 {violin: -violinwidth} -constraints {
    knownBug
} -setup {
    mkCanvas 400 400
} -body {
    # The violin is twice as wide as specified
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p dataconfig v -violinwidth 30
    $p violin v 5 {2 3 3 4 4 4 5 5 6 8}
    set xs [lmap {x y} [.c coords [violins]] {set x}]
    approx [expr {[tcl::mathfunc::max {*}$xs] - [tcl::mathfunc::min {*}$xs]}] 30 2
} -cleanup {
    cleanupPlot
} -result 1

test Plotchart-208.4 {violin: data tags} -constraints {
    knownBug
} -setup {
    mkCanvas 400 400
} -body {
    # The violin polygon has no tags
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p violin v 5 {2 3 3 4 4 4 5 5 6 8}
    llength [items data_v]
} -cleanup {
    cleanupPlot
} -result 1

test Plotchart-208.5 {violin: both lists} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p violin v {1 2} {3 4}
} -cleanup {
    cleanupPlot
} -returnCodes error -result {Use either a list of x values or a list of y values - not both}

# -------------------------------------------------------------------------
# vector and vectorconfig

test Plotchart-209.1 {vector: cartesian components (default)} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p vector v 5 5 30 40
    set l [items data_v]
    lassign [pix $p 5 5] x y
    list [.c type $l] [.c itemcget $l -arrow] [.c itemcget $l -fill] \
	[samePixels [.c coords $l] [list $x $y [expr {$x+30}] [expr {$y-40}]] 0.01]
} -cleanup {
    cleanupPlot
} -result {line last black 1}

test Plotchart-209.2 {vectorconfig -scale, -colour, -centred} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p vectorconfig v -scale 2 -colour red -centred 1
    $p vector v 5 5 10 20
    set l [items data_v]
    lassign [pix $p 5 5] x y
    list [.c itemcget $l -fill] \
	[samePixels [.c coords $l] [list [expr {$x-10}] [expr {$y+20}] [expr {$x+10}] [expr {$y-20}]] 0.01]
} -cleanup {
    cleanupPlot
} -result {red 1}

test Plotchart-209.3 {vectorconfig: -color and -centered synonyms} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p vectorconfig v -color green -centered 1
    $p vector v 5 5 10 0
    set l [items data_v]
    lassign [pix $p 5 5] x y
    list [.c itemcget $l -fill] [samePixels [.c coords $l] [list [expr {$x-5}] $y [expr {$x+5}] $y] 0.01]
} -cleanup {
    cleanupPlot
} -result {green 1}

test Plotchart-209.4 {vectorconfig -type polar: angle 0 along the x-axis} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p vectorconfig v -type polar
    $p vector v 5 5 20 0
    $p vector w 5 5 20 90
    $p vectorconfig w -type polar
    .c delete data_w
    $p vector w 5 5 20 90
    lassign [pix $p 5 5] x y
    list [samePixels [.c coords [items data_v]] [list $x $y [expr {$x+20}] $y] 0.01] \
	[samePixels [.c coords [items data_w]] [list $x $y $x [expr {$y-20}]] 0.01]
} -cleanup {
    cleanupPlot
} -result {1 1}

test Plotchart-209.5 {vectorconfig -type nautical: 0 is north, 90 is east} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p vectorconfig n -type nautical
    $p vectorconfig e -type nautical
    $p vector n 5 5 20 0
    $p vector e 5 5 20 90
    lassign [pix $p 5 5] x y
    list [samePixels [.c coords [items data_n]] [list $x $y $x [expr {$y-20}]] 0.01] \
	[samePixels [.c coords [items data_e]] [list $x $y [expr {$x+20}] $y] 0.01]
} -cleanup {
    cleanupPlot
} -result {1 1}

test Plotchart-209.6 {vectorconfig: invalid -scale} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p vectorconfig v -scale 0
} -cleanup {
    cleanupPlot
} -returnCodes error -result {Scale factor must be positive}

test Plotchart-209.7 {vectorconfig: invalid -type} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p vectorconfig v -type spherical
} -cleanup {
    cleanupPlot
} -returnCodes error -result {Unknown vector components option: spherical}

test Plotchart-209.8 {vectorconfig: unknown option} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p vectorconfig v -width 2
} -cleanup {
    cleanupPlot
} -returnCodes error -result {Unknown vector option: -width (2)}

test Plotchart-209.9 {vector: wrong # args} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p vector v 5 5 1
} -cleanup {
    cleanupPlot
} -returnCodes error -result {wrong # args: should be "DrawVector w series xcrd ycrd ucmp vcmp"}

# -------------------------------------------------------------------------
# dot and dotconfig

proc brightness {colour} {
    lassign [winfo rgb . $colour] r g b
    expr {$r + $g + $b}
}

proc dotRadius {i} {
    lassign [.c coords $i] x1 y1 x2 y2
    R [expr {($x2-$x1)/2.0}] 1
}

test Plotchart-210.1 {dot: size scaled by the value (default)} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p dot d 3 3 5
    $p dot d 7 7 10
    lassign [items data_d] d1 d2
    lassign [.c coords $d1] x1 y1 x2 y2
    list [itemTypes data_d] [dotRadius $d1] [dotRadius $d2] [.c itemcget $d1 -fill] \
	[.c itemcget $d1 -outline] [samePixels [list [expr {($x1+$x2)/2}] [expr {($y1+$y2)/2}]] [pix $p 3 3] 0.01]
} -cleanup {
    cleanupPlot
} -result {oval 5.0 10.0 black black 1}

