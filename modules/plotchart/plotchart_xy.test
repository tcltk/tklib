} -result {1 {Minimum and maximum for x-axis must be positive} 1 {Minimum and maximum for y-axis must be positive}}

test Plotchart-215.8 {logarithmic plots: general methods} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createLogXLogYPlot .c {1 1000} {1 1000}]
    $p title "Log-log"
    $p xtext "X"
    $p ytext "Y"
    $p dataconfig s -colour red
    $p plot s 10 10
    $p plot s 100 100
    $p legend s "Series"
    $p xticklines grey
    $p yticklines grey
    list [itemTexts title] [itemTexts legend] [expr {[llength [items xtickline]] > 0}] \
	[expr {[llength [items ytickline]] > 0}]
} -cleanup {
    cleanupPlot
} -result {Log-log Series 1 1}

# -------------------------------------------------------------------------
# createIsometricPlot

test Plotchart-216.1 {createIsometricPlot: same scale in both directions} -setup {
    mkCanvas 400 300
} -body {
    set p [::Plotchart::createIsometricPlot .c {0 10} {0 10} 2]
    lassign [pix $p 0 0] x0 y0
    lassign [pix $p 1 1] x1 y1
    list [string match isometric_* $p] [approx [expr {$x1-$x0}] [expr {$y0-$y1}] 0.01] \
	[expr {[llength [items xaxis]] > 0}] [expr {[llength [items yaxis]] > 0}]
} -cleanup {
    cleanupPlot
} -result {1 1 1 1}

test Plotchart-216.2 {createIsometricPlot: noaxes uses the full canvas} -setup {
    mkCanvas 400 300
} -body {
    set p [::Plotchart::createIsometricPlot .c {0 10} {0 10} noaxes]
    lassign [pix $p 0 0] x0 y0
    lassign [pix $p 1 1] x1 y1
    list [llength [items xaxis]] [llength [items yaxis]] [llength [items mask]] \
	[approx [expr {$x1-$x0}] [expr {$y0-$y1}] 0.01] [approx [expr {$y0-$y1}] 30 0.01]
} -cleanup {
    cleanupPlot
} -result {0 0 0 1 1}

test Plotchart-216.3 {createIsometricPlot: extremes must differ} -setup {
    mkCanvas
} -body {
    ::Plotchart::createIsometricPlot .c {0 10} {5 5} 2
} -cleanup {
    cleanupPlot
} -returnCodes error -result {Extremes for axes must be different}

test Plotchart-216.4 {isometric plot: rectangle and filled-rectangle} -setup {
    mkCanvas 400 300
} -body {
    set p [::Plotchart::createIsometricPlot .c {0 10} {0 10} noaxes]
    $p plot rectangle 1 1 3 4 red
    $p plot filled-rectangle 5 5 7 6 blue
    lassign [items data] r f
    list [.c type $r] [.c itemcget $r -outline] [.c itemcget $r -fill] \
	[samePixels [lsort -real [.c coords $r]] [lsort -real [pixList $p {1 1 3 4}]] 0.01] \
	[.c type $f] [.c itemcget $f -outline] [.c itemcget $f -fill] \
	[samePixels [lsort -real [.c coords $f]] [lsort -real [pixList $p {5 5 7 6}]] 0.01]
} -cleanup {
    cleanupPlot
} -result {rectangle red {} 1 rectangle blue blue 1}

test Plotchart-216.5 {isometric plot: circle and filled-circle are round} -setup {
    mkCanvas 400 300
} -body {
    set p [::Plotchart::createIsometricPlot .c {0 10} {0 10} 2]
    $p plot circle 5 5 2 green
    $p plot filled-circle 3 3 1 yellow
    lassign [items data] c f
    lassign [.c coords $c] x1 y1 x2 y2
    lassign [.c coords $f] u1 v1 u2 v2
    list [.c type $c] [.c itemcget $c -outline] [.c itemcget $c -fill] \
	[approx [expr {abs($x2-$x1)}] [expr {abs($y2-$y1)}] 0.01] \
	[samePixels [list [expr {($x1+$x2)/2}] [expr {($y1+$y2)/2}]] [pix $p 5 5] 0.01] \
	[.c type $f] [.c itemcget $f -fill] [approx [expr {abs($u2-$u1)}] [expr {abs($v2-$v1)}] 0.01]
} -cleanup {
    cleanupPlot
} -result {oval green {} 1 1 oval yellow 1}

test Plotchart-216.6 {isometric plot: default colour is black} -setup {
    mkCanvas 400 300
} -body {
    set p [::Plotchart::createIsometricPlot .c {0 10} {0 10} noaxes]
    $p plot rectangle 1 1 3 4
    $p plot circle 5 5 1
    itemOption data -outline
} -cleanup {
    cleanupPlot
} -result {black}

test Plotchart-216.7 {createIsometricPlot: wrong # args} -body {
    ::Plotchart::createIsometricPlot .c {0 10} {0 10}
} -returnCodes error -result {wrong # args: should be "::Plotchart::createIsometricPlot c xscale yscale stepsize ?arg ...?"}

# -------------------------------------------------------------------------
# createHistogram

test Plotchart-217.1 {histogram: bars end at the given x-coordinate} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createHistogram .c {0 10 2} {0 10 2}]
    $p plot h 2 4
    $p plot h 6 8
    set rects [items {data_h type=rectangle}]
    lassign $rects r1 r2
    list [string match histogram_* $p] [llength $rects] \
	[samePixels [lsort -real [.c coords $r1]] [lsort -real [pixList $p {0 0 2 4}]]] \
	[samePixels [lsort -real [.c coords $r2]] [lsort -real [pixList $p {2 0 6 8}]]] \
	[.c itemcget $r1 -fill] [llength [items {data_h type=line}]]
} -cleanup {
    cleanupPlot
} -result {1 2 1 1 black 2}

test Plotchart-217.2 {histogram: -fillcolour and -colour} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createHistogram .c {0 10 2} {0 10 2}]
    $p dataconfig h -fillcolour green -colour red -width 2
    $p plot h 2 4
    list [itemOption {data_h type=rectangle} -fill] [itemOption {data_h type=line} -fill] \
	[itemOption {data_h type=line} -width]
} -cleanup {
    cleanupPlot
} -result {green red 2.0}

test Plotchart-217.3 {histogram: styles spike, symbol, plateau and stair} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createHistogram .c {0 10 2} {0 10 2}]
    set r {}
    foreach style {spike symbol plateau stair} {
	$p dataconfig $style -style $style
	$p plot $style 2 4
	$p plot $style 4 6
	lappend r $style [lsort -unique [lmap i [items data_$style] {.c type $i}]] \
	    [llength [items data_$style]]
    }
    set r
} -cleanup {
    cleanupPlot
} -result {spike line 2 symbol line 2 plateau line 2 stair line 2}

test Plotchart-217.4 {histogram: spike is a vertical line at the point} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createHistogram .c {0 10 2} {0 10 2}]
    $p dataconfig s -style spike
    $p plot s 4 6
    samePixels [.c coords [items data_s]] [pixList $p {4 0 4 6}]
} -cleanup {
    cleanupPlot
} -result 1

test Plotchart-217.5 {histogram: stair connects the data points} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createHistogram .c {0 10 2} {0 10 2}]
    $p dataconfig s -style stair
    $p plot s 2 4
    $p plot s 4 6
    set l [lindex [items data_s] 1]
    samePixels [.c coords $l] [pixList $p {2 4 2 6 4 6}]
} -cleanup {
    cleanupPlot
} -result 1

test Plotchart-217.6 {histogram: symbol style uses plus by default} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createHistogram .c {0 10 2} {0 10 2}]
    $p dataconfig s -style symbol
    $p dataconfig c -style symbol -symbol circle
    $p plot s 4 6
    $p plot c 4 6
    list [.c type [items data_s]] [.c type [items data_c]]
} -cleanup {
    cleanupPlot
} -result {line oval}

test Plotchart-217.7 {histogram: invalid style} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createHistogram .c {0 10 2} {0 10 2}]
    $p dataconfig s -style bars
} -cleanup {
    cleanupPlot
} -returnCodes error -result {Unknown or invalid value: bars for option -style - filled spike symbol plateau stair}

test Plotchart-217.8 {histogram: plotcumulative accumulates the values} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createHistogram .c {0 10 2} {0 10 2}]
    $p plotcumulative h 2 1
    $p plotcumulative h 4 2
    $p plotcumulative h 6 3
    set tops {}
    foreach r [items {data_h type=rectangle}] {
	lassign [.c coords $r] x1 y1 x2 y2
	lappend tops [R [lindex [::Plotchart::pixelToCoords [$p canvas] $x2 [expr {min($y1,$y2)}]] 1] 1]
    }
    set tops
} -cleanup {
    cleanupPlot
} -result {1.0 3.0 6.0}

test Plotchart-217.9 {histogram: -xlabels with empty step} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createHistogram .c {0 10 {}} {0 10 2} -xlabels {A B C}]
    itemTexts xaxis
} -cleanup {
    cleanupPlot
} -result {A B C}

test Plotchart-217.10 {histogram: missing y value starts the next bar} -constraints {
    knownBug
} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createHistogram .c {0 10 2} {0 10 2}]
    $p plot h 2 {}
    $p plot h 4 5
    # Fails with: can't read "data_series(00.c,h,pystair)"
    set r [items {data_h type=rectangle}]
    samePixels [lsort -real [.c coords $r]] [lsort -real [pixList $p {2 0 4 5}]]
} -cleanup {
    cleanupPlot
} -result 1

test Plotchart-217.11 {histogram: step size zero} -setup {
    mkCanvas
} -body {
    ::Plotchart::createHistogram .c {0 10 0} {0 10 2}
} -cleanup {
    cleanupPlot
} -returnCodes error -result {Step size can not be zero}

# -------------------------------------------------------------------------
# createRightAxis

test Plotchart-218.1 {createRightAxis: axis at the right with its own scale} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    set r [::Plotchart::createRightAxis $p {0 100 20}]
    lassign [pix $p 10 0] xr
    set axle [lindex [items raxis] 0]
    list [string match right_* $r] [itemTexts raxis] [approx [lindex [.c coords $axle] 0] $xr 0.01]
} -cleanup {
    cleanupPlot
} -result {1 {0 20 40 60 80 100} 1}

test Plotchart-218.2 {createRightAxis: data plotted against the right axis} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    set r [::Plotchart::createRightAxis $p {0 100 20}]
    $r dataconfig s -colour red
    $r plot s 0 50
    $r plot s 10 100
    $p plot s 0 0
    $p plot s 10 5
    set lines [items data_s]
    set rl [lindex [lmap l $lines {expr {[.c itemcget $l -fill] eq "red" ? $l : [continue]}}] 0]
    set ll [lindex [lmap l $lines {expr {[.c itemcget $l -fill] eq "black" ? $l : [continue]}}] 0]
    list [samePixels [.c coords $rl] [pixList $p {0 5 10 10}]] \
	[samePixels [.c coords $ll] [pixList $p {0 0 10 5}]]
} -cleanup {
    cleanupPlot
} -result {1 1}

test Plotchart-218.3 {createRightAxis: with the canvas name} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    set r [::Plotchart::createRightAxis .c {0 1 0.5}]
    itemTexts raxis
} -cleanup {
    cleanupPlot
} -result {0 0.5 1}

test Plotchart-218.4 {createRightAxis: -ylabels with empty step} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    set r [::Plotchart::createRightAxis $p {0 2 {}} -ylabels {Low Mid High}]
    itemTexts raxis
} -cleanup {
    cleanupPlot
} -result {Low Mid High}

test Plotchart-218.5 {createRightAxis: no plot yet} -setup {
    mkCanvas
} -body {
    ::Plotchart::createRightAxis .c {0 100 20}
} -cleanup {
    cleanupPlot
} -returnCodes error -result {There should be a plot with a left axis already defined}

test Plotchart-218.6 {createRightAxis: step size zero} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    ::Plotchart::createRightAxis $p {0 100 0}
} -cleanup {
    cleanupPlot
} -returnCodes error -result {Step size can not be zero}

test Plotchart-218.7 {createRightAxis: configuration type inherited from the plot} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createHistogram .c {0 10 2} {0 10 2}]
    set r [::Plotchart::createRightAxis $p {0 100 20}]
    $r plot h 4 50
    llength [items {data_h type=rectangle}]
} -cleanup {
    cleanupPlot
} -result 1

test Plotchart-218.8 {createRightAxis: yconfig for the right axis} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    set r [::Plotchart::createRightAxis $p {0 100 50}]
    $r yconfig -format %.1f
    list [itemTexts raxis] [itemTexts yaxis]
