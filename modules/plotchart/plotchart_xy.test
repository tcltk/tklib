} -body {
    list [catch {::Plotchart::createLogXLogYPlot .c {0 1000} {1 1000}} m1] $m1 \
	[catch {::Plotchart::createLogXLogYPlot .c {1 1000} {1 -1000}} m2] $m2
} -cleanup {
