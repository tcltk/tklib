# background

test Plotchart-107.1 {background axes: colour of the area outside the plot} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p background axes lightblue
    list [itemOption mask -fill] [itemOption mask -outline] [llength [items mask]]
} -cleanup {
    cleanupPlot
} -result {lightblue lightblue 4}

test Plotchart-107.2 {background plot: colour of the inner part} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p background plot yellow
    list [.c cget -background] [itemOption mask -fill]
} -cleanup {
    cleanupPlot
} -result {yellow white}

test Plotchart-107.3 {background gradient: rectangles in the plot area} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p background gradient green left-right
    set rects [items background]
    lassign [.c bbox background] x1 y1 x2 y2
    lassign [pix $p 0 0] px1 py2
    lassign [pix $p 10 10] px2 py1
    list [itemTypes background] [llength $rects] \
	[approx $x1 $px1 2] [approx $x2 $px2 2] [approx $y1 $py1 2] [approx $y2 $py2 2] \
	[expr {[lindex [.c find all] 0] eq [lindex $rects 0]}]
} -cleanup {
    cleanupPlot
} -result {rectangle 50 1 1 1 1 1}

proc gradientEnds {} {
    # Colours of the rectangles at the top, bottom, left and right
    set top {}
    set bottom {}
    set left {}
    set right {}
    foreach i [items background] {
	lassign [.c coords $i] x1 y1 x2 y2
	set ymid [expr {($y1+$y2)/2.0}]
	set xmid [expr {($x1+$x2)/2.0}]
	set col [.c itemcget $i -fill]
	if {$top eq "" || $ymid < [lindex $top 0]} {set top [list $ymid $col]}
	if {$bottom eq "" || $ymid > [lindex $bottom 0]} {set bottom [list $ymid $col]}
	if {$left eq "" || $xmid < [lindex $left 0]} {set left [list $xmid $col]}
	if {$right eq "" || $xmid > [lindex $right 0]} {set right [list $xmid $col]}
    }
    list [lindex $top 1] [lindex $bottom 1] [lindex $left 1] [lindex $right 1]
}
proc brightness {colour} {
    lassign [winfo rgb . $colour] r g b
    expr {$r + $g + $b}
}
proc gradientRange {} {
    set min {}
    set max {}
    foreach i [items background] {
	set b [brightness [.c itemcget $i -fill]]
	if {$min eq "" || $b < $min} {set min $b}
	if {$max eq "" || $b > $max} {set max $b}
    }
    list $min $max
}

test Plotchart-107.4 {background gradient top-down: whiter towards the bottom} -constraints {
    knownBug
} -setup {
    mkCanvas
} -body {
    # No rectangles are drawn for vertical gradients
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p background gradient #008000 top-down
    lassign [gradientEnds] top bottom
    list [expr {[llength [items background]] > 0}] \
	[expr {[brightness $bottom] > [brightness $top]}]
} -cleanup {
    cleanupPlot
} -result {1 1}

test Plotchart-107.5 {background gradient bottom-up: whiter towards the top} -constraints {
    knownBug
} -setup {
    mkCanvas
} -body {
    # No rectangles are drawn for vertical gradients
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p background gradient #008000 bottom-up
    lassign [gradientEnds] top bottom
    list [expr {[llength [items background]] > 0}] \
	[expr {[brightness $top] > [brightness $bottom]}]
} -cleanup {
    cleanupPlot
} -result {1 1}

test Plotchart-107.6 {background gradient left-right: whiter towards the right} -constraints {
    knownBug
} -setup {
    mkCanvas
} -body {
    # The colour gets whiter towards the left instead
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p background gradient #008000 left-right
    lassign [gradientEnds] top bottom left right
    expr {[brightness $right] > [brightness $left]}
} -cleanup {
    cleanupPlot
} -result 1

test Plotchart-107.7 {background gradient right-left: whiter towards the left} -constraints {
    knownBug
} -setup {
    mkCanvas
} -body {
    # The colour gets whiter towards the right instead
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p background gradient #008000 right-left
    lassign [gradientEnds] top bottom left right
    expr {[brightness $left] > [brightness $right]}
} -cleanup {
    cleanupPlot
} -result 1

test Plotchart-107.8 {background gradient: left-right and right-left are opposite} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p background gradient #008000 left-right
    lassign [gradientEnds] top bottom l1 r1
    .c delete background
    $p background gradient #008000 right-left
    lassign [gradientEnds] top bottom l2 r2
    list [expr {$l1 eq $r2}] [expr {$r1 eq $l2}] [expr {$l1 ne $r1}]
} -cleanup {
    cleanupPlot
} -result {1 1 1}

test Plotchart-107.9 {background gradient bright: from the colour to white} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p background gradient #008000 left-right bright
    lassign [gradientRange] min max
    list [expr {$min >= [brightness #008000]}] [expr {$max > [brightness #008000]}] \
	[expr {$max <= [brightness white]}]
} -cleanup {
    cleanupPlot
} -result {1 1 1}

test Plotchart-107.10 {background gradient dark: from the colour to black} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p background gradient #00c000 left-right dark
    lassign [gradientRange] min max
    list [expr {$max <= [brightness #00c000]}] [expr {$min < [brightness #00c000]}]
} -cleanup {
    cleanupPlot
} -result {1 1}

test Plotchart-107.11 {background gradient: bright is the default} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p background gradient #008000 left-right
    set c1 [gradientEnds]
    .c delete background
    $p background gradient #008000 left-right bright
    expr {$c1 eq [gradientEnds]}
} -cleanup {
    cleanupPlot
} -result 1

test Plotchart-107.12 {background image: tiles the plot area} -setup {
    mkCanvas
    image create photo plotchartTestImage -width 40 -height 30
    plotchartTestImage put red -to 0 0 40 30
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p background image plotchartTestImage
    lassign [.c bbox background] x1 y1 x2 y2
    lassign [pix $p 0 0] px1 py2
    lassign [pix $p 10 10] px2 py1
    list [itemTypes background] [itemOption background -image] \
	[expr {$x1 <= $px1 + 1 && $x2 >= $px2 - 1 && $y1 <= $py1 + 1 && $y2 >= $py2 - 1}] \
	[expr {[lindex [.c find all] 0] eq [lindex [items background] 0]}]
} -cleanup {
    cleanupPlot
    image delete plotchartTestImage
} -result {image plotchartTestImage 1 1}

test Plotchart-107.13 {background: wrong # args} -setup {
    mkCanvas
} -body {
