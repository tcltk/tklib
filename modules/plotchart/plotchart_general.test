# -------------------------------------------------------------------------
# xticklines and yticklines

test Plotchart-108.1 {xticklines: vertical lines at the ticks} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p xticklines
    set xs {}
    set ok 1
    lassign [pix $p 0 0] x0 y0
    lassign [pix $p 10 10] x1 y1
    foreach i [items xtickline] {
	lassign [.c coords $i] xa ya xb yb
	lappend xs [R [lindex [::Plotchart::pixelToCoords [$p canvas] $xa $ya] 0] 0]
	if {$xa != $xb || ![approx $ya $y1] || ![approx $yb $y0]} {set ok 0}
    }
    list $xs $ok [itemTypes xtickline] [itemOption xtickline -fill] [itemOption xtickline -dash]
} -cleanup {
    cleanupPlot
} -result {{0 2 4 6 8 10} 1 line black {{}}}

test Plotchart-108.2 {yticklines: horizontal lines at the ticks} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 5} {0 10 5}]
    $p yticklines red
    set ys {}
    foreach i [items ytickline] {
	lassign [.c coords $i] xa ya xb yb
	lappend ys [expr {$ya == $yb}]
    }
    list $ys [itemOption ytickline -fill]
} -cleanup {
    cleanupPlot
} -result {{1 1 1} red}

test Plotchart-108.3 {xticklines: dash patterns} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 5} {0 10 5}]
    set r {}
    foreach dash {lines dots1 dots2 unknown} {
	$p xticklines grey $dash
	lappend r [itemOption xtickline -dash]
    }
    foreach dash {dots3 dots4 dots5} {
	$p yticklines grey $dash
	lappend r [expr {[itemOption ytickline -dash] ne "{}"}]
    }
    set r
} -cleanup {
    cleanupPlot
} -result {{{}} {{1 4}} {{1 8}} {{}} 1 1 1}

test Plotchart-108.4 {xticklines/yticklines: empty colour removes the lines} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 5} {0 10 5}]
    $p xticklines blue
    $p yticklines blue
    set r [list [llength [items xtickline]] [llength [items ytickline]]]
    $p xticklines ""
    $p yticklines ""
    lappend r [llength [items xtickline]] [llength [items ytickline]]
} -cleanup {
    cleanupPlot
} -result {3 3 0 0}

