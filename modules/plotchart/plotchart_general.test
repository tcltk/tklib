    ::Plotchart::plotconfig nosuchchart
} -returnCodes error -result {Unknown chart type - nosuchchart}

test Plotchart-115.17 {plotconfig: unknown component} -body {
    ::Plotchart::plotconfig xyplot nosuchcomponent
} -returnCodes error -result {Unknown component 'nosuchcomponent' for this chart type - xyplot}

