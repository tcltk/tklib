test Plotchart-111.6 {plaintext: anchor south-west} -constraints {
    knownBug
} -setup {
    mkCanvas
} -body {
    # The anchor is nw instead
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p plaintext 5 5 "Text" south-west
    itemOption PlainText -anchor
} -cleanup {
    cleanupPlot
} -result {sw}

test Plotchart-111.7 {plaintext: default and unknown anchor is centre} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p plaintext 5 5 "Default"
    $p plaintext 5 5 "Unknown" nowhere
    itemOption PlainText -anchor
} -cleanup {
    cleanupPlot
} -result {center}

test Plotchart-111.8 {plaintextconfig: font, justify and colour} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p plaintextconfig -font {Courier 12} -justify right -textcolour blue
    $p plaintext 5 5 "Line\nLonger line" north
    set t [items PlainText]
    list [.c itemcget $t -font] [.c itemcget $t -justify] [.c itemcget $t -fill]
} -cleanup {
    cleanupPlot
} -result {{Courier 12} right blue}

test Plotchart-111.9 {plaintextconfig: -textcolor is a synonym, used for the next text} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p plaintext 2 2 "First" north
    $p plaintextconfig -textcolor red
    $p plaintext 8 8 "Second" north
    lmap t [items PlainText] {.c itemcget $t -fill}
} -cleanup {
    cleanupPlot
} -result {black red}

test Plotchart-111.13 {plaintext: timechart} -constraints {
    knownBug
} -setup {
    mkCanvas
} -body {
    # The plain text settings are not initialised for timecharts
    set p [::Plotchart::createTimechart .c "1 january 2004" "31 december 2004" 4]
    $p plaintext [clock scan "1 july 2004"] 2 "Text"
    itemTexts PlainText
} -cleanup {
    cleanupPlot
} -result {Text}

test Plotchart-111.10 {plaintext: time-x plot takes a date/time} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createTXPlot .c {2006-01-01 2006-01-11 2} {0 10 2}]
    $p plaintext 2006-01-06 5 "Middle" north
    expr {[R [.c coords [items PlainText]] 2] eq [R [pix $p [clock scan 2006-01-06] 5] 2]}
} -cleanup {
    cleanupPlot
} -result 1

test Plotchart-111.11 {plaintext: wrong # args} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p plaintext 1 1
} -cleanup {
    cleanupPlot
} -returnCodes error -result {wrong # args: should be "DrawPlainText w x y text ?anchor?"}

test Plotchart-111.12 {plaintext: in a barchart bar N is at x = N} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createBarchart .c {A B C} {0 10 2} 1]
    $p plot s {2 4 6} red
    $p plaintext 2 4 "Top of B" south
    # The text is above the middle of the second bar
    set bar [lindex [items data_s] 1]
    lassign [.c coords $bar] x1 y1 x2 y2
    lassign [.c coords [items PlainText]] tx ty
    list [approx $tx [expr {($x1+$x2)/2.0}]] [approx $ty [expr {min($y1,$y2)}]]
} -cleanup {
    cleanupPlot
} -result {1 1}

# -------------------------------------------------------------------------
# object

test Plotchart-112.1 {object: standard canvas item in world coordinates} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    set id [$p object line s1 1 1 9 9 -width 2]
    list [.c type $id] [expr {[R [.c coords $id] 2] eq [R [concat [pix $p 1 1] [pix $p 9 9]] 2]}] \
	[.c itemcget $id -width] [.c gettags $id]
} -cleanup {
    cleanupPlot
} -result {line 1 2.0 object}

test Plotchart-112.2 {object: coordinates as a single list} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    set id [$p object rectangle s1 {2 2 4 6} -fill red]
    lassign [pix $p 2 2] x1 y1
    lassign [pix $p 4 6] x2 y2
    list [.c type $id] \
	[expr {[R [.c coords $id] 2] eq [R [list $x1 [expr {min($y1,$y2)}] $x2 [expr {max($y1,$y2)}]] 2]}] \
	[.c itemcget $id -fill]
} -cleanup {
    cleanupPlot
} -result {rectangle 1 red}

test Plotchart-112.3 {object: drawing options of the series} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p dataconfig s1 -colour red -width 3
    set l [$p object line s1 1 1 9 9]
    set r [$p object rectangle s1 1 1 3 3 -fill yellow]
    set t [$p object text s1 5 5 -text Hello]
    list [.c itemcget $l -fill] [.c itemcget $l -width] \
	[.c itemcget $r -outline] [.c itemcget $r -fill] [.c itemcget $r -width] \
	[.c itemcget $t -fill] [.c itemcget $t -text]
} -cleanup {
    cleanupPlot
} -result {red 3.0 red yellow 3.0 red Hello}

test Plotchart-112.10 {object: fill colour of the series} -constraints {
    knownBug
} -setup {
    mkCanvas
} -body {
    # Fails with: unknown option "-fillcolour"
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p dataconfig s1 -colour red -fillcolour yellow
    set r [$p object rectangle s1 1 1 3 3]
    list [.c itemcget $r -outline] [.c itemcget $r -fill]
} -cleanup {
    cleanupPlot
} -result {red yellow}

test Plotchart-112.4 {object: circle, dot and cross} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    set c [$p object circle s1 5 5 -diameter 20 -colour blue -fillcolour yellow]
    set d [$p object dot s1 2 2 -diameter 6 -colour green]
    set x [$p object cross s1 8 8 -diameter 10 -colour red]
    lassign [.c coords $c] x1 y1 x2 y2
    lassign [pix $p 5 5] cx cy
    lassign [.c coords $d] dx1 dy1 dx2 dy2
    list [.c type $c] [R [expr {$x2-$x1}] 0] [approx [expr {($x1+$x2)/2.0}] $cx 0.01] \
	[.c itemcget $c -outline] [.c itemcget $c -fill] \
	[.c type $d] [R [expr {abs($dx2-$dx1)}] 0] [.c itemcget $d -fill] \
	[lsort -unique [lmap i [.c find withtag $x] {.c type $i}]] [llength [.c find withtag $x]] \
	[itemOption $x -fill] [string match canvCross_* $x] \
	[lsort [string map [list $x canvCross_] [.c gettags [lindex [.c find withtag $x] 0]]]] \
	[lsort [string map [list $x canvCross_] [.c gettags [lindex [.c find withtag $x] 1]]]]
} -cleanup {
    cleanupPlot
} -result [list oval 20 1 blue yellow oval 6 green line 2 red 1 {canvCross_ object} {canvCross_ object}]

test Plotchart-112.5 {object: unknown item type} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p object triangle s1 1 1
} -cleanup {
    cleanupPlot
} -returnCodes error -result {no such canvas object: triangle}

test Plotchart-112.6 {object: no coordinates} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p object line s1 -fill red
} -cleanup {
    cleanupPlot
} -returnCodes error -result {no coordinates given for line object}

test Plotchart-112.7 {object: barcharts and piecharts} -setup {
    mkCanvas
} -body {
    set r {}
    foreach cmd {
	{::Plotchart::createBarchart .c {A B C} {0 10 2} 1}
	{::Plotchart::createHorizontalBarchart .c {0 10 2} {A B C} 1}
	{::Plotchart::createPiechart .c}
    } {
	set p [{*}$cmd]
	set id [$p object oval s1 0.5 0.5 1 1]
	lappend r [.c type $id]
	cleanupPlot
	mkCanvas
    }
    set r
} -cleanup {
    cleanupPlot
} -result {oval oval oval}

test Plotchart-112.8 {object: horizontal barchart with transposed coordinates} -setup {
    ::Plotchart::plotconfig horizbars object transposecoordinates 1
    mkCanvas
} -body {
    set p [::Plotchart::createHorizontalBarchart .c {0 10 2} {A B C} 1]
    set id [$p object line s1 2 4 2 8]
    expr {[R [.c coords $id] 2] eq [R [concat [pix $p 4 2] [pix $p 8 2]] 2]}
} -cleanup {
    cleanupPlot
    ::Plotchart::plotconfig horizbars object transposecoordinates default
} -result 1

test Plotchart-112.9 {object: legend entry via dataconfig -type rectangle} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p dataconfig obj -type rectangle -colour orange
    $p object oval obj 1 1 3 3
    $p legend obj "Object"
    list [lsort [itemTypes legend]] [itemOption {legend type=rectangle} -fill]
} -cleanup {
    cleanupPlot
} -result {{rectangle text} orange}

# -------------------------------------------------------------------------
# deletedata

test Plotchart-113.1 {deletedata: removes the data, keeps axes and legend} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p dataconfig s1 -colour red -type both
    $p plot s1 1 1
    $p plot s1 2 3
    $p legend s1 "Series 1"
    set before [llength [items data]]
    $p deletedata
    list [expr {$before > 0}] [llength [items data]] [expr {[llength [items xaxis]] > 0}] \
	[itemTexts legend]
} -cleanup {
    cleanupPlot
} -result {1 0 1 {{Series 1}}}

test Plotchart-113.2 {deletedata: series options kept, new line not connected} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p dataconfig s1 -colour red
    $p plot s1 1 1
    $p plot s1 2 3
    $p deletedata
    $p plot s1 5 5
    set n1 [llength [items data]]
    $p plot s1 6 6
    list $n1 [llength [items data]] [itemOption data -fill]
} -cleanup {
    cleanupPlot
} -result {0 1 red}

# -------------------------------------------------------------------------
# bindplot and bindlast

test Plotchart-114.1 {bindplot: command called with world coordinates} -setup {
    wm deiconify .
    mkCanvas
    pack .c
    update
    set ::bindResult {}
    proc bindCmd {x y args} {
	lappend ::bindResult [R [list $x $y] 1] $args
    }
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p bindplot <ButtonPress-1> {bindCmd A B}
    lassign [pix $p 4 6] px py
    event generate .c <Motion> -x [expr {round($px)}] -y [expr {round($py)}]
    event generate .c <ButtonPress-1> -x [expr {round($px)}] -y [expr {round($py)}]
    event generate .c <ButtonRelease-1> -x [expr {round($px)}] -y [expr {round($py)}]
    update
    lassign $::bindResult xy args
    list [expr {abs([lindex $xy 0]-4) < 0.2 && abs([lindex $xy 1]-6) < 0.2}] $args
} -cleanup {
    cleanupPlot
    rename bindCmd {}
    unset ::bindResult
    restoreRoot
} -result {1 {A B}}

test Plotchart-114.2 {bindlast: command near the last point} -setup {
    wm deiconify .
    mkCanvas
    pack .c
    update
    set ::bindResult {}
    proc bindCmd {x y args} {
	lappend ::bindResult [R [list $x $y] 1] $args
    }
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p plot s1 2 3
    $p bindlast s1 <ButtonPress-1> {bindCmd first}
    $p plot s1 7 8
    $p bindlast s1 <ButtonPress-1> {bindCmd second}
    foreach {x y} {2 3 7 8} {
	lassign [pix $p $x $y] px py
	event generate .c <Motion> -x [expr {round($px)+2}] -y [expr {round($py)-2}]
	event generate .c <ButtonPress-1> -x [expr {round($px)+2}] -y [expr {round($py)-2}]
	event generate .c <ButtonRelease-1> -x [expr {round($px)+2}] -y [expr {round($py)-2}]
	update
    }
    set ::bindResult
} -cleanup {
    cleanupPlot
    rename bindCmd {}
    unset ::bindResult
    restoreRoot
} -result {{2.0 3.0} first {7.0 8.0} second}

test Plotchart-114.3 {bindplot: wrong # args} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p bindplot <ButtonPress-1>
} -cleanup {
    cleanupPlot
} -returnCodes error -result {wrong # args: should be "BindPlot w event cmd"}

test Plotchart-114.4 {bindlast: wrong # args} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p bindlast s1 <ButtonPress-1>
} -cleanup {
    cleanupPlot
} -returnCodes error -result {wrong # args: should be "BindLast w series event cmd"}

# -------------------------------------------------------------------------
# plotconfig

test Plotchart-115.1 {plotconfig: list of chart types} -body {
    lsort [::Plotchart::plotconfig]
} -result [lsort {
    xyplot xlogyplot logxyplot logxlogyplot piechart spiralpie polarplot
    histogram horizbars vertbars ganttchart timechart stripchart isometric
    3dplot 3dbars radialchart txplot 3dribbon boxplot windrose
    targetdiagram performance table ternary distnormal taylordiagram
    heatmap circleplot dendrogram}]

test Plotchart-115.2 {plotconfig: the documented configuration types} -body {
    # Each creation command mentions its configuration type
    set types [::Plotchart::plotconfig]
    set missing {}
    foreach t {xyplot stripchart txplot xlogyplot logxyplot logxlogyplot
	       polarplot isometric histogram piechart spiralpie radialchart
	       vertbars horizbars 3dbars 3dribbon boxplot timechart
	       ganttchart ternary} {
	if {$t ni $types} {lappend missing $t}
    }
    set missing
} -result {}

test Plotchart-115.3 {plotconfig: list of components} -body {
    ::Plotchart::plotconfig xyplot
} -result {title subtitle margin text legend leftaxis rightaxis bottomaxis background mask}

test Plotchart-115.4 {plotconfig: list of properties} -body {
    list [::Plotchart::plotconfig xyplot margin] [::Plotchart::plotconfig xyplot background] \
	[::Plotchart::plotconfig xyplot legend] [::Plotchart::plotconfig xyplot mask] \
	[::Plotchart::plotconfig xyplot title] [::Plotchart::plotconfig piechart slice] \
	[::Plotchart::plotconfig vertbars bar]
} -result {{left right top bottom} {outercolor innercolor} {background border position} draw {textcolor font anchor background} {outlinewidth outline startangle direction} {barwidth innermargin outline}}

test Plotchart-115.5 {plotconfig: documented axis properties} -body {
    set props [::Plotchart::plotconfig xyplot leftaxis]
    set missing {}
    foreach p {color thickness ticklength font format textcolor labeloffset
	       minorticks shownumbers showaxle} {
	if {$p ni $props} {lappend missing $p}
    }
    list $missing [::Plotchart::plotconfig polarplot axis color] \
	[::Plotchart::plotconfig xyplot leftaxis ticklength]
} -result {{} gray 3}

test Plotchart-115.6 {plotconfig: query, set, default and none} -body {
    set r [list [::Plotchart::plotconfig xyplot leftaxis color]]
    ::Plotchart::plotconfig xyplot leftaxis color red
    lappend r [::Plotchart::plotconfig xyplot leftaxis color]
    ::Plotchart::plotconfig xyplot leftaxis color none
    lappend r [::Plotchart::plotconfig xyplot leftaxis color]
    ::Plotchart::plotconfig xyplot leftaxis color default
    lappend r [::Plotchart::plotconfig xyplot leftaxis color]
} -cleanup {
    ::Plotchart::plotconfig xyplot leftaxis color default
} -result {black red {} black}

test Plotchart-115.7 {plotconfig: several property-value pairs at once} -body {
    ::Plotchart::plotconfig xyplot margin left 50 right 20
    list [::Plotchart::plotconfig xyplot margin left] [::Plotchart::plotconfig xyplot margin right]
} -cleanup {
    ::Plotchart::plotconfig xyplot margin left default right default
} -result {50 20}

test Plotchart-115.8 {plotconfig: only new plots are affected} -setup {
    mkCanvas
} -body {
    set p1 [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    ::Plotchart::plotconfig xyplot leftaxis textcolor red
    set p2 [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    ::Plotchart::plotconfig xyplot leftaxis textcolor default
    list [itemOption [list yaxis [$p1 canvas] type=text] -fill] \
	[itemOption [list yaxis [$p2 canvas] type=text] -fill]
} -cleanup {
    cleanupPlot
    ::Plotchart::plotconfig xyplot leftaxis textcolor default
} -result {black red}

test Plotchart-115.9 {plotconfig: margins determine the plot area} -setup {
    ::Plotchart::plotconfig xyplot margin left 150 top 50 right 60 bottom 70
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    list [R [pix $p 0 10] 0] [R [pix $p 10 0] 0]
} -cleanup {
    cleanupPlot
    ::Plotchart::plotconfig xyplot margin left default top default right default bottom default
} -result {{150 50} {340 230}}

test Plotchart-115.10 {plotconfig: axis colour, thickness and number format} -setup {
    ::Plotchart::plotconfig xyplot bottomaxis color blue
    ::Plotchart::plotconfig xyplot bottomaxis thickness 3
    ::Plotchart::plotconfig xyplot bottomaxis format %.1f
    ::Plotchart::plotconfig xyplot bottomaxis textcolor green
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 5} {0 10 5}]
    set axle [lindex [items {xaxis type=line}] 0]
    list [itemOption {xaxis type=line} -fill] [.c itemcget $axle -width] [itemTexts xaxis] \
	[itemOption {xaxis type=text} -fill]
} -cleanup {
    cleanupPlot
    foreach prop {color thickness format textcolor} {
	::Plotchart::plotconfig xyplot bottomaxis $prop default
    }
} -result {blue 3.0 {0.0 5.0 10.0} green}

test Plotchart-115.11 {plotconfig: shownumbers, showaxle and minorticks} -setup {
    ::Plotchart::plotconfig xyplot leftaxis shownumbers 0
    ::Plotchart::plotconfig xyplot bottomaxis minorticks 4
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 5} {0 10 5}]
    set r [list [itemTexts yaxis] [llength [items {xaxis type=line}]]]
    cleanupPlot
    ::Plotchart::plotconfig xyplot leftaxis shownumbers default
    ::Plotchart::plotconfig xyplot bottomaxis minorticks default
    ::Plotchart::plotconfig xyplot bottomaxis showaxle 0
    mkCanvas
    set p [::Plotchart::createXYPlot .c {0 10 5} {0 10 5}]
    lappend r [llength [items {xaxis type=line}]]
} -cleanup {
    cleanupPlot
    ::Plotchart::plotconfig xyplot leftaxis shownumbers default
    ::Plotchart::plotconfig xyplot bottomaxis minorticks default
    ::Plotchart::plotconfig xyplot bottomaxis showaxle default
} -result {{} 12 3}

test Plotchart-115.12 {plotconfig: mask draw 0} -setup {
    ::Plotchart::plotconfig xyplot mask draw 0
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 5} {0 10 5}]
    llength [items mask]
} -cleanup {
    cleanupPlot
    ::Plotchart::plotconfig xyplot mask draw default
} -result 0

test Plotchart-115.13 {plotconfig: background outercolor} -setup {
    ::Plotchart::plotconfig xyplot background outercolor lightgrey
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 5} {0 10 5}]
    $p title "Title"
    list [itemOption mask -fill] [itemOption titlebackground -fill]
} -cleanup {
    cleanupPlot
    ::Plotchart::plotconfig xyplot background outercolor default
} -result {lightgrey lightgrey}

test Plotchart-115.14 {plotconfig: title background differs from outercolor} -setup {
    ::Plotchart::plotconfig xyplot title background yellow
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 5} {0 10 5}]
    $p title "Title"
    list [itemOption mask -fill] [itemOption titlebackground -fill]
} -cleanup {
    cleanupPlot
    ::Plotchart::plotconfig xyplot title background default
} -result {white yellow}

test Plotchart-115.15 {plotconfig: text component for plaintext} -constraints {
    knownBug
} -setup {
    ::Plotchart::plotconfig xyplot text textcolor red
    ::Plotchart::plotconfig xyplot text font {Courier 12}
    mkCanvas
} -body {
    # The text component is not used by plaintext
    set p [::Plotchart::createXYPlot .c {0 10 5} {0 10 5}]
    $p plaintext 5 5 "Text"
    list [itemOption PlainText -fill] [itemOption PlainText -font]
} -cleanup {
    cleanupPlot
    ::Plotchart::plotconfig xyplot text textcolor default
    ::Plotchart::plotconfig xyplot text font default
} -result {red {{Courier 12}}}

