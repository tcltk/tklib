test Plotchart-106.3 {xconfig -ticklength: length of the tickmarks} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    set lengths {}
    foreach len {3 10} {
	$p xconfig -ticklength $len
	set tick [lindex [items xaxis] 1]
	lassign [.c coords $tick] x1 y1 x2 y2
	lappend lengths [expr {round(abs($y2-$y1))}] [.c type $tick]
    }
    set lengths
} -cleanup {
    cleanupPlot
} -result {3 line 10 line}

test Plotchart-106.4 {yconfig -ticklength: negative value points inward} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p yconfig -ticklength -5
    set x0 [lindex [pix $p 0 0] 0]
    set ticks {}
    foreach i [lrange [items {yaxis}] 1 end] {
	if {[.c type $i] eq "line"} {
	    lassign [.c coords $i] x1 y1 x2 y2
	    lappend ticks [expr {round(max($x1,$x2) - $x0)}]
	}
    }
    lsort -unique $ticks
} -cleanup {
    cleanupPlot
} -result {5}

