    knownBug
} -setup {
    mkCanvas
} -body {
    # Fails with: bad anchor "ew"
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p plaintext 5 5 "Text" north-east
    itemOption PlainText -anchor
} -cleanup {
    cleanupPlot
} -result {ne}

