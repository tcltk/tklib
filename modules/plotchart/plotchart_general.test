test Plotchart-108.7 {xticklines: too many args} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 5} {0 10 5}]
    $p xticklines red lines extra
} -cleanup {
    cleanupPlot
} -returnCodes error -result {wrong # args: should be "DrawXTicklines w ?colour? ?dash?"}

# -------------------------------------------------------------------------
# legend, removefromlegend and legendconfig

test Plotchart-109.1 {legend: entries with line, text and frame} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p dataconfig s1 -colour red
    $p dataconfig s2 -colour blue
    $p legend s1 "Series 1"
    $p legend s2 "Series 2"
    set lines {}
    foreach i [items legend] {
	if {[.c type $i] eq "line"} {lappend lines [.c itemcget $i -fill]}
    }
    set bg [items legendbg]
    list [itemTexts legend] $lines [.c type $bg] [.c itemcget $bg -fill] \
	[.c itemcget $bg -outline] [itemTexts legend_s1] [itemTexts legend_s2] \
	[expr {[llength [items legendobj]] == [llength [items legend]] + 1}]
} -cleanup {
    cleanupPlot
} -result {{{Series 1} {Series 2}} {red blue} rectangle white black {{Series 1}} {{Series 2}} 1}

test Plotchart-109.2 {legend: default position top-right inside the plot} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p legend s1 "Series 1"
    lassign [.c bbox legendbg] x1 y1 x2 y2
    lassign [pix $p 0 10] px1 py1
    lassign [pix $p 10 0] px2 py2
    list [approx $x2 [expr {$px2-10}] 2] [approx $y1 [expr {$py1+10}] 2] \
	[expr {$x1 > $px1}] [expr {$y2 < $py2}]
} -cleanup {
    cleanupPlot
} -result {1 1 1 1}

test Plotchart-109.3 {legend: symbols for type symbol and both} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p dataconfig s1 -type symbol -symbol circle -colour green
    $p dataconfig s2 -type both -symbol up -colour blue
    $p legend s1 "Symbols"
    $p legend s2 "Both"
    list [lsort [itemTypes legend_s1]] [lsort [itemTypes legend]] \
	[itemOption {legend_s1 notype=text} -outline]
} -cleanup {
    cleanupPlot
} -result {{oval text} {line oval polygon text} green}

test Plotchart-109.4 {legend: the same series is added only once} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p legend s1 "First"
    $p legend s1 "Again"
    itemTexts legend
} -cleanup {
    cleanupPlot
} -result {First}

test Plotchart-109.5 {legend: spacing between the entries} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p legend s1 "A"
    $p legend s2 "B" 30
    lassign [items {legend_s1 type=text}] t1
    lassign [items {legend_s2 type=text}] t2
    set d1 [expr {[lindex [.c coords $t2] 1] - [lindex [.c coords $t1] 1]}]
    $p legend s3 "C"
    lassign [items {legend_s3 type=text}] t3
    lassign [items {legend_s2 type=text}] t2
    set d2 [expr {[lindex [.c coords $t3] 1] - [lindex [.c coords $t2] 1]}]
    list [R $d1 0] [R $d2 0]
} -cleanup {
    cleanupPlot
} -result {30 30}

test Plotchart-109.6 {removefromlegend: removes the entry and redraws} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p legend s1 "A"
    $p legend s2 "B"
    $p legend s3 "C"
    $p removefromlegend s2
    list [itemTexts legend] [llength [items legendbg]]
} -cleanup {
    cleanupPlot
} -result {{A C} 1}

test Plotchart-109.7 {removefromlegend: last entry removes the frame} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p legend s1 "A"
    $p removefromlegend s1
    list [llength [items legend]] [llength [items legendbg]]
} -cleanup {
    cleanupPlot
} -result {0 0}

test Plotchart-109.8 {legendconfig -background and -border} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p legendconfig -background yellow -border red
    $p legend s1 "A"
    set r [list [itemOption legendbg -fill] [itemOption legendbg -outline]]
    $p legendconfig -background "" -border ""
    $p legend s2 "B"
    lappend r [itemOption legendbg -fill] [itemOption legendbg -outline]
} -cleanup {
    cleanupPlot
} -result {yellow red {{}} {{}}}

test Plotchart-109.9 {legendconfig -position: the four corners} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    lassign [pix $p 0 10] px1 py1
    lassign [pix $p 10 0] px2 py2
    set r {}
    foreach pos {top-left top-right bottom-left bottom-right} {
	$p legendconfig -position $pos
	$p legend s1 "Entry"
	lassign [.c bbox legendbg] x1 y1 x2 y2
	set xm [expr {($x1+$x2)/2.0 < ($px1+$px2)/2.0 ? "left" : "right"}]
	set ym [expr {($y1+$y2)/2.0 < ($py1+$py2)/2.0 ? "top" : "bottom"}]
	lappend r $ym-$xm
    }
    set r
} -cleanup {
    cleanupPlot
} -result {top-left top-right bottom-left bottom-right}

test Plotchart-109.10 {legendconfig -position: invalid value} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p legendconfig -position centre
} -cleanup {
    cleanupPlot
} -returnCodes error -result {Unknown or invalid position: centre}

test Plotchart-109.11 {legendconfig -font} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p legendconfig -font {Courier 14}
    $p legend s1 "A"
    itemOption {legend type=text} -font
} -cleanup {
    cleanupPlot
} -result {{Courier 14}}

test Plotchart-109.12 {legendconfig -legendtype rectangle and line} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p dataconfig s1 -colour red
    $p legendconfig -legendtype rectangle
    $p legend s1 "A"
    set r [list [lsort [itemTypes legend]] [itemOption {legend type=rectangle} -fill]]
    cleanupPlot
    mkCanvas
    set p [::Plotchart::createBarchart .c {A B} {0 10 2} 1]
    $p legendconfig -legendtype line
    $p legend s1 "A"
    lappend r [lsort [itemTypes legend]]
} -cleanup {
    cleanupPlot
} -result {{rectangle text} red {line text}}

test Plotchart-109.13 {legendconfig -spacing} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p legendconfig -spacing 25
    $p legend s1 "A"
    $p legend s2 "B"
    set y1 [lindex [.c coords [items {legend_s1 type=text}]] 1]
    set y2 [lindex [.c coords [items {legend_s2 type=text}]] 1]
    R [expr {$y2 - $y1}] 0
} -cleanup {
    cleanupPlot
} -result {25}

test Plotchart-109.14 {legendconfig -order} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p legend s1 "A"
    $p legend s2 "B"
    $p legend s3 "C"
    set r [list [itemTexts legend]]
    $p legendconfig -order reverse
    $p legend s1 "A"
    set y {}
    foreach t [items {legend type=text}] {
	lappend y [list [lindex [.c coords $t] 1] [.c itemcget $t -text]]
    }
    set order {}
    foreach e [lsort -real -index 0 $y] {lappend order [lindex $e 1]}
    lappend r $order
    $p legendconfig -order normal
    $p legend s1 "A"
    set y {}
    foreach t [items {legend type=text}] {
	lappend y [list [lindex [.c coords $t] 1] [.c itemcget $t -text]]
    }
    set order {}
    foreach e [lsort -real -index 0 $y] {lappend order [lindex $e 1]}
    lappend r $order
} -cleanup {
    cleanupPlot
} -result {{A B C} {C B A} {A B C}}

test Plotchart-109.15 {legendconfig -order: invalid value} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p legendconfig -order sorted
} -cleanup {
    cleanupPlot
} -returnCodes error -result {Unknown or invalid order: sorted}

test Plotchart-109.16 {legendconfig: unknown option} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p legendconfig -colour red
} -cleanup {
    cleanupPlot
} -returnCodes error -result {Unknown or invalid option: -colour (value: red)}

test Plotchart-109.17 {legendconfig -canvas: legend in another canvas} -setup {
    mkCanvas
    mkCanvas 200 200 .c2
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p legendconfig -canvas .c2
    $p legend s1 "Elsewhere"
    list [llength [items legend]] [itemTexts legend .c2] [itemTypes legendbg .c2]
} -cleanup {
    cleanupPlot
    destroy .c2
} -result {0 Elsewhere rectangle}

test Plotchart-109.18 {legend: entries for a right axis} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    set r [::Plotchart::createRightAxis $p {0 100 20}]
    $p dataconfig s1 -colour red
    $r dataconfig s1 -colour blue
    $p legend s1 "Left"
    $r legend s1 "Right"
    set lines {}
    foreach i [items legend] {
	if {[.c type $i] eq "line"} {lappend lines [.c itemcget $i -fill]}
    }
    list [itemTexts legend] $lines
} -cleanup {
    cleanupPlot
} -result {{Left Right} {red blue}}

test Plotchart-109.19 {legend: line width of the series} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p dataconfig s1 -width 3
    $p legend s1 "A"
    itemOption {legend type=line} -width
} -cleanup {
    cleanupPlot
} -result {3.0}

test Plotchart-109.20 {legend: moving with the mouse} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p legend s1 "A"
    set before [.c bbox legendbg]
    set w [$p canvas]
    ::Plotchart::LegendAnchor $w 100 100
    ::Plotchart::LegendMove $w 90 120
    ::Plotchart::LegendRelease $w
    ::Plotchart::LegendMove $w 0 0
    set after [.c bbox legendbg]
    list [expr {[lindex $after 0] - [lindex $before 0]}] \
	[expr {[lindex $after 1] - [lindex $before 1]}]
} -cleanup {
    cleanupPlot
} -result {-10 20}

test Plotchart-109.21 {legend: wrong # args} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p legend s1
} -cleanup {
    cleanupPlot
} -returnCodes error -result {wrong # args: should be "DrawLegend w series text ?spacing?"}

test Plotchart-109.22 {removefromlegend: wrong # args} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p removefromlegend
} -cleanup {
