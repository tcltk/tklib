    ::Plotchart::plotconfig xyplot leftaxis nosuchproperty
} -returnCodes error -result {Unknown property 'nosuchproperty' for this component 'leftaxis' (chart: xyplot)}

test Plotchart-115.19 {plotconfig: empty arguments} -body {
    list [expr {[::Plotchart::plotconfig {}] eq [::Plotchart::plotconfig]}] \
	[::Plotchart::plotconfig xyplot {}] \
	[::Plotchart::plotconfig xyplot margin {}]
} -result {1 {title subtitle margin text legend leftaxis rightaxis bottomaxis background mask} {left right top bottom}}

# -------------------------------------------------------------------------
# plotstyle

test Plotchart-116.1 {plotstyle: current style and names} -body {
    list [::Plotchart::plotstyle current] [::Plotchart::plotstyle names]
} -result {default default}

test Plotchart-116.2 {plotstyle: configure and load a new style} -setup {
    mkCanvas
} -body {
    ::Plotchart::plotstyle configure testStyle xyplot leftaxis color red \
	xyplot background outercolor yellow
    set r [list [::Plotchart::plotstyle names] [::Plotchart::plotstyle current] \
	       [::Plotchart::plotconfig xyplot leftaxis color]]
    ::Plotchart::plotstyle load testStyle
    lappend r [::Plotchart::plotstyle current] [::Plotchart::plotconfig xyplot leftaxis color]
    set p [::Plotchart::createXYPlot .c {0 10 5} {0 10 5}]
    lappend r [itemOption {yaxis type=line} -fill] [itemOption mask -fill]
} -cleanup {
    cleanupPlot
    ::Plotchart::plotstyle load default
    array unset ::Plotchart::style testStyle,*
    set ::Plotchart::config(styles) \
	[lsearch -all -inline -not $::Plotchart::config(styles) testStyle]
} -result {{default testStyle} default black testStyle red red yellow}

test Plotchart-116.3 {plotstyle: configure the current style changes the config} -body {
    ::Plotchart::plotstyle configure default xyplot leftaxis color blue
    ::Plotchart::plotconfig xyplot leftaxis color
} -cleanup {
    ::Plotchart::plotstyle configure default xyplot leftaxis color black
} -result {blue}

test Plotchart-116.4 {plotstyle: load the default style again} -body {
    ::Plotchart::plotstyle configure testStyle2 xyplot leftaxis color green
    ::Plotchart::plotstyle load testStyle2
    set r [::Plotchart::plotconfig xyplot leftaxis color]
    ::Plotchart::plotstyle load default
    lappend r [::Plotchart::plotconfig xyplot leftaxis color] [::Plotchart::plotstyle current]
} -cleanup {
    ::Plotchart::plotstyle load default
    array unset ::Plotchart::style testStyle2,*
    set ::Plotchart::config(styles) \
	[lsearch -all -inline -not $::Plotchart::config(styles) testStyle2]
} -result {green black default}

test Plotchart-116.5 {plotstyle: load unknown style} -body {
    ::Plotchart::plotstyle load nosuchstyle
} -returnCodes error -result {no such plotting style 'nosuchstyle'}

# -------------------------------------------------------------------------
# eraseplot

test Plotchart-117.1 {eraseplot: removes the plot command and its items} -setup {
    mkCanvas
} -body {
    set p1 [::Plotchart::createXYPlot .c {0 10 2} {0 10 2} -box {0 0 200 300}]
    set p2 [::Plotchart::createXYPlot .c {0 10 2} {0 10 2} -box {200 0 200 300}]
    $p1 title "One"
    set w1 [$p1 canvas]
    set w2 [$p2 canvas]
    ::Plotchart::eraseplot $p1
    list [llength [info commands $p1]] [llength [items $w1]] \
	[expr {[llength [items $w2]] > 0}] [llength [info commands $p2]] \
	[llength [array names ::Plotchart::scaling $w1,*]]
} -cleanup {
    cleanupPlot
} -result {0 0 1 1 0}

test Plotchart-117.2 {eraseplot: the data are removed too} -constraints {
    knownBug
} -setup {
    mkCanvas
} -body {
    # The data items do not have the tag of the plot
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p plot s1 1 1
    $p plot s1 2 2
    $p legend s1 "Series"
    ::Plotchart::eraseplot $p
    llength [.c find all]
} -cleanup {
    cleanupPlot
} -result 0

test Plotchart-117.3 {eraseplot: wrong # args} -body {
    ::Plotchart::eraseplot
} -returnCodes error -result {wrong # args: should be "::Plotchart::eraseplot p"}

# -------------------------------------------------------------------------
# plotmethod

test Plotchart-118.1 {plotmethod: new method for a chart type} -setup {
    mkCanvas
    proc doodle {p w x y} {
	$p plaintext $x $y "DOODLE"
	return [list $p $w]
    }
} -body {
    ::Plotchart::plotmethod xyplot doodle doodle
    set p [::Plotchart::createXYPlot .c {0 100 10} {0 20 5}]
    set r [$p doodle 40 10]
    list [expr {[lindex $r 0] eq $p}] [expr {[lindex $r 1] eq [$p canvas]}] \
	[itemTexts PlainText] \
	[expr {[R [.c coords [items PlainText]] 2] eq [R [pix $p 40 10] 2]}]
} -cleanup {
    cleanupPlot
    unset -nocomplain ::Plotchart::methodProc(xyplot,doodle)
    rename doodle {}
} -result {1 1 DOODLE 1}

test Plotchart-118.2 {plotmethod: only for the given chart type} -setup {
    mkCanvas
    proc doodle {p w} {}
} -body {
    ::Plotchart::plotmethod xyplot doodle doodle
    set p [::Plotchart::createHistogram .c {0 100 10} {0 20 5}]
    $p doodle
} -cleanup {
    cleanupPlot
    unset -nocomplain ::Plotchart::methodProc(xyplot,doodle)
    rename doodle {}
} -returnCodes error -result {No such method - doodle}

test Plotchart-118.3 {plotmethod: namespace-relative procedure} -setup {
    mkCanvas
    namespace eval ::plotchartTest {
	proc myMethod {p w} {return ok}
    }
} -body {
    namespace eval ::plotchartTest {
	::Plotchart::plotmethod xyplot mymethod myMethod
    }
    set p [::Plotchart::createXYPlot .c {0 100 10} {0 20 5}]
    $p mymethod
} -cleanup {
    cleanupPlot
    unset -nocomplain ::Plotchart::methodProc(xyplot,mymethod)
    namespace delete ::plotchartTest
} -result ok

test Plotchart-118.4 {plotmethod: unknown procedure} -body {
    ::Plotchart::plotmethod xyplot doodle nosuchproc
} -returnCodes error -result {No such command or procedure: nosuchproc}

# -------------------------------------------------------------------------
# plotpack

test Plotchart-119.1 {plotpack top: plots copied above each other} -setup {
    mkCanvas 300 200
    mkCanvas 300 200 .c2
    mkCanvas 400 500 .c3
} -body {
    set p1 [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p1 title "First"
    set p2 [::Plotchart::createBarchart .c2 {A B} {0 10 2} 1]
    $p2 title "Second"
    ::Plotchart::plotpack .c3 top $p1 $p2
    set t1 [lindex [.c3 find withtag {title && 00.c}] 0]
    set t2 [lindex [.c3 find withtag {title && 00.c2}] 0]
    list [expr {[llength [.c3 find all]] == [llength [.c find all]] + [llength [.c2 find all]]}] \
	[.c3 itemcget $t1 -text] [.c3 itemcget $t2 -text] \
	[R [expr {[lindex [.c3 coords $t2] 1] - [lindex [.c3 coords $t1] 1]}] 0] \
	[R [expr {[lindex [.c3 coords $t2] 0] - [lindex [.c3 coords $t1] 0]}] 0]
} -cleanup {
    cleanupPlot
    cleanupPlot .c2
    cleanupPlot .c3
} -result {1 First Second 200 0}

test Plotchart-119.2 {plotpack left: plots side by side} -setup {
    mkCanvas 300 200
    mkCanvas 200 200 .c2
    mkCanvas 600 300 .c3
} -body {
    set p1 [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p1 title "First"
    set p2 [::Plotchart::createXYPlot .c2 {0 10 2} {0 10 2}]
    $p2 title "Second"
    ::Plotchart::plotpack .c3 left $p1
    ::Plotchart::plotpack .c3 left $p2
    set t1 [lindex [.c3 find withtag {title && 00.c}] 0]
    set t2 [lindex [.c3 find withtag {title && 00.c2}] 0]
    list [R [expr {[lindex [.c3 coords $t2] 0] - [lindex [.c3 coords $t1] 0]}] 0] \
	[R [expr {[lindex [.c3 coords $t2] 1] - [lindex [.c3 coords $t1] 1]}] 0]
} -cleanup {
    cleanupPlot
    cleanupPlot .c2
    cleanupPlot .c3
} -result {250 0}

test Plotchart-119.3 {plotpack bottom: plot at the bottom} -setup {
    mkCanvas 300 200
    mkCanvas 300 500 .c3
} -body {
    set p1 [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p1 title "First"
    ::Plotchart::plotpack .c3 bottom $p1
    set t1 [lindex [.c3 find withtag {title && 00.c}] 0]
    R [expr {[lindex [.c3 coords $t1] 1] - [lindex [.c coords [items title]] 1]}] 0
} -cleanup {
    cleanupPlot
    cleanupPlot .c3
} -result {300}

test Plotchart-119.4 {plotpack right: plot at the right} -constraints {
    knownBug
} -setup {
    mkCanvas 300 200
    mkCanvas 500 300 .c3
} -body {
    # Fails with: can't read "cheight": no such variable
    set p1 [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p1 title "First"
    ::Plotchart::plotpack .c3 right $p1
    set t1 [lindex [.c3 find withtag {title && 00.c}] 0]
    R [expr {[lindex [.c3 coords $t1] 0] - [lindex [.c coords [items title]] 0]}] 0
} -cleanup {
    cleanupPlot
    cleanupPlot .c3
} -result {200}

# -------------------------------------------------------------------------
# Coordinate transformations

test Plotchart-120.1 {viewPort and worldCoordinates: reversed x-axis} -body {
    set ::Plotchart::scaling(plotchartTestW,coordSystem) 0
    ::Plotchart::viewPort plotchartTestW 10 20 110 220
    ::Plotchart::worldCoordinates plotchartTestW 100 0 0 50
    list [R [::Plotchart::coordsToPixel plotchartTestW 100 0]] \
	[R [::Plotchart::coordsToPixel plotchartTestW 0 50]] \
	[R [::Plotchart::coordsToPixel plotchartTestW 25 25]] \
	[R [::Plotchart::pixelToCoords plotchartTestW 85 120]]
} -cleanup {
    array unset ::Plotchart::scaling plotchartTestW,*
} -result {{10.0 220.0} {110.0 20.0} {85.0 120.0} {25.0 25.0}}

test Plotchart-120.2 {worldCoordinates: extremes must differ} -body {
    ::Plotchart::worldCoordinates plotchartTestW 0 0 0 10
} -cleanup {
    array unset ::Plotchart::scaling plotchartTestW,*
} -returnCodes error -result {Minimum and maximum must differ for world coordinates}

test Plotchart-120.3 {worldCoordinates: wrong # args} -body {
    ::Plotchart::worldCoordinates plotchartTestW 0 0 10
} -returnCodes error -result {wrong # args: should be "::Plotchart::worldCoordinates w xmin ymin xmax ymax"}

test Plotchart-120.4 {viewPort: wrong # args} -body {
    ::Plotchart::viewPort plotchartTestW 0 0 10
} -returnCodes error -result {wrong # args: should be "::Plotchart::viewPort w pxmin pymin pxmax pymax"}

test Plotchart-120.5 {polarCoordinates: maximum radius} -body {
    set ::Plotchart::scaling(plotchartTestW,coordSystem) 0
    ::Plotchart::viewPort plotchartTestW 0 0 200 200
    ::Plotchart::polarCoordinates plotchartTestW 10
    list [R [::Plotchart::coordsToPixel plotchartTestW 0 0]] \
	[R [::Plotchart::coordsToPixel plotchartTestW 10 10]] \
	[R [::Plotchart::coordsToPixel plotchartTestW -10 -10]]
} -cleanup {
    array unset ::Plotchart::scaling plotchartTestW,*
} -result {{100.0 100.0} {200.0 0.0} {0.0 200.0}}

test Plotchart-120.6 {polarCoordinates: radius must be positive} -body {
    ::Plotchart::polarCoordinates plotchartTestW 0
} -returnCodes error -result {Maximum radius must be positive}

test Plotchart-120.7 {polarToPixel: radius and angle in a polar plot} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createPolarplot .c {10 2}]
    set w [$p canvas]
    lassign [::Plotchart::polarToPixel $w 0 0] cx cy
    lassign [::Plotchart::polarToPixel $w 10 0] x0 y0
    lassign [::Plotchart::polarToPixel $w 10 90] x90 y90
    lassign [::Plotchart::polarToPixel $w 5 180] x180 y180
    list [approx $y0 $cy 0.01] [expr {$x0 > $cx}] [approx $x90 $cx 0.01] [expr {$y90 < $cy}] \
	[approx [expr {$cx - $x180}] [expr {($x0 - $cx)/2.0}] 0.01] \
	[expr {[R [::Plotchart::polarToPixel $w 3 30] 3] eq [R [::Plotchart::coordsToPixel $w 3 30] 3]}]
} -cleanup {
    cleanupPlot
} -result {1 1 1 1 1 1}

test Plotchart-120.8 {pixelToCoords: polar plot} -constraints {
    knownBug
} -setup {
    mkCanvas 400 400
} -body {
    # Fails with: can't read "xycrd": no such variable
    set p [::Plotchart::createPolarplot .c {10 2}]
    set w [$p canvas]
    R [::Plotchart::pixelToCoords $w {*}[::Plotchart::coordsToPixel $w 5 90]]
} -cleanup {
    cleanupPlot
} -result {5.0 90.0}

test Plotchart-120.9 {pixelToCoords: logarithmic axes} -setup {
    mkCanvas
} -body {
    set r {}
    foreach cmd {
	{::Plotchart::createLogXYPlot .c {1 1000} {0 10 2}}
	{::Plotchart::createXLogYPlot .c {0 10 2} {1 1000}}
	{::Plotchart::createLogXLogYPlot .c {1 1000} {1 1000}}
    } {
	set p [{*}$cmd]
	set w [$p canvas]
	lappend r [R [::Plotchart::pixelToCoords $w {*}[::Plotchart::coordsToPixel $w 10 10]]]
	cleanupPlot
	mkCanvas
    }
    set r
} -cleanup {
    cleanupPlot
} -result {{10.0 10.0} {10.0 10.0} {10.0 10.0}}

test Plotchart-120.10 {coordsToPixel: logarithmic x-axis} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createLogXYPlot .c {1 1000} {0 10 2}]
    set w [$p canvas]
    lassign [::Plotchart::coordsToPixel $w 1 0] x1
    lassign [::Plotchart::coordsToPixel $w 10 0] x10
    lassign [::Plotchart::coordsToPixel $w 100 0] x100
    lassign [::Plotchart::coordsToPixel $w 1000 0] x1000
    list [approx [expr {$x10-$x1}] [expr {$x100-$x10}] 0.01] \
	[approx [expr {$x1000-$x100}] [expr {$x100-$x10}] 0.01]
} -cleanup {
    cleanupPlot
} -result {1 1}

test Plotchart-120.11 {world3DCoordinates and coords3DToPixel} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::create3DPlot .c {0 10 5} {0 10 5} {0 10 5}]
    set w [$p canvas]
    lassign [::Plotchart::coords3DToPixel $w 10 0 0] xa ya
    lassign [::Plotchart::coords3DToPixel $w 10 10 0] xb yb
    lassign [::Plotchart::coords3DToPixel $w 10 0 10] xc yc
    lassign [::Plotchart::coords3DToPixel $w 0 0 0] xd yd
    # y goes to the right, z goes up, x goes into the screen
    list [expr {$xb > $xa}] [approx $yb $ya 0.01] [expr {$yc < $ya}] [approx $xc $xa 0.01] \
	[expr {$xd < $xa}] [expr {$yd > $ya}]
} -cleanup {
    cleanupPlot
} -result {1 1 1 1 1 1}

test Plotchart-120.12 {world3DCoordinates: extremes must differ} -body {
    ::Plotchart::world3DCoordinates plotchartTestW 0 0 0 1 1 0
} -cleanup {
    array unset ::Plotchart::scaling plotchartTestW,*
} -returnCodes error -result {Minimum and maximum must differ for world coordinates}

test Plotchart-120.13 {pixelToIndex: segment of a piechart} -setup {
    mkCanvas 400 400
} -body {
    set p [::Plotchart::createPiechart .c]
    $p plot {A 1 B 1 C 2}
    set w [$p canvas]
    lassign [.c bbox segment_0] x1 y1 x2 y2
    set r {}
    foreach seg {0 1 2} {
	lassign [centre segment_$seg] x y
	# Move from the bounding box centre a bit towards the arc
	lappend r [::Plotchart::pixelToIndex $w $x $y]
    }
    lappend r [::Plotchart::pixelToIndex $w 0 0]
} -cleanup {
    cleanupPlot
} -result {0 1 2 -1}

test Plotchart-120.14 {determineScale: nice numbers} -body {
    list [::Plotchart::determineScale 0.1 9.8] [::Plotchart::determineScale 0.1 9.8 1] \
	[::Plotchart::determineScale -3 17]
} -result {{0.0 10.0 2.0} {10.0 0.0 -2.0} {-10.0 20.0 10.0}}

test Plotchart-120.15 {determineScale: wrong # args} -body {
    ::Plotchart::determineScale 1
} -returnCodes error -result {wrong # args: should be "::Plotchart::determineScale xmin xmax ?inverted?"}

test Plotchart-120.16 {determineScaleFromList: missing values and inverted} -body {
    list [::Plotchart::determineScaleFromList {1 {} 3.5 9.8 {} 2}] \
	[::Plotchart::determineScaleFromList {1 {} 3.5 9.8 {} 2} 1]
} -result {{0.0 10.0 2.0} {10.0 0.0 -2.0}}

test Plotchart-120.17 {determineScaleFromList: wrong # args} -body {
    ::Plotchart::determineScaleFromList
} -returnCodes error -result {wrong # args: should be "::Plotchart::determineScaleFromList values ?inverted?"}

# -------------------------------------------------------------------------
# rescale (zooming in)

test Plotchart-121.1 {rescale: new axes, data scaled and moved} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p plot s1 2 2
    $p plot s1 4 6
    $p rescale {0 5 1} {0 10 2}
    set line [items data_s1]
    list [itemTexts xaxis] [itemTexts yaxis] \
	[expr {[R [.c coords $line] 0] eq [R [concat [pix $p 2 2] [pix $p 4 6]] 0]}]
} -cleanup {
    cleanupPlot
} -result {{0 1 2 3 4 5} {0 2 4 6 8 10} 1}

test Plotchart-121.2 {rescale: step size can not be zero} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p rescale {0 5 0} {0 10 2}
} -cleanup {
    cleanupPlot
} -returnCodes error -result {Step size can not be zero}

# -------------------------------------------------------------------------
# -box and -axesbox

test Plotchart-122.1 {-box: plot in a part of the canvas} -setup {
    mkCanvas 600 300
} -body {
    set p1 [::Plotchart::createXYPlot .c {0 10 2} {0 10 2} -box {0 0 300 300}]
    set p2 [::Plotchart::createXYPlot .c {0 10 2} {0 10 2} -box {300 0 300 300}]
    lassign [pix $p1 0 0] x1a y1a
    lassign [pix $p1 10 10] x1b y1b
    lassign [pix $p2 0 0] x2a y2a
    lassign [pix $p2 10 10] x2b y2b
    list [R [expr {$x2a - $x1a}] 0] [R [expr {$x2b - $x1b}] 0] [R [expr {$y2a - $y1a}] 0] \
	[expr {$x1b < 300}] [expr {$x2b < 600}]
} -cleanup {
    cleanupPlot
} -result {300 300 0 1 1}

test Plotchart-122.2 {-box: titles per plot} -setup {
    mkCanvas 600 300
} -body {
    set p1 [::Plotchart::createXYPlot .c {0 10 2} {0 10 2} -box {0 0 300 300}]
    set p2 [::Plotchart::createXYPlot .c {0 10 2} {0 10 2} -box {300 0 300 300}]
    $p1 title "Left plot"
    $p2 title "Right plot"
    list [itemTexts [list title [$p1 canvas]]] [R [lindex [.c coords [items [list title [$p1 canvas]]]] 0] 0] \
	[itemTexts [list title [$p2 canvas]]] [R [lindex [.c coords [items [list title [$p2 canvas]]]] 0] 0]
} -cleanup {
    cleanupPlot
} -result {{{Left plot}} 150 {{Right plot}} 450}

test Plotchart-122.3 {-axesbox: axes aligned with another plot} -setup {
    mkCanvas 600 400
} -body {
    set p1 [::Plotchart::createXYPlot .c {0 10 2} {0 10 2} -box {0 0 300 400}]
    set p2 [::Plotchart::createXYPlot .c {0 10 1} {-5 5 2.5} -axesbox [list $p1 ne 0 0 200 200]]
    lassign [pix $p1 10 10] nex ney
    lassign [pix $p2 0 5] x2a y2a
    lassign [pix $p2 10 -5] x2b y2b
    list [R [list $x2a $y2a] 0] [R [list $nex $ney] 0] [R [list [expr {$x2b-$x2a}] [expr {$y2b-$y2a}]] 0]
} -cleanup {
    cleanupPlot
} -match glob -result {{* *} {* *} {200 200}}

test Plotchart-122.4 {-axesbox: anchored at the north-east corner} -setup {
    mkCanvas 600 400
} -body {
    set p1 [::Plotchart::createXYPlot .c {0 10 2} {0 10 2} -box {0 0 300 400}]
    set p2 [::Plotchart::createXYPlot .c {0 10 1} {-5 5 2.5} -axesbox [list $p1 ne 0 0 200 200]]
    expr {[R [pix $p2 0 5] 0] eq [R [pix $p1 10 10] 0]}
} -cleanup {
    cleanupPlot
} -result 1

test Plotchart-122.5 {-axesbox: offset and other anchors} -setup {
    mkCanvas 600 600
} -body {
    set p1 [::Plotchart::createXYPlot .c {0 10 2} {0 10 2} -box {0 0 300 300}]
    set r {}
    foreach {anchor xref yref} {nw 0 10  sw 0 0  se 10 0} {
	set p2 [::Plotchart::createXYPlot .c {0 10 1} {0 10 1} -axesbox [list $p1 $anchor 20 10 100 100]]
	lassign [pix $p1 $xref $yref] ax ay
	lassign [pix $p2 0 10] bx by
	lappend r [R [list [expr {$bx - $ax}] [expr {$by - $ay}]] 0]
    }
    set r
} -cleanup {
    cleanupPlot
} -result {{20 -10} {20 -10} {20 -10}}

# -------------------------------------------------------------------------
# Missing values

test Plotchart-123.1 {missing values: gap in the line of an XY plot} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0.0 100.0 10.0} {0.0 100.0 20.0}]
    foreach {x y} {0.0 32.0 10.0 {} 25.0 60.0 78.0 11.0} {
	$p plot series1 $x $y
    }
    set lines [items data_series1]
    list [llength $lines] [R [.c coords [lindex $lines 0]] 1] \
	[R [concat [pix $p 25 60] [pix $p 78 11]] 1]
} -cleanup {
    cleanupPlot
} -match glob -result {1 * *}

test Plotchart-123.2 {missing values: line resumes after the gap} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0.0 100.0 10.0} {0.0 100.0 20.0}]
    foreach {x y} {0.0 32.0 10.0 {} 25.0 60.0 78.0 11.0} {
	$p plot series1 $x $y
    }
    set line [items data_series1]
    expr {[R [.c coords $line] 1] eq [R [concat [pix $p 25 60] [pix $p 78 11]] 1]}
} -cleanup {
    cleanupPlot
} -result 1

test Plotchart-123.3 {missing values: zero in a barchart} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createBarchart .c {A B C} {0 10 2} 1]
    $p plot s1 {4 {} 6} red
    set h {}
    foreach bar [items data_s1] {
	lassign [.c coords $bar] x1 y1 x2 y2
	lappend h [R [expr {abs($y2-$y1)}] 0]
    }
    list [llength $h] [lindex $h 1]
} -cleanup {
    cleanupPlot
} -result {3 0}

# -------------------------------------------------------------------------
# Several plots in one canvas

test Plotchart-124.1 {several plots: independent items and names} -setup {
    mkCanvas 600 300
} -body {
    set p1 [::Plotchart::createXYPlot .c {0 10 2} {0 10 2} -box {0 0 300 300}]
    set p2 [::Plotchart::createBarchart .c {A B} {0 10 2} 1 -box {300 0 300 300}]
    list [expr {$p1 ne $p2}] [expr {[$p1 canvas] ne [$p2 canvas]}] \
	[llength [items [list xaxis [$p1 canvas]]]] [expr {[llength [items [list xaxis [$p2 canvas]]]] > 0}]
} -cleanup {
    cleanupPlot
} -match glob -result {1 1 [1-9]* 1}

test Plotchart-124.2 {clearcanvas: start afresh} -setup {
    mkCanvas
} -body {
    set p1 [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    ::Plotchart::clearcanvas .c
    set p2 [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    list [expr {$p1 eq $p2}] [llength [items {xaxis type=text}]]
} -cleanup {
    cleanupPlot
} -result {1 6}

# -------------------------------------------------------------------------
interp bgerror {} $::oldBgError
restoreRoot
test Plotchart-199.1 {no background errors} -body {
    set ::bgErrors
} -result {}
file delete -force $tmpDir
::tcltest::cleanupTests
