# -*- tcl -*-
# plotchart_general.test --
#
#	Tests for the Plotchart package: the methods common to all (or
#	most) plot types (title, subtitle, canvas, saveplot, axis texts,
#	axis configuration, background, ticklines, legend, balloon and
#	plain text annotations, objects, deletedata, interactive bindings),
#	and the general commands plotconfig, plotstyle, eraseplot,
#	plotmethod, plotpack, the coordinate transformations and the
#	-box and -axesbox options.
#
# The output of Plotchart is drawn on a canvas, so the tests check the
# canvas items (types, tags, coordinates relative to each other, colours
# and texts), not pixels.
#
# The tests in this file are numbered Plotchart-101.M to Plotchart-199.M
# (plotchart.test uses the numbers below 100).

if {![package vsatisfies [package provide Tcl] 8.5-]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring Tcl 8.5, have [package present Tcl]"
    return
}

if {[catch { package require Tk 8.5- } msg]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring Tk 8.5, $msg"
    return
}

if {[lsearch [namespace children] ::tcltest] == -1} {
    package require tcltest 2.2
    namespace import ::tcltest::*
}

::tcltest::testConstraint tk 1

source [file join [file dirname [file normalize [info script]]] plotchart.tcl]

# -------------------------------------------------------------------------
# Helpers
#
# Plotchart keeps its state in namespace arrays keyed by the name of the
# canvas (or of its per-plot alias, "00.c", "01.c", ...).  The canvases
# are normally not mapped, so that the size of the plot is determined by
# the -width and -height options only.

# Collect background errors instead of showing a dialog
set ::bgErrors {}
proc ::testBgError {msg opts} {
    lappend ::bgErrors $msg
}
set ::oldBgError [interp bgerror {}]
interp bgerror {} ::testBgError

set ::oldRootState [wm state .]

proc mkCanvas {{width 400} {height 300} {c .c}} {
    canvas $c -width $width -height $height -background white \
	-highlightthickness 0 -borderwidth 0
    return $c
}

proc cleanupPlot {{c .c}} {
    if {[winfo exists $c]} {
	::Plotchart::clearcanvas $c
	destroy $c
    }
    set pat [string map {. \\.} $c]
    foreach a [interp aliases {}] {
	if {[regexp "^(.+_)?r?\[0-9\]\[0-9\]$pat\$" $a] ||
	    [regexp "^\[a-z0-9\]+_$pat\$" $a]} {
	    interp alias {} $a {}
	}
    }
    foreach v {scaling config data_series legend settings packing} {
	if {[info exists ::Plotchart::$v]} {
	    array unset ::Plotchart::$v *$c,*
	}
    }
}

# Return the item ids having all given tags, in display order.
# An element "type=T" selects only items of type T, "notype=T" excludes
# items of type T.
proc items {tags {c .c}} {
    set t {}
    set type {}
    set notype {}
    foreach x $tags {
	if {[string match type=* $x]} {
	    set type [string range $x 5 end]
	} elseif {[string match notype=* $x]} {
	    set notype [string range $x 7 end]
	} else {
	    lappend t $x
	}
    }
    set ids {}
    foreach i [$c find withtag [join $t " && "]] {
	if {($type eq "" || [$c type $i] eq $type) &&
	    ($notype eq "" || [$c type $i] ne $notype)} {
	    lappend ids $i
	}
    }
    return $ids
}

# Return the types of the items having all given tags, sorted and unique
proc itemTypes {tags {c .c}} {
    set types {}
    foreach i [items $tags $c] {
	lappend types [$c type $i]
    }
    lsort -unique $types
}

# Return the texts of the text items having all given tags
proc itemTexts {tags {c .c}} {
    set texts {}
    foreach i [items $tags $c] {
	if {[$c type $i] eq "text"} {
	    lappend texts [$c itemcget $i -text]
	}
    }
    return $texts
}

# Return the given option for all items having the given tags (unique)
proc itemOption {tags option {c .c}} {
    set values {}
    foreach i [items $tags $c] {
	lappend values [$c itemcget $i $option]
    }
    lsort -unique $values
}

# Round the numbers in a list to the given number of decimals
proc R {value {digits 1}} {
    set r {}
    foreach v $value {
	if {[string is double -strict $v]} {
	    set v [format %.${digits}f $v]
	    if {$v == 0} {set v [format %.${digits}f 0]}
	}
	lappend r $v
    }
    return $r
}

# Centre of the bounding box of the items with the given tags
proc centre {tags {c .c}} {
    lassign [$c bbox [join $tags " && "]] x1 y1 x2 y2
    list [expr {($x1+$x2)/2.0}] [expr {($y1+$y2)/2.0}]
}

# Pixel coordinates of a world point in the given plot
proc pix {p x y} {
    ::Plotchart::coordsToPixel [$p canvas] $x $y
}

proc approx {a b {eps 1.0}} {
    expr {abs($a-$b) <= $eps}
}

proc restoreRoot {} {
    if {$::oldRootState eq "withdrawn"} {
	wm withdraw .
    }
}

::tcltest::testConstraint normalplot \
    [llength [info commands ::Plotchart::createNormalPlot]]
::tcltest::testConstraint img [expr {![catch {package require Img}]}]

# One creation command for each type of plot, using the names of the
# commands as they are implemented.
# Private directory for the files written by saveplot
set tmpDir [makeDirectory plotchart_general_tmp]

set allPlots {
    xyplot          {::Plotchart::createXYPlot .c {0 10 2} {0 10 2}}
    stripchart      {::Plotchart::createStripchart .c {0 10 2} {0 10 2}}
    txplot          {::Plotchart::createTXPlot .c {2006-01-01 2006-01-11 2} {0 10 2}}
    xlogyplot       {::Plotchart::createXLogYPlot .c {0 10 2} {1 1000}}
    logxyplot       {::Plotchart::createLogXYPlot .c {1 1000} {0 10 2}}
    logxlogyplot    {::Plotchart::createLogXLogYPlot .c {1 1000} {1 1000}}
    polarplot       {::Plotchart::createPolarplot .c {10 2}}
    windrose        {::Plotchart::createWindRose .c {10 2} 8}
    isometric       {::Plotchart::createIsometricPlot .c {0 10} {0 10} 2}
    histogram       {::Plotchart::createHistogram .c {0 10 2} {0 10 2}}
    3dplot          {::Plotchart::create3DPlot .c {0 10 2} {0 10 2} {0 10 2}}
    3dribbonplot    {::Plotchart::create3DRibbonPlot .c {0 10 2} {0 10 2}}
    piechart        {::Plotchart::createPiechart .c}
    spiralpie       {::Plotchart::createSpiralPie .c}
    radialchart     {::Plotchart::createRadialchart .c {A B C} 10}
    barchart        {::Plotchart::createBarchart .c {A B C} {0 10 2} 2}
    hbarchart       {::Plotchart::createHorizontalBarchart .c {0 10 2} {A B C} 2}
    3dbarchart      {::Plotchart::create3DBarchart .c {0 10 2} 3}
    3dribbonchart   {::Plotchart::create3DRibbonChart .c {A B} {0 10 2} {0 10 2}}
    boxplot         {::Plotchart::createBoxplot .c {0 10 2} {A B}}
    timechart       {::Plotchart::createTimechart .c "1 january 2004" "31 december 2004" 4}
    ganttchart      {::Plotchart::createGanttchart .c "1 january 2004" "31 december 2004" 4}
    table           {::Plotchart::createTableChart .c {A B C}}
    ternary         {::Plotchart::createTernaryDiagram .c}
    normalplot      {::Plotchart::createNormalPlot .c {-3 3 1}}
    statustimeline  {::Plotchart::createStatusTimeline .c {0 10 2} {A B}}
    dendrogram      {::Plotchart::createDendrogram .c}
    targetdiagram   {::Plotchart::createTargetDiagram .c {0.5 1.0}}
    performance     {::Plotchart::createPerformanceProfile .c 10}
    taylordiagram   {::Plotchart::createTaylorDiagram .c {1.0 0.2}}
    heatmap         {::Plotchart::createHeatmap .c {r1 r2} {c1 c2}}
    circleplot      {::Plotchart::createCirclePlot .c {a b c}}
}

# Plot types for which a documented general method is missing
# (the documentation lists title, subtitle, canvas and saveplot as
# "general subcommands for all types of charts")
set missingMethods {
    subtitle {heatmap dendrogram}
    canvas   {normalplot heatmap circleplot dendrogram}
    saveplot {table normalplot heatmap circleplot dendrogram}
}

proc constraintsFor {type method} {
    set c {}
    if {$type eq "normalplot"} {
	lappend c normalplot
    }
    if {[dict exists $::missingMethods $method] &&
	    [lsearch [dict get $::missingMethods $method] $type] >= 0} {
	lappend c knownBug
    }
    return $c
}

# -------------------------------------------------------------------------
# title

set n 0
foreach {type cmd} $allPlots {
    incr n
    test Plotchart-101.$n "title method for $type" \
	-constraints [constraintsFor $type title] -setup {
	mkCanvas
    } -body [string map [list @CMD@ $cmd] {
	set p [@CMD@]
	$p title "Chart title"
	list [itemTypes title] [itemTexts title]
    }] -cleanup {
	cleanupPlot
    } -result {text {{Chart title}}}
}

test Plotchart-101.100 {title: default position is centre, anchor n} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p title "Centre"
    set i [items title]
    list [.c itemcget $i -anchor] [.c coords $i] [items title_n]
} -cleanup {
    cleanupPlot
} -match glob -result {n {200.0 *} [0-9]*}

test Plotchart-101.101 {title: positions left and right} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p title "Left" left
    $p title "Right" right
    set l [items title_nw]
    set r [items title_ne]
    list [.c itemcget $l -text] [.c itemcget $l -anchor] \
	[expr {[lindex [.c coords $l] 0] < 10}] \
	[.c itemcget $r -text] [.c itemcget $r -anchor] \
	[expr {[lindex [.c coords $r] 0] > 390}]
} -cleanup {
    cleanupPlot
} -result {Left nw 1 Right ne 1}

test Plotchart-101.102 {title: multiple titles with different positions} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p title "Centre"
    $p title "Left" left
    $p title "Right" right
    lsort [itemTexts title]
} -cleanup {
    cleanupPlot
} -result {Centre Left Right}

test Plotchart-101.103 {title: a new title replaces the one at the same position} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p title "First"
    $p title "Second"
    itemTexts title
} -cleanup {
    cleanupPlot
} -result {Second}

test Plotchart-101.104 {title: background rectangle in the outer colour} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p title "Title"
    set bg [items titlebackground]
    lassign [.c bbox [items title]] x1 y1 x2 y2
    lassign [.c coords $bg] bx1 by1 bx2 by2
    list [.c type $bg] [.c itemcget $bg -fill] [expr {$by2 >= $y2 - 2}] \
	[R [list $bx1 $bx2] 0] \
	[expr {[lsearch [.c find all] $bg] < [lsearch [.c find all] [items title]]}]
} -cleanup {
    cleanupPlot
} -result {rectangle white 1 {0 400} 1}

test Plotchart-101.105 {title: colour and font from plotconfig} -setup {
    mkCanvas
    ::Plotchart::plotconfig xyplot title textcolor red
    ::Plotchart::plotconfig xyplot title font {Helvetica 16}
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p title "Title"
    set i [items title]
    list [.c itemcget $i -fill] [.c itemcget $i -font]
} -cleanup {
    cleanupPlot
    ::Plotchart::plotconfig xyplot title textcolor default
    ::Plotchart::plotconfig xyplot title font default
} -result {red {Helvetica 16}}

test Plotchart-101.106 {title: wrong # args} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p title
} -cleanup {
    cleanupPlot
} -returnCodes error -result {wrong # args: should be "DrawTitle w title ?position?"}

test Plotchart-101.107 {title: too many args} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p title a left b
} -cleanup {
    cleanupPlot
} -returnCodes error -result {wrong # args: should be "DrawTitle w title ?position?"}

test Plotchart-101.108 {unknown method} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p nosuchmethod 1 2
} -cleanup {
    cleanupPlot
} -returnCodes error -result {No such method - nosuchmethod}

test Plotchart-101.109 {title: title and plot items share the plot tag} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p title "Title"
    expr {[$p canvas] in [.c gettags [items title]]}
} -cleanup {
    cleanupPlot
} -result 1

# -------------------------------------------------------------------------
# subtitle

set n 0
foreach {type cmd} $allPlots {
    incr n
    test Plotchart-102.$n "subtitle method for $type" \
	-constraints [constraintsFor $type subtitle] -setup {
	mkCanvas
    } -body [string map [list @CMD@ $cmd] {
	set p [@CMD@]
	$p title "Chart title"
	$p subtitle "Chart subtitle"
	list [itemTypes subtitle] [itemTexts subtitle]
    }] -cleanup {
	cleanupPlot
    } -result {text {{Chart subtitle}}}
}

test Plotchart-102.100 {subtitle: drawn below the title} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p title "Title"
    $p subtitle "Subtitle"
    lassign [.c bbox [items title]] tx1 ty1 tx2 ty2
    lassign [.c bbox [items subtitle]] sx1 sy1 sx2 sy2
    list [expr {$sy1 >= $ty2 - 1}] [.c itemcget [items subtitle] -anchor] \
	[R [lindex [.c coords [items subtitle]] 0] 0] \
	[itemTypes subtitlebackground]
} -cleanup {
    cleanupPlot
} -result {1 n 200 rectangle}

test Plotchart-102.101 {subtitle: without a title} -constraints {
    knownBug
} -setup {
    mkCanvas
} -body {
    # Fails with: can't read "0": no such variable
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p subtitle "Subtitle"
    itemTexts subtitle
} -cleanup {
    cleanupPlot
} -result {Subtitle}

test Plotchart-102.102 {subtitle: replaces the previous subtitle} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p title "Title"
    $p subtitle "First"
    $p subtitle "Second"
    itemTexts subtitle
} -cleanup {
    cleanupPlot
} -result {Second}

test Plotchart-102.103 {subtitle: wrong # args} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p subtitle
} -cleanup {
    cleanupPlot
} -returnCodes error -result {wrong # args: should be "DrawSubtitle w title"}

# -------------------------------------------------------------------------
# canvas

set n 0
foreach {type cmd} $allPlots {
    incr n
    test Plotchart-103.$n "canvas method for $type" \
	-constraints [constraintsFor $type canvas] -setup {
	mkCanvas
    } -body [string map [list @CMD@ $cmd] {
	set p [@CMD@]
	set w [$p canvas]
	$w cget -width
    }] -cleanup {
	cleanupPlot
    } -result 400
}

test Plotchart-103.100 {canvas: alias for each plot in the canvas} -setup {
    mkCanvas
} -body {
    set p1 [::Plotchart::createXYPlot .c {0 10 2} {0 10 2} -box {0 0 200 300}]
    set p2 [::Plotchart::createXYPlot .c {0 10 2} {0 10 2} -box {200 0 200 300}]
    set w1 [$p1 canvas]
    set w2 [$p2 canvas]
    list [expr {$w1 ne $w2}] [interp alias {} $w1] [interp alias {} $w2]
} -cleanup {
    cleanupPlot
} -result {1 .c .c}

test Plotchart-103.101 {canvas: usable for coordinate transformations} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    set w [$p canvas]
    # The corners of the plot area are at the ends of the axes
    lassign [.c coords [lindex [items {xaxis}] 0]] ax1 ay1 ax2 ay2
    list [R [::Plotchart::coordsToPixel $w 0 0] 0] [R [list $ax1 $ay1] 0] \
	[R [::Plotchart::coordsToPixel $w 10 0] 0] [R [list $ax2 $ay2] 0] \
	[R [::Plotchart::pixelToCoords $w {*}[::Plotchart::coordsToPixel $w 3 7]]]
} -cleanup {
    cleanupPlot
} -match glob -result {{* *} {* *} {* *} {* *} {3.0 7.0}}

test Plotchart-103.102 {canvas: timecharts are drawn in the canvas itself} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createTimechart .c "1 january 2004" "31 december 2004" 4]
    $p canvas
} -cleanup {
    cleanupPlot
} -result {.c}

# -------------------------------------------------------------------------
# saveplot

set n 0
foreach {type cmd} $allPlots {
    incr n
    test Plotchart-104.$n "saveplot method for $type" \
	-constraints [constraintsFor $type saveplot] -setup {
	mkCanvas
	set file [file join $tmpDir save.ps]
    } -body [string map [list @CMD@ $cmd] {
	set p [@CMD@]
	$p title "Saved"
	$p saveplot $file
	set f [open $file]
	set data [read $f 20]
	close $f
	string range $data 0 3
    }] -cleanup {
	cleanupPlot
	file delete $file
    } -result {%!PS}
}

test Plotchart-104.100 {saveplot: -plotregion window and bbox} -setup {
    mkCanvas
    set file1 [file join $tmpDir save1.ps]
    set file2 [file join $tmpDir save2.ps]
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p plot s 1 1
    $p plot s 9 9
    $p saveplot $file1 -plotregion window
    $p saveplot $file2 -plotregion bbox
    list [file size $file1] [file size $file2]
} -cleanup {
    cleanupPlot
    file delete $file1 $file2
} -match glob -result {[1-9]* [1-9]*}

test Plotchart-104.101 {saveplot: unknown option} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p saveplot [file join $tmpDir never.ps] -colour red
} -cleanup {
    cleanupPlot
} -returnCodes error -result {Unknown option: -colour - must be: -format or -plotregion}

test Plotchart-104.102 {saveplot: bad -plotregion value} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p saveplot [file join $tmpDir never.ps] -plotregion all
} -cleanup {
    cleanupPlot
    file delete [file join $tmpDir never.ps]
} -returnCodes error -result {Unknown value 'all' for -plotregion option}

test Plotchart-104.103 {saveplot: -plotregion bbox requires PostScript} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p saveplot [file join $tmpDir never.png] -format png -plotregion bbox
} -cleanup {
    cleanupPlot
} -returnCodes error -result {'-plotregion bbox' can only be used together with '-format ps'}

test Plotchart-104.104 {saveplot: wrong # args} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p saveplot
} -cleanup {
    cleanupPlot
} -returnCodes error -result {wrong # args: should be "SavePlot w filename ?arg ...?"}

test Plotchart-104.105 {saveplot: -format via the Img package} -constraints {
    img
} -setup {
    wm deiconify .
    mkCanvas 200 150
    pack .c
    update
    set file [file join $tmpDir save.png]
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p plot s 1 1
    $p plot s 9 9
    $p saveplot $file -format png
    set img [image create photo -file $file]
    set r [list [image width $img] [image height $img]]
    image delete $img
    set r
} -cleanup {
    cleanupPlot
    file delete $file
    restoreRoot
} -result {200 150}

# -------------------------------------------------------------------------
# xtext, ytext, vtext, xsubtext, ysubtext, vsubtext

test Plotchart-105.1 {xtext: centred below the x-axis} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p xtext "X axis"
    set i [items xtext]
    lassign [.c coords $i] x y
    lassign [pix $p 0 0] x0 y0
    lassign [pix $p 10 0] x1 y1
    list [.c itemcget $i -text] [.c itemcget $i -anchor] \
	[approx $x [expr {($x0+$x1)/2.0}]] [expr {$y > $y0}] \
	[expr {[lindex [.c bbox $i] 1] > [lindex [.c bbox xaxis] 1]}]
} -cleanup {
    cleanupPlot
} -result {{X axis} n 1 1 1}

test Plotchart-105.2 {xtext: replaces the previous text} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p xtext "First"
    $p xtext "Second"
    itemTexts xtext
} -cleanup {
    cleanupPlot
} -result {Second}

test Plotchart-105.3 {ytext: at the top of the y-axis} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p ytext "Y axis"
    set i [items ytext]
    lassign [.c coords $i] x y
    lassign [pix $p 0 10] x0 y0
    list [.c itemcget $i -text] [.c itemcget $i -anchor] \
	[approx $x $x0] [expr {$y < $y0}]
} -cleanup {
    cleanupPlot
} -result {{Y axis} se 1 1}

test Plotchart-105.4 {ytext: for a right axis} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    set r [::Plotchart::createRightAxis $p {0 100 20}]
    $r ytext "Right"
    set i [lindex [items ytext] end]
    lassign [.c coords $i] x y
    lassign [pix $p 10 10] x0 y0
    list [.c itemcget $i -text] [.c itemcget $i -anchor] [approx $x $x0]
} -cleanup {
    cleanupPlot
} -result {Right sw 1}

test Plotchart-105.5 {vtext: vertical text left of the y-axis} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p vtext "Vertical"
    set i [items vtext]
    lassign [.c coords $i] x y
    lassign [pix $p 0 0] x0 y0
    lassign [pix $p 0 10] x1 y1
    list [.c itemcget $i -text] [.c itemcget $i -angle] [.c itemcget $i -anchor] \
	[expr {$x < [lindex [.c bbox yaxis] 0]}] [approx $y [expr {($y0+$y1)/2.0}]]
} -cleanup {
    cleanupPlot
} -result {Vertical 90.0 s 1 1}

test Plotchart-105.6 {vtext: for a right axis} -setup {
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    set r [::Plotchart::createRightAxis $p {0 100 20}]
    $r vtext "Right vertical"
    set i [items rvtext]
    lassign [.c coords $i] x y
    list [.c itemcget $i -text] [.c itemcget $i -angle] [.c itemcget $i -anchor] \
	[expr {$x > [lindex [.c bbox raxis] 2]}]
} -cleanup {
    cleanupPlot
} -result {{Right vertical} 90.0 n 1}

test Plotchart-105.7 {xsubtext: below the x text, with usesubtext} -setup {
    ::Plotchart::plotconfig xyplot bottomaxis usesubtext 1
    ::Plotchart::plotconfig xyplot bottomaxis subtextcolor blue
    mkCanvas
} -body {
    set p [::Plotchart::createXYPlot .c {0 10 2} {0 10 2}]
    $p xtext "Main"
    $p xsubtext "Sub"
    set m [items xtext]
    set s [items xsubtext]
    list [.c itemcget $s -text] [.c itemcget $s -fill] \
	[expr {[lindex [.c coords $s] 1] > [lindex [.c coords $m] 1]}]
} -cleanup {
    cleanupPlot
    ::Plotchart::plotconfig xyplot bottomaxis usesubtext default
    ::Plotchart::plotconfig xyplot bottomaxis subtextcolor default
} -result {Sub blue 1}

