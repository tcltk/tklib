# -*- tcl -*-
# Tests for the ico package (reading and writing Windows icons)
#
# All icon, cursor, bitmap and executable files used by the tests are
# generated by the tests themselves, following the published file
# format specifications (ICO/CUR directory, BITMAPINFOHEADER DIBs with
# 32-bit aligned rows, PE resource tree).

if {![package vsatisfies [package provide Tcl] 8.5-]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring Tcl 8.5, have [package present Tcl]"
    return
}

if {[catch { package require Tk 8.5- } msg]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring Tk 8.5, $msg"
    return
}

package require tcltest 2.2
namespace import ::tcltest::*

source [file join [file dirname [file normalize [info script]]] ico.tcl]

testConstraint bwidget [expr {![catch {package require BWidget}]}]

# -------------------------------------------------------------------------
# Helpers for generating files

set icoDir [makeDirectory icotest]

# Write binary data to a file in the test directory, return its full path.
proc writeBin {name data} {
    set f [file join $::icoDir $name]
    set ch [open $f wb]
    puts -nonewline $ch $data
    close $ch
    return $f
}

proc readBin {f} {
    set ch [open $f rb]
    set data [read $ch]
    close $ch
    return $data
}

proc tmpFile {name} {
    set f [file join $::icoDir $name]
    file delete $f
    return $f
}

# Pack a string of binary digits (MSB first) into bytes, padding each row
# to a multiple of 32 bits.
proc packRow {bits} {
    set n [string length $bits]
    append bits [string repeat 0 [expr {(32 - $n % 32) % 32}]]
    binary format B* $bits
}

proc hexRGB {c} {
    scan $c "#%2x%2x%2x" r g b
    list $r $g $b
}

# Create a DIB (BITMAPINFOHEADER + palette + XOR mask + AND mask) as stored
# in ICO files and icon resources.
#   palette	list of #RRGGBB colors (bpp <= 8)
#   pixels	rows, top to bottom; palette indices for bpp <= 8, #RRGGBB
#		colors otherwise
#   mask	rows of 0/1 (1 = transparent), top to bottom; empty means
#		all opaque
proc dib {bpp palette pixels {mask {}}} {
    set h [llength $pixels]
    set w [llength [lindex $pixels 0]]
    if {![llength $mask]} {
	set mask [lrepeat $h [lrepeat $w 0]]
    }
    set pal {}
    if {$bpp <= 8} {
	for {set i 0} {$i < (1 << $bpp)} {incr i} {
	    set c [lindex $palette $i]
	    if {$c eq ""} {set c #000000}
	    lassign [hexRGB $c] r g b
	    append pal [binary format cccc $b $g $r 0]
	}
    }
    set xor {}
    set and {}
    for {set y [expr {$h - 1}]} {$y >= 0} {incr y -1} {
	set row [lindex $pixels $y]
	if {$bpp <= 8} {
	    set bits {}
	    foreach p $row {
		set b {}
		for {set k [expr {$bpp - 1}]} {$k >= 0} {incr k -1} {
		    append b [expr {($p >> $k) & 1}]
		}
		append bits $b
	    }
	    append xor [packRow $bits]
	} else {
	    set bytes {}
	    foreach p $row {
		lassign [hexRGB $p] r g b
		if {$bpp == 24} {
		    append bytes [binary format ccc $b $g $r]
		} else {
		    append bytes [binary format cccc $b $g $r 255]
		}
	    }
	    append bytes [string repeat \0 \
		[expr {(4 - [string length $bytes] % 4) % 4}]]
	    append xor $bytes
	}
	append and [packRow [join [lindex $mask $y] {}]]
    }
    set size [string length $xor$and]
    return [binary format iiissiiiiii 40 $w [expr {2 * $h}] 1 $bpp 0 $size \
		0 0 0 0]$pal$xor$and
}

# Create an ICO (type 1) or CUR (type 2) file image from a list of DIBs.
proc icoData {dibs {type 1}} {
    set n [llength $dibs]
    set dir [binary format sss 0 $type $n]
    set data {}
    set offset [expr {6 + 16 * $n}]
    foreach d $dibs {
	binary scan $d x4iix2s w h bpp
	set h [expr {$h / 2}]
	set colors [expr {$bpp <= 4 ? 1 << $bpp : 0}]
	if {$type == 1} {
	    set f1 1
	    set f2 $bpp
	} else {
	    # hotspot
	    set f1 [expr {$w / 2}]
	    set f2 [expr {$h / 2}]
	}
	append dir [binary format ccccssii [expr {$w & 255}] [expr {$h & 255}] \
			$colors 0 $f1 $f2 [string length $d] $offset]
	append data $d
	incr offset [string length $d]
    }
    return $dir$data
}

# Create a BMP file image from rows of #RRGGBB colors (24 bpp).
proc bmpData {pixels} {
    set h [llength $pixels]
    set w [llength [lindex $pixels 0]]
    set xor {}
    for {set y [expr {$h - 1}]} {$y >= 0} {incr y -1} {
	set bytes {}
	foreach p [lindex $pixels $y] {
	    lassign [hexRGB $p] r g b
	    append bytes [binary format ccc $b $g $r]
	}
	append bytes [string repeat \0 \
	    [expr {(4 - [string length $bytes] % 4) % 4}]]
	append xor $bytes
    }
    set size [string length $xor]
    return [binary format a2issi BM [expr {54 + $size}] 0 0 54][binary \
	format iiissiiiiii 40 $w $h 1 24 0 $size 0 0 0 0]$xor
}

# Create a minimal PE executable image with an icon resources section.
#   groups	list of {name memberIds}; name is an integer or a string
#   icons	list of {id dib}
proc peData {groups icons} {
    set baserva 0x1000
    set base 512
    set nI [llength $icons]
    set nG [llength $groups]
    # Layout of the resource section
    set off 32
    set iconDir $off;  incr off [expr {16 + 8 * $nI}]
    set groupDir $off; incr off [expr {16 + 8 * $nG}]
    set entries {}
    foreach r [concat $icons $groups] {
	lappend entries $off
	incr off 40
    }
    set strings {}
    set stroff {}
    foreach g $groups {
	set name [lindex $g 0]
	if {[string is integer -strict $name]} {
	    lappend stroff {}
	} else {
	    lappend stroff $off
	    set s [binary format s [string length $name]][encoding convertto unicode $name]
	    if {[string length $s] % 4} {append s \0\0}
	    append strings $s
	    incr off [string length $s]
	}
    }
    set blobs {}
    foreach i $icons {
	lappend blobs [lindex $i 1]
    }
    foreach g $groups {
	set members [lindex $g 1]
	set gd [binary format sss 0 1 [llength $members]]
	foreach id $members {
	    set d [lindex $icons [lsearch -index 0 $icons $id] 1]
	    binary scan $d x4iix2s w h bpp
	    append gd [binary format ccccssis [expr {$w & 255}] \
			   [expr {($h / 2) & 255}] 0 0 1 $bpp \
			   [string length $d] $id]
	}
	lappend blobs $gd
    }
    set blobOffs {}
    set data {}
    foreach b $blobs {
	lappend blobOffs $off
	append b [string repeat \0 [expr {(4 - [string length $b] % 4) % 4}]]
	append data $b
	incr off [string length $b]
    }
    # Build it
    set sec [binary format iissss 0 0 0 0 0 2]
    append sec [binary format ii 3 [expr {$iconDir | 0x80000000}]]
    append sec [binary format ii 14 [expr {$groupDir | 0x80000000}]]
    append sec [binary format iissss 0 0 0 0 0 $nI]
    set k 0
    foreach i $icons {
	append sec [binary format ii [lindex $i 0] \
			[expr {[lindex $entries $k] | 0x80000000}]]
	incr k
    }
    set named 0
    set gents {}
    foreach g $groups s $stroff {
	if {$s eq ""} {
	    append gents [binary format ii [lindex $g 0] \
			      [expr {[lindex $entries $k] | 0x80000000}]]
	} else {
	    incr named
	    append gents [binary format ii [expr {$s | 0x80000000}] \
			      [expr {[lindex $entries $k] | 0x80000000}]]
	}
	incr k
    }
    append sec [binary format iissss 0 0 0 0 $named [expr {$nG - $named}]]
    append sec $gents
    set k 0
    foreach b $blobs {
	set e [lindex $entries $k]
	append sec [binary format iissss 0 0 0 0 0 1]
	append sec [binary format ii 0x409 [expr {$e + 24}]]
	append sec [binary format iiii [expr {$baserva + [lindex $blobOffs $k]}] \
			[string length $b] 0 0]
	incr k
    }
    append sec $strings $data
    # Headers
    set hdr [binary format a2 MZ][string repeat \0 58][binary format i 64]
    append hdr PE\0\0 [binary format ssiiiss 0x14c 1 0 0 0 0 0x102]
    append hdr [binary format a8iiiiiissi .rsrc [string length $sec] \
		    $baserva [string length $sec] $base 0 0 0 0 0x40000040]
    append hdr [string repeat \0 [expr {$base - [string length $hdr]}]]
    return $hdr$sec
}

# Decode the image $idx of an ICO file following the specification,
# return rows of #RRGGBB colors, {} for transparent pixels.
proc decodeIco {f idx} {
    set data [readBin $f]
    binary scan $data sss r t n
    binary scan $data @[expr {6 + 16 * $idx + 12}]i off
    binary scan $data @${off}iiissii hs w h planes bpp comp size
    set h [expr {$h / 2}]
    set p [expr {$off + $hs}]
    set pal {}
    if {$bpp <= 8} {
	for {set i 0} {$i < (1 << $bpp)} {incr i} {
	    binary scan $data @${p}cucucu b g r
	    lappend pal [format #%02X%02X%02X $r $g $b]
	    incr p 4
	}
    }
    set xstride [expr {(($w * $bpp + 31) / 32) * 4}]
    set astride [expr {(($w + 31) / 32) * 4}]
    set apos [expr {$p + $xstride * $h}]
    set rows {}
    for {set y [expr {$h - 1}]} {$y >= 0} {incr y -1} {
	set rp [expr {$p + $xstride * $y}]
	binary scan $data @${rp}B[expr {$w * $bpp}] xbits
	binary scan $data @[expr {$apos + $astride * $y}]B$w abits
	set row {}
	for {set x 0} {$x < $w} {incr x} {
	    if {[string index $abits $x]} {
		lappend row {}
		continue
	    }
	    if {$bpp <= 8} {
		set v 0
		foreach bit [split [string range $xbits [expr {$x * $bpp}] \
					[expr {$x * $bpp + $bpp - 1}]] {}] {
		    set v [expr {$v * 2 + $bit}]
		}
		lappend row [lindex $pal $v]
	    } else {
		set bp [expr {$rp + $x * $bpp / 8}]
		binary scan $data @${bp}cucucu b g r
		lappend row [format #%02X%02X%02X $r $g $b]
	    }
	}
	lappend rows $row
    }
    return $rows
}

# Sample images

# 4x4 color list with 3 colors
set img4 {
    {#FF0000 #00FF00 #0000FF #FF0000}
    {#00FF00 #0000FF #FF0000 #00FF00}
    {#0000FF #FF0000 #00FF00 #0000FF}
    {#FF0000 #FF0000 #FFFFFF #000000}
}

# 4x4 color list for BMP files; all bytes are below 0x80 and are not CR
# or LF (see ico-4.23).
set bmp4 {
    {#102030 #203040 #304050 #405060}
    {#203040 #304050 #405060 #102030}
    {#304050 #405060 #102030 #203040}
    {#405060 #102030 #203040 #304050}
}

# Generate a WxH pattern of palette indices 0..n-1
proc pattern {w h n} {
    set rows {}
    for {set y 0} {$y < $h} {incr y} {
	set row {}
	for {set x 0} {$x < $w} {incr x} {
	    lappend row [expr {($x + 2 * $y) % $n}]
	}
	lappend rows $row
    }
    return $rows
}

# Mask with a transparent diagonal
proc diagMask {w h} {
    set rows {}
    for {set y 0} {$y < $h} {incr y} {
	set row {}
	for {set x 0} {$x < $w} {incr x} {
	    lappend row [expr {$x == $y}]
	}
	lappend rows $row
    }
    return $rows
}

# The colors expected from decoding pattern/mask/palette
proc expectColors {pixels palette {mask {}}} {
    set rows {}
    set y 0
    foreach row $pixels {
	set r {}
	set x 0
	foreach p $row {
	    if {[llength $mask] && [lindex $mask $y $x]} {
		lappend r {}
	    } elseif {[string match #* $p]} {
		lappend r $p
	    } else {
		lappend r [lindex $palette $p]
	    }
	    incr x
	}
	lappend rows $r
	incr y
    }
    return $rows
}

# Convert palette indices to #RRGGBB colors
proc toColors {pixels palette} {
    expectColors $pixels $palette
}

set pal16 {
    #000000 #800000 #008000 #808000 #000080 #800080 #008080 #C0C0C0
    #808080 #FF0000 #00FF00 #FFFF00 #0000FF #FF00FF #00FFFF #FFFFFF
}
set pal256 {}
for {set i 0} {$i < 256} {incr i} {
    lappend pal256 [format #%02X%02X%02X $i [expr {255 - $i}] [expr {$i / 2}]]
}
unset i

# Normalise a list of colors (rows) to a canonical list form
proc canon {rows} {
    set res {}
    foreach r $rows {
	lappend res [list {*}$r]
    }
    return $res
}

# Colors of a Tk photo image as rows, {} for transparent pixels
proc photoColors {img} {
    set rows {}
    for {set y 0} {$y < [image height $img]} {incr y} {
	set row {}
	for {set x 0} {$x < [image width $img]} {incr x} {
	    if {[$img transparency get $x $y]} {
		lappend row {}
	    } else {
		lappend row [format #%02X%02X%02X {*}[lrange [$img get $x $y] 0 2]]
	    }
	}
	lappend rows $row
    }
    return $rows
}

# A sample multi-image ICO file:
#   0: 16x16 4bpp, 1: 32x32 4bpp, 2: 32x32 8bpp, 3: 32x32 24bpp,
#   4: 48x48 32bpp
proc multiIco {} {
    icoData [list \
	[dib 4 $::pal16 [pattern 16 16 16]] \
	[dib 4 $::pal16 [pattern 32 32 16]] \
	[dib 8 $::pal256 [pattern 32 32 256]] \
	[dib 24 {} [toColors [pattern 32 32 16] $::pal16]] \
	[dib 32 {} [toColors [pattern 48 48 16] $::pal16]]]
}

# -------------------------------------------------------------------------

test ico-1.1 {package version} -body {
    package present ico
} -result 1.1.3

test ico-1.2 {exported commands} -body {
    lsort [namespace eval ::ico {namespace export}]
} -result {EXEtoICO clearCache copyIcon getIcon getIconByName iconMembers icons transparentColor writeIcon}

# -------------------------------------------------------------------------
# icons

test ico-2.1 {icons: wrong # args} -body {
    ::ico::icons
} -returnCodes error -result {wrong # args: should be "::ico::icons file ?arg ...?"}

test ico-2.2 {icons: ICO file has a single icon 0} -setup {
    set f [writeBin a.ico [multiIco]]
} -body {
    ::ico::icons $f
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f
} -result 0

test ico-2.3 {icons: missing file} -body {
    ::ico::icons [file join $icoDir nosuch.ico]
} -returnCodes error -result "couldn't open \"[file join $icoDir nosuch.ico]\": no such file or directory"

test ico-2.4 {icons: not an icon file} -setup {
    set f [writeBin bad.ico "not an icon at all"]
} -body {
    ::ico::icons $f
} -cleanup {
    file delete $f
    unset f
} -returnCodes error -result {not an icon file}

test ico-2.5 {icons: unknown extension} -setup {
    set f [writeBin a.xyz [multiIco]]
} -body {
    ::ico::icons $f
} -cleanup {
    file delete $f
    unset f
} -returnCodes error -result {unsupported file format XYZ}

test ico-2.6 {icons: no extension} -setup {
    set f [writeBin noext [multiIco]]
} -body {
    ::ico::icons $f
} -cleanup {
    file delete $f
    unset f
} -returnCodes error -result {could not determine file type from extension, use -type option}

test ico-2.7 {icons: -type overrides the extension} -setup {
    set f [writeBin noext [multiIco]]
} -body {
    ::ico::icons $f -type ICO
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f
} -result 0

test ico-2.8 {icons: extension is case insensitive} -setup {
    set f [writeBin UPPER.ICO [multiIco]]
} -body {
    ::ico::icons $f
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f
} -result 0

test ico-2.9 {icons: bad option} -setup {
    set f [writeBin a.ico [multiIco]]
} -body {
    ::ico::icons $f -format colors
} -cleanup {
    file delete $f
    unset f
} -returnCodes error -result {unknown option "format": must be one of type}

test ico-2.10 {icons: bad -type} -setup {
    set f [writeBin a.ico [multiIco]]
} -body {
    ::ico::icons $f -type GIF
} -cleanup {
    file delete $f
    unset f
} -returnCodes error -result {unsupported file format GIF}

test ico-2.11 {icons: BMP file} -setup {
    set f [writeBin a.bmp [bmpData $bmp4]]
} -body {
    ::ico::icons $f
} -cleanup {
    file delete $f
    unset f
} -result 0

test ico-2.12 {icons: not a BMP file} -setup {
    set f [writeBin a.bmp [multiIco]]
} -body {
    ::ico::icons $f
} -cleanup {
    file delete $f
    unset f
} -returnCodes error -result {not a BMP file}

# -------------------------------------------------------------------------
# iconMembers

test ico-3.1 {iconMembers: wrong # args} -body {
    ::ico::iconMembers x
} -returnCodes error -result {wrong # args: should be "::ico::iconMembers file name ?arg ...?"}

test ico-3.2 {iconMembers: ICO file} -setup {
    set f [writeBin a.ico [multiIco]]
} -body {
    ::ico::iconMembers $f 0
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f
} -result {{0 16 16 4} {1 32 32 4} {2 32 32 8} {3 32 32 24} {4 48 48 32}}

test ico-3.3 {iconMembers: 1 bpp icon} -setup {
    set f [writeBin a.ico [icoData [list \
	[dib 1 {#000000 #FFFFFF} [pattern 32 32 2]]]]]
} -body {
    ::ico::iconMembers $f 0
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f
} -result {{0 32 32 1}}

test ico-3.4 {iconMembers: unknown icon name} -setup {
    set f [writeBin a.ico [multiIco]]
} -body {
    ::ico::iconMembers $f 1
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f
} -returnCodes error -result {no icon "1"}

test ico-3.5 {iconMembers: missing file} -body {
    ::ico::iconMembers [file join $icoDir nosuch.ico] 0
} -returnCodes error -result "couldn't open \"[file join $icoDir nosuch.ico]\": no such file or directory"

test ico-3.6 {iconMembers: not an icon file} -setup {
    set f [writeBin bad.ico "MZ garbage data"]
} -body {
    ::ico::iconMembers $f 0
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f
} -returnCodes error -result {not an icon file}

test ico-3.7 {iconMembers: unsupported format} -setup {
    set f [writeBin a.png abc]
} -body {
    ::ico::iconMembers $f 0
} -cleanup {
    file delete $f
    unset f
} -returnCodes error -result {unsupported file format PNG}

test ico-3.8 {iconMembers: bad option} -setup {
    set f [writeBin a.ico [multiIco]]
} -body {
    ::ico::iconMembers $f 0 -res 16
} -cleanup {
    file delete $f
    unset f
} -returnCodes error -result {unknown option "res": must be one of type}

test ico-3.9 {iconMembers: 256x256 icon} -constraints knownBug -setup {
    # Ticket e7f1ed859e: width and height 256 are stored as 0 in the
    # directory and reported as 0.
    set f [writeBin big.ico [icoData [list \
	[dib 4 $pal16 [pattern 16 16 16]] \
	[dib 32 {} [lrepeat 256 [lrepeat 256 #102030]]]]]]
} -body {
    ::ico::iconMembers $f 0
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f
} -result {{0 16 16 4} {1 256 256 32}}

test ico-3.10 {iconMembers: BMP file} -constraints knownBug -setup {
    # The documentation promises a list of {name width height bpp}
    # sublists, but for BMP files a flat list is returned.
    set f [writeBin a.bmp [bmpData $bmp4]]
} -body {
    ::ico::iconMembers $f 0
} -cleanup {
    file delete $f
    unset f
} -result {{1 4 4 24}}

test ico-3.11 {iconMembers: BMP file, unknown icon} -setup {
    set f [writeBin a.bmp [bmpData $bmp4]]
} -body {
    ::ico::iconMembers $f 1
} -cleanup {
    file delete $f
    unset f
} -returnCodes error -result {no icon "1"}

test ico-3.12 {iconMembers: name of an image works with getIconByName} -setup {
    set f [writeBin a.ico [multiIco]]
} -body {
    set res {}
    foreach m [::ico::iconMembers $f 0] {
	lassign $m name w h bpp
	set c [::ico::getIconByName $f $name -format colors]
	lappend res [expr {[llength $c] == $h && [llength [lindex $c 0]] == $w}]
    }
    set res
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset -nocomplain f res m name w h bpp c
} -result {1 1 1 1 1}

# -------------------------------------------------------------------------
# getIconByName: decoding of all supported color depths

test ico-4.1 {getIconByName: wrong # args} -body {
    ::ico::getIconByName x
} -returnCodes error -result {wrong # args: should be "::ico::getIconByName file name ?arg ...?"}

test ico-4.2 {getIconByName: 1 bpp, 32x32} -setup {
    set pixels [pattern 32 32 2]
    set f [writeBin a.ico [icoData [list [dib 1 {#000000 #FFFF00} $pixels]]]]
} -body {
    expr {[canon [::ico::getIconByName $f 0 -format colors]] eq
	  [canon [expectColors $pixels {#000000 #FFFF00}]]}
} -cleanup {
    file delete $f
    unset f pixels
} -result 1

test ico-4.3 {getIconByName: 1 bpp, 16x16} -constraints knownBug -setup {
    # Rows of the XOR mask are 32 bit aligned; the padding of 16 pixel
    # wide 1 bpp rows is not taken into account.
    set pixels [pattern 16 16 2]
    set f [writeBin a.ico [icoData [list [dib 1 {#000000 #FFFF00} $pixels]]]]
} -body {
    expr {[canon [::ico::getIconByName $f 0 -format colors]] eq
	  [canon [expectColors $pixels {#000000 #FFFF00}]]}
} -cleanup {
    file delete $f
    unset f pixels
} -result 1

test ico-4.4 {getIconByName: 4 bpp, 16x16 and 32x32} -setup {
    set f [writeBin a.ico [multiIco]]
} -body {
    list [expr {[canon [::ico::getIconByName $f 0 -format colors]] eq
		[canon [expectColors [pattern 16 16 16] $pal16]]}] \
	[expr {[canon [::ico::getIconByName $f 1 -format colors]] eq
	       [canon [expectColors [pattern 32 32 16] $pal16]]}]
} -cleanup {
    file delete $f
    unset f
} -result {1 1}

test ico-4.5 {getIconByName: 8 bpp} -setup {
    set f [writeBin a.ico [multiIco]]
} -body {
    expr {[canon [::ico::getIconByName $f 2 -format colors]] eq
	  [canon [expectColors [pattern 32 32 256] $pal256]]}
} -cleanup {
    file delete $f
    unset f
} -result 1

test ico-4.6 {getIconByName: 24 bpp} -setup {
    set f [writeBin a.ico [multiIco]]
} -body {
    expr {[canon [::ico::getIconByName $f 3 -format colors]] eq
	  [canon [toColors [pattern 32 32 16] $pal16]]}
} -cleanup {
    file delete $f
    unset f
} -result 1

test ico-4.7 {getIconByName: 32 bpp} -setup {
    set f [writeBin a.ico [multiIco]]
} -body {
    expr {[canon [::ico::getIconByName $f 4 -format colors]] eq
	  [canon [toColors [pattern 48 48 16] $pal16]]}
} -cleanup {
    file delete $f
    unset f
} -result 1

test ico-4.8 {getIconByName: transparency from the AND mask} -setup {
    set pixels [pattern 16 16 16]
    set mask [diagMask 16 16]
    set f [writeBin a.ico [icoData [list [dib 4 $pal16 $pixels $mask]]]]
} -body {
    set c [::ico::getIconByName $f 0 -format colors]
    list [lindex $c 0 0] [lindex $c 5 5] [lindex $c 0 1] \
	[expr {[canon $c] eq [canon [expectColors $pixels $pal16 $mask]]}]
} -cleanup {
    file delete $f
    unset f pixels mask c
} -result [list {} {} [lindex $pal16 1] 1]

test ico-4.9 {getIconByName: transparency in a 24 bpp 32x32 icon} -setup {
    set pixels [toColors [pattern 32 32 16] $pal16]
    set mask [diagMask 32 32]
    set f [writeBin a.ico [icoData [list [dib 24 {} $pixels $mask]]]]
} -body {
    expr {[canon [::ico::getIconByName $f 0 -format colors]] eq
	  [canon [expectColors $pixels {} $mask]]}
} -cleanup {
    file delete $f
    unset f pixels mask
} -result 1

test ico-4.10 {getIconByName: transparency in a 24x24 icon} -setup {
    set pixels [toColors [pattern 24 24 16] $pal16]
    set mask [diagMask 24 24]
    set f [writeBin a.ico [icoData [list [dib 24 {} $pixels $mask]]]]
} -body {
    expr {[canon [::ico::getIconByName $f 0 -format colors]] eq
	  [canon [expectColors $pixels {} $mask]]}
} -cleanup {
    file delete $f
    unset f pixels mask
} -result 1

test ico-4.11 {getIconByName: transparency in an 8x8 icon} -setup {
    # Ticket 3470437fff: AND mask rows are padded to 32 bits, also for
    # widths like 8.
    set pixels [toColors [pattern 8 8 16] $pal16]
    set mask [diagMask 8 8]
    set f [writeBin a.ico [icoData [list [dib 24 {} $pixels $mask]]]]
} -body {
    expr {[canon [::ico::getIconByName $f 0 -format colors]] eq
	  [canon [expectColors $pixels {} $mask]]}
} -cleanup {
    file delete $f
    unset f pixels mask
} -result 1

test ico-4.12 {getIconByName: default format is a Tk image} -setup {
    set pixels [pattern 16 16 16]
    set mask [diagMask 16 16]
    set f [writeBin a.ico [icoData [list [dib 4 $pal16 $pixels $mask]]]]
} -body {
    set img [::ico::getIconByName $f 0]
    list [image type $img] [image width $img] [image height $img] \
	[expr {[photoColors $img] eq [canon [expectColors $pixels $pal16 $mask]]}]
} -cleanup {
    image delete $img
    file delete $f
    unset f pixels mask img
} -result {photo 16 16 1}

test ico-4.13 {getIconByName: -format image -image name} -setup {
    set f [writeBin a.ico [multiIco]]
} -body {
    set img [::ico::getIconByName $f 1 -format image -image icoTestImage]
    list $img [image width icoTestImage] [image height icoTestImage]
} -cleanup {
    image delete icoTestImage
    file delete $f
    unset f img
} -result {icoTestImage 32 32}

test ico-4.14 {getIconByName: no such image} -setup {
    set f [writeBin a.ico [multiIco]]
} -body {
    ::ico::getIconByName $f 5
} -cleanup {
    file delete $f
    unset f
} -returnCodes error -result {no icon "5"}

test ico-4.15 {getIconByName: bad image name} -setup {
    set f [writeBin a.ico [multiIco]]
} -body {
    ::ico::getIconByName $f x -format colors
} -cleanup {
    file delete $f
    unset f
} -returnCodes error -result {no icon "x"}

test ico-4.16 {getIconByName: missing file} -body {
    ::ico::getIconByName [file join $icoDir nosuch.ico] 0
} -returnCodes error -result "couldn't open \"[file join $icoDir nosuch.ico]\": no such file or directory"

test ico-4.17 {getIconByName: bad option} -setup {
    set f [writeBin a.ico [multiIco]]
} -body {
    ::ico::getIconByName $f 0 -res 16
} -cleanup {
    file delete $f
    unset f
} -returnCodes error -result {unknown option "res": must be one of type format image}

test ico-4.18 {getIconByName: unsupported format} -setup {
    set f [writeBin a.gif abc]
} -body {
    ::ico::getIconByName $f 0
} -cleanup {
    file delete $f
    unset f
} -returnCodes error -result {unsupported file format GIF}

test ico-4.19 {getIconByName: unsupported color depth} -setup {
    set d [dib 4 $pal16 [pattern 16 16 16]]
    # patch the bpp field
    set d [string replace $d 14 15 [binary format s 2]]
    set f [writeBin a.ico [icoData [list $d]]]
} -body {
    ::ico::getIconByName $f 0 -format colors
} -cleanup {
    file delete $f
    unset f d
} -returnCodes error -result {unsupported color depth: 2}

test ico-4.20 {getIconByName: cursor files are not supported} -setup {
    set pixels [toColors [pattern 32 32 16] $pal16]
    set f [writeBin a.cur [icoData [list [dib 24 {} $pixels]] 2]]
} -body {
    list [catch {::ico::getIconByName $f 0 -type ICO -format colors} msg] $msg \
	[catch {::ico::icons $f} msg] $msg
} -cleanup {
    file delete $f
    unset f pixels msg
} -result {1 {not an icon file} 1 {unsupported file format CUR}}

test ico-4.21 {getIconByName: BMP file} -setup {
    set f [writeBin a.bmp [bmpData $bmp4]]
} -body {
    canon [::ico::getIconByName $f 1 -format colors]
} -cleanup {
    file delete $f
    unset f
} -result [canon $bmp4]

test ico-4.22 {getIconByName: BMP file, unknown name} -setup {
    set f [writeBin a.bmp [bmpData $bmp4]]
} -body {
    ::ico::getIconByName $f 0 -format colors
} -cleanup {
    file delete $f
    unset f
} -returnCodes error -result {No icon "0"}

test ico-4.23 {getIconByName: BMP file with CR LF bytes in pixel data} -constraints knownBug -setup {
    # BMP files are opened in text mode, so binary data is translated.
    set pixels [lrepeat 4 [lrepeat 4 #000A0D]]
    set f [writeBin crlf.bmp [bmpData $pixels]]
} -body {
    canon [::ico::getIconByName $f 1 -format colors]
} -cleanup {
    file delete $f
    unset f pixels
} -result [canon [lrepeat 4 [lrepeat 4 #000A0D]]]

# -------------------------------------------------------------------------
# getIcon

test ico-5.1 {getIcon: wrong # args} -body {
    ::ico::getIcon x
} -returnCodes error -result {wrong # args: should be "::ico::getIcon file name ?arg ...?"}

test ico-5.2 {getIcon: default is the first image as a Tk image} -setup {
    set f [writeBin a.ico [multiIco]]
} -body {
    set img [::ico::getIcon $f 0]
    list [image type $img] [image width $img] [image height $img] \
	[expr {[photoColors $img] eq [canon [expectColors [pattern 16 16 16] $pal16]]}]
} -cleanup {
    image delete $img
    ::ico::clearCache
    file delete $f
    unset f img
} -result {photo 16 16 1}

test ico-5.3 {getIcon: -image} -setup {
    set f [writeBin a.ico [multiIco]]
} -body {
    set img [::ico::getIcon $f 0 -image icoTestImage]
    list $img [image width icoTestImage]
} -cleanup {
    image delete icoTestImage
    ::ico::clearCache
    file delete $f
    unset f img
} -result {icoTestImage 16}

test ico-5.4 {getIcon: -format colors} -setup {
    set f [writeBin a.ico [multiIco]]
} -body {
    expr {[canon [::ico::getIcon $f 0 -format colors]] eq
	  [canon [expectColors [pattern 16 16 16] $pal16]]}
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f
} -result 1

test ico-5.5 {getIcon: -format name} -setup {
    set f [writeBin a.ico [multiIco]]
} -body {
    ::ico::getIcon $f 0 -format name
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f
} -result 0

test ico-5.6 {getIcon: -res selects the resolution, best depth <= 24} -setup {
    set f [writeBin a.ico [multiIco]]
} -body {
    list [::ico::getIcon $f 0 -res 16 -format name] \
	[::ico::getIcon $f 0 -res 32 -format name] \
	[::ico::getIcon $f 0 -res 48 -format name]
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f
} -result {0 3 4}

test ico-5.7 {getIcon: -res and -bpp} -setup {
    set f [writeBin a.ico [multiIco]]
} -body {
    list [::ico::getIcon $f 0 -res 32 -bpp 4 -format name] \
	[::ico::getIcon $f 0 -res 32 -bpp 8 -format name] \
	[::ico::getIcon $f 0 -res 32 -bpp 6 -format name] \
	[::ico::getIcon $f 0 -res 32 -bpp 32 -format name] \
	[::ico::getIcon $f 0 -res 32 -bpp 1 -format name]
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f
} -result {1 2 1 3 1}

test ico-5.8 {getIcon: unavailable resolution selects the largest} -setup {
    set f [writeBin a.ico [multiIco]]
} -body {
    list [::ico::getIcon $f 0 -res 64 -format name] \
	[::ico::getIcon $f 0 -res 20 -format name]
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f
} -result {4 4}

test ico-5.9 {getIcon: -exact} -setup {
    set f [writeBin a.ico [multiIco]]
} -body {
    list [::ico::getIcon $f 0 -res 32 -bpp 8 -exact 1 -format name] \
	[::ico::getIcon $f 0 -res 16 -bpp 4 -exact 1 -format name] \
	[::ico::getIcon $f 0 -res 48 -bpp 32 -exact 1 -format name] \
	[::ico::getIcon $f 0 -res {32 32} -bpp 24 -exact 1 -format name]
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f
} -result {2 0 4 3}

test ico-5.10 {getIcon: -exact without a match} -setup {
    set f [writeBin a.ico [multiIco]]
} -body {
    ::ico::getIcon $f 0 -res 32 -bpp 1 -exact 1
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f
} -returnCodes error -result {No matching icon}

test ico-5.11 {getIcon: -exact with the default depth 24} -setup {
    set f [writeBin a.ico [multiIco]]
} -body {
    list [::ico::getIcon $f 0 -res 32 -exact 1 -format name] \
	[catch {::ico::getIcon $f 0 -res 16 -exact 1 -format name} msg] $msg
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f msg
} -result {3 1 {No matching icon}}

test ico-5.12 {getIcon: -exact 0} -setup {
    set f [writeBin a.ico [multiIco]]
} -body {
    ::ico::getIcon $f 0 -res 32 -bpp 1 -exact 0 -format name
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f
} -result 1

test ico-5.13 {getIcon: selected image colors} -setup {
    set f [writeBin a.ico [multiIco]]
} -body {
    expr {[canon [::ico::getIcon $f 0 -res 32 -bpp 8 -format colors]] eq
	  [canon [expectColors [pattern 32 32 256] $pal256]]}
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f
} -result 1

test ico-5.14 {getIcon: bad option} -setup {
    set f [writeBin a.ico [multiIco]]
} -body {
    ::ico::getIcon $f 0 -name x
} -cleanup {
    file delete $f
    unset f
} -returnCodes error -result {unknown option "name": must be one of type format image res bpp exact}

test ico-5.15 {getIcon: unknown icon} -setup {
    set f [writeBin a.ico [multiIco]]
} -body {
    ::ico::getIcon $f 3
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f
} -returnCodes error -result {no icon "3"}

test ico-5.16 {getIcon: missing file} -body {
    ::ico::getIcon [file join $icoDir nosuch.ico] 0
} -returnCodes error -result "couldn't open \"[file join $icoDir nosuch.ico]\": no such file or directory"

test ico-5.17 {getIcon: unsupported file format} -setup {
    set f [writeBin a.txt abc]
} -body {
    ::ico::getIcon $f 0
} -cleanup {
    file delete $f
    unset f
} -returnCodes error -result {unsupported file format TXT}

test ico-5.18 {getIcon: 256x256 icon with -res 256} -constraints knownBug -setup {
    # Ticket e7f1ed859e
    set f [writeBin big.ico [icoData [list \
	[dib 4 $pal16 [pattern 16 16 16]] \
	[dib 32 {} [lrepeat 256 [lrepeat 256 #102030]]]]]]
} -body {
    ::ico::getIcon $f 0 -res 256 -bpp 32 -exact 1 -format name
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f
} -result 1

test ico-5.19 {getIcon: 256x256 image is decoded} -setup {
    set f [writeBin big.ico [icoData [list \
	[dib 32 {} [lrepeat 256 [lrepeat 256 #102030]]]]]]
} -body {
    set c [::ico::getIcon $f 0 -format colors]
    list [llength $c] [llength [lindex $c 0]] [lindex $c 0 0] [lindex $c 255 255]
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f c
} -result {256 256 #102030 #102030}

test ico-5.20 {getIcon: BMP file} -setup {
    set f [writeBin a.bmp [bmpData $bmp4]]
} -body {
    canon [::ico::getIcon $f 0 -format colors]
} -cleanup {
    file delete $f
    unset f
} -result [canon $bmp4]

test ico-5.21 {getIcon: BMP file with -res} -constraints knownBug -setup {
    # Fails because iconMembers returns a flat list for BMP files.
    set f [writeBin a.bmp [bmpData $bmp4]]
} -body {
    canon [::ico::getIcon $f 0 -res 4 -format colors]
} -cleanup {
    file delete $f
    unset f
} -result [canon $bmp4]

test ico-5.22 {getIcon: ICODATA} -constraints knownBug -setup {
    # Icon data in a string can be written with -type ICODATA, but not
    # read: getIcon tests that the data is an existing file.
    set data [multiIco]
} -body {
    ::ico::getIcon $data 0 -type ICODATA -format name
} -cleanup {
    unset data
} -result 0

# -------------------------------------------------------------------------
# writeIcon

test ico-6.1 {writeIcon: wrong # args} -body {
    ::ico::writeIcon a.ico 0 24
} -returnCodes error -result {wrong # args: should be "::ico::writeIcon file name bpp data ?arg ...?"}

test ico-6.2 {writeIcon: creates a new ICO file} -setup {
    set f [tmpFile new.ico]
} -body {
    set r [::ico::writeIcon $f 0 24 $img4]
    list $r [file exists $f] [::ico::icons $f] [::ico::iconMembers $f 0]
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f r
} -result {0 1 0 {{0 4 4 24}}}

foreach {n bpp} {3 1 4 4 5 8 6 24 7 32} {
    test ico-6.$n "writeIcon: round trip, $bpp bpp" -setup {
	set f [tmpFile new.ico]
	set colors [lrepeat 32 [lrepeat 32 #000000]]
	set y 0
	foreach row $img4 {
	    set x 0
	    foreach c $row {
		lset colors [expr {$y * 2}] [expr {$x * 3}] $c
		incr x
	    }
	    incr y
	}
	if {$bpp == 1} {
	    set colors [string map {#FF0000 #FFFFFF #00FF00 #FFFFFF
		#0000FF #FFFFFF} $colors]
	}
	unset -nocomplain y x c row
    } -body {
	::ico::writeIcon $f 0 $bpp $colors
	list [::ico::iconMembers $f 0] \
	    [expr {[canon [::ico::getIcon $f 0 -format colors]] eq [canon $colors]}] \
	    [expr {[canon [decodeIco $f 0]] eq [canon $colors]}]
    } -cleanup {
	::ico::clearCache
	file delete $f
	unset f colors
    } -result [list [list [list 0 32 32 $bpp]] 1 1]
}
unset n bpp

test ico-6.8 {writeIcon: transparent pixels} -setup {
    set f [tmpFile new.ico]
    set colors [toColors [pattern 32 32 16] $pal16]
    for {set i 0} {$i < 32} {incr i} {lset colors $i $i {}}
} -body {
    ::ico::writeIcon $f 0 24 $colors
    list [expr {[canon [::ico::getIcon $f 0 -format colors]] eq [canon $colors]}] \
	[expr {[canon [decodeIco $f 0]] eq [canon $colors]}]
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f colors i
} -result {1 1}

test ico-6.9 {writeIcon: transparent pixels, 16x16 8 bpp} -setup {
    set f [tmpFile new.ico]
    set colors [expectColors [pattern 16 16 16] $pal16 [diagMask 16 16]]
} -body {
    ::ico::writeIcon $f 0 8 $colors
    list [expr {[canon [::ico::getIcon $f 0 -format colors]] eq [canon $colors]}] \
	[expr {[canon [decodeIco $f 0]] eq [canon $colors]}]
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f colors
} -result {1 1}

test ico-6.10 {writeIcon: transparent pixels, 8x8} -setup {
    # Ticket 3470437fff: padding of AND mask rows.
    set f [tmpFile new.ico]
    set colors [expectColors [pattern 8 8 16] $pal16 [diagMask 8 8]]
} -body {
    ::ico::writeIcon $f 0 24 $colors
    list [expr {[canon [::ico::getIcon $f 0 -format colors]] eq [canon $colors]}] \
	[expr {[canon [decodeIco $f 0]] eq [canon $colors]}]
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f colors
} -result {1 1}

test ico-6.11 {writeIcon: 16x16 1 bpp is written in standard format} -constraints knownBug -setup {
    # XOR mask rows are not padded to 32 bits.
    set f [tmpFile new.ico]
    set colors [expectColors [pattern 16 16 2] {#000000 #FFFFFF}]
} -body {
    ::ico::writeIcon $f 0 1 $colors
    expr {[canon [decodeIco $f 0]] eq [canon $colors]}
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f colors
} -result 1

test ico-6.12 {writeIcon: appends an image if the name does not exist} -setup {
    set f [tmpFile new.ico]
} -body {
    set r {}
    lappend r [::ico::writeIcon $f 0 24 $img4]
    lappend r [::ico::writeIcon $f 7 8 [lrepeat 8 [lrepeat 8 #808080]]]
    lappend r [::ico::writeIcon $f x 4 [lrepeat 16 [lrepeat 16 #FFFFFF]]]
    ::ico::clearCache
    lappend r [::ico::iconMembers $f 0]
    lappend r [lindex [::ico::getIconByName $f 1 -format colors] 0 0]
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f r
} -result {0 1 2 {{0 4 4 24} {1 8 8 8} {2 16 16 4}} #808080}

test ico-6.13 {writeIcon: replaces an image with different dimensions} -setup {
    set f [tmpFile new.ico]
    ::ico::writeIcon $f 0 24 $img4
    ::ico::writeIcon $f 1 8 [lrepeat 8 [lrepeat 8 #808080]]
    ::ico::writeIcon $f 2 4 [lrepeat 16 [lrepeat 16 #FFFFFF]]
} -body {
    set r [::ico::writeIcon $f 1 24 [lrepeat 32 [lrepeat 32 #123456]]]
    ::ico::clearCache
    list $r [::ico::iconMembers $f 0] \
	[canon [::ico::getIconByName $f 0 -format colors]] \
	[lindex [::ico::getIconByName $f 1 -format colors] 31 31] \
	[lindex [::ico::getIconByName $f 2 -format colors] 15 15] \
	[expr {[canon [decodeIco $f 1]] eq [canon [lrepeat 32 [lrepeat 32 #123456]]]}]
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f r
} -result [list 1 {{0 4 4 24} {1 32 32 24} {2 16 16 4}} [canon $img4] #123456 #FFFFFF 1]

test ico-6.14 {writeIcon: from a Tk image} -setup {
    set f [tmpFile new.ico]
    set expect [toColors [pattern 16 16 16] $pal16]
    image create photo icoTestImage -width 16 -height 16
    icoTestImage put $expect
    icoTestImage transparency set 1 2 1
    lset expect 2 1 {}
} -body {
    ::ico::writeIcon $f 0 24 icoTestImage
    list [::ico::iconMembers $f 0] \
	[expr {[canon [::ico::getIcon $f 0 -format colors]] eq [canon $expect]}] \
	[expr {[canon [decodeIco $f 0]] eq [canon $expect]}]
} -cleanup {
    image delete icoTestImage
    ::ico::clearCache
    file delete $f
    unset f expect
} -result {{{0 16 16 24}} 1 1}

test ico-6.15 {writeIcon: from a Tk image, 4 bpp} -setup {
    set f [tmpFile new.ico]
    image create photo icoTestImage -width 16 -height 16
    icoTestImage put #FF0000 -to 0 0 16 8
    icoTestImage put #0000FF -to 0 8 16 16
} -body {
    ::ico::writeIcon $f 0 4 icoTestImage
    set c [::ico::getIcon $f 0 -format colors]
    list [::ico::iconMembers $f 0] [lindex $c 0 0] [lindex $c 15 15]
} -cleanup {
    image delete icoTestImage
    ::ico::clearCache
    file delete $f
    unset f c
} -result {{{0 16 16 4}} #FF0000 #0000FF}

test ico-6.16 {writeIcon: invalid color depth} -setup {
    set f [tmpFile new.ico]
} -body {
    ::ico::writeIcon $f 0 16 $img4
} -cleanup {
    file delete $f
    unset f
} -returnCodes error -result {invalid color depth}

test ico-6.17 {writeIcon: invalid color depth 2} -setup {
    set f [tmpFile new.ico]
} -body {
    ::ico::writeIcon $f 0 2 $img4
} -cleanup {
    file delete $f
    unset f
} -returnCodes error -result {invalid color depth}

test ico-6.18 {writeIcon: too many colors for the depth} -setup {
    set f [tmpFile new.ico]
} -body {
    ::ico::writeIcon $f 0 1 $img4
} -cleanup {
    file delete $f
    unset f
} -returnCodes error -result {specified color depth too low}

test ico-6.19 {writeIcon: black is always in the palette} -setup {
    set f [tmpFile new.ico]
    # two colors without black need 3 palette entries
    set two [lrepeat 8 [concat [lrepeat 4 #FF0000] [lrepeat 4 #00FF00]]]
    # black and white fit in 2 entries
    set bw [lrepeat 8 [concat [lrepeat 4 #000000] [lrepeat 4 #FFFFFF]]]
} -body {
    list [catch {::ico::writeIcon $f 0 1 $two} msg] $msg \
	[catch {::ico::writeIcon $f 0 1 $bw}]
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f two bw msg
} -result {1 {specified color depth too low} 0}

test ico-6.20 {writeIcon: 16 colors fit in 4 bpp when black is included} -constraints knownBug -setup {
    # The 4 bpp encoder only handles palette indices 0 to 9.
    set f [tmpFile new.ico]
    set colors [toColors [pattern 16 16 16] $pal16]
} -body {
    ::ico::writeIcon $f 0 4 $colors
    expr {[canon [::ico::getIcon $f 0 -format colors]] eq [canon $colors]}
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f colors
} -result 1

test ico-6.31 {writeIcon: 4 bpp with 10 colors} -setup {
    set f [tmpFile new.ico]
    set colors [toColors [pattern 16 16 10] $pal16]
} -body {
    ::ico::writeIcon $f 0 4 $colors
    list [::ico::iconMembers $f 0] \
	[expr {[canon [::ico::getIcon $f 0 -format colors]] eq [canon $colors]}] \
	[expr {[canon [decodeIco $f 0]] eq [canon $colors]}]
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f colors
} -result {{{0 16 16 4}} 1 1}

test ico-6.32 {writeIcon: transparency round trip for various widths} -setup {
    # Ticket 3470437fff: AND mask rows are padded to a multiple of 32 bits.
    set f [tmpFile new.ico]
} -body {
    set res {}
    foreach size {8 16 20 24 40 48} {
	set colors [expectColors [pattern $size $size 16] $pal16 \
			[diagMask $size $size]]
	::ico::writeIcon $f 0 24 $colors
	lappend res [expr {[canon [::ico::getIcon $f 0 -format colors \
				       -res $size]] eq [canon $colors]}]
	::ico::clearCache
	file delete $f
    }
    set res
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset -nocomplain f res size colors
} -result {1 1 1 1 1 1}

test ico-6.33 {writeIcon: transparency of icon data for various widths} -setup {
    # Ticket 3470437fff: AND mask rows are padded to a multiple of 32 bits.
    set f [tmpFile new.ico]
} -body {
    set res {}
    foreach size {8 16 20 24 40 48} {
	set colors [expectColors [pattern $size $size 16] $pal16 \
			[diagMask $size $size]]
	::ico::writeIcon $f 0 24 $colors
	set c [::ico::getIconAsColorList \
		   {*}[::ico::getRawIconDataICODATA [readBin $f] 0]]
	lappend res [expr {[canon $c] eq [canon $colors]}]
	::ico::clearCache
	file delete $f
    }
    set res
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset -nocomplain f res size colors c
} -result {1 1 1 1 1 1}

test ico-6.21 {writeIcon: not an icon file} -setup {
    set f [writeBin bad.ico "this is not an icon"]
} -body {
    ::ico::writeIcon $f 0 24 $img4
} -cleanup {
    file delete $f
    unset f
} -returnCodes error -result {not an icon file}

test ico-6.22 {writeIcon: unsupported format} -setup {
    set f [tmpFile new.png]
} -body {
    ::ico::writeIcon $f 0 24 $img4
} -cleanup {
    file delete $f
    unset f
} -returnCodes error -result {unsupported file format PNG}

test ico-6.23 {writeIcon: -type} -setup {
    set f [tmpFile newicon]
} -body {
    ::ico::writeIcon $f 0 24 $img4 -type ICO
    canon [::ico::getIcon $f 0 -type ICO -format colors]
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f
} -result [canon $img4]

test ico-6.24 {writeIcon: bad option} -setup {
    set f [tmpFile new.ico]
} -body {
    ::ico::writeIcon $f 0 24 $img4 -format colors
} -cleanup {
    file delete $f
    unset f
} -returnCodes error -result {unknown option "format": must be one of type}

test ico-6.25 {writeIcon: nonexistent Tk image} -setup {
    set f [tmpFile new.ico]
} -body {
    ::ico::writeIcon $f 0 24 noSuchImage
} -cleanup {
    file delete $f
    unset f
} -returnCodes error -match glob -result {image "noSuchImage" does*t exist}

test ico-6.26 {writeIcon: BMP file} -setup {
    set f [tmpFile new.bmp]
} -body {
    ::ico::writeIcon $f whatever 24 $bmp4
    list [::ico::icons $f] [canon [::ico::getIcon $f 0 -format colors]] \
	[string range [readBin $f] 0 1]
} -cleanup {
    file delete $f
    unset f
} -result [list 0 [canon $bmp4] BM]

test ico-6.27 {writeIcon: BMP file is overwritten} -setup {
    set f [tmpFile new.bmp]
    ::ico::writeIcon $f 0 24 [lrepeat 8 [lrepeat 8 #808080]]
} -body {
    ::ico::writeIcon $f 0 24 $bmp4
    canon [::ico::getIcon $f 0 -format colors]
} -cleanup {
    file delete $f
    unset f
} -result [canon $bmp4]

test ico-6.28 {writeIcon: BMP file with 8 bpp} -setup {
    set f [tmpFile new.bmp]
} -body {
    ::ico::writeIcon $f 0 8 $bmp4
    canon [::ico::getIcon $f 0 -format colors]
} -cleanup {
    file delete $f
    unset f
} -result [canon $bmp4]

test ico-6.29 {writeIcon: ICODATA to a variable} -setup {
    unset -nocomplain icoTestData
} -body {
    set r [::ico::writeIcon icoTestData 0 24 $img4 -type ICODATA]
    set f [writeBin fromdata.ico $icoTestData]
    list $r [::ico::iconMembers $f 0] \
	[canon [::ico::getIcon $f 0 -format colors]]
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset -nocomplain f r icoTestData
} -result [list 0 {{0 4 4 24}} [canon $img4]]

test ico-6.30 {writeIcon: ICODATA appends to existing data} -constraints knownBug -setup {
    unset -nocomplain icoTestData
    ::ico::writeIcon icoTestData 0 24 $img4 -type ICODATA
} -body {
    set r [::ico::writeIcon icoTestData 1 8 $img4 -type ICODATA]
    set f [writeBin fromdata.ico $icoTestData]
    list $r [::ico::iconMembers $f 0]
} -cleanup {
    ::ico::clearCache
    catch {file delete $f}
    unset -nocomplain f r icoTestData
} -result {1 {{0 4 4 24} {1 4 4 8}}}

# -------------------------------------------------------------------------
# copyIcon

test ico-7.1 {copyIcon: wrong # args} -body {
    ::ico::copyIcon a 0 b
} -returnCodes error -result {wrong # args: should be "::ico::copyIcon file1 name1 file2 name2 ?arg ...?"}

test ico-7.2 {copyIcon: ICO to existing ICO, appended} -setup {
    set f1 [writeBin a.ico [multiIco]]
    set f2 [tmpFile b.ico]
    ::ico::writeIcon $f2 0 24 $img4
} -body {
    ::ico::copyIcon $f1 3 $f2 9
    ::ico::clearCache
    list [::ico::iconMembers $f2 0] \
	[expr {[canon [::ico::getIconByName $f2 1 -format colors]] eq
	       [canon [::ico::getIconByName $f1 3 -format colors]]}]
} -cleanup {
    ::ico::clearCache
    file delete $f1 $f2
    unset f1 f2
} -result {{{0 4 4 24} {1 32 32 24}} 1}

test ico-7.3 {copyIcon: ICO to ICO, replacing an image} -setup {
    set f1 [writeBin a.ico [multiIco]]
    set f2 [tmpFile b.ico]
    ::ico::writeIcon $f2 0 24 $img4
} -body {
    ::ico::copyIcon $f1 2 $f2 0
    ::ico::clearCache
    list [::ico::iconMembers $f2 0] \
	[expr {[canon [::ico::getIconByName $f2 0 -format colors]] eq
	       [canon [expectColors [pattern 32 32 256] $pal256]]}]
} -cleanup {
    ::ico::clearCache
    file delete $f1 $f2
    unset f1 f2
} -result {{{0 32 32 8}} 1}

test ico-7.4 {copyIcon: ICO to BMP} -constraints knownBug -setup {
    # BMP files are read in text mode (see ico-4.23), so pixel bytes
    # above 0x7F or CR LF pairs are corrupted.
    set f1 [writeBin a.ico [multiIco]]
    set f2 [writeBin b.bmp [bmpData $img4]]
} -body {
    ::ico::copyIcon $f1 3 $f2 1
    expr {[canon [::ico::getIcon $f2 0 -format colors]] eq
	  [canon [toColors [pattern 32 32 16] $pal16]]}
} -cleanup {
    ::ico::clearCache
    file delete $f1 $f2
    unset f1 f2
} -result 1

test ico-7.5 {copyIcon: BMP to ICO} -setup {
    set f1 [writeBin a.bmp [bmpData $bmp4]]
    set f2 [tmpFile b.ico]
    ::ico::writeIcon $f2 0 24 [lrepeat 8 [lrepeat 8 #808080]]
} -body {
    ::ico::copyIcon $f1 1 $f2 0
    ::ico::clearCache
    list [::ico::iconMembers $f2 0] [canon [::ico::getIcon $f2 0 -format colors]]
} -cleanup {
    ::ico::clearCache
    file delete $f1 $f2
    unset f1 f2
} -result [list {{0 4 4 24}} [canon $bmp4]]

test ico-7.6 {copyIcon: -fromtype and -totype} -setup {
    set f1 [writeBin src.dat [multiIco]]
    set f2 [tmpFile dst.dat]
    ::ico::writeIcon $f2 0 24 $img4 -type ICO
} -body {
    ::ico::copyIcon $f1 0 $f2 0 -fromtype ICO -totype ICO
    ::ico::clearCache
    ::ico::iconMembers $f2 0 -type ICO
} -cleanup {
    ::ico::clearCache
    file delete $f1 $f2
    unset f1 f2
} -result {{0 16 16 4}}

test ico-7.7 {copyIcon: missing source file} -setup {
    set f2 [tmpFile b.ico]
    ::ico::writeIcon $f2 0 24 $img4
} -body {
    ::ico::copyIcon [file join $icoDir nosuch.ico] 0 $f2 0
} -cleanup {
    file delete $f2
    unset f2
} -returnCodes error -result "couldn't open \"[file join $icoDir nosuch.ico]\": no such file or directory"

test ico-7.8 {copyIcon: missing destination file} -setup {
    set f1 [writeBin a.ico [multiIco]]
} -body {
    ::ico::copyIcon $f1 0 [file join $icoDir nosuch.ico] 0
} -cleanup {
    file delete $f1
    unset f1
} -returnCodes error -result "couldn't open \"[file join $icoDir nosuch.ico]\": no such file or directory"

test ico-7.9 {copyIcon: unknown source image} -setup {
    set f1 [writeBin a.ico [multiIco]]
    set f2 [tmpFile b.ico]
    ::ico::writeIcon $f2 0 24 $img4
} -body {
    ::ico::copyIcon $f1 9 $f2 0
} -cleanup {
    ::ico::clearCache
    file delete $f1 $f2
    unset f1 f2
} -returnCodes error -result {no icon "9"}

test ico-7.10 {copyIcon: bad option} -setup {
    set f1 [writeBin a.ico [multiIco]]
    set f2 [tmpFile b.ico]
    ::ico::writeIcon $f2 0 24 $img4
} -body {
    ::ico::copyIcon $f1 0 $f2 0 -type ICO
} -cleanup {
    file delete $f1 $f2
    unset f1 f2
} -returnCodes error -result {unknown option "type": must be one of fromtype totype}

test ico-7.11 {copyIcon: unsupported destination format} -setup {
    set f1 [writeBin a.ico [multiIco]]
    set f2 [writeBin b.gif abc]
} -body {
    ::ico::copyIcon $f1 0 $f2 0
} -cleanup {
    file delete $f1 $f2
    unset f1 f2
} -returnCodes error -result {unsupported file format GIF}

test ico-7.12 {copyIcon: unsupported source format} -setup {
    set f1 [writeBin a.gif abc]
    set f2 [tmpFile b.ico]
    ::ico::writeIcon $f2 0 24 $img4
} -body {
    ::ico::copyIcon $f1 0 $f2 0
} -cleanup {
    file delete $f1 $f2
    unset f1 f2
} -returnCodes error -result {unsupported file format GIF}

# -------------------------------------------------------------------------
# Executables (EXE, DLL, ICL)

proc samplePE {} {
    peData {{1 {11 12}} {APPICON {13}} {7 {14}}} [list \
	[list 11 [dib 4 $::pal16 [pattern 16 16 16]]] \
	[list 12 [dib 8 $::pal256 [pattern 32 32 256]]] \
	[list 13 [dib 24 {} [toColors [pattern 32 32 16] $::pal16] [diagMask 32 32]]] \
	[list 14 [dib 32 {} [toColors [pattern 48 48 16] $::pal16]]]]
}

test ico-8.1 {icons: EXE file} -setup {
    set f [writeBin app.exe [samplePE]]
} -body {
    lsort [::ico::icons $f]
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f
} -result {1 7 APPICON}

test ico-8.2 {iconMembers: EXE file} -setup {
    set f [writeBin app.exe [samplePE]]
} -body {
    list [::ico::iconMembers $f 1] [::ico::iconMembers $f APPICON] \
	[::ico::iconMembers $f 7]
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f
} -result {{{11 16 16 4} {12 32 32 8}} {{13 32 32 24}} {{14 48 48 32}}}

test ico-8.3 {iconMembers: EXE file, unknown icon} -setup {
    set f [writeBin app.exe [samplePE]]
} -body {
    ::ico::iconMembers $f 2
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f
} -returnCodes error -result {no icon "2"}

test ico-8.4 {getIcon: EXE file} -setup {
    set f [writeBin app.exe [samplePE]]
} -body {
    list [::ico::getIcon $f 1 -format name] \
	[::ico::getIcon $f 1 -res 32 -format name] \
	[expr {[canon [::ico::getIcon $f 1 -res 32 -format colors]] eq
	       [canon [expectColors [pattern 32 32 256] $pal256]]}] \
	[expr {[canon [::ico::getIcon $f APPICON -format colors]] eq
	       [canon [expectColors [toColors [pattern 32 32 16] $pal16] {} \
				 [diagMask 32 32]]]}]
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f
} -result {11 12 1 1}

test ico-8.5 {getIconByName: EXE file} -setup {
    set f [writeBin app.exe [samplePE]]
} -body {
    list [expr {[canon [::ico::getIconByName $f 11 -format colors]] eq
		[canon [expectColors [pattern 16 16 16] $pal16]]}] \
	[expr {[canon [::ico::getIconByName $f 14 -format colors]] eq
	       [canon [toColors [pattern 48 48 16] $pal16]]}]
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f
} -result {1 1}

test ico-8.6 {getIconByName: EXE file, unknown image} -setup {
    set f [writeBin app.exe [samplePE]]
} -body {
    ::ico::getIconByName $f 1
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f
} -returnCodes error -result {No icon "1"}

test ico-8.7 {icons: DLL and ICL files} -setup {
    set f1 [writeBin lib.dll [samplePE]]
    set f2 [writeBin lib.icl [samplePE]]
} -body {
    list [lsort [::ico::icons $f1]] [::ico::iconMembers $f2 7] \
	[::ico::getIcon $f1 1 -res 16 -format name]
} -cleanup {
    ::ico::clearCache
    file delete $f1 $f2
    unset f1 f2
} -result {{1 7 APPICON} {{14 48 48 32}} 11}

test ico-8.8 {icons: not an executable} -setup {
    set f [writeBin bad.exe "this is not an executable file at all, really, it is not, honestly....."]
} -body {
    ::ico::icons $f
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f
} -returnCodes error -result {file is not a valid executable}

test ico-8.9 {icons: MZ file without a PE or NE header} -setup {
    set f [writeBin bad.exe [binary format a2x58ia8 MZ 64 XXXXXXXX]]
} -body {
    ::ico::icons $f
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f
} -returnCodes error -result {file is not a valid executable}

test ico-8.10 {icons: executable without resources} -setup {
    set d [peData {} {}]
    # rename the section so that there is no .rsrc section
    set i [string first .rsrc $d]
    set d [string replace $d $i [expr {$i + 4}] .text]
    set f [writeBin nores.exe $d]
} -body {
    ::ico::icons $f
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f d i
} -result {}

test ico-8.11 {writeIcon: EXE file, same format} -setup {
    set f [writeBin app.exe [samplePE]]
    set new [lrepeat 32 [lrepeat 32 #123456]]
} -body {
    ::ico::writeIcon $f 13 24 $new
    ::ico::clearCache
    expr {[canon [::ico::getIconByName $f 13 -format colors]] eq [canon $new]}
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f new
} -result 1

test ico-8.12 {writeIcon: EXE file, other images are unchanged} -setup {
    set f [writeBin app.exe [samplePE]]
    set before [::ico::getIconByName $f 12 -format colors]
} -body {
    ::ico::writeIcon $f 13 24 [lrepeat 32 [lrepeat 32 #123456]]
    ::ico::clearCache
    list [expr {[::ico::getIconByName $f 12 -format colors] eq $before}] \
	[file size $f]
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f before
} -result [list 1 [string length [samplePE]]]

test ico-8.13 {writeIcon: EXE file, different size} -setup {
    set f [writeBin app.exe [samplePE]]
} -body {
    ::ico::writeIcon $f 13 24 $img4
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f
} -returnCodes error -result {icon format differs from original}

test ico-8.14 {writeIcon: EXE file, different depth} -setup {
    set f [writeBin app.exe [samplePE]]
} -body {
    ::ico::writeIcon $f 13 8 [lrepeat 32 [lrepeat 32 #123456]]
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f
} -returnCodes error -result {icon format differs from original}

test ico-8.15 {writeIcon: EXE file, images cannot be added} -setup {
    set f [writeBin app.exe [samplePE]]
} -body {
    ::ico::writeIcon $f 99 24 [lrepeat 32 [lrepeat 32 #123456]]
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f
} -returnCodes error -result {no icon "99"}

test ico-8.16 {copyIcon: ICO to EXE} -setup {
    set f1 [writeBin a.ico [multiIco]]
    set f2 [writeBin app.exe [samplePE]]
} -body {
    ::ico::copyIcon $f1 2 $f2 12
    ::ico::clearCache
    expr {[canon [::ico::getIconByName $f2 12 -format colors]] eq
	  [canon [expectColors [pattern 32 32 256] $pal256]]}
} -cleanup {
    ::ico::clearCache
    file delete $f1 $f2
    unset f1 f2
} -result 1

test ico-8.17 {copyIcon: EXE to ICO} -setup {
    set f1 [writeBin app.exe [samplePE]]
    set f2 [tmpFile b.ico]
    ::ico::writeIcon $f2 0 24 $img4
} -body {
    ::ico::copyIcon $f1 14 $f2 0
    ::ico::clearCache
    list [::ico::iconMembers $f2 0] \
	[expr {[canon [::ico::getIconByName $f2 0 -format colors]] eq
	       [canon [toColors [pattern 48 48 16] $pal16]]}]
} -cleanup {
    ::ico::clearCache
    file delete $f1 $f2
    unset f1 f2
} -result {{{0 48 48 32}} 1}

# -------------------------------------------------------------------------
# EXEtoICO

test ico-9.1 {EXEtoICO: wrong # args} -body {
    ::ico::EXEtoICO
} -returnCodes error -result {wrong # args: should be "::ico::EXEtoICO exeFile ?icoDir?"}

test ico-9.2 {EXEtoICO: missing file} -body {
    ::ico::EXEtoICO [file join $icoDir nosuch.exe]
} -returnCodes error -result "couldn't open \"[file join $icoDir nosuch.exe]\": no such file or directory"

test ico-9.3 {EXEtoICO: icons in the directory of the file} -setup {
    set f [writeBin app.exe [samplePE]]
} -body {
    ::ico::EXEtoICO $f
    set res {}
    foreach name {1 APPICON 7} {
	set ico [file join $icoDir app.exe-$name.ico]
	lappend res [file exists $ico] [::ico::iconMembers $ico 0]
    }
    lappend res [expr {[canon [::ico::getIconByName \
	[file join $icoDir app.exe-1.ico] 1 -format colors]] eq
		       [canon [expectColors [pattern 32 32 256] $pal256]]}]
} -cleanup {
    ::ico::clearCache
    file delete $f {*}[glob -nocomplain -directory $icoDir app.exe-*.ico]
    unset -nocomplain f res name ico
} -result {1 {{0 16 16 4} {1 32 32 8}} 1 {{0 32 32 24}} 1 {{0 48 48 32}} 1}

test ico-9.4 {EXEtoICO: icons in another directory} -setup {
    set f [writeBin app.exe [samplePE]]
    set out [makeDirectory icoout]
} -body {
    ::ico::EXEtoICO $f $out
    list [lsort [glob -tails -directory $out *]] \
	[glob -nocomplain -directory $icoDir app.exe-*]
} -cleanup {
    ::ico::clearCache
    file delete $f
    removeDirectory icoout
    unset f out
} -result {{app.exe-1.ico app.exe-7.ico app.exe-APPICON.ico} {}}

test ico-9.5 {EXEtoICO: not an executable} -setup {
    set f [writeBin a.ico [multiIco]]
} -body {
    ::ico::EXEtoICO $f
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f
} -returnCodes error -result {file is not a valid executable}

test ico-9.6 {EXEtoICO: image data of all icon files} -constraints knownBug -setup {
    # The list of size fields to fix up is not reset between icon groups,
    # so the files after the first one get garbage written into their
    # image data.
    set f [writeBin app.exe [samplePE]]
} -body {
    ::ico::EXEtoICO $f
    list [expr {[canon [decodeIco [file join $icoDir app.exe-APPICON.ico] 0]] eq
		[canon [expectColors [toColors [pattern 32 32 16] $pal16] {} \
			    [diagMask 32 32]]]}] \
	[expr {[canon [decodeIco [file join $icoDir app.exe-7.ico] 0]] eq
	       [canon [toColors [pattern 48 48 16] $pal16]]}]
} -cleanup {
    ::ico::clearCache
    file delete $f {*}[glob -nocomplain -directory $icoDir app.exe-*.ico]
    unset f
} -result {1 1}

# -------------------------------------------------------------------------
# clearCache

test ico-10.1 {clearCache: wrong # args} -body {
    ::ico::clearCache a b
} -returnCodes error -result {wrong # args: should be "::ico::clearCache ?file?"}

test ico-10.2 {clearCache: changes are seen after clearing the cache} -setup {
    set f [tmpFile c.ico]
    ::ico::writeIcon $f 0 24 $img4
} -body {
    set r [list [::ico::iconMembers $f 0]]
    ::ico::writeIcon $f 1 24 $img4
    ::ico::clearCache
    lappend r [::ico::iconMembers $f 0]
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f r
} -result {{{0 4 4 24}} {{0 4 4 24} {1 4 4 24}}}

test ico-10.3 {clearCache: for a specific file} -setup {
    set f1 [tmpFile c1.ico]
    set f2 [tmpFile c2.ico]
    ::ico::writeIcon $f1 0 24 $img4
    ::ico::writeIcon $f2 0 24 $img4
    ::ico::iconMembers $f1 0
    ::ico::iconMembers $f2 0
} -body {
    ::ico::writeIcon $f1 1 24 $img4
    ::ico::writeIcon $f2 1 24 $img4
    ::ico::clearCache [file normalize $f1]
    list [llength [::ico::iconMembers $f1 0]] [llength [::ico::iconMembers $f2 0]]
} -cleanup {
    ::ico::clearCache
    file delete $f1 $f2
    unset f1 f2
} -result {2 1}

test ico-10.4 {clearCache: returns an empty string} -body {
    list [::ico::clearCache] [::ico::clearCache nosuchfile]
} -result {{} {}}

test ico-10.5 {clearCache: EXE file} -setup {
    set f [writeBin app.exe [samplePE]]
    ::ico::icons $f
} -body {
    writeBin app.exe [peData {{5 {11}}} [list \
	[list 11 [dib 4 $::pal16 [pattern 16 16 16]]]]]
    set r [lsort [::ico::icons $f]]
    ::ico::clearCache $f
    lappend r [::ico::icons $f]
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f r
} -result {1 7 APPICON 5}

# -------------------------------------------------------------------------
# transparentColor

test ico-11.1 {transparentColor: wrong # args} -body {
    ::ico::transparentColor x
} -returnCodes error -result {wrong # args: should be "::ico::transparentColor img color"}

test ico-11.2 {transparentColor: color list} -body {
    canon [::ico::transparentColor {{#FF0000 #00FF00} {#00FF00 #FF0000}} #FF0000]
} -result [canon {{{} #00FF00} {#00FF00 {}}}]

test ico-11.3 {transparentColor: color list without the color} -body {
    canon [::ico::transparentColor {{#FF0000 #00FF00} {#00FF00 #FF0000}} #0000FF]
} -result [canon {{#FF0000 #00FF00} {#00FF00 #FF0000}}]

test ico-11.4 {transparentColor: color list with transparent pixels} -body {
    canon [::ico::transparentColor {{{} #00FF00 #0000FF} {#00FF00 {} #00FF00}} #00FF00]
} -result [canon {{{} {} #0000FF} {{} {} {}}}]

test ico-11.5 {transparentColor: Tk image} -setup {
    image create photo icoTestImage -width 2 -height 2
    icoTestImage put {{#FF0000 #00FF00} {#00FF00 #FF0000}}
} -body {
    set r [::ico::transparentColor icoTestImage #00FF00]
    list $r [icoTestImage transparency get 0 0] [icoTestImage transparency get 1 0] \
	[icoTestImage transparency get 0 1] [icoTestImage transparency get 1 1]
} -cleanup {
    image delete icoTestImage
    unset r
} -result {icoTestImage 0 1 1 0}

test ico-11.6 {transparentColor: Tk image, color as RGB list} -setup {
    image create photo icoTestImage -width 2 -height 1
    icoTestImage put {{#FF0000 #00FF00}}
} -body {
    ::ico::transparentColor icoTestImage {255 0 0}
    list [icoTestImage transparency get 0 0] [icoTestImage transparency get 1 0]
} -cleanup {
    image delete icoTestImage
} -result {1 0}

test ico-11.7 {transparentColor: result can be written as an icon} -setup {
    set f [tmpFile t.ico]
    set colors [toColors [pattern 32 32 16] $pal16]
} -body {
    ::ico::writeIcon $f 0 24 [::ico::transparentColor $colors #FF0000]
    expr {[canon [::ico::getIcon $f 0 -format colors]] eq
	  [canon [string map {#FF0000 {{}}} $colors]]}
} -cleanup {
    ::ico::clearCache
    file delete $f
    unset f colors
} -result 1

# -------------------------------------------------------------------------
# getFileIcon (Windows only)

testConstraint win [expr {$tcl_platform(platform) eq "windows"}]

test ico-12.1 {getFileIcon: folder icon} -constraints win -body {
    set img [::ico::getFileIcon Folder -res 32]
    list [image type $img] [image width $img]
} -cleanup {
    image delete $img
    unset img
} -result {photo 32}

test ico-12.2 {getFileIcon: -format colors for an extension} -constraints win -body {
    set c [::ico::getFileIcon .txt -res 16 -format colors]
    llength $c
} -cleanup {
    unset c
} -result 16

# -------------------------------------------------------------------------
# Show

test ico-13.1 {Show: displays the icons of a file} -constraints bwidget -setup {
    set f [writeBin a.ico [multiIco]]
} -body {
    ::ico::Show $f
    update
    winfo exists .iconsw
} -cleanup {
    destroy .iconsw
    ::ico::clearCache
    file delete $f
    unset f
} -result 1

test ico-13.2 {Show: -parent} -constraints {bwidget knownBug} -setup {
    # The documented -parent option is rejected.
    set f [writeBin a.ico [multiIco]]
    toplevel .top
} -body {
    ::ico::Show $f -parent .top
    update
    winfo exists .top.iconsw
} -cleanup {
    destroy .top
    ::ico::clearCache
    file delete $f
    unset f
} -result 1

# -------------------------------------------------------------------------

removeDirectory icotest
foreach p {writeBin readBin tmpFile packRow hexRGB dib icoData bmpData peData
	   decodeIco pattern diagMask expectColors toColors canon photoColors
	   multiIco samplePE} {
    rename $p {}
}
unset p icoDir img4 bmp4 pal16 pal256

::tcltest::cleanupTests
return
