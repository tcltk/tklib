test khim-5.28 {character map: no variable traces are left after closing} -constraints {
    knownBug
} -setup {
    khimWidget entry .e
} -body {
    # The traces on the code page variables added when the dialog is
    # posted are never removed; after a few dialogs, changing the code
    # page loops forever.
    withCharMap .e {khim::CMapCancel $m}
    list [trace info variable ::khim::CMapCodePage(.khimcmap)] \
	[trace info variable ::khim::CMapInputCodePage(.khimcmap)] \
	$::khimTestErrors
} -cleanup {
    cleanupAll
} -result {{} {} {}}

