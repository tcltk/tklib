# -------------------------------------------------------------------------
# getOptions

# Run getOptions .khim and execute $script with the dialog shown.
proc withOptions {script} {
    onWindow .khim.lf1.lb $script
    khim::getOptions .khim
}

test khim-7.1 {getOptions: wrong # args} -body {
    khim::getOptions
} -returnCodes error -result {wrong # args: should be "khim::getOptions w"}

test khim-7.2 {getOptions: dialog contents} -setup {
    set res {}
} -body {
    set r [withOptions {
	lappend ::res [wm title .khim] \
	    [.khim.lf1.lb size] [.khim.lf1.lb get 0] \
	    [.khim.v cget -text] [.khim.b1 cget -text]
	destroy .khim
    }]
    lappend res $r [winfo exists .khim] $::khimTestErrors
} -cleanup {
    cleanupAll
    unset -nocomplain res r
} -result [list [kmc "KHIM Controls"] \
	       [expr {[llength [lindex $khimTestDefaultConfig 4]] / 2}] \
	       "!! \u2192 \u00a1" [kmc "Use KHIM"] Pause {} 0 {}]

