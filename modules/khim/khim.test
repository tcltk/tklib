	.khim.lf1.f3.b1 invoke
	set lb .khim.lf1.lb
	lappend ::res [$lb get 0 end] [$lb get [$lb curselection]]
	.khim.bf.ok invoke
    }
    lappend res [winfo exists .khim] [cfgMap] \
	$::khimTestErrors
} -cleanup {
    cleanupAll
    unset -nocomplain res
} -result [list [list "ab \u2192 x" "zz \u2192 \u017e"] "zz \u2192 \u017e" \
	       0 [list ab x zz \u017e] {}]

