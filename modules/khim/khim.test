# -------------------------------------------------------------------------
# Localisation

set khimDir [file dirname [file normalize [info script]]]
set khimMessages {
    Apply Cancel Change Character {Compose Key} {Compose key:}
    {Composed sequence must be two characters long} Delete Help...
    HELPTEXT {Input key sequence} {Insert Character} {Key sequences}
    {KHIM Controls} {KHIM Help} OK {Select code page:}
    {SELECT COMPOSE KEY} Unicode... {Use KHIM}
}

# Return the documented messages missing from the catalog of a locale.
proc missingMessages {locale} {
    set i [interp create]
    try {
	$i eval {package require msgcat}
	$i eval [list ::msgcat::mclocale $locale]
	$i eval [list namespace eval ::khim \
		     [list ::msgcat::mcload $::khimDir]]
	set missing {}
	foreach msg $::khimMessages {
	    if {![$i eval [list namespace eval ::khim \
			       [list ::msgcat::mcexists -exactlocale $msg]]]} {
		lappend missing $msg
	    }
	}
	return $missing
    } finally {
	interp delete $i
    }
}

set i [interp create]
testConstraint mcexists [package vsatisfies [$i eval {package require msgcat}] 1.6-]
interp delete $i
unset i

# The cs, da and de catalogs lack the "KHIM Help" message.
foreach {n locale c} {1 en {} 2 cs knownBug 3 da knownBug 4 de knownBug
		      5 es {} 6 pl {} 7 uk {}} {
    test khim-8.$n "localisation: $locale catalog has all documented messages" \
	-constraints [list mcexists {*}$c] -body {
	    missingMessages $locale
	} -result {}
}
unset n locale c

test khim-8.8 {localisation: help texts fall back to the root locale} -constraints mcexists -setup {
    set i [interp create]
} -body {
    $i eval {package require msgcat; ::msgcat::mclocale xx}
    $i eval [list namespace eval ::khim [list ::msgcat::mcload $khimDir]]
    $i eval {
	namespace eval ::khim {
	    list [::msgcat::mcexists HELPTEXT] \
		[::msgcat::mcexists {SELECT COMPOSE KEY}]
	}
    }
} -cleanup {
    interp delete $i
    unset i
} -result {1 1}

test khim-8.9 {localisation: help texts are available in the current locale} -body {
    list [expr {[kmc HELPTEXT] ne "HELPTEXT"}] \
	[expr {[kmc {SELECT COMPOSE KEY}] ne "SELECT COMPOSE KEY"}]
} -result {1 1}

# -------------------------------------------------------------------------

rename keys {}
rename khimWidget {}
rename onWindow {}
rename onWindowPoll {}
rename cleanupAll {}
rename clickCell {}
rename withCharMap {}
rename withOptions {}
rename setSequence {}
rename missingMessages {}
rename restoreConfig {}
rename kmc {}
rename removeCMapTraces {}
rename cfgMap {}
unset khimTestDefaultConfig khimTestErrors khimDir khimMessages

wm state . $khimMainState
unset khimMainState
::tcltest::cleanupTests
return
