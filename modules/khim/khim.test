test khim-5.21 {character map: invalid code page marks the spinbox} -setup {
    khimWidget entry .e
    set res {}
} -body {
    withCharMap .e {
	set bg [$m.spin cget -background]
	foreach v {xyz -1 256 0x100} {
	    $m.spin delete 0 end
	    $m.spin insert 0 $v
	    lappend ::res [$m.spin cget -background]
	}
	$m.spin delete 0 end
	$m.spin insert 0 3
	lappend ::res [expr {[$m.spin cget -background] eq $bg}]
	$m.f.b2 invoke
    }
    lappend res $::khimTestErrors
} -cleanup {
    cleanupAll
    unset -nocomplain res
} -result [list #ff6666 #ff6666 #ff6666 #ff6666 1 {}]

