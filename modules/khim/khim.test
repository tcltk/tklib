	lappend ::res [.khim.lf1.f1.e1 get] [.khim.lf1.f2.e1 get]
	destroy .khim
    }
    lappend res $::khimTestErrors
} -cleanup {
    cleanupAll
    unset -nocomplain res
} -result [list zz \u017e {}]

# Set the sequence and character entries of the options dialog.
proc setSequence {seq char} {
    .khim.lf1.f1.e1 delete 0 end
    .khim.lf1.f1.e1 insert 0 $seq
    .khim.lf1.f2.e1 delete 0 end
    .khim.lf1.f2.e1 insert 0 $char
}

