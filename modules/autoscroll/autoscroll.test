# -*- tcl -*-
# Tests for the autoscroll package

if {![package vsatisfies [package provide Tcl] 8.5-]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring Tcl 8.5, have [package present Tcl]"
    return
}

if {[catch { package require Tk 8.5- } msg]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring Tk 8.5, $msg"
    return
}

if {[lsearch [namespace children] ::tcltest] == -1} {
    package require tcltest 2
    namespace import ::tcltest::*
}

source [file join [file dirname [info script]] autoscroll.tcl]

# -------------------------------------------------------------------------

test autoscroll-1.0 {grid: scrollbar hidden and shown again} -setup {
    wm deiconify .
    text .t -height 5 -yscrollcommand {.s set}
    scrollbar .s -command {.t yview}
    grid .t .s -sticky news
    ::autoscroll::autoscroll .s
} -body {
    .t insert end [string repeat "line\n" 20]
    update
    .t delete 1.0 end
    update
    set res [list [winfo manager .s]]
    .t insert end [string repeat "line\n" 20]
    update
    lappend res [winfo manager .s] [dict get [grid info .s] -column]
} -cleanup {
    destroy .t .s
    wm withdraw .
} -result {{} grid 1}

test autoscroll-1.1 {pack: scrollbar hidden and shown again} -setup {
    wm deiconify .
    text .t -height 5 -yscrollcommand {.s set}
    scrollbar .s -command {.t yview}
    pack .s -side right -fill y
    pack .t -side left -fill both -expand 1
    ::autoscroll::autoscroll .s
} -body {
    .t insert end [string repeat "line\n" 20]
    update
    .t delete 1.0 end
    update
    set res [list [winfo manager .s]]
    .t insert end [string repeat "line\n" 20]
    update
    lappend res [winfo manager .s] [pack slaves .]
} -cleanup {
    destroy .t .s
    wm withdraw .
} -result {{} pack {.s .t}}

test autoscroll-1.2 {pack -in other than parent, ticket 6da48f4579} -setup {
    wm deiconify .
    frame .f
    pack .f -fill both -expand 1
    text .t -height 5 -yscrollcommand {.s set}
    scrollbar .s -command {.t yview}
    pack .s -in .f -side right -fill y
    pack .t -in .f -side left -fill both -expand 1
    ::autoscroll::autoscroll .s
} -body {
    .t insert end [string repeat "line\n" 20]
    update
    .t delete 1.0 end
    update
    set res [list [winfo manager .s]]
    .t insert end [string repeat "line\n" 20]
    update
    lappend res [winfo manager .s] [pack slaves .f] [pack slaves .]
} -cleanup {
    destroy .t .s .f
    wm withdraw .
} -result {{} pack {.s .t} .f}

# -------------------------------------------------------------------------
::tcltest::cleanupTests
