} -body {
    ::dia draw {line from [0 0] to [10 0] with end at [100 100]}
    R [::dia draw {list [[last] start] [[last] end]}]
} -cleanup {
    cleanupDiagram
} -result {{point {90.00 100.00}} {point {100.00 100.00}}}

test diagram-7.19 {line: element references as locations} -setup {
    mkDiagram
} -body {
    ::dia draw {set a [box at [0 0]]; set b [box at [200 0]]; line from $a to $b}
    R [::dia draw {list [[last] start] [[last] end]}]
} -cleanup {
    cleanupDiagram
} -result {{point {0.00 0.00}} {point {200.00 0.00}}}

test diagram-7.20 {arrow, -->, <--, <--> and spline} -setup {
    mkDiagram
} -body {
    set r {}
    foreach a {arrow --> <-- <--> spline} {
	::dia draw "$a from \[0 0\] to \[10 0\] to \[20 10\]"
	lappend r [.c type [lastItem]] [.c itemcget [lastItem] -arrow] \
		[expr {[.c itemcget [lastItem] -smooth] ni {0 false}}]
    }
    lappend r [::dia draw {last arrow}] [::dia draw {last spline}]
} -cleanup {
    cleanupDiagram
    unset r a
} -result {line last 0 line last 0 line first 0 line both 0 line none 1 {element 4} {element 5}}

test diagram-7.21 {line: smooth} -setup {
    mkDiagram
} -body {
    ::dia draw {line from [0 0] to [10 0] smooth}
    expr {[.c itemcget [lastItem] -smooth] ni {0 false}}
} -cleanup {
    cleanupDiagram
} -result 1

test diagram-7.22 {move: no canvas item, corners and layout} -setup {
    mkDiagram
} -body {
    set e [::dia draw {move from [0 0] to [50 0]}]
    list $e [llength [.c find all]] [::dia draw {[last] names}] \
	    [R [::dia draw {list [[last] start] [[last] end] [here]}]] \
	    [::dia draw {last move}]
} -cleanup {
    cleanupDiagram
    unset e
} -result {{element 1} 0 {start end 1 2} {{point {0.00 0.00}} {point {50.00 0.00}} {point {50.00 0.00}}} {element 1}}

test diagram-7.23 {move: changes the location of the next element} -setup {
    mkDiagram
} -body {
    ::dia draw {box; move; box}
    R [::dia draw {expr {[lindex [[2nd box] west] 1 0] - [lindex [[1st box] east] 1 0]}}]
} -cleanup {
    cleanupDiagram
} -result [cm 2]

test diagram-7.24 {arc: corners} -setup {
    mkDiagram
} -body {
    ::dia draw {arc}
    list [::dia draw {[last] names}] [R [::dia draw {[last] radius}]] [.c type [lastItem]]
} -cleanup {
    cleanupDiagram
} -result [list {north east south west center radius width height northeast southeast southwest northwest start end} [cm 1] arc]

test diagram-7.25 {arc: from, to, radius} -setup {
    mkDiagram
} -body {
    ::dia draw {arc from [0 0] to [100 0] radius 100}
    lassign [::dia draw {list [[last] start] [[last] end] [[last] center]}] s e c
    set c [lindex $c 1]
    list [R [list $s $e]] [R [expr {hypot([lindex $c 0], [lindex $c 1])}]] \
	    [R [expr {hypot([lindex $c 0] - 100, [lindex $c 1])}]]
} -cleanup {
    cleanupDiagram
    unset s e c
} -result {{{point {0.00 0.00}} {point {100.00 0.00}}} 100.00 100.00}

test diagram-7.26 {arc: clockwise and counterclockwise centers are opposite} -setup {
    mkDiagram
} -body {
    set r {}
    foreach a {cw clockwise ccw counterclockwise} {
	::dia draw "arc from \[0 0\] to \[100 0\] radius 100 $a"
	lappend r [expr {[lindex [::dia draw {[last] center}] 1 1] > 0}]
    }
    list [expr {[lindex $r 0] == [lindex $r 1]}] [expr {[lindex $r 2] == [lindex $r 3]}] \
	    [expr {[lindex $r 0] != [lindex $r 2]}]
} -cleanup {
    cleanupDiagram
    unset r a
} -result {1 1 1}

test diagram-7.27 {arc: clockwise variable} -setup {
    mkDiagram
} -body {
    ::dia draw {arc from [0 0] to [100 0] radius 100}
    set a [lindex [::dia draw {[last] center}] 1 1]
    ::dia draw {set clockwise 1; arc from [0 0] to [100 0] radius 100}
    set b [lindex [::dia draw {[last] center}] 1 1]
    expr {($a > 0) != ($b > 0)}
} -cleanup {
    cleanupDiagram
    unset a b
} -result 1

test diagram-7.28 {arc: default is a 90 degree arc} -setup {
    mkDiagram
} -body {
    ::dia draw {arc from [0 0]}
    lassign [::dia draw {list [[last] start] [[last] end] [[last] center]}] s e c
    set s [lindex $s 1]; set e [lindex $e 1]; set c [lindex $c 1]
    set v1 [list [expr {[lindex $s 0] - [lindex $c 0]}] [expr {[lindex $s 1] - [lindex $c 1]}]]
    set v2 [list [expr {[lindex $e 0] - [lindex $c 0]}] [expr {[lindex $e 1] - [lindex $c 1]}]]
    R [list [expr {[lindex $v1 0]*[lindex $v2 0] + [lindex $v1 1]*[lindex $v2 1]}] \
	    [expr {hypot([lindex $v1 0], [lindex $v1 1])}] \
	    [expr {hypot([lindex $v2 0], [lindex $v2 1])}]]
} -cleanup {
    cleanupDiagram
    unset s e c v1 v2
} -result [list 0.00 [cm 1] [cm 1]]

# -------------------------------------------------------------------------
# Placement and layout

test diagram-8.1 {elements are placed east of each other} -setup {
    mkDiagram
} -body {
    ::dia draw {box; circle; box}
    R [::dia draw {list [[1st box] east] [[1st circle] west] [[1st circle] east] [[2nd box] west]}]
} -cleanup {
    cleanupDiagram
} -result [list [list point [list [cm 2] 0.00]] [list point [list [cm 2] 0.00]] [list point [list [cm 4] 0.00]] [list point [list [cm 4] 0.00]]]

test diagram-8.2 {west: placement to the west} -setup {
    mkDiagram
} -body {
    ::dia draw {box; west; box}
    R [::dia draw {list [[1st box] west] [[2nd box] east]}]
} -cleanup {
    cleanupDiagram
} -result {{point {0.00 0.00}} {point {0.00 0.00}}}

test diagram-8.3 {at and with} -setup {
    mkDiagram
} -body {
    set r {}
    foreach a {{at [0 0]} {at [0 0] with nw} {at [0 0] with center} {with west at [10 10]}} {
	::dia draw "box width 40 height 20 $a"
	lappend r [R [::dia draw {[last] center}]]
    }
    set r
} -cleanup {
    cleanupDiagram
    unset r a
} -result {{point {0.00 0.00}} {point {20.00 10.00}} {point {0.00 0.00}} {point {30.00 10.00}}}

test diagram-8.4 {at with an element reference} -setup {
    mkDiagram
} -body {
    ::dia draw {set a [circle at [50 60]]; box at $a}
    R [::dia draw {[last box] center}]
} -cleanup {
    cleanupDiagram
} -result {point {50.00 60.00}}

test diagram-8.5 {here} -setup {
    mkDiagram
} -body {
    set r [list [R [::dia draw {here}]]]
    ::dia draw {box}
    lappend r [R [::dia draw {here}]]
} -cleanup {
    cleanupDiagram
    unset r
} -result [list {point {0.00 0.00}} [list point [list [cm 2] 0.00]]]

test diagram-8.6 {block: aggregates elements, exports variables} -setup {
    mkDiagram
} -body {
    set b [::dia draw {block {box at [0 0]; box; set p [here]} at [0 0]}]
    list $b [::dia draw [list $b names]] [R [::dia draw [list $b width]]] \
	    [R [::dia draw [list $b center]]] [R [::dia draw [list $b p]]] \
	    [llength [.c find all]]
} -cleanup {
    cleanupDiagram
    unset b
} -result [list {element 3} [list {*}$ClosedCorners p] [cm 4] {point {0.00 0.00}} [list point [list [cm 2] 0.00]] 2]

test diagram-8.7 {block: history contains only the block afterwards} -setup {
    mkDiagram
} -body {
    set b [::dia draw {circle; block {box; set inner [last]}}]
    list $b [::dia draw {last}] [::dia draw {2nd last}] [::dia draw [list $b inner]] \
	    [catch {::dia draw {last box}}] [catch {::dia draw {set inner}}]
} -cleanup {
    cleanupDiagram
} -result {{element 3} {element 3} {element 1} {element 2} 1 1}

test diagram-8.8 {block: variable changes are reverted} -setup {
    mkDiagram
} -body {
    ::dia draw {block {set boxwidth 30; box}}
    list [R [::dia draw {set boxwidth}]] [R [::dia draw {[last] width}]]
} -cleanup {
    cleanupDiagram
} -result [list [cm 2] 30.00]

test diagram-8.9 {block: attributes become defaults inside} -setup {
    mkDiagram
} -body {
    ::dia draw {block {box} color red}
    list [.c itemcget [lastItem] -outline] [::dia draw {set linecolor}]
} -cleanup {
    cleanupDiagram
} -result {red black}

test diagram-8.10 {block: the layout is restored} -setup {
    mkDiagram
} -body {
    ::dia draw {block {box; west}; box; direction}
} -cleanup {
    cleanupDiagram
} -result east

# Bug: a block without elements fails with an arithmetic error.
test diagram-8.11 {block without elements} -constraints knownBug -setup {
    mkDiagram
} -body {
    ::dia draw {block {set x 1}}
    ::dia draw {set boxwidth}
} -cleanup {
    cleanupDiagram
} -result [cm 2]

test diagram-8.12 {group: the layout is restored} -setup {
    mkDiagram
} -body {
    ::dia draw {box; group {west; circle}; box}
    R [::dia draw {list [[1st box] east] [[2nd box] west]}]
} -cleanup {
    cleanupDiagram
} -result [list [list point [list [cm 2] 0.00]] [list point [list [cm 2] 0.00]]]

# -------------------------------------------------------------------------
# Named directions

test diagram-9.1 {direction names and aliases} -setup {
    mkDiagram
} -body {
    set r {}
    foreach {d names} {
	west {west w left l}
	south {south s down bottom bot b}
	east {east e right r}
	north {north n up top t}
	northwest {northwest nw up-left upleft leftup}
	northeast {northeast ne up-right upright rightup}
	southwest {southwest sw down-left downleft leftdown}
	southeast {southeast se down-right downright rightdown}
    } {
	foreach n $names {
	    if {[::dia draw [list by 1 $n]] ne [::dia draw [list by 1 $d]]} {
		lappend r $n
	    }
	}
    }
    set r
} -cleanup {
    cleanupDiagram
    unset r d names n
} -result {}

test diagram-9.2 {direction angles} -setup {
    mkDiagram
} -body {
    set r {}
    foreach d {east northeast north northwest west southwest south southeast} {
	lappend r [lindex [::dia draw [list by 1 $d]] 1 1]
    }
    set r
} -cleanup {
    cleanupDiagram
    unset r d
} -result {0 45 90 135 180 225 270 315}

test diagram-9.3 {direction commands change the layout direction} -setup {
    mkDiagram
} -body {
    set r {}
    foreach d {north west south east} {
	lappend r [::dia draw "$d; direction"]
    }
    set r
} -cleanup {
    cleanupDiagram
    unset r d
} -result {north west south east}

test diagram-9.4 {horizontal directions} -setup {
    mkDiagram
} -body {
    R [list [::dia draw {[0 0] by 10 east}] [::dia draw {[0 0] by 10 west}]]
} -cleanup {
    cleanupDiagram
} -result {{point {10.00 0.00}} {point {-10.00 0.00}}}

# Bug: since math::geometry 1.4 the vertical component of the directions
# is reversed: north points down (to larger canvas y).
# Tickets e9c4eeae1f and ffcd8611b8.
