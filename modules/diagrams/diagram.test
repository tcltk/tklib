    mkDiagram
} -body {
    R [list [::dia draw {[0 0] by 10 northeast}] [::dia draw {[0 0] by 10 southwest}]]
} -cleanup {
    cleanupDiagram
} -result {{point {7.07 -7.07}} {point {-7.07 7.07}}}

# Tickets e9c4eeae1f and ffcd8611b8.
