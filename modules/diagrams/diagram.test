    mkDiagram
} -body {
    ::dia draw {line from [0 0] then south 20}
    R [::dia draw {[last] end}]
} -cleanup {
    cleanupDiagram
} -result {point {0.00 20.00}}

test diagram-9.8 {layout to the south places elements below} -setup {
    mkDiagram
} -body {
    ::dia draw {box; south; box}
    R [::dia draw {list [[1st box] south] [[2nd box] north]}]
} -cleanup {
    cleanupDiagram
} -result [list [list point [list [cm 1] [cm 1]]] [list point [list [cm 1] [cm 1]]]]

# Tickets e9c4eeae1f and ffcd8611b8.
