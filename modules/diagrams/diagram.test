test diagram-10.1 {absolute point} -setup {
    mkDiagram
} -body {
    ::dia draw {10 20}
} -cleanup {
    cleanupDiagram
} -result {point {10 20}}

test diagram-10.2 {relative point: by} -setup {
    mkDiagram
} -body {
    list [::dia draw {by 10 east}] [::dia draw {by 10 33}]
} -cleanup {
    cleanupDiagram
} -result {{by {10 0}} {by {10 33}}}

test diagram-10.3 {by: wrong # args} -setup {
    mkDiagram
} -body {
    ::dia draw {by 10}
} -cleanup {
    cleanupDiagram
} -returnCodes error -match glob -result {wrong # args: should be "*"}

test diagram-10.4 {point addition} -setup {
    mkDiagram
} -body {
    R [list [::dia draw {[10 20] + [30 40]}] [::dia draw {[10 20] + [by 5 east]}] \
	   [::dia draw {[by 5 east] + [10 20]}] [::dia draw {[by 10 east] + [by 5 east]}]]
} -cleanup {
    cleanupDiagram
} -result {{point {40.00 60.00}} {point {15.00 20.00}} {point {15.00 20.00}} {+ {15.00 0.00}}}

test diagram-10.5 {point subtraction} -setup {
    mkDiagram
} -body {
    R [list [::dia draw {[10 20] - [30 40]}] [::dia draw {[10 20] - [by 5 east]}] \
	   [::dia draw {[by 10 east] - [by 5 east]}]]
} -cleanup {
    cleanupDiagram
} -result {{point {-20.00 -20.00}} {point {5.00 20.00}} {+ {5.00 0.00}}}

test diagram-10.6 {point projection} -setup {
    mkDiagram
} -body {
    ::dia draw {[10 20] | [30 40]}
} -cleanup {
    cleanupDiagram
} -result {point {10 40}}

test diagram-10.7 {point by distance direction} -setup {
    mkDiagram
} -body {
    R [list [::dia draw {[10 20] by 10 east}] [::dia draw {[10 20] by 10 180}]]
} -cleanup {
    cleanupDiagram
} -result {{point {20.00 20.00}} {point {0.00 20.00}}}

test diagram-10.8 {interpolation: between} -setup {
    mkDiagram
} -body {
    set r {}
    foreach n {0 1 0.5 0.25 2 -1} {
	lappend r [R [::dia draw "$n between \[0 0\] \[10 20\]"]]
    }
    set r
} -cleanup {
    cleanupDiagram
    unset r n
} -result {{point {0.00 0.00}} {point {10.00 20.00}} {point {5.00 10.00}} {point {2.50 5.00}} {point {20.00 40.00}} {point {-10.00 -20.00}}}

test diagram-10.9 {intersect} -setup {
    mkDiagram
} -body {
    ::dia draw {set a [line from [0 0] to [100 0]]; set b [line from [50 -50] to [50 50]]}
    R [::dia draw {intersect $a $b}]
} -cleanup {
    cleanupDiagram
} -result {point {50.00 0.00}}

test diagram-10.10 {intersect: extended lines} -setup {
    mkDiagram
} -body {
    ::dia draw {set a [line from [0 0] to [10 0]]; set b [line from [50 10] to [50 20]]}
    R [::dia draw {intersect $a $b}]
} -cleanup {
    cleanupDiagram
} -result {point {50.00 0.00}}

test diagram-10.11 {intersect: parallel lines} -setup {
    mkDiagram
} -body {
    ::dia draw {intersect [line from [0 0] to [10 0]] [line from [0 5] to [10 5]]}
} -cleanup {
    cleanupDiagram
} -returnCodes error -result {Intersection failure, parallel lines have none}

test diagram-10.12 {intersect: coincident lines} -setup {
    mkDiagram
} -body {
    ::dia draw {intersect [line from [0 0] to [10 0]] [line from [20 0] to [30 0]]}
} -cleanup {
    cleanupDiagram
} -returnCodes error -result {Intersection failure, unable to choose among infinite set of points of coincident lines}

test diagram-10.13 {units: cm, mm, inch} -setup {
    mkDiagram
} -body {
    list [R [::dia draw {1 cm}]] [R [::dia draw {10 mm}]] [R [::dia draw {1 inch}]] \
	    [R [::dia draw {2.54 cm}]] [R [::dia draw {0.5 cm}]]
} -cleanup {
    cleanupDiagram
} -result [list [cm 1] [cm 1] [cm 2.54] [cm 2.54] [cm 0.5]]

test diagram-10.14 {units: based on tk scaling} -setup {
    mkDiagram
} -body {
    R [expr {[::dia draw {1 inch}] / [tk scaling]}]
} -cleanup {
    cleanupDiagram
} -result 72.00

# Bug: the unit is implemented as "point", but documented as "pt".
test diagram-10.15 {units: pt} -constraints knownBug -setup {
    mkDiagram
} -body {
    expr {[::dia draw {72 pt}] == [::dia draw {1 inch}]}
} -cleanup {
    cleanupDiagram
} -result 1

test diagram-10.16 {units in attributes} -setup {
    mkDiagram
} -body {
    ::dia draw {box width [3 cm]}
    R [::dia draw {[last] width}]
} -cleanup {
    cleanupDiagram
} -result [cm 3]

# -------------------------------------------------------------------------
# Element queries and history

test diagram-11.1 {element names with pattern} -setup {
    mkDiagram
} -body {
    ::dia draw {set e [box]}
    list [::dia draw {$e names n*}] [::dia draw {$e names x*}] [::dia draw {$e names *th}]
} -cleanup {
    cleanupDiagram
} -result {{north northeast northwest} {} {north south width}}

test diagram-11.2 {element: unknown corner} -setup {
    mkDiagram
} -body {
    ::dia draw {set e [box]; $e nosuchcorner}
} -cleanup {
    cleanupDiagram
} -returnCodes error -match glob -result {*nosuchcorner*}

test diagram-11.3 {element: chained corners} -setup {
    mkDiagram
} -body {
    ::dia draw {set b [block {set inner [box at [0 0] width 20 height 10]}]}
    list [::dia draw {$b inner}] [R [::dia draw {$b inner width}]] \
	    [::dia draw {$b inner names w*}]
} -cleanup {
    cleanupDiagram
} -result {{element 1} 20.00 {west width}}

test diagram-11.4 {element: names takes at most one pattern} -setup {
    mkDiagram
} -body {
    ::dia draw {set e [box]; $e names n* extra}
} -cleanup {
    cleanupDiagram
} -returnCodes error -result {wrong#args: should be "?corner...? ?names ?pattern??"}

# Bug: "<n>th" without arguments fails with a wrong # args error, although
# the corner argument is optional.
test diagram-11.5 {history: nth} -constraints knownBug -setup {
    mkDiagram
} -body {
    ::dia draw {box; circle; box; line}
    list [::dia draw {1th}] [::dia draw {2th}] [::dia draw {4th}] \
	    [::dia draw {1st}] [::dia draw {2nd}] [::dia draw {3rd}]
} -cleanup {
    cleanupDiagram
} -result {{element 1} {element 2} {element 4} {element 1} {element 2} {element 3}}

test diagram-11.6 {history: nth last} -setup {
    mkDiagram
} -body {
    ::dia draw {box; circle; box; line}
    list [::dia draw {1st last}] [::dia draw {2nd last}] [::dia draw {4th last}] \
	    [::dia draw {last}]
} -cleanup {
    cleanupDiagram
} -result {{element 4} {element 3} {element 1} {element 4}}

test diagram-11.7 {history: nth shape, nth last shape, last shape} -setup {
    mkDiagram
} -body {
    ::dia draw {box; circle; box; line; box}
    list [::dia draw {1st box}] [::dia draw {2nd box}] [::dia draw {3rd box}] \
	    [::dia draw {1st circle}] [::dia draw {2nd last box}] \
	    [::dia draw {last box}] [::dia draw {last line}]
} -cleanup {
    cleanupDiagram
} -result {{element 1} {element 3} {element 5} {element 2} {element 3} {element 5} {element 4}}

test diagram-11.8 {history: with corner} -setup {
    mkDiagram
} -body {
    ::dia draw {box at [0 0]; circle at [100 0]}
    R [list [::dia draw {1st center}] [::dia draw {last center}] \
	    [::dia draw {1st box east}] [::dia draw {last box west}] \
	    [::dia draw {1st last circle center}] [::dia draw {last circle radius}]]
} -cleanup {
    cleanupDiagram
} -result [R [list {point {0 0}} {point {100 0}} [list point [list $CM 0]] [list point [list -$CM 0]] {point {100 0}} $CM]]

test diagram-11.9 {history: too many arguments} -setup {
    mkDiagram
    ::dia draw {box}
} -body {
    ::dia draw {1st box east extra}
} -cleanup {
    cleanupDiagram
} -returnCodes error -result {wrong#args: should be "?n'th? ?last? ?shape? ?corner?"}

test diagram-11.10 {history: nth with corner} -setup {
    mkDiagram
    ::dia draw {box at [0 0]; circle at [100 0]}
} -body {
    R [list [::dia draw {2nd center}] [::dia draw {1st width}]]
} -cleanup {
    cleanupDiagram
} -result [list {point {100.00 0.00}} [cm 2]]

# -------------------------------------------------------------------------
# Variables

test diagram-12.1 {variable defaults} -setup {
    mkDiagram
} -body {
    set r {}
    foreach v {anchor arrowhead clockwise diamondaspect drumaspect fillcolor
	       justify linecolor linewidth slant textcolor} {
	lappend r $v [::dia draw [list set $v]]
    }
    set r
} -cleanup {
    cleanupDiagram
    unset r v
} -result {anchor center arrowhead none clockwise 0 diamondaspect 2 drumaspect 0.35 fillcolor {} justify left linecolor black linewidth 1 slant 90 textcolor black}

test diagram-12.2 {variable defaults: distances} -setup {
    mkDiagram
} -body {
    set r {}
    foreach v {arcradius boxheight boxwidth circleradius movelength} {
	lappend r $v [R [::dia draw [list set $v]]]
    }
    set r
} -cleanup {
    cleanupDiagram
    unset r v
} -result [list arcradius [cm 1] boxheight [cm 2] boxwidth [cm 2] circleradius [cm 1] movelength [cm 2]]

test diagram-12.3 {variable defaults: linestyle is solid} -setup {
    mkDiagram
} -body {
    expr {[::dia draw {set linestyle}] in {solid {}}}
} -cleanup {
    cleanupDiagram
} -result 1

test diagram-12.4 {variable defaults: textfont is Helvetica 12pt} -setup {
    mkDiagram
} -body {
    set f [::dia draw {set textfont}]
    list [lindex $f 0] [string trimright [lindex $f 1] pt]
} -cleanup {
    cleanupDiagram
    unset f
} -result {Helvetica 12}

test diagram-12.5 {variables are used as defaults} -setup {
    mkDiagram
} -body {
    ::dia draw {
	set boxwidth 30; set boxheight 20; set linecolor red; set fillcolor yellow
	set linewidth 2; set linestyle -
	box
    }
    set i [lastItem]
    list [R [::dia draw {list [[last] width] [[last] height]}]] \
	    [.c itemcget $i -outline] [.c itemcget $i -fill] \
	    [R [.c itemcget $i -width]] [.c itemcget $i -dash]
} -cleanup {
    cleanupDiagram
    unset i
} -result {{30.00 20.00} red yellow 2.00 -}

# Bug: the values of the linestyle variable are not transformed, so the
# documented names like "dashed" are rejected by the canvas.
test diagram-12.5.1 {variables: linestyle names} -constraints knownBug -setup {
    mkDiagram
} -body {
    ::dia draw {set linestyle dashed; box}
    .c itemcget [lastItem] -dash
} -cleanup {
    cleanupDiagram
} -result -

test diagram-12.6 {variables are used as defaults: circle, arc, text} -setup {
    mkDiagram
} -body {
    ::dia draw {
	set circleradius 15; circle
	set arcradius 25; arc
	set textcolor blue; set textfont {Courier 9}; set justify center
	text text A
    }
    list [R [::dia draw {[last circle] radius}]] [R [::dia draw {[last arc] radius}]] \
	    [.c itemcget [lastItem] -fill] [.c itemcget [lastItem] -font] \
	    [.c itemcget [lastItem] -justify]
} -cleanup {
    cleanupDiagram
} -result {15.00 25.00 blue {Courier 9} center}

test diagram-12.7 {variables: movelength} -setup {
    mkDiagram
} -body {
    ::dia draw {set movelength 40; line from [0 0]}
    R [::dia draw {[last] end}]
} -cleanup {
    cleanupDiagram
} -result {point {40.00 0.00}}

test diagram-12.8 {variables: anchor} -setup {
    mkDiagram
} -body {
    ::dia draw {set anchor west; box text Hello at [100 100]}
    lassign [.c bbox [lastItem]] x1 y1 x2 y2
    expr {$x1 >= 98}
} -cleanup {
    cleanupDiagram
    unset x1 y1 x2 y2
} -result 1

test diagram-12.9 {variables: slant} -setup {
    mkDiagram
} -body {
    ::dia draw {set slant 45; box}
    .c type [lastItem]
} -cleanup {
    cleanupDiagram
} -result polygon

test diagram-12.10 {variables: drumaspect} -setup {
    mkDiagram
} -body {
    ::dia draw {drum width 40 height 60 aspect 0.5 at [0 0]}
    set a [lmap i [.c find all] {R [.c coords $i]}]
    .c delete all
    ::dia draw {set drumaspect 0.5; drum width 40 height 60 at [0 0]}
    set b [lmap i [.c find all] {R [.c coords $i]}]
    expr {$a eq $b}
} -cleanup {
    cleanupDiagram
    unset a b
} -result 1

# -------------------------------------------------------------------------

rename mkDiagram {}
rename cleanupDiagram {}
rename R {}
rename cm {}
rename lastItem {}
rename itemTypes {}
foreach p {DrawMark DrawAbsolute DrawTurn DrawTagged} {
    rename ::$p {}
}
unset CM ClosedCorners p

::tcltest::cleanupTests
