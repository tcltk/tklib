    mkDiagram
} -body {
    R [list [::dia draw {[0 0] by 10 north}] [::dia draw {[0 0] by 10 south}]]
} -cleanup {
    cleanupDiagram
} -result {{point {0.00 -10.00}} {point {0.00 10.00}}}

# Tickets e9c4eeae1f and ffcd8611b8.
