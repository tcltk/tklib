    list [::dia draw {[last] names}] \
	    [R [::dia draw {list [[last] start] [[last] end] [[last] center] [[last] 3]}]] \
	    [.c type [lastItem]] [R [.c coords [lastItem]]]
} -cleanup {
    cleanupDiagram
} -result {{start end center 1 2 3 4} {{point {0.00 0.00}} {point {20.00 10.00}} {point {10.00 5.00}} {point {10.00 10.00}}} line {0.00 0.00 10.00 0.00 10.00 10.00 20.00 10.00}}

