# -*- tcl -*-
# crosshair.test --
#
#	Tests for the crosshair package: crosshair::crosshair, off,
#	configure, track on/off, bbox_add and bbox_remove.
#
if {![package vsatisfies [package provide Tcl] 8.5-]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring Tcl 8.5, have [package present Tcl]"
    return
}

if {[catch { package require Tk 8.5- } msg]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring Tk 8.5, $msg"
    return
}

if {[lsearch [namespace children] ::tcltest] == -1} {
    package require tcltest 2.2
    namespace import ::tcltest::*
} else {
    if {![package vsatisfies [package present tcltest] 2.2]} {
	puts "    Aborting the tests found in \"[file tail [info script]]\"."
	puts "    Requiring tcltest 2.2, have [package present tcltest]"
	return
    }
}

::tcltest::testConstraint tk 1

source [file join [file dirname [info script]] crosshair.tcl]

# -------------------------------------------------------------------------
# Helpers

# The tklib test harness withdraws ".", which is needed mapped for the
# canvas to receive events.  Restore its state at the end.
set mainState [wm state .]
wm deiconify .
wm geometry . +0+0

proc mkcanvas {{w .c}} {
    canvas $w -width 300 -height 200 -highlightthickness 0 -borderwidth 0
    pack $w
    update
    return $w
}

# Coordinates of the crosshair line items (all items of type line),
# sorted, so that the result does not depend on creation order.
proc hairs {w} {
    set res {}
    foreach i [$w find all] {
	if {[$w type $i] eq "line"} {
	    set c {}
	    foreach v [$w coords $i] {lappend c [expr {round($v)}]}
	    lappend res $c
	}
    }
    lsort $res
}

proc move {w x y} {
    event generate $w <Motion> -x $x -y $y
}

proc record {args} {
    lappend ::trace $args
}

# -------------------------------------------------------------------------
# crosshair::crosshair

test crosshair-1.1 {crosshair: wrong # args} -body {
    crosshair::crosshair
} -returnCodes error -result {wrong # args: should be "crosshair::crosshair w ?arg ...?"}

test crosshair-1.2 {crosshair: result is empty} -setup {
    mkcanvas
} -body {
    crosshair::crosshair .c
} -cleanup {
    destroy .c
} -result {}

test crosshair-1.3 {crosshair: Crosshair bind tag inserted after the widget tag} -setup {
    mkcanvas
} -body {
    crosshair::crosshair .c
    bindtags .c
} -cleanup {
    destroy .c
} -result {.c Crosshair Canvas . all}

test crosshair-1.4 {crosshair: nothing is drawn before pointer motion} -setup {
    mkcanvas
} -body {
    crosshair::crosshair .c
    .c find all
} -cleanup {
    destroy .c
} -result {}

test crosshair-1.5 {crosshair: motion draws four lines around the pointer} -setup {
    mkcanvas
} -body {
    crosshair::crosshair .c
    move .c 50 60
    hairs .c
} -cleanup {
    destroy .c
} -result {{0 60 46 60} {50 0 50 56} {50 64 50 200} {54 60 300 60}}

test crosshair-1.6 {crosshair: lines follow the pointer} -setup {
    mkcanvas
} -body {
    crosshair::crosshair .c
    move .c 50 60
    set ids [lsort -integer [.c find all]]
    move .c 120 30
    list [expr {[lsort -integer [.c find all]] eq $ids}] [hairs .c]
} -cleanup {
    destroy .c
    unset -nocomplain ids
} -result {1 {{0 30 116 30} {120 0 120 26} {120 34 120 200} {124 30 300 30}}}

test crosshair-1.7 {crosshair: line options are applied} -setup {
    mkcanvas
} -body {
    crosshair::crosshair .c -fill red -width 3
    move .c 50 60
    set res {}
    foreach i [.c find all] {
	lappend res [.c itemcget $i -fill] [.c itemcget $i -width]
    }
    set res
} -cleanup {
    destroy .c
    unset -nocomplain res i
} -result {red 3.0 red 3.0 red 3.0 red 3.0}

test crosshair-1.8 {crosshair: bad line option fails on display} -setup {
    mkcanvas
} -body {
    crosshair::crosshair .c -foo bar
    ::crosshair::Move .c 50 60
} -cleanup {
    destroy .c
} -returnCodes error -result {unknown option "-foo"}

test crosshair-1.9 {crosshair: lines are raised above other items} -setup {
    mkcanvas
} -body {
    crosshair::crosshair .c
    move .c 50 60
    set r [.c create rectangle 10 10 100 100]
    move .c 55 65
    expr {[lindex [.c find all] 0] == $r}
} -cleanup {
    destroy .c
    unset -nocomplain r
} -result 1

test crosshair-1.10 {crosshair: Leave hides, Enter shows} -setup {
    mkcanvas
} -body {
    crosshair::crosshair .c
    move .c 50 60
    set res [llength [.c find all]]
    event generate .c <Leave>
    lappend res [llength [.c find all]]
    event generate .c <Leave>
    lappend res [llength [.c find all]]
    event generate .c <Enter> -x 70 -y 80
    lappend res [hairs .c]
} -cleanup {
    destroy .c
    unset -nocomplain res
} -result {4 0 0 {{0 80 66 80} {70 0 70 76} {70 84 70 200} {74 80 300 80}}}

test crosshair-1.11 {crosshair: coordinates in a scrolled canvas} -setup {
    mkcanvas
    .c configure -scrollregion {0 0 1000 1000}
    .c xview moveto 0.1
    .c yview moveto 0.2
    update
} -body {
    crosshair::crosshair .c
    move .c 50 60
    hairs .c
} -cleanup {
    destroy .c
} -result {{100 260 146 260} {150 200 150 256} {150 264 150 400} {154 260 400 260}}

test crosshair-1.12 {crosshair: independent crosshairs in two canvases} -setup {
    mkcanvas .c
    mkcanvas .d
} -body {
    crosshair::crosshair .c -fill red
    crosshair::crosshair .d -fill blue
    move .c 50 60
    move .d 70 80
    list [hairs .c] [hairs .d] [.d itemcget [lindex [.d find all] 0] -fill]
} -cleanup {
    destroy .c .d
} -result {{{0 60 46 60} {50 0 50 56} {50 64 50 200} {54 60 300 60}} {{0 80 66 80} {70 0 70 76} {70 84 70 200} {74 80 300 80}} blue}

# -------------------------------------------------------------------------
# crosshair::off

test crosshair-2.1 {off: wrong # args} -body {
    crosshair::off
} -returnCodes error -result {wrong # args: should be "crosshair::off w"}

test crosshair-2.2 {off: removes the lines and the bind tag} -setup {
    mkcanvas
} -body {
    crosshair::crosshair .c
    move .c 50 60
    list [crosshair::off .c] [.c find all] [bindtags .c]
} -cleanup {
    destroy .c
} -result {{} {} {.c Canvas . all}}

test crosshair-2.3 {off: motion no longer draws crosshairs} -setup {
    mkcanvas
} -body {
    crosshair::crosshair .c
    crosshair::off .c
    move .c 50 60
    .c find all
} -cleanup {
    destroy .c
} -result {}

test crosshair-2.4 {off: canvas without crosshairs is a no-op} -setup {
    mkcanvas
} -body {
    list [crosshair::off .c] [bindtags .c]
} -cleanup {
    destroy .c
} -result {{} {.c Canvas . all}}

test crosshair-2.5 {off: nonexistent window is a no-op} -body {
    crosshair::off .nosuchwindow
} -result {}

test crosshair-2.6 {off: other items are kept} -setup {
    mkcanvas
} -body {
    set r [.c create rectangle 10 10 20 20]
    crosshair::crosshair .c
    move .c 50 60
    crosshair::off .c
    expr {[.c find all] eq $r}
} -cleanup {
    destroy .c
    unset -nocomplain r
} -result 1

test crosshair-2.7 {off: crosshairs can be reactivated} -setup {
    mkcanvas
} -body {
    crosshair::crosshair .c
    crosshair::off .c
    crosshair::crosshair .c -fill green
    move .c 50 60
    list [bindtags .c] [.c itemcget [lindex [.c find all] 0] -fill]
} -cleanup {
    destroy .c
} -result {{.c Crosshair Canvas . all} green}

test crosshair-2.8 {destroying the canvas removes the crosshair state} -setup {
    mkcanvas
} -body {
    crosshair::crosshair .c
    move .c 50 60
    destroy .c
    list [catch {crosshair::configure .c} msg] $msg
} -cleanup {
    unset -nocomplain msg
} -result {1 {no crosshairs in .c}}

# -------------------------------------------------------------------------
# crosshair::configure

test crosshair-3.1 {configure: wrong # args} -body {
    crosshair::configure
} -returnCodes error -result {wrong # args: should be "crosshair::configure w ?arg ...?"}

test crosshair-3.2 {configure: canvas without crosshairs} -setup {
    mkcanvas
} -body {
    crosshair::configure .c -fill red
} -cleanup {
    destroy .c
} -returnCodes error -result {no crosshairs in .c}

test crosshair-3.3 {configure: query without options} -setup {
    mkcanvas
} -body {
    crosshair::crosshair .c -fill red
    crosshair::configure .c
} -cleanup {
    destroy .c
} -result {-fill red}

test crosshair-3.4 {configure: query of unconfigured crosshairs} -setup {
    mkcanvas
} -body {
    crosshair::crosshair .c
    crosshair::configure .c
} -cleanup {
    destroy .c
} -result {}

test crosshair-3.5 {configure: options are merged, result is the settings} -setup {
    mkcanvas
} -body {
    crosshair::crosshair .c -fill red
    set res [list [dict get [crosshair::configure .c -dash -] -dash]]
    set d [crosshair::configure .c -fill blue]
    lappend res [dict get $d -fill] [dict get $d -dash] [dict size $d]
    lappend res [dict get [crosshair::configure .c] -fill]
} -cleanup {
    destroy .c
    unset -nocomplain res d
} -result {- blue - 2 blue}

test crosshair-3.6 {configure: applies to visible crosshairs} -setup {
    mkcanvas
} -body {
    crosshair::crosshair .c -fill red
    move .c 50 60
    crosshair::configure .c -fill blue -width 2
    set res {}
    foreach i [.c find all] {
	lappend res [.c itemcget $i -fill] [.c itemcget $i -width]
    }
    set res
} -cleanup {
    destroy .c
    unset -nocomplain res i
} -result {blue 2.0 blue 2.0 blue 2.0 blue 2.0}

test crosshair-3.7 {configure: applies to crosshairs shown later} -setup {
    mkcanvas
} -body {
    crosshair::crosshair .c -fill red
    crosshair::configure .c -fill blue
    move .c 50 60
    .c itemcget [lindex [.c find all] 0] -fill
} -cleanup {
    destroy .c
} -result blue

test crosshair-3.8 {configure: bad option on visible crosshairs} -setup {
    mkcanvas
} -body {
    crosshair::crosshair .c
    move .c 50 60
    crosshair::configure .c -foo bar
} -cleanup {
    destroy .c
} -returnCodes error -result {unknown option "-foo"}

# -------------------------------------------------------------------------
# crosshair::track

test crosshair-4.1 {track: wrong # args} -body {
    crosshair::track on
} -returnCodes error -result {wrong # args: should be "crosshair::track which w ?arg ...?"}

test crosshair-4.2 {track on: canvas without crosshairs} -setup {
    mkcanvas
} -body {
    crosshair::track on .c record
} -cleanup {
    destroy .c
} -returnCodes error -result {no crosshairs in .c}

test crosshair-4.3 {track off: canvas without crosshairs} -setup {
    mkcanvas
} -body {
    crosshair::track off .c
} -cleanup {
    destroy .c
} -returnCodes error -result {no crosshairs in .c}

test crosshair-4.4 {track on: missing command prefix} -setup {
    mkcanvas
    crosshair::crosshair .c
} -body {
    crosshair::track on .c
} -cleanup {
    destroy .c
} -returnCodes error -result {wrong#args: Expected 'on w cmdprefix'}

test crosshair-4.5 {track on: too many arguments} -setup {
    mkcanvas
    crosshair::crosshair .c
} -body {
    crosshair::track on .c record extra
} -cleanup {
    destroy .c
} -returnCodes error -result {wrong#args: Expected 'on w cmdprefix'}

test crosshair-4.6 {track off: too many arguments} -setup {
    mkcanvas
    crosshair::crosshair .c
} -body {
    crosshair::track off .c record
} -cleanup {
    destroy .c
} -returnCodes error -result {wrong#args: Expected 'off w'}

test crosshair-4.7 {track on: result is empty, callback gets 7 arguments} -setup {
    mkcanvas
    crosshair::crosshair .c
    set ::trace {}
} -body {
    set res [crosshair::track on .c {record a}]
    move .c 50 60
    move .c 70 80
    list $res $::trace
} -cleanup {
    destroy .c
    unset -nocomplain res ::trace
} -result {{} {{a .c 50.0 60.0 0.0 0.0 300.0 200.0} {a .c 70.0 80.0 0.0 0.0 300.0 200.0}}}

test crosshair-4.8 {track on: viewport of a scrolled canvas} -setup {
    mkcanvas
    .c configure -scrollregion {0 0 1000 1000}
    .c xview moveto 0.1
    .c yview moveto 0.2
    update
    crosshair::crosshair .c
    set ::trace {}
} -body {
    crosshair::track on .c record
    move .c 50 60
    set ::trace
} -cleanup {
    destroy .c
    unset -nocomplain ::trace
} -result {{.c 150.0 260.0 100.0 200.0 400.0 400.0}}

test crosshair-4.9 {track on: callback is called at global level} -setup {
    mkcanvas
    crosshair::crosshair .c
    set ::trace {}
} -body {
    crosshair::track on .c {apply {args {lappend ::trace [uplevel 1 {info level}]}}}
    move .c 50 60
    set ::trace
} -cleanup {
    destroy .c
    unset -nocomplain ::trace
} -result 0

test crosshair-4.10 {track on: new callback replaces the previous one} -setup {
    mkcanvas
    crosshair::crosshair .c
    set ::trace {}
} -body {
    crosshair::track on .c {record a}
    crosshair::track on .c {record b}
    move .c 50 60
    set ::trace
} -cleanup {
    destroy .c
    unset -nocomplain ::trace
} -result {{b .c 50.0 60.0 0.0 0.0 300.0 200.0}}

test crosshair-4.11 {track off: result is empty, callback disabled} -setup {
    mkcanvas
    crosshair::crosshair .c
    set ::trace {}
} -body {
    crosshair::track on .c record
    move .c 50 60
    set res [crosshair::track off .c]
    move .c 70 80
    list $res [llength $::trace] [llength [hairs .c]]
} -cleanup {
    destroy .c
    unset -nocomplain res ::trace
} -result {{} 1 4}

test crosshair-4.12 {track off: without active callback} -setup {
    mkcanvas
    crosshair::crosshair .c
} -body {
    crosshair::track off .c
} -cleanup {
    destroy .c
} -result {}

test crosshair-4.13 {track: callback per canvas} -setup {
    mkcanvas .c
    mkcanvas .d
    crosshair::crosshair .c
    crosshair::crosshair .d
    set ::trace {}
} -body {
    crosshair::track on .c {record c}
    crosshair::track on .d {record d}
    move .d 10 20
    move .c 30 40
    set ::trace
} -cleanup {
    destroy .c .d
    unset -nocomplain ::trace
} -result {{d .d 10.0 20.0 0.0 0.0 300.0 200.0} {c .c 30.0 40.0 0.0 0.0 300.0 200.0}}

test crosshair-4.14 {track: no callback after off} -setup {
    mkcanvas
    crosshair::crosshair .c
    set ::trace {}
} -body {
    crosshair::track on .c record
    crosshair::off .c
    move .c 50 60
    list $::trace [catch {crosshair::track off .c} msg] $msg
} -cleanup {
    destroy .c
    unset -nocomplain ::trace msg
} -result {{} 1 {no crosshairs in .c}}

# -------------------------------------------------------------------------
# crosshair::bbox_add

test crosshair-5.1 {bbox_add: wrong # args} -body {
    crosshair::bbox_add .c
} -returnCodes error -result {wrong # args: should be "crosshair::bbox_add w bbox"}

test crosshair-5.2 {bbox_add: canvas without crosshairs} -setup {
    mkcanvas
} -body {
    crosshair::bbox_add .c {10 10 100 100}
} -cleanup {
    destroy .c
} -returnCodes error -result {no crosshairs in .c}

test crosshair-5.3 {bbox_add: returns distinct tokens} -setup {
    mkcanvas
    crosshair::crosshair .c
} -body {
    set t1 [crosshair::bbox_add .c {10 10 100 100}]
    set t2 [crosshair::bbox_add .c {10 10 100 100}]
    list [expr {$t1 ne ""}] [expr {$t1 ne $t2}]
} -cleanup {
    destroy .c
    unset -nocomplain t1 t2
} -result {1 1}

test crosshair-5.4 {bbox_add: crosshairs hidden outside the box} -setup {
    mkcanvas
    crosshair::crosshair .c
} -body {
    crosshair::bbox_add .c {100 50 200 150}
    move .c 50 60
    hairs .c
} -cleanup {
    destroy .c
} -result {}

test crosshair-5.5 {bbox_add: crosshairs confined to the box} -setup {
    mkcanvas
    crosshair::crosshair .c
} -body {
    crosshair::bbox_add .c {100 50 200 150}
    move .c 150 80
    hairs .c
} -cleanup {
    destroy .c
} -result {{100 80 146 80} {150 50 150 76} {150 84 150 150} {154 80 200 80}}

test crosshair-5.6 {bbox_add: crosshairs disappear when leaving the box} -setup {
    mkcanvas
    crosshair::crosshair .c
} -body {
    crosshair::bbox_add .c {100 50 200 150}
    move .c 150 80
    set res [llength [hairs .c]]
    move .c 250 80
    lappend res [llength [hairs .c]]
    move .c 150 80
    lappend res [llength [hairs .c]]
} -cleanup {
    destroy .c
    unset -nocomplain res
} -result {4 0 4}

test crosshair-5.7 {bbox_add: the box border is outside} -setup {
    mkcanvas
    crosshair::crosshair .c
} -body {
    crosshair::bbox_add .c {100 50 200 150}
    set res {}
    foreach {x y} {100 80 200 80 150 50 150 150 101 51 199 149} {
	move .c $x $y
	lappend res [llength [hairs .c]]
    }
    set res
} -cleanup {
    destroy .c
    unset -nocomplain res x y
} -result {0 0 0 0 4 4}

test crosshair-5.8 {bbox_add: no tracking callback outside the box} -setup {
    mkcanvas
    crosshair::crosshair .c
    set ::trace {}
} -body {
    crosshair::bbox_add .c {100 50 200 150}
    crosshair::track on .c record
    move .c 50 60
    move .c 150 80
    set ::trace
} -cleanup {
    destroy .c
    unset -nocomplain ::trace
} -result {{.c 150.0 80.0 100.0 50.0 200.0 150.0}}

test crosshair-5.9 {bbox_add: two disjoint boxes} -setup {
    mkcanvas
    crosshair::crosshair .c
} -body {
    crosshair::bbox_add .c {10 10 100 100}
    crosshair::bbox_add .c {150 50 250 150}
    move .c 50 60
    set res [list [hairs .c]]
    move .c 120 60
    lappend res [hairs .c]
    move .c 200 100
    lappend res [hairs .c]
} -cleanup {
    destroy .c
    unset -nocomplain res
} -result {{{10 60 46 60} {50 10 50 56} {50 64 50 100} {54 60 100 60}} {} {{150 100 196 100} {200 104 200 150} {200 50 200 96} {204 100 250 100}}}

test crosshair-5.10 {bbox_add: corners can be given in any order} -setup {
    mkcanvas
    crosshair::crosshair .c
} -body {
    crosshair::bbox_add .c {200 150 100 50}
    move .c 150 80
    hairs .c
} -cleanup {
    destroy .c
} -result {{100 80 146 80} {150 50 150 76} {150 84 150 150} {154 80 200 80}}

test crosshair-5.11 {bbox_add: the visible area is the union of the boxes} -setup {
    mkcanvas
    crosshair::crosshair .c
} -constraints knownBug -body {
    # Inside both boxes the lines must extend to the outer borders of
    # the union.  The code takes the union horizontally but the
    # intersection vertically.
    crosshair::bbox_add .c {10 10 100 100}
    crosshair::bbox_add .c {50 50 150 150}
    move .c 75 75
    hairs .c
} -cleanup {
    destroy .c
} -result {{10 75 71 75} {75 10 75 71} {75 79 75 150} {79 75 150 75}}

test crosshair-5.12 {bbox_add: union of nested boxes} -setup {
    mkcanvas
    crosshair::crosshair .c
} -constraints knownBug -body {
    # Same bug as crosshair-5.11: vertically the inner box wins.
    crosshair::bbox_add .c {10 10 200 150}
    crosshair::bbox_add .c {50 50 100 100}
    move .c 75 75
    hairs .c
} -cleanup {
    destroy .c
} -result {{10 75 71 75} {75 10 75 71} {75 79 75 150} {79 75 200 75}}

# -------------------------------------------------------------------------
# crosshair::bbox_remove

test crosshair-6.1 {bbox_remove: wrong # args} -body {
    crosshair::bbox_remove
} -returnCodes error -result {wrong # args: should be "crosshair::bbox_remove token"}

test crosshair-6.2 {bbox_remove: not a token} -body {
    crosshair::bbox_remove foo
} -returnCodes error -result {Expected a bbox token, got "foo"}

test crosshair-6.3 {bbox_remove: removing the only box removes the confinement} -setup {
    mkcanvas
    crosshair::crosshair .c
} -constraints knownBug -body {
    # bbox_remove matches its regexp against "->" instead of the
    # token, so it rejects every token.  It also decrements the index
    # taken from the token, which is already 0-based.
    set t [crosshair::bbox_add .c {100 50 200 150}]
    set res [list [crosshair::bbox_remove $t]]
    move .c 50 60
    lappend res [hairs .c]
} -cleanup {
    destroy .c
    unset -nocomplain t res
} -result {{} {{0 60 46 60} {50 0 50 56} {50 64 50 200} {54 60 300 60}}}

test crosshair-6.4 {bbox_remove: other boxes remain active} -setup {
    mkcanvas
    crosshair::crosshair .c
} -constraints knownBug -body {
    set t1 [crosshair::bbox_add .c {10 10 100 100}]
    set t2 [crosshair::bbox_add .c {150 50 250 150}]
    crosshair::bbox_remove $t1
    move .c 50 60
    set res [list [hairs .c]]
    move .c 200 100
    lappend res [hairs .c]
} -cleanup {
    destroy .c
    unset -nocomplain t1 t2 res
} -result {{} {{150 100 196 100} {200 104 200 150} {200 50 200 96} {204 100 250 100}}}

test crosshair-6.5 {bbox_remove: removing the last added box} -setup {
    mkcanvas
    crosshair::crosshair .c
} -constraints knownBug -body {
    set t1 [crosshair::bbox_add .c {10 10 100 100}]
    set t2 [crosshair::bbox_add .c {150 50 250 150}]
    crosshair::bbox_remove $t2
    move .c 200 100
    set res [list [hairs .c]]
    move .c 50 60
    lappend res [hairs .c]
} -cleanup {
    destroy .c
    unset -nocomplain t1 t2 res
} -result {{} {{10 60 46 60} {50 10 50 56} {50 64 50 100} {54 60 100 60}}}

test crosshair-6.6 {bbox_remove: crosshairs removed from the canvas} -setup {
    mkcanvas
    crosshair::crosshair .c
} -constraints knownBug -body {
    set t [crosshair::bbox_add .c {100 50 200 150}]
    crosshair::off .c
    crosshair::bbox_remove $t
} -cleanup {
    destroy .c
    unset -nocomplain t
} -returnCodes error -result {no crosshairs in .c}

# -------------------------------------------------------------------------

rename mkcanvas {}
rename hairs {}
rename move {}
rename record {}
wm state . $mainState
unset mainState

::tcltest::cleanupTests
