# -*- tcl -*-
# Test cases of the widget::listentry and widget::listsimple packages

if {![package vsatisfies [package provide Tcl] 8.5-]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring Tcl 8.5, have [package present Tcl]"
    return
}

if {[catch { package require Tk 8.5- } msg]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring Tk 8.5, $msg"
    return
}

package require tcltest 2.2
namespace import ::tcltest::*

package require snit
package require msgcat
package require tooltip
package require widget::scrolledwindow
package require widget::validator

# Tk 8.6+ reads PNG images itself; with Tk 8.5 the packages need Img.
testConstraint png [expr {[package vsatisfies [package provide Tk] 8.6-]
	|| ![catch {package require img::png}]}]

# -------------------------------------------------------------------------

test widgetl-load-1.1 {listsimple loads and shows its png icons without Img} -constraints png -body {
    source [file join [file dirname [info script]] listsimple.tcl]
    widget::listsimple .l
    pack .l
    update
    image type [.l.add cget -image]
} -result photo

test widgetl-load-1.2 {listentry loads without Img} -constraints png -body {
    source [file join [file dirname [info script]] listentry.tcl]
    widget::listentry .le
    pack .le
    update
    winfo class .le
} -result Listentry

# -------------------------------------------------------------------------

# Destroy the widgets only at the end: widget::validator keeps references
# to destroyed entries and raises background errors on later style changes.
destroy .l .le
::tcltest::cleanupTests
