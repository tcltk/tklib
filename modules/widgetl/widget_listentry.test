if {![package vsatisfies [package provide Tcl] 8.5-]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring Tcl 8.5, have [package present Tcl]"
    return
}

if {[catch { package require Tk 8.5- } msg]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring Tk 8.5, $msg"
    return
}

package require tcltest 2.2
namespace import ::tcltest::*

lappend auto_path [file dirname [file dirname [file normalize [info script]]]]

# The package requires img::png (see ticket d74509223b), but Tk 8.6 and
# later read PNG images natively.  Provide a placeholder if Img is not
# installed, so that the rest of the package can be tested.
testConstraint haveImg [expr {![catch {package require img::png}]}]
if {![testConstraint haveImg]} {
    package provide img::png 0
}

# -------------------------------------------------------------------------

test widget_listentry-0.1 {package can be loaded without Img} -constraints {
    knownBug
} -setup {
    # Ticket d74509223b: the package requires img::png instead of png.
    interp create child
    load {} Tk child
    child eval [list set auto_path $auto_path]
} -body {
    child eval {package require widget::listentry}
} -cleanup {
    interp delete child
} -result 0.1.2

package require widget::listentry

# Keyboard tests need a viewable main window (test runners withdraw it).
set oldmainstate [wm state .]
wm deiconify .
update

set oldlocale [msgcat::mclocale]
msgcat::mclocale en

# -------------------------------------------------------------------------
# Helpers

proc mk {args} {
    eval [list widget::listentry .le] $args
    pack .le
    update
    return .le
}

# Destroy the widget.  The validator attached to the entry field is not
# detached when the widget is destroyed (see widget_listentry-1.14), so
# forget it explicitly.
proc cleanupLe {} {
    destroy .le
    dict unset ::widget::validator::attached .le.e
}

# Put the text into the entry field.
proc type {text} {
    .le.e delete 0 end
    .le.e insert 0 $text
}

# Enter the text and press the Add button.
proc add {text} {
    type $text
    .le.add invoke
}

# Press a button (some commands return with code break).
proc press {b} {
    catch {$b invoke}
    update
}

proc states {args} {
    set res {}
    foreach b $args {
        lappend res [expr {[.le$b instate disabled] ? "disabled" : "normal"}]
    }
    set res
}

proc tipOf {w} {
    lindex $::tooltip::tooltip($w) 0
}

proc values {cmd args} {
    switch -exact -- $cmd {
        get {return $::mru}
        set {lappend ::saved [lindex $args 0]}
    }
}

proc browse {cvar} {
    upvar #0 $cvar cookie
    lappend ::cookies $cookie
    set cookie [expr {$cookie eq "" ? 1 : $cookie + 1}]
    return $::browsed
}

# -------------------------------------------------------------------------
# Creation and options

test widget_listentry-1.1 {creation: returns the path name} -body {
    widget::listentry .le
} -cleanup {
    cleanupLe
} -result .le

test widget_listentry-1.2 {creation: components} -body {
    widget::listentry .le
    list [winfo class .le.e] [winfo class .le.l] [winfo class .le.add] \
        [winfo class .le.rem] [winfo exists .le.up] [winfo exists .le.down] \
        [winfo exists .le.b]
} -cleanup {
    cleanupLe
} -result {TEntry Listbox TButton TButton 0 0 0}

test widget_listentry-1.3 {creation: default options} -body {
    widget::listentry .le
    list [.le cget -state] [.le cget -height] [.le cget -ordered] \
        [.le cget -allow-duplicates] [.le cget -listvariable] \
        [.le cget -values] [.le cget -validate] [.le cget -transform] \
        [.le cget -browse] [.le cget -skin-invalid-color]
} -cleanup {
    cleanupLe
} -result {normal 20 no no {} {} {} {} {} {}}

test widget_listentry-1.4 {creation: unknown option} -body {
    widget::listentry .le -foo 1
} -returnCodes error -match glob -result {*unknown option "-foo"}

test widget_listentry-1.5 {creation: bad -ordered value} -body {
    widget::listentry .le -ordered foo
} -returnCodes error -match glob -result {*invalid -ordered value: invalid boolean "foo"*}

test widget_listentry-1.6 {creation: bad -allow-duplicates value} -body {
    widget::listentry .le -allow-duplicates foo
} -returnCodes error -match glob -result {*invalid -allow-duplicates value: invalid boolean "foo"*}

test widget_listentry-1.7 {creation: initial state of buttons} -body {
    mk
    states .add .rem
} -cleanup {
    cleanupLe
} -result {disabled disabled}

test widget_listentry-1.8 {construction-time only options} -setup {
    mk
} -body {
    set res {}
    foreach o {-ordered -allow-duplicates -values -validate -transform -browse} {
        lappend res [catch {.le configure $o 1} msg] $msg
    }
    set res
} -cleanup {
    cleanupLe
    unset -nocomplain res o msg
} -result {1 {option -ordered can only be set at instance creation} 1 {option -allow-duplicates can only be set at instance creation} 1 {option -values can only be set at instance creation} 1 {option -validate can only be set at instance creation} 1 {option -transform can only be set at instance creation} 1 {option -browse can only be set at instance creation}}

test widget_listentry-1.9 {configure: list all options} -setup {
    mk
} -body {
    set names {}
    foreach item [.le configure] {lappend names [lindex $item 0]}
    lsort $names
} -cleanup {
    cleanupLe
    unset -nocomplain names item
} -result [lsort {-allow-duplicates -browse -height -listvariable -ordered
    -skin-add -skin-browse -skin-down -skin-img-add -skin-img-browse
    -skin-img-down -skin-img-remove -skin-img-up -skin-invalid-color
    -skin-remove -skin-tip-add -skin-tip-add-none -skin-tip-browse
    -skin-tip-down -skin-tip-duplicate -skin-tip-empty -skin-tip-entry
    -skin-tip-list -skin-tip-main -skin-tip-remove -skin-tip-remove-none
    -skin-tip-up -skin-up -state -transform -validate -values}]

test widget_listentry-1.10 {configure option is an alias of cget} -constraints {
    knownBug
} -setup {
    # The documentation says that "configure option" is identical to
    # "cget option", but it returns the full option description.
    mk -height 7
} -body {
    .le configure -height
} -cleanup {
    cleanupLe
} -result 7

test widget_listentry-1.11 {configure returns empty string} -setup {
    mk
} -body {
    .le configure -height 5 -skin-add Plus
} -cleanup {
    cleanupLe
} -result {}

test widget_listentry-1.12 {destroy method} -constraints {
    knownBug
} -setup {
    # The documented destroy method does not exist.
    mk
} -body {
    list [.le destroy] [winfo exists .le] [info commands .le]
} -cleanup {
    cleanupLe
} -result {{} 0 {}}

test widget_listentry-1.13 {cget: unknown option} -setup {
    mk
} -body {
    .le cget -foo
} -cleanup {
    cleanupLe
} -returnCodes error -result {unknown option "-foo"}

test widget_listentry-1.14 {create again after destroy} -constraints {
    knownBug
} -setup {
    # The validator is not detached from the entry field, because it is
    # already destroyed when the destructor runs.
    widget::listentry .le
    destroy .le
} -body {
    widget::listentry .le
} -cleanup {
    cleanupLe
} -result .le

# -------------------------------------------------------------------------
# Adding and removing

test widget_listentry-2.1 {entering text enables Add} -setup {
    mk
} -body {
    set res [list [states .add]]
    type foo
    lappend res [states .add] [.le.e instate invalid]
    type {}
    lappend res [states .add] [.le.e instate invalid]
} -cleanup {
    cleanupLe
    unset -nocomplain res
} -result {disabled normal 0 disabled 1}

test widget_listentry-2.2 {Add moves the text into the list} -setup {
    set L {}
    mk -listvariable ::L
} -body {
    add foo
    add bar
    list $L [.le.l get 0 end] [.le.e get] [states .add]
} -cleanup {
    cleanupLe
    unset -nocomplain L
} -result {{foo bar} {foo bar} {} disabled}

test widget_listentry-2.3 {Add ignores empty text} -setup {
    set L {}
    mk -listvariable ::L
} -body {
    add {}
    .le.l get 0 end
} -cleanup {
    cleanupLe
    unset -nocomplain L
} -result {}

test widget_listentry-2.4 {duplicates are refused} -setup {
    set L {foo}
    mk -listvariable ::L
} -body {
    type foo
    set res [list [states .add] [.le.e instate invalid]]
    .le.add invoke
    lappend res $L
} -cleanup {
    cleanupLe
    unset -nocomplain L res
} -result {disabled 1 foo}

test widget_listentry-2.5 {-allow-duplicates} -setup {
    set L {foo}
    mk -listvariable ::L -allow-duplicates 1
} -body {
    add foo
    set L
} -cleanup {
    cleanupLe
    unset -nocomplain L
} -result {foo foo}

test widget_listentry-2.6 {Return key adds} -setup {
    set L {}
    mk -listvariable ::L
    focus -force .le.e
    update
} -body {
    type foo
    event generate .le.e <Key-Return>
    event generate .le.e <Key-KP_Enter>
    type bar
    event generate .le.e <Key-KP_Enter>
    update
    set L
} -cleanup {
    cleanupLe
    unset -nocomplain L
} -result {foo bar}

test widget_listentry-2.7 {selection enables Remove} -setup {
    set L {a b c}
    mk -listvariable ::L
} -body {
    set res [states .rem]
    .le.l selection set 1
    event generate .le.l <<ListboxSelect>>
    update
    lappend res [states .rem]
} -cleanup {
    cleanupLe
    unset -nocomplain L res
} -result {disabled normal}

test widget_listentry-2.8 {Remove deletes the selected elements} -setup {
    set L {a b c d}
    mk -listvariable ::L
} -body {
    .le.l selection set 0
    .le.l selection set 2
    event generate .le.l <<ListboxSelect>>
    update
    .le.rem invoke
    list $L [states .rem]
} -cleanup {
    cleanupLe
    unset -nocomplain L
} -result {{b d} disabled}

test widget_listentry-2.9 {Delete key removes} -setup {
    set L {a b c}
    mk -listvariable ::L
    focus -force .le.l
    update
} -body {
    .le.l selection set 1
    event generate .le.l <<ListboxSelect>>
    update
    event generate .le.l <Key-Delete>
    update
    set L
} -cleanup {
    cleanupLe
    unset -nocomplain L
} -result {a c}

test widget_listentry-2.10 {removed element can be added again} -setup {
    set L {a b}
    mk -listvariable ::L
} -body {
    type a
    set res [states .add]
    .le.l selection set 0
    event generate .le.l <<ListboxSelect>>
    update
    .le.rem invoke
    # The entry is revalidated only when it changes.
    type a
    lappend res [states .add]
    .le.add invoke
    lappend res $L
} -cleanup {
    cleanupLe
    unset -nocomplain L res
} -result {disabled normal {b a}}

# -------------------------------------------------------------------------
# -listvariable

test widget_listentry-3.1 {-listvariable: initial contents} -setup {
    set L {x y z}
} -body {
    mk -listvariable ::L
    .le.l get 0 end
} -cleanup {
    cleanupLe
    unset -nocomplain L
} -result {x y z}

test widget_listentry-3.2 {-listvariable: external changes are imported} -setup {
    set L {x y z}
    mk -listvariable ::L
} -body {
    set L {p q}
    .le.l get 0 end
} -cleanup {
    cleanupLe
    unset -nocomplain L
} -result {p q}

test widget_listentry-3.3 {-listvariable: namespace variable} -setup {
    namespace eval ::letest {variable L {a}}
    mk -listvariable ::letest::L
} -body {
    add b
    set ::letest::L
} -cleanup {
    cleanupLe
    namespace delete ::letest
} -result {a b}

test widget_listentry-3.4 {-listvariable: change at runtime} -setup {
    set L1 {a b}
    set L2 {c d}
    mk -listvariable ::L1
} -body {
    type c
    set res [list [states .add]]
    .le configure -listvariable ::L2
    lappend res [.le cget -listvariable] [.le.l get 0 end] [states .add]
    .le.e delete 0 end
    add e
    lappend res $L1 $L2
} -cleanup {
    cleanupLe
    unset -nocomplain L1 L2 res
} -result {normal ::L2 {c d} disabled {a b} {c d e}}

test widget_listentry-3.5 {-listvariable: unset at creation} -body {
    mk -listvariable ::L
    add a
    set L
} -cleanup {
    cleanupLe
    unset -nocomplain L
} -result a

# -------------------------------------------------------------------------
# -state and -height

test widget_listentry-4.1 {-state disabled} -setup {
    set L {a b}
    mk -listvariable ::L -ordered 1
} -body {
    type c
    .le configure -state disabled
    list [.le cget -state] [states .add .rem .e .up .down]
} -cleanup {
    cleanupLe
    unset -nocomplain L
} -result {disabled {disabled disabled disabled disabled disabled}}

test widget_listentry-4.2 {-state disabled: keyboard Add is ignored} -setup {
    set L {a b}
    mk -listvariable ::L
    type c
    .le configure -state disabled
    focus -force .le
    update
} -body {
    event generate .le <Key-Return>
    update
    set L
} -cleanup {
    cleanupLe
    unset -nocomplain L
} -result {a b}

test widget_listentry-4.3 {-state normal restores the button states} -setup {
    set L {a b}
    mk -listvariable ::L -ordered 1
    type c
    .le configure -state disabled
} -body {
    .le configure -state normal
    list [.le cget -state] [states .add .rem .e .up .down]
} -cleanup {
    cleanupLe
    unset -nocomplain L
} -result {normal {normal disabled normal disabled disabled}}

test widget_listentry-4.4 {-state: bad value} -setup {
    mk
} -body {
    .le configure -state foo
} -cleanup {
    cleanupLe
} -returnCodes error -result {Bad state "foo"}

test widget_listentry-4.5 {-state: bad value keeps the old value} -constraints {
    knownBug
} -setup {
    # The option value is saved before it is checked.
    mk
} -body {
    catch {.le configure -state foo}
    .le cget -state
} -cleanup {
    cleanupLe
} -result normal

test widget_listentry-4.6 {-height} -body {
    mk -height 5
    set res [list [.le cget -height] [.le.l cget -height]]
    .le configure -height 12
    lappend res [.le cget -height] [.le.l cget -height]
} -cleanup {
    cleanupLe
    unset -nocomplain res
} -result {5 5 12 12}

# -------------------------------------------------------------------------
# -ordered

test widget_listentry-5.1 {-ordered: up and down buttons} -body {
    mk -ordered 1
    list [winfo class .le.up] [winfo class .le.down] [states .up .down]
} -cleanup {
    cleanupLe
} -result {TButton TButton {disabled disabled}}

test widget_listentry-5.2 {-ordered: button states follow the selection} -setup {
    set L {a b c}
    mk -listvariable ::L -ordered 1
} -body {
    set res {}
    foreach i {0 1 2} {
        .le.l selection clear 0 end
        .le.l selection set $i
        event generate .le.l <<ListboxSelect>>
        update
        lappend res [states .up .down]
    }
    set res
} -cleanup {
    cleanupLe
    unset -nocomplain L res i
} -result {{disabled normal} {normal normal} {normal disabled}}

test widget_listentry-5.3 {-ordered: move up} -setup {
    set L {a b c d}
    mk -listvariable ::L -ordered 1
    .le.l selection set 2 3
    event generate .le.l <<ListboxSelect>>
    update
} -body {
    press .le.up
    set res [list $L [.le.l curselection] [states .up .down]]
    press .le.up
    lappend res $L [.le.l curselection] [states .up .down]
} -cleanup {
    cleanupLe
    unset -nocomplain L res
} -result {{a c d b} {1 2} {normal normal} {c d a b} {0 1} {disabled normal}}

test widget_listentry-5.4 {-ordered: move down} -setup {
    set L {a b c d}
    mk -listvariable ::L -ordered 1
    .le.l selection set 0
    event generate .le.l <<ListboxSelect>>
    update
} -body {
    press .le.down
    press .le.down
    set res [list $L [.le.l curselection] [states .up .down]]
    press .le.down
    lappend res $L [.le.l curselection] [states .up .down]
} -cleanup {
    cleanupLe
    unset -nocomplain L res
} -result {{b c a d} 2 {normal normal} {b c d a} 3 {normal disabled}}

test widget_listentry-5.5 {-ordered: Control-Up and Control-Down} -setup {
    set L {a b c}
    mk -listvariable ::L -ordered 1
    focus -force .le.l
    update
    .le.l selection set 1
    event generate .le.l <<ListboxSelect>>
    update
} -body {
    event generate .le.l <Control-Key-Up>
    update
    set res [list $L]
    event generate .le.l <Control-Key-Down>
    event generate .le.l <Control-Key-Down>
    update
    lappend res $L
} -cleanup {
    cleanupLe
    unset -nocomplain L res
} -result {{b a c} {a c b}}

test widget_listentry-5.6 {-ordered: move without -listvariable} -constraints {
    knownBug
} -setup {
    # The list is written into the global variable with the empty name.
    mk -ordered 1
    add a
    add b
    .le.l selection set 1
    event generate .le.l <<ListboxSelect>>
    update
} -body {
    press .le.up
    list [.le.l get 0 end] [uplevel #0 {info exists {}}]
} -cleanup {
    cleanupLe
    uplevel #0 {unset -nocomplain {}}
} -result {{b a} 0}

test widget_listentry-5.7 {-ordered 0: no Control-Up binding} -setup {
    set L {a b c}
    mk -listvariable ::L
} -body {
    list [bind .le <Control-Key-Up>] [bind .le <Key-Return>] ne {}
} -cleanup {
    cleanupLe
    unset -nocomplain L
} -match glob -result {{} * ne {}}

# -------------------------------------------------------------------------
# -validate and -transform

test widget_listentry-6.1 {-validate: custom validation} -setup {
    proc validate {text errvar} {
        upvar #0 $errvar err
        lappend ::validated $text
        if {![string is integer -strict $text]} {
            set err "Not an integer"
            return 0
        }
        return 1
    }
    set validated {}
    set L {}
    mk -listvariable ::L -validate validate
} -body {
    type abc
    set res [list [states .add] [.le.e instate invalid] [tipOf .le.e]]
    type 12
    lappend res [states .add] [.le.e instate invalid]
    .le.add invoke
    lappend res $L [expr {"abc" in $validated}]
} -cleanup {
    cleanupLe
    rename validate {}
    unset -nocomplain validated L res
} -result [list disabled 1 "Enter a new value\n* Not an integer" normal 0 12 1]

test widget_listentry-6.2 {-validate: empty text can be valid} -setup {
    set L {}
    mk -listvariable ::L -validate {apply {{text errvar} {return 1}}}
} -body {
    add {}
    set L
} -cleanup {
    cleanupLe
    unset -nocomplain L
} -result {{}}

test widget_listentry-6.3 {-validate: duplicates are refused anyway} -setup {
    set L {a}
    mk -listvariable ::L -validate {apply {{text errvar} {return 1}}}
} -body {
    type a
    list [states .add] [tipOf .le.e]
} -cleanup {
    cleanupLe
    unset -nocomplain L
} -result [list disabled "Enter a new value\n* The list already contains this item"]

test widget_listentry-6.4 {-transform: applied when adding} -setup {
    set L {}
    mk -listvariable ::L -transform {string toupper}
} -body {
    add abc
    set L
} -cleanup {
    cleanupLe
    unset -nocomplain L
} -result ABC

test widget_listentry-6.5 {-transform: used for duplicate check} -setup {
    set L {ABC}
    mk -listvariable ::L -transform {string toupper}
} -body {
    type abc
    states .add
} -cleanup {
    cleanupLe
    unset -nocomplain L
} -result disabled

test widget_listentry-6.6 {-transform with -allow-duplicates} -setup {
    set L {ABC}
    mk -listvariable ::L -transform {string toupper} -allow-duplicates 1
} -body {
    add abc
    set L
} -cleanup {
    cleanupLe
    unset -nocomplain L
} -result {ABC ABC}

# -------------------------------------------------------------------------
# -values

test widget_listentry-7.1 {-values: combobox filled from the callback} -setup {
    set mru {one two}
} -body {
    mk -values values
    list [winfo class .le.e] [.le.e cget -values]
} -cleanup {
    cleanupLe
    unset -nocomplain mru
} -result {TCombobox {one two}}

test widget_listentry-7.2 {-values: new values are saved} -setup {
    set mru {one two}
    set saved {}
    set L {}
    mk -values values -listvariable ::L
} -body {
    add three
    add two
    list $L $saved [.le.e cget -values]
} -cleanup {
    cleanupLe
    unset -nocomplain mru saved L
} -result {{three two} {{three one two} {two three one}} {two three one}}

test widget_listentry-7.3 {-values: selecting from the combobox} -setup {
    set mru {one two}
    set saved {}
    set L {}
    mk -values values -listvariable ::L
} -body {
    .le.e current 1
    set res [list [.le.e get] [states .add]]
    .le.add invoke
    lappend res $L
} -cleanup {
    cleanupLe
    unset -nocomplain mru saved L res
} -result {two normal two}

# -------------------------------------------------------------------------
# -browse

test widget_listentry-8.1 {-browse: button} -body {
    mk -browse browse
    list [winfo class .le.b] [.le.b cget -text] [tipOf .le.b]
} -cleanup {
    cleanupLe
} -result {TButton Browse... {Search for elements}}

test widget_listentry-8.2 {-browse: adds the returned elements} -setup {
    set L {a}
    set cookies {}
    mk -browse browse -listvariable ::L
} -body {
    set browsed {b a c {}}
    .le.b invoke
    set browsed {d}
    .le.b invoke
    set browsed {}
    .le.b invoke
    list $L $cookies
} -cleanup {
    cleanupLe
    unset -nocomplain L cookies browsed
} -result {{a b c d} {{} 1 2}}

test widget_listentry-8.3 {-browse: disabled state} -setup {
    mk -browse browse
} -body {
    .le configure -state disabled
    set res [.le.b instate disabled]
    .le configure -state normal
    lappend res [.le.b instate disabled]
} -cleanup {
    cleanupLe
    unset -nocomplain res
} -result {1 0}

# -------------------------------------------------------------------------
# Skin

test widget_listentry-9.1 {skin: default texts} -body {
    mk -ordered 1
    list [.le.add cget -text] [.le.rem cget -text] [.le.up cget -text] \
        [.le.down cget -text]
} -cleanup {
    cleanupLe
} -result {Add Remove Up Down}

test widget_listentry-9.2 {skin: default texts in German} -setup {
    msgcat::mclocale de
} -body {
    mk -ordered 1
    list [.le.add cget -text] [.le.rem cget -text]
} -cleanup {
    cleanupLe
    msgcat::mclocale en
} -result {Hinzufuegen Entfernen}

test widget_listentry-9.3 {skin: texts at runtime} -body {
    mk -ordered 1 -browse browse
    .le configure -skin-add Plus -skin-remove Minus
    set res [list [.le.add cget -text] [.le.rem cget -text]]
    .le configure -skin-add P -skin-remove M -skin-up U -skin-down D \
        -skin-browse B
    lappend res [.le.add cget -text] [.le.rem cget -text] \
        [.le.up cget -text] [.le.down cget -text] [.le.b cget -text] \
        [.le cget -skin-add]
} -cleanup {
    cleanupLe
    unset -nocomplain res
} -result {Plus Minus P M U D B P}

test widget_listentry-9.4 {skin: texts are message catalog keys} -setup {
    namespace eval ::widget::listentry {
        msgcat::mcset en test.plus {Plus key}
    }
} -body {
    mk
    .le configure -skin-add test.plus
    .le.add cget -text
} -cleanup {
    cleanupLe
} -result {Plus key}

test widget_listentry-9.5 {skin: up/down texts without -ordered} -body {
    mk
    .le configure -skin-up U -skin-down D -skin-browse B \
        -skin-img-up {} -skin-tip-up X
    list [.le cget -skin-up] [.le cget -skin-tip-up]
} -cleanup {
    cleanupLe
} -result {U X}

test widget_listentry-9.6 {skin: default tooltips} -setup {
    set L {}
    mk -listvariable ::L
} -body {
    list [tipOf .le] [tipOf .le.add] [tipOf .le.rem] [tipOf .le.e] \
        [tipOf .le.l]
} -cleanup {
    cleanupLe
    unset -nocomplain L
} -result [list {List of values} \
               "Add a new value to the list\n* Nothing to enter" \
               "Remove the selected values from the list\n* Nothing selected for removal" \
               "Enter a new value\n* Empty" \
               "List of values\n* Empty"]

test widget_listentry-9.7 {skin: tooltip options} -setup {
    set L {a}
    mk -listvariable ::L
    .le configure -skin-tip-main Main
} -body {
    set res [list [tipOf .le]]
    .le configure -skin-tip-main M -skin-tip-add A -skin-tip-add-none N \
        -skin-tip-entry E -skin-tip-empty Y -skin-tip-list L
    lappend res [tipOf .le] [tipOf .le.add] [tipOf .le.e] [tipOf .le.l]
    type a
    .le configure -skin-tip-duplicate Dup
    lappend res [tipOf .le.add] [tipOf .le.e]
} -cleanup {
    cleanupLe
    unset -nocomplain L res
} -result [list Main M "A\n* N" "E\n* Y" L "A\n* Dup" "E\n* Dup"]

test widget_listentry-9.8 {skin: default images} -body {
    mk -ordered 1 -browse browse
    set res {}
    foreach b {add rem up down b} {
        set img [.le.$b cget -image]
        lappend res [image type $img] [expr {[image width $img] > 0}]
    }
    set res
} -cleanup {
    cleanupLe
    unset -nocomplain res b img
} -result {photo 1 photo 1 photo 1 photo 1 photo 1}

test widget_listentry-9.9 {skin: custom images} -setup {
    image create photo testimg1 -width 4 -height 4
    image create photo testimg2 -width 4 -height 4
} -body {
    mk -ordered 1 -browse browse
    .le configure -skin-img-add testimg1
    set res [list [.le.add cget -image]]
    .le configure -skin-img-remove testimg2 -skin-img-up testimg1 \
        -skin-img-down testimg2 -skin-img-browse testimg1
    lappend res [.le.rem cget -image] [.le.up cget -image] \
        [.le.down cget -image] [.le.b cget -image]
} -cleanup {
    cleanupLe
    image delete testimg1 testimg2
    unset -nocomplain res
} -result {testimg1 testimg2 testimg1 testimg2 testimg1}

test widget_listentry-9.10 {skin: invalid color} -body {
    mk
    set map [ttk::style map [.le.e cget -style] -fieldbackground]
    set res [list [lindex $map [expr {[lsearch -exact $map invalid] + 1}]]]
    .le configure -skin-invalid-color pink
    set map [ttk::style map [.le.e cget -style] -fieldbackground]
    lappend res [lindex $map [expr {[lsearch -exact $map invalid] + 1}]] \
        [.le.e instate invalid]
} -cleanup {
    cleanupLe
    unset -nocomplain res map
} -result {yellow pink 1}

test widget_listentry-9.11 {skin: invalid color at creation} -constraints {
    knownBug
} -body {
    # Skin options can not be specified at creation, see 9.12.
    mk -skin-invalid-color pink
    set map [ttk::style map [.le.e cget -style] -fieldbackground]
    lindex $map [expr {[lsearch -exact $map invalid] + 1}]
} -cleanup {
    cleanupLe
    unset -nocomplain map
} -result pink

test widget_listentry-9.12 {skin: texts at creation} -constraints {
    knownBug
} -body {
    # The configure methods of the skin options access the internal
    # widgets before they are created.
    mk -ordered 1 -browse browse -skin-add Plus -skin-remove Minus \
        -skin-up U -skin-down D -skin-browse B
    list [.le.add cget -text] [.le.rem cget -text] [.le.up cget -text] \
        [.le.down cget -text] [.le.b cget -text]
} -cleanup {
    cleanupLe
} -result {Plus Minus U D B}

test widget_listentry-9.13 {skin: tooltips at creation} -constraints {
    knownBug
} -body {
    # See 9.12.
    mk -skin-tip-main Main -skin-tip-entry Entry
    list [tipOf .le] [tipOf .le.e]
} -cleanup {
    cleanupLe
} -result [list Main "Entry\n* Empty"]

test widget_listentry-9.14 {skin: images at creation} -constraints {
    knownBug
} -setup {
    # See 9.12.
    image create photo testimg1 -width 4 -height 4
} -body {
    mk -skin-img-add testimg1 -skin-img-remove testimg1
    list [.le.add cget -image] [.le.rem cget -image]
} -cleanup {
    cleanupLe
    image delete testimg1
} -result {testimg1 testimg1}

# -------------------------------------------------------------------------
msgcat::mclocale $oldlocale
unset oldlocale
if {$oldmainstate eq "withdrawn"} {
    wm withdraw .
}
unset oldmainstate
foreach p {cleanupLe mk type add press states tipOf values browse} {rename $p {}}
unset p
if {![testConstraint haveImg]} {
    package forget img::png
}
::tcltest::cleanupTests
