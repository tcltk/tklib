# -*- tcl -*-
# Tests for the controlwidget packages

if {![package vsatisfies [package provide Tcl] 8.5-]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring Tcl 8.5, have [package present Tcl]"
    return
}

if {[catch { package require Tk 8.5- } msg]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring Tk 8.5, $msg"
    return
}

if {[lsearch [namespace children] ::tcltest] == -1} {
    package require tcltest 2
    namespace import ::tcltest::*
}

if {[catch {package require snit} msg]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring snit, $msg"
    return
}

source [file join [file dirname [info script]] tachometer.tcl]

# -------------------------------------------------------------------------

proc needle {w} {
    $w.c coords [$w cget -indexid]
}

test tachometer-1.0 {create with default size} -body {
    controlwidget::tachometer .t
} -cleanup {
    destroy .t
} -result .t

test tachometer-1.1 {integer -min, -max and value, ticket b845a924db} -setup {
    set ::tvalue1 0
    set ::tvalue2 0
    controlwidget::tachometer .t1 -variable ::tvalue1 -min 0 -max 10
    controlwidget::tachometer .t2 -variable ::tvalue2 -min 0.0 -max 10.0
} -body {
    set ::tvalue1 1
    set ::tvalue2 1.0
    expr {[needle .t1] eq [needle .t2]}
} -cleanup {
    destroy .t1 .t2
    unset -nocomplain ::tvalue1 ::tvalue2
} -result 1

test tachometer-1.2 {needle moves with the value} -setup {
    set ::tvalue 0
    controlwidget::tachometer .t -variable ::tvalue -min 0 -max 10
} -body {
    set ::tvalue 1
    set c1 [needle .t]
    set ::tvalue 2
    expr {$c1 ne [needle .t]}
} -cleanup {
    destroy .t
    unset -nocomplain ::tvalue c1
} -result 1

rename needle {}

# -------------------------------------------------------------------------
::tcltest::cleanupTests
