# -*- tcl -*-
# Tests for the controlwidget packages

if {![package vsatisfies [package provide Tcl] 8.5-]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring Tcl 8.5, have [package present Tcl]"
    return
}

if {[catch { package require Tk 8.5- } msg]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring Tk 8.5, $msg"
    return
}

if {[lsearch [namespace children] ::tcltest] == -1} {
    package require tcltest 2
    namespace import ::tcltest::*
}

if {[catch {package require snit} msg]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring snit, $msg"
    return
}

source [file join [file dirname [info script]] rdial.tcl]

# -------------------------------------------------------------------------

test rdial-1.0 {create with default width, ticket 7ae7ab1e83} -body {
    controlwidget::rdial .r
} -cleanup {
    destroy .r
} -result .r

test rdial-1.1 {create vertical with default width} -body {
    controlwidget::rdial .r -orient vertical
    llength [.r.c find withtag all]
} -cleanup {
    destroy .r
} -match glob -result {[1-9]*}

test rdial-1.2 {create with explicit width} -body {
    controlwidget::rdial .r -width 200
    .r.c cget -width
} -cleanup {
    destroy .r
} -result 200

# -------------------------------------------------------------------------
::tcltest::cleanupTests
