# -*- tcl -*-
# Tests for the controlwidget packages

if {![package vsatisfies [package provide Tcl] 8.5-]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring Tcl 8.5, have [package present Tcl]"
    return
}

if {[catch { package require Tk 8.5- } msg]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring Tk 8.5, $msg"
    return
}

if {[lsearch [namespace children] ::tcltest] == -1} {
    package require tcltest 2
    namespace import ::tcltest::*
}

if {[catch {package require snit} msg]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring snit, $msg"
    return
}

source [file join [file dirname [info script]] vertical_meter.tcl]

# -------------------------------------------------------------------------

test thermometer-2.1 {set changes the value} -body {
    controlwidget::thermometer .t
    .t set 30
    .t get
} -cleanup {
    destroy .t
} -result 30

test thermometer-2.2 {the value follows -variable} -setup {
    set ::tvalue 10
} -body {
    controlwidget::thermometer .t -variable ::tvalue
    set ::tvalue 40
    set r [.t get]
    .t set 20
    lappend r [.t get] $::tvalue
} -cleanup {
    destroy .t
    unset -nocomplain ::tvalue r
} -result {40 20 20}

# -------------------------------------------------------------------------
::tcltest::cleanupTests
