test controlwidget-8.19 {rdial: mouse wheel with -slow and -fast} -constraints x11 -body {
    controlwidget::rdial .d -width 100 -slow 0.5 -fast 3
    pack .d
    update
    event generate .d.c <ButtonPress-4> -state 1
