# slider

test controlwidget-3.1 {slider: default creation} -body {
    controlwidget::slider .s
    list [winfo class .s] [.s cget -number]
} -cleanup {
    cleanupWidgets
} -result {Slider 1}

test controlwidget-3.2 {slider: set and get, one slider} -body {
    controlwidget::slider .s
    .s set 0.5
    .s get
} -cleanup {
    cleanupWidgets
} -result 0.5

test controlwidget-3.3 {slider: set and get, several sliders} -body {
    controlwidget::slider .s -number 3
    .s set {0.1 0.2 0.3}
    .s get
} -cleanup {
    cleanupWidgets
} -result {0.1 0.2 0.3}

test controlwidget-3.4 {slider: set moves the slider handles} -body {
    controlwidget::slider .s -number 2
    set y0 [lindex [.s.c bbox slider0] 1]
    set y1 [lindex [.s.c bbox slider1] 1]
    .s set {1 -1}
    list [expr {[lindex [.s.c bbox slider0] 1] < $y0}] \
	[expr {[lindex [.s.c bbox slider1] 1] > $y1}]
} -cleanup {
    cleanupWidgets
    unset y0 y1
} -result {1 1}

test controlwidget-3.5 {slider: -variable} -setup {
    set ::cwvar {0 0}
} -body {
    controlwidget::slider .s -number 2 -variable ::cwvar
    .s set {0.5 -0.5}
    set r [list $::cwvar [.s get]]
    set ::cwvar {0.25 0.75}
    lappend r [.s get]
} -cleanup {
    cleanupWidgets
    unset ::cwvar r
} -result {{0.5 -0.5} {0.5 -0.5} {0.25 0.75}}

test controlwidget-3.6 {slider: -variable, initial value} -setup {
    set ::cwvar {0.5 -0.5}
} -body {
    controlwidget::slider .s -number 2 -variable ::cwvar
    .s get
} -cleanup {
    cleanupWidgets
    unset ::cwvar
} -result {0.5 -0.5}

test controlwidget-3.7 {slider: dragging a handle changes the variable} -setup {
    set ::cwvar {0 0}
} -body {
    controlwidget::slider .s -number 2 -variable ::cwvar
    pack .s
    update
    dragItem .s.c slider1 -20
    list [lindex $::cwvar 0] [expr {[lindex $::cwvar 1] > 0}]
} -cleanup {
    cleanupWidgets
    unset ::cwvar
} -result {0 1}

test controlwidget-3.8 {slider: configure -variable after creation} -constraints knownBug -setup {
    set ::cwvar {0}
    set ::cwvar2 {0.5}
} -body {
    # Calls the nonexistent method needleTo
    controlwidget::slider .s -variable ::cwvar
    .s configure -variable ::cwvar2
    .s get
} -cleanup {
    cleanupWidgets
    unset ::cwvar ::cwvar2
} -result 0.5

test controlwidget-3.9 {slider: read-only options} -body {
    controlwidget::slider .s -number 2
    set res {}
    foreach opt {-number -sliderthickness -sliderwidth -troughwidth} {
	lappend res [catch {.s configure $opt 5} msg] $msg
    }
    set res
} -cleanup {
    cleanupWidgets
    unset res opt msg
} -result {1 {option -number can only be set at instance creation} 1 {option -sliderthickness can only be set at instance creation} 1 {option -sliderwidth can only be set at instance creation} 1 {option -troughwidth can only be set at instance creation}}

test controlwidget-3.10 {slider: -number must be an integer} -body {
    controlwidget::slider .s -number x
} -cleanup {
    cleanupWidgets
} -returnCodes error -match glob -result {*invalid -number value*}

test controlwidget-3.11 {slider: -sliderwidth and -troughwidth} -body {
    controlwidget::slider .s -sliderwidth 30 -troughwidth 6 -sliderthickness 14
    lassign [.s.c bbox slider0] x0 y0 x1 y1
    list [expr {abs(($x1 - $x0) - 30) <= 2}] [expr {abs(($y1 - $y0) - 14) <= 2}]
} -cleanup {
    cleanupWidgets
    unset x0 y0 x1 y1
} -result {1 1}

test controlwidget-3.12 {slider: -height} -body {
    controlwidget::slider .s -height 100
    set h1 [.s.c cget -height]
    controlwidget::slider .s2 -height 300
    expr {[.s2.c cget -height] - $h1 == 200}
} -cleanup {
    cleanupWidgets
    unset h1
} -result 1

test controlwidget-3.13 {slider: -background} -body {
    controlwidget::slider .s -background yellow
    .s.c cget -background
} -cleanup {
    cleanupWidgets
} -result yellow

test controlwidget-3.14 {slider: axis labels} -body {
    controlwidget::slider .s -from 0 -to 100 -majorticks 50
    uniq [canvasTexts .s.c]
} -cleanup {
    cleanupWidgets
} -result {0 50 1e+02}

# -------------------------------------------------------------------------
# equalizerBar

# Fill colors of the segments of an equalizer bar, bottom to top
proc segmentColors {w} {
    set res {}
    foreach i [$w.c find all] {
	if {[$w.c type $i] eq "rectangle"} {
	    lappend res [$w.c itemcget $i -fill]
	}
    }
    return $res
}

test controlwidget-4.1 {equalizerBar: default creation} -body {
    controlwidget::equalizerBar .e
    list [winfo class .e] [llength [segmentColors .e]]
} -cleanup {
    cleanupWidgets
} -result {EqualizerBar 10}

test controlwidget-4.2 {equalizerBar: -number and -segments} -body {
    controlwidget::equalizerBar .e -number 3 -segments 5
    llength [segmentColors .e]
} -cleanup {
    cleanupWidgets
} -result 15

test controlwidget-4.3 {equalizerBar: set colors the segments} -body {
    controlwidget::equalizerBar .e -from 0 -to 10 -segments 5 -warninglevel 7 \
	-background black
    .e set 9
    segmentColors .e
} -cleanup {
    cleanupWidgets
} -result {green green green red black}

test controlwidget-4.4 {equalizerBar: -safecolor and -warningcolor} -body {
    controlwidget::equalizerBar .e -from 0 -to 10 -segments 5 -warninglevel 5 \
	-background black -safecolor blue -warningcolor yellow
    .e set 10
    segmentColors .e
} -cleanup {
    cleanupWidgets
} -result {blue blue yellow yellow yellow}

test controlwidget-4.5 {equalizerBar: several bars} -body {
    controlwidget::equalizerBar .e -number 2 -from 0 -to 10 -segments 2 \
	-warninglevel 100 -background black
    .e set {5 10}
    segmentColors .e
} -cleanup {
    cleanupWidgets
} -result {green black green green}

test controlwidget-4.6 {equalizerBar: get} -constraints knownBug -body {
    # get always returns an empty string
    controlwidget::equalizerBar .e -number 2 -from 0 -to 10
    .e set {5 10}
    .e get
} -cleanup {
    cleanupWidgets
} -result {5 10}

test controlwidget-4.7 {equalizerBar: -variable} -setup {
    set ::cwvar {0 0}
} -body {
    controlwidget::equalizerBar .e -number 2 -from 0 -to 10 -segments 2 \
	-warninglevel 100 -background black -variable ::cwvar
    set ::cwvar {10 5}
    set r [segmentColors .e]
    .e set {0 10}
    lappend r $::cwvar
    concat $r [segmentColors .e]
} -cleanup {
    cleanupWidgets
    unset ::cwvar r
} -result {green green green black {0 10} black black green green}

test controlwidget-4.8 {equalizerBar: -variable, initial value} -setup {
    set ::cwvar {10}
} -body {
    controlwidget::equalizerBar .e -from 0 -to 10 -segments 2 \
	-warninglevel 100 -background black -variable ::cwvar
    segmentColors .e
} -cleanup {
    cleanupWidgets
    unset ::cwvar
} -result {green green}

test controlwidget-4.9 {equalizerBar: read-only options} -body {
    controlwidget::equalizerBar .e
    list [catch {.e configure -segments 3} msg] $msg
} -cleanup {
    cleanupWidgets
    unset msg
} -result {1 {option -segments can only be set at instance creation}}

test controlwidget-4.10 {equalizerBar: -barwidth} -body {
    controlwidget::equalizerBar .e -barwidth 20 -background black
    set widths {}
    foreach i [.e.c find all] {
	if {[.e.c type $i] eq "rectangle"} {
	    lassign [.e.c coords $i] x0 y0 x1 y1
	    lappend widths [expr {$x1 - $x0}]
	}
    }
    lsort -unique $widths
} -cleanup {
    cleanupWidgets
    unset widths i x0 y0 x1 y1
} -result 20.0

# -------------------------------------------------------------------------
# thermometer

test controlwidget-5.1 {thermometer: default creation} -body {
    controlwidget::thermometer .t
    list [winfo class .t] [.t get]
} -cleanup {
    cleanupWidgets
} -result {Thermometer 0}

test controlwidget-5.2 {thermometer: set and get} -constraints knownBug -body {
    # Ticket 7ddeff4e86
    controlwidget::thermometer .t -from 0 -to 50
    .t set 30
    .t get
} -cleanup {
    cleanupWidgets
} -result 30

test controlwidget-5.3 {thermometer: -variable} -constraints knownBug -setup {
    set ::cwvar 10
} -body {
    # Ticket 7ddeff4e86
    controlwidget::thermometer .t -from 0 -to 50 -variable ::cwvar
    set ::cwvar 20
    .t get
} -cleanup {
    cleanupWidgets
    unset ::cwvar
} -result 20

test controlwidget-5.4 {thermometer: -variable, initial value} -setup {
    set ::cwvar 40
} -body {
    controlwidget::thermometer .t -from 0 -to 50 -variable ::cwvar
    set top40 [lindex [.t.c coords line] 1]
    controlwidget::thermometer .t2 -from 0 -to 50
    list [.t get] [expr {$top40 < [lindex [.t2.c coords line] 1]}]
} -cleanup {
    cleanupWidgets
    unset ::cwvar top40
} -result {40 1}

test controlwidget-5.5 {thermometer: -linecolor and -linethickness} -body {
    controlwidget::thermometer .t -linecolor blue -linethickness 9
    lassign [.t.c coords line] x0 y0 x1 y1
    list [.t.c itemcget line -fill] [expr {$x1 - $x0}]
} -cleanup {
    cleanupWidgets
    unset x0 y0 x1 y1
} -result {blue 10.0}

test controlwidget-5.6 {thermometer: -linethickness must be an integer} -body {
    controlwidget::thermometer .t -linethickness x
} -cleanup {
    cleanupWidgets
} -returnCodes error -match glob -result {*invalid -linethickness value*}

