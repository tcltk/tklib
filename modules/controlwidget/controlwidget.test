    .d configure -width 150 -height 12
    list [.d.c cget -width] [.d.c cget -height]
} -cleanup {
    cleanupWidgets
} -result {150 12}

test controlwidget-8.11 {rdial: dragging changes the value} -body {
    controlwidget::rdial .d -width 100
    pack .d
    update
    event generate .d.c <ButtonPress-1> -x 10 -y 3
    event generate .d.c <Motion> -x 30 -y 3 -state 0x100
    event generate .d.c <ButtonRelease-1> -x 30 -y 3 -state 0x100
    .d get
} -cleanup {
    cleanupWidgets
} -result 20.0

