} -result 25

test controlwidget-8.6 {rdial: set redraws the marker lines} -body {
    controlwidget::rdial .d -width 100
    set before [lmap i [.d.c find all] {.d.c coords $i}]
    .d set 5
    expr {[lmap i [.d.c find all] {.d.c coords $i}] ne $before}
} -cleanup {
