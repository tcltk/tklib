    cleanupWidgets
} -result .v

test controlwidget-6.2 {voltmeter: creation with pixel sizes} -body {
    controlwidget::voltmeter .v -width 200 -height 100
    list [winfo class .v] [.v.c cget -width] [.v.c cget -height]
} -cleanup {
    cleanupWidgets
} -result {Voltmeter 200 100}

test controlwidget-6.3 {voltmeter: -labels and -title} -body {
    controlwidget::voltmeter .v -width 200 -height 100 -labels {0 50 100} \
	-title Volts
    canvasTexts .v.c
} -cleanup {
    cleanupWidgets
} -result {0 50 100 Volts}

test controlwidget-6.4 {voltmeter: label and title colors and fonts} -body {
    controlwidget::voltmeter .v -width 200 -height 100 -labels {0 1} \
	-title T -labelcolor red -titlecolor blue \
	-labelfont {Courier 7} -titlefont {Times 11}
    set res {}
    foreach i [.v.c find all] {
	if {[.v.c type $i] eq "text"} {
	    lappend res [.v.c itemcget $i -fill] [.v.c itemcget $i -font]
	}
    }
    set res
} -cleanup {
    cleanupWidgets
    unset res i
} -result {red {Courier 7} red {Courier 7} blue {Times 11}}

test controlwidget-6.5 {voltmeter: -variable moves the needle} -setup {
    set ::cwvar 0
} -body {
    controlwidget::voltmeter .v -width 200 -height 100 -variable ::cwvar
    set c0 [.v.c coords [.v cget -indexid]]
    set ::cwvar 100
    set c1 [.v.c coords [.v cget -indexid]]
    set ::cwvar 50
    set c2 [.v.c coords [.v cget -indexid]]
    # the needle turns clockwise from the left to the right
    list [expr {[lindex $c1 2] > [lindex $c0 2]}] \
	[expr {abs([lindex $c2 2] - 100) < 1}] [.v get]
} -cleanup {
    cleanupWidgets
    unset ::cwvar c0 c1 c2
} -result {1 1 50}

test controlwidget-6.6 {voltmeter: set with -variable} -setup {
    set ::cwvar 0
} -body {
    controlwidget::voltmeter .v -width 200 -height 100 -variable ::cwvar
    .v set 40
    list $::cwvar [.v get]
} -cleanup {
    cleanupWidgets
    unset ::cwvar
} -result {40 40}

test controlwidget-6.7 {voltmeter: get before the value is set} -constraints knownBug -setup {
    set ::cwvar 20
} -body {
    controlwidget::voltmeter .v -width 200 -height 100 -variable ::cwvar
    .v get
} -cleanup {
    cleanupWidgets
    unset ::cwvar
} -result 20

test controlwidget-6.8 {voltmeter: set and get without a variable} -constraints knownBug -body {
    controlwidget::voltmeter .v -width 200 -height 100
    .v set 30
    .v get
} -cleanup {
    cleanupWidgets
} -result 30

test controlwidget-6.9 {voltmeter: -value} -constraints knownBug -body {
    # The documented -value option does not exist.
    controlwidget::voltmeter .v -width 200 -height 100 -value 30
    .v get
} -cleanup {
    cleanupWidgets
} -result 30

test controlwidget-6.10 {voltmeter: -min and -max} -setup {
    set ::cwvar 0
} -body {
    controlwidget::voltmeter .v -width 200 -height 100 -variable ::cwvar \
	-min -10 -max 10
    set ::cwvar 0
    set c [.v.c coords [.v cget -indexid]]
    expr {abs([lindex $c 2] - 100) < 1}
} -cleanup {
    cleanupWidgets
    unset ::cwvar c
} -result 1

test controlwidget-6.11 {voltmeter: colors} -setup {
    set ::cwvar 0
} -body {
    controlwidget::voltmeter .v -width 200 -height 100 -variable ::cwvar \
	-needlecolor red -background yellow -relief sunken -borderwidth 3
    list [.v.c itemcget [.v cget -indexid] -fill] [.v.c cget -background] \
	[.v.c cget -relief] [.v.c cget -borderwidth]
} -cleanup {
    cleanupWidgets
    unset ::cwvar
} -result {red yellow sunken 3}

test controlwidget-6.14 {voltmeter: initial needle position from the variable} -constraints knownBug -setup {
    set ::cwvar 50
} -body {
    # The needle is drawn at 0 until the variable is changed.
    controlwidget::voltmeter .v -width 200 -height 100 -variable ::cwvar
    set c1 [.v.c coords [.v cget -indexid]]
    set ::cwvar 50
    expr {[.v.c coords [.v cget -indexid]] eq $c1}
} -cleanup {
    cleanupWidgets
    unset ::cwvar c1
} -result 1

test controlwidget-6.12 {voltmeter: dragging the needle changes the variable} -setup {
    set ::cwvar 0
} -body {
    controlwidget::voltmeter .v -width 200 -height 100 -variable ::cwvar
    pack .v
    update
    set ::cwvar 50
    lassign [.v.c coords [.v cget -indexid]] x0 y0 x1 y1
    set x [expr {int(($x0 + $x1) / 2)}]
    set y [expr {int(($y0 + $y1) / 2)}]
    event generate .v.c <Motion> -x $x -y $y
    event generate .v.c <ButtonPress-1> -x $x -y $y
    event generate .v.c <Motion> -x [expr {$x + 20}] -y $y -state 0x100
    event generate .v.c <ButtonRelease-1> -x [expr {$x + 20}] -y $y
    expr {$::cwvar > 50}
} -cleanup {
    cleanupWidgets
    unset ::cwvar x0 y0 x1 y1 x y
} -result 1

test controlwidget-6.13 {voltmeter: destroying with a -variable} -constraints knownBug -setup {
    set ::cwvar 0
} -body {
    # The variable trace is not removed.
    controlwidget::voltmeter .v -width 200 -height 100 -variable ::cwvar
    destroy .v
    set ::cwvar 5
} -cleanup {
    cleanupWidgets
    foreach t [trace info variable ::cwvar] {trace remove variable ::cwvar {*}$t}
    unset ::cwvar
} -result 5

