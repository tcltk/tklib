test controlwidget-8.13 {rdial: dragging with Shift changes slowly} -constraints knownBug -body {
    # Shift and Control are swapped: Shift uses -fast, Control -slow.
    controlwidget::rdial .d -width 100
    pack .d
    update
    event generate .d.c <Shift-ButtonPress-1> -x 10 -y 3
    event generate .d.c <Motion> -x 30 -y 3 -state 0x101
    event generate .d.c <Shift-ButtonRelease-1> -x 30 -y 3
    .d get
} -cleanup {
    cleanupWidgets
} -result 2.0

test controlwidget-8.14 {rdial: dragging with Control changes fast} -constraints knownBug -body {
    controlwidget::rdial .d -width 100
    pack .d
    update
    event generate .d.c <Control-ButtonPress-1> -x 10 -y 3
    event generate .d.c <Motion> -x 30 -y 3 -state 0x104
    event generate .d.c <Control-ButtonRelease-1> -x 30 -y 3
    .d get
} -cleanup {
    cleanupWidgets
} -result 200.0

