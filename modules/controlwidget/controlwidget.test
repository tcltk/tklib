    controlwidget::rdial .d -width 100 -orient vertical
    pack .d
    update
    event generate .d.c <ButtonPress-1> -x 3 -y 50
    event generate .d.c <Motion> -x 3 -y 40 -state 0x100
    event generate .d.c <ButtonRelease-1> -x 3 -y 40 -state 0x100
    .d get
