# -*- tcl -*-
# Tests for the controlwidget package: meter, slider, equalizerBar,
# thermometer, voltmeter, tachometer, rdial, led and radioMatrix.

if {![package vsatisfies [package provide Tcl] 8.5-]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring Tcl 8.5, have [package present Tcl]"
    return
}

if {[catch { package require Tk 8.5- } msg]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring Tk 8.5, $msg"
    return
}

package require tcltest 2.2
namespace import ::tcltest::*

lappend auto_path [file dirname [file dirname [file normalize [info script]]]]
package require controlwidget

testConstraint x11 [expr {[tk windowingsystem] eq "x11"}]

# Since Tk 9 the default sizes given as screen distances (e.g. 2i, 50m)
# make meter, thermometer, voltmeter and tachometer fail (ticket
# 1c877f89a4).
set tk9Bug [expr {[package vsatisfies [package provide Tk] 9-] ? "knownBug" : ""}]

# The tklib test harness withdraws "."; the event tests need the widgets
# mapped.
set cwMainState [wm state .]
wm deiconify .

# Collect background errors (from event bindings) instead of showing
# the bgerror dialog.
set cwBgErrors {}
set cwOldBgHandler [interp bgerror {}]
interp bgerror {} [list apply {{msg opts} {lappend ::cwBgErrors $msg}}]

proc cleanupWidgets {} {
    set ::cwBgErrors {}
    foreach w [winfo children .] {
	destroy $w
    }
    update
}

# Texts of all text items of a canvas, in stacking order
proc canvasTexts {c} {
    set res {}
    foreach i [$c find all] {
	if {[$c type $i] eq "text"} {
	    lappend res [$c itemcget $i -text]
	}
    }
    return $res
}

# Remove duplicates, keeping the order (the axis ticks are drawn twice)
proc uniq {list} {
    set res {}
    foreach x $list {
	if {$x ni $res} {lappend res $x}
    }
    return $res
}

# Drag canvas item(s) with the given tag by dy pixels with button 1.
proc dragItem {c tag dy} {
    lassign [$c bbox $tag] x0 y0 x1 y1
    set x [expr {int(($x0 + $x1) / 2)}]
    set y [expr {int(($y0 + $y1) / 2)}]
    event generate $c <Enter> -x $x -y $y
    event generate $c <Motion> -x $x -y $y
    event generate $c <ButtonPress-1> -x $x -y $y
    event generate $c <Motion> -x $x -y [expr {$y + $dy}] -state 0x100
    event generate $c <ButtonRelease-1> -x $x -y [expr {$y + $dy}] -state 0x100
}

# -------------------------------------------------------------------------

test controlwidget-1.1 {package versions} -body {
    list [package present controlwidget] [package present meter] \
	[package present led] [package present rdial] \
	[package present tachometer] [package present voltmeter] \
	[package present radioMatrix] [package present bindDown]
} -result {0.1 1.0 1.0 0.7 0.2 0.2 1.0 1.0}

test controlwidget-1.2 {widget commands} -body {
    lsort [namespace eval ::controlwidget {namespace export}]
} -result {equalizerBar led meter radioMatrix rdial slider tachometer thermometer voltmeter}

test controlwidget-1.3 {all documented widget commands exist} -body {
    set res {}
    foreach cmd {meter slider equalizerBar thermometer voltmeter tachometer
		 rdial led radioMatrix} {
	lappend res [llength [info commands ::controlwidget::$cmd]]
    }
    set res
} -cleanup {
    unset res cmd
} -result {1 1 1 1 1 1 1 1 1}

# -------------------------------------------------------------------------
# meter

test controlwidget-2.1 {meter: default creation} -constraints $tk9Bug -body {
    controlwidget::meter .m
} -cleanup {
    cleanupWidgets
} -result .m

test controlwidget-2.2 {meter: creation with pixel sizes} -body {
    controlwidget::meter .m -width 150 -height 200
    pack .m
    update
    list [winfo class .m] [winfo exists .m.c] [.m cget -width] [.m cget -height]
} -cleanup {
    cleanupWidgets
} -result {Meter 1 150 200}

test controlwidget-2.3 {meter: initial value} -body {
    controlwidget::meter .m -width 150 -height 200
    .m get
} -cleanup {
    cleanupWidgets
} -result 0

test controlwidget-2.4 {meter: set and get} -body {
    controlwidget::meter .m -width 150 -height 200
    .m set 0.5
    .m get
} -cleanup {
    cleanupWidgets
} -result 0.5

test controlwidget-2.5 {meter: set moves the arrow} -body {
    controlwidget::meter .m -width 150 -height 200
    set y {}
    foreach v {-1 0 1} {
	.m set $v
	lappend y [lindex [.m.c coords arrow] 1]
    }
    list [expr {[lindex $y 0] > [lindex $y 1]}] [expr {[lindex $y 1] > [lindex $y 2]}]
} -cleanup {
    cleanupWidgets
    unset y v
} -result {1 1}

test controlwidget-2.6 {meter: values outside the axis range are clipped} -body {
    controlwidget::meter .m -width 150 -height 200
    .m set 1
    set top [lindex [.m.c coords arrow] 1]
    .m set 10
    set top2 [lindex [.m.c coords arrow] 1]
    .m set -1
    set bottom [lindex [.m.c coords arrow] 1]
    .m set -10
    list [expr {$top == $top2}] [expr {$bottom == [lindex [.m.c coords arrow] 1]}] [.m get]
} -cleanup {
    cleanupWidgets
    unset top top2 bottom
} -result {1 1 -10}

test controlwidget-2.7 {meter: -variable, initial value from the variable} -setup {
    set ::cwvar 0.25
} -body {
    controlwidget::meter .m -width 150 -height 200 -variable ::cwvar
    .m get
} -cleanup {
    cleanupWidgets
    unset ::cwvar
} -result 0.25

test controlwidget-2.8 {meter: -variable, changing the variable} -setup {
    set ::cwvar 0.25
} -body {
    controlwidget::meter .m -width 150 -height 200 -variable ::cwvar
    set ::cwvar -0.5
    .m get
} -cleanup {
    cleanupWidgets
    unset ::cwvar
} -result -0.5

test controlwidget-2.9 {meter: -variable, set changes the variable} -setup {
    set ::cwvar 0.25
} -body {
    controlwidget::meter .m -width 150 -height 200 -variable ::cwvar
    .m set 0.75
    list $::cwvar [.m get]
} -cleanup {
    cleanupWidgets
    unset ::cwvar
} -result {0.75 0.75}

test controlwidget-2.10 {meter: -variable without the ::} -setup {
    set ::cwvar 0.5
} -body {
    controlwidget::meter .m -width 150 -height 200 -variable cwvar
    set ::cwvar 0.1
    .m get
} -cleanup {
    cleanupWidgets
    unset ::cwvar
} -result 0.1

test controlwidget-2.11 {meter: configure -variable after creation} -setup {
    set ::cwvar 0.5
    set ::cwvar2 -0.5
} -body {
    controlwidget::meter .m -width 150 -height 200 -variable ::cwvar
    .m configure -variable ::cwvar2
    set r [list [.m get] [.m cget -variable]]
    set ::cwvar 0.9
    lappend r [.m get]
    set ::cwvar2 0.3
    lappend r [.m get]
} -cleanup {
    cleanupWidgets
    unset ::cwvar ::cwvar2 r
} -result {-0.5 ::cwvar2 -0.5 0.3}

test controlwidget-2.12 {meter: dragging the arrow changes the variable} -setup {
    set ::cwvar 0
} -body {
    controlwidget::meter .m -width 150 -height 200 -variable ::cwvar
    pack .m
    update
    set y0 [lindex [.m.c coords arrow] 1]
    dragItem .m.c arrow -20
    list [expr {$::cwvar > 0}] [expr {[lindex [.m.c coords arrow] 1] < $y0}] \
	[expr {abs([.m get] - $::cwvar) < 1e-9}]
} -cleanup {
    cleanupWidgets
    unset ::cwvar y0
} -result {1 1 1}

test controlwidget-2.13 {meter: -readonly prevents dragging} -setup {
    set ::cwvar 0
} -body {
    controlwidget::meter .m -width 150 -height 200 -variable ::cwvar -readonly 1
    pack .m
    update
    set y0 [lindex [.m.c coords arrow] 1]
    dragItem .m.c arrow -20
    list $::cwvar [expr {[lindex [.m.c coords arrow] 1] == $y0}]
} -cleanup {
    cleanupWidgets
    unset ::cwvar y0
} -result {0 1}

test controlwidget-2.30 {meter: no error on releasing the button over a read-only meter} -constraints knownBug -setup {
    set ::cwvar 0
} -body {
    # ReleaseIndicator unsets a grab entry that was never set.
    controlwidget::meter .m -width 150 -height 200 -variable ::cwvar -readonly 1
    pack .m
    update
    dragItem .m.c arrow -20
    set ::cwBgErrors
} -cleanup {
    cleanupWidgets
    unset ::cwvar
} -result {}

test controlwidget-2.14 {meter: -readonly must be a boolean} -body {
    controlwidget::meter .m -width 150 -height 200 -readonly maybe
} -cleanup {
    cleanupWidgets
} -returnCodes error -match glob -result {*invalid -readonly value: invalid boolean "maybe"*}

test controlwidget-2.15 {meter: -arrowcolor and -arrowthickness at creation} -constraints knownBug -body {
    # The options are applied to the canvas before it is created.
    controlwidget::meter .m -width 150 -height 200 -arrowcolor red -arrowthickness 3
    list [.m.c itemcget arrow -fill] [.m.c itemcget arrow -width]
} -cleanup {
    cleanupWidgets
} -result {red 3.0}

test controlwidget-2.16 {meter: configure -arrowcolor and -arrowthickness} -body {
    controlwidget::meter .m -width 150 -height 200
    .m configure -arrowcolor red -arrowthickness 3
    list [.m.c itemcget arrow -fill] [.m.c itemcget arrow -width]
} -cleanup {
    cleanupWidgets
} -result {red 3.0}

test controlwidget-2.17 {meter: cget -arrowcolor after configure} -constraints knownBug -body {
    # The configure method does not store the new value.
    controlwidget::meter .m -width 150 -height 200
    .m configure -arrowcolor red -arrowthickness 3
    list [.m cget -arrowcolor] [.m cget -arrowthickness]
} -cleanup {
    cleanupWidgets
} -result {red 3}

test controlwidget-2.18 {meter: default option values} -body {
    controlwidget::meter .m -width 150 -height 200
    list [.m cget -from] [.m cget -to] [.m cget -background] \
	[.m cget -arrowcolor] [.m cget -arrowthickness] [.m cget -readonly] \
	[.m cget -variable] [.m cget -log] [.m cget -axisformat]
} -cleanup {
    cleanupWidgets
} -result {-1.0 1.0 white black 1 0 {} false %.2g}

test controlwidget-2.19 {meter: axis labels} -body {
    controlwidget::meter .m -width 150 -height 200 -from 0 -to 10 -majorticks 5
    uniq [canvasTexts .m.c]
} -cleanup {
    cleanupWidgets
} -result {0 5 10}

test controlwidget-2.20 {meter: -axisformat} -body {
    controlwidget::meter .m -width 150 -height 200 -from 0 -to 1 \
	-majorticks 0.25 -axisformat %.2f
    uniq [canvasTexts .m.c]
} -cleanup {
    cleanupWidgets
} -result {0.00 0.25 0.50 0.75 1.00}

test controlwidget-2.21 {meter: -axiscolor and -axisfont} -body {
    controlwidget::meter .m -width 150 -height 200 -from 0 -to 10 \
	-majorticks 10 -axiscolor blue -axisfont {Courier 9}
    set res {}
    foreach i [.m.c find all] {
	if {[.m.c type $i] eq "text"} {
	    lappend res [list [.m.c itemcget $i -fill] [.m.c itemcget $i -font]]
	}
    }
    lsort -unique $res
} -cleanup {
    cleanupWidgets
    unset res i
} -result {{blue {Courier 9}}}

test controlwidget-2.22 {meter: values map linearly onto the axis} -body {
    controlwidget::meter .m -width 150 -height 200 -from 0 -to 10 -majorticks 5
    set ys {}
    foreach v {0 5 10} {
	.m set $v
	lappend ys [lindex [.m.c coords arrow] 1]
    }
    lassign $ys y0 y5 y10
    expr {abs(($y0 - $y5) - ($y5 - $y10)) < 1e-6}
} -cleanup {
    cleanupWidgets
    unset ys v y0 y5 y10
} -result 1

test controlwidget-2.23 {meter: changing -majorticks replaces the labels} -constraints knownBug -body {
    # The tick items get the tag "ticks]", so the old ones are not deleted.
    controlwidget::meter .m -width 150 -height 200 -from 0 -to 10 -majorticks 5
    .m configure -majorticks 10
    canvasTexts .m.c
} -cleanup {
    cleanupWidgets
} -result {0 10}

test controlwidget-2.24 {meter: logarithmic axis} -constraints knownBug -body {
    controlwidget::meter .m -width 150 -height 200 -log 1 -from 1 -to 1000
    canvasTexts .m.c
} -cleanup {
    cleanupWidgets
} -result {1.0e00 1.0e01 1.0e02 1.0e03}

test controlwidget-2.25 {meter: unknown option} -body {
    controlwidget::meter .m -width 150 -height 200 -foo 1
} -cleanup {
    cleanupWidgets
} -returnCodes error -match glob -result {*unknown option "-foo"*}

test controlwidget-2.26 {meter: set wrong # args} -body {
    controlwidget::meter .m -width 150 -height 200
    .m set
} -cleanup {
    cleanupWidgets
} -returnCodes error -result {wrong # args: should be ".m set newValue"}

test controlwidget-2.27 {meter: get wrong # args} -body {
    controlwidget::meter .m -width 150 -height 200
    .m get 1
} -cleanup {
    cleanupWidgets
} -returnCodes error -result {wrong # args: should be ".m get"}

test controlwidget-2.28 {meter: -height as a screen distance} -constraints $tk9Bug -body {
    controlwidget::meter .m -width 1i -height 2i
    list [expr {abs([.m cget -height] - [winfo pixels . 2i]) <= 1}]
} -cleanup {
    cleanupWidgets
} -result 1

test controlwidget-2.29 {meter: destroying with a -variable} -constraints knownBug -setup {
    # The variable trace is not removed.
    set ::cwvar 0.5
} -body {
    controlwidget::meter .m -width 150 -height 200 -variable ::cwvar
    destroy .m
    set ::cwvar 0.2
} -cleanup {
    cleanupWidgets
    foreach t [trace info variable ::cwvar] {trace remove variable ::cwvar {*}$t}
    unset ::cwvar
} -result 0.2

