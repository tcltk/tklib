test controlwidget-8.7 {rdial: -step determines the number of marker lines} -body {
    controlwidget::rdial .d1 -width 100 -step 10
    controlwidget::rdial .d2 -width 100 -step 20
    expr {[llength [.d1.c find all]] > [llength [.d2.c find all]]}
} -cleanup {
    cleanupWidgets
} -result 1

test controlwidget-8.8 {rdial: -background and -foreground} -body {
    controlwidget::rdial .d -width 100 -background yellow -foreground blue
    set lines {}
    foreach i [.d.c find all] {
	if {[.d.c type $i] eq "line"} {lappend lines [.d.c itemcget $i -fill]}
    }
    list [.d.c itemcget [lindex [.d.c find all] 0] -fill] [lsort -unique $lines]
} -cleanup {
    cleanupWidgets
    unset lines i
} -result {yellow blue}

test controlwidget-8.9 {rdial: configure -bg and -fg} -body {
    controlwidget::rdial .d -width 100
    .d configure -bg yellow -fg blue
    list [.d cget -background] [.d cget -foreground] \
	[.d.c itemcget [lindex [.d.c find all] 0] -fill] \
	[.d.c itemcget [lindex [.d.c find all] end] -fill]
} -cleanup {
    cleanupWidgets
} -result {yellow blue yellow blue}

test controlwidget-8.10 {rdial: configure -width and -height} -body {
