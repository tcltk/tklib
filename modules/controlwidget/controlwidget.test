# -------------------------------------------------------------------------
# led

test controlwidget-9.1 {led: default creation} -body {
    controlwidget::led .l
    list [winfo class .l] [.l.led cget -width] [.l.led itemcget 1 -fill]
} -cleanup {
    cleanupWidgets
} -result {Led 17 black}

test controlwidget-9.2 {led: on and off} -body {
    controlwidget::led .l
    .l on
    set r [.l.led itemcget 1 -fill]
    .l off
    lappend r [.l.led itemcget 1 -fill]
} -cleanup {
    cleanupWidgets
    unset r
} -result {green black}

test controlwidget-9.3 {led: -on and -off colors} -body {
    controlwidget::led .l -on red -off gray
    set r [.l.led itemcget 1 -fill]
    .l on
    lappend r [.l.led itemcget 1 -fill]
} -cleanup {
    cleanupWidgets
    unset r
} -result {gray red}

test controlwidget-9.4 {led: setstate} -body {
    controlwidget::led .l
    set r {}
    foreach s {1 0 yes no true false} {
	.l setstate $s
	lappend r [.l.led itemcget 1 -fill]
    }
    set r
} -cleanup {
    cleanupWidgets
    unset r s
} -result {green black green black green black}

test controlwidget-9.5 {led: setstate with a bad value} -body {
    controlwidget::led .l
    .l setstate maybe
} -cleanup {
    cleanupWidgets
} -returnCodes error -result {expected boolean value but got "maybe"}

test controlwidget-9.6 {led: -size} -body {
    controlwidget::led .l -size 30
    list [.l.led cget -width] [.l.led cget -height] [.l.led coords 1]
} -cleanup {
    cleanupWidgets
} -result {30 30 {2.0 2.0 28.0 28.0}}

test controlwidget-9.7 {led: -variable} -setup {
    set ::cwvar 0
} -body {
    controlwidget::led .l -variable cwvar
    set ::cwvar 1
    set r [.l.led itemcget 1 -fill]
    set ::cwvar 0
    lappend r [.l.led itemcget 1 -fill]
} -cleanup {
    cleanupWidgets
    unset ::cwvar r
} -result {green black}

test controlwidget-9.8 {led: -variable, initial state} -setup {
    set ::cwvar 1
} -body {
    controlwidget::led .l -variable cwvar
    set n 100
    while {[.l.led itemcget 1 -fill] ne "green" && [incr n -1]} {
	after 10
	update
    }
    .l.led itemcget 1 -fill
} -cleanup {
    cleanupWidgets
    unset ::cwvar n
} -result green

test controlwidget-9.9 {led: on and off set the variable} -setup {
    set ::cwvar 0
} -body {
    controlwidget::led .l -variable cwvar
    .l on
    set r [list $::cwvar [.l.led itemcget 1 -fill]]
    .l off
    lappend r $::cwvar [.l.led itemcget 1 -fill]
} -cleanup {
    cleanupWidgets
    unset ::cwvar r
} -result {1 green 0 black}

test controlwidget-9.10 {led: non-boolean variable values are ignored} -setup {
    set ::cwvar 1
} -body {
    controlwidget::led .l -variable cwvar
    set ::cwvar 1
    set ::cwvar xyz
    .l.led itemcget 1 -fill
} -cleanup {
    cleanupWidgets
    unset ::cwvar
} -result green

test controlwidget-9.11 {led: configure -variable} -setup {
    set ::cwvar 0
    set ::cwvar2 0
} -body {
    controlwidget::led .l -variable cwvar
    .l configure -variable cwvar2
    set ::cwvar 1
    set r [.l.led itemcget 1 -fill]
    set ::cwvar2 1
    lappend r [.l.led itemcget 1 -fill]
} -cleanup {
    cleanupWidgets
    unset ::cwvar ::cwvar2 r
} -result {black green}

test controlwidget-9.12 {led: options are delegated to the frame} -body {
    controlwidget::led .l -relief sunken -borderwidth 2
    list [.l cget -relief] [.l cget -borderwidth]
} -cleanup {
    cleanupWidgets
} -result {sunken 2}

test controlwidget-9.13 {led: destroying with a -variable} -constraints knownBug -setup {
    set ::cwvar 0
} -body {
    # The variable trace is not removed.
    controlwidget::led .l -variable cwvar
    destroy .l
    set ::cwvar 1
} -cleanup {
    cleanupWidgets
    foreach t [trace info variable ::cwvar] {trace remove variable ::cwvar {*}$t}
    unset ::cwvar
} -result 1

test controlwidget-9.14 {led: unknown method} -body {
    controlwidget::led .l
    .l blink
} -cleanup {
    cleanupWidgets
} -returnCodes error -match glob -result {*unknown subcommand "blink"*}

# -------------------------------------------------------------------------
# radioMatrix

proc buttonGrid {w} {
    set res {}
    foreach b [lsort -dictionary [winfo children $w.buttons]] {
	array set g [grid info $b]
	lappend res [list [$b cget -text] [$b cget -value] $g(-row) $g(-column)]
    }
    return $res
}

test controlwidget-10.1 {radioMatrix: rows and columns} -body {
    controlwidget::radioMatrix .r -rows 2 -columns 3
    list [winfo class .r] [buttonGrid .r]
} -cleanup {
    cleanupWidgets
} -result {RadioMatrix {{0 0 0 0} {1 1 0 1} {2 2 0 2} {3 3 1 0} {4 4 1 1} {5 5 1 2}}}

test controlwidget-10.2 {radioMatrix: vertical orientation} -body {
    controlwidget::radioMatrix .r -rows 2 -columns 3 -orient vertical
    buttonGrid .r
} -cleanup {
    cleanupWidgets
} -result {{0 0 0 0} {1 1 1 0} {2 2 0 1} {3 3 1 1} {4 4 0 2} {5 5 1 2}}

test controlwidget-10.3 {radioMatrix: -values with labels} -body {
    controlwidget::radioMatrix .r -values {{A 1} {B 2} {C 3}} -rows 1
    buttonGrid .r
} -cleanup {
    cleanupWidgets
} -result {{A 1 0 0} {B 2 0 1} {C 3 0 2}}

test controlwidget-10.4 {radioMatrix: -values, vertical with -columns} -body {
    controlwidget::radioMatrix .r -values {a b c d e} -columns 2 -rows {} \
	-orient vertical
    buttonGrid .r
} -cleanup {
    cleanupWidgets
} -result {{a a 0 0} {b b 1 0} {c c 2 0} {d d 0 1} {e e 1 1}}

test controlwidget-10.5 {radioMatrix: get and set} -body {
    controlwidget::radioMatrix .r -rows 2 -columns 2
    set r [list [.r get]]
    .r set 3
    lappend r [.r get]
} -cleanup {
    cleanupWidgets
    unset r
} -result {{} 3}

test controlwidget-10.6 {radioMatrix: set selects the button} -body {
    controlwidget::radioMatrix .r -rows 2 -columns 2
    .r set 2
    set var [.r.buttons.cb2 cget -variable]
    list [set $var] [.r.buttons.cb2 cget -value]
} -cleanup {
    cleanupWidgets
    unset var
} -result {2 2}

test controlwidget-10.7 {radioMatrix: clicking a button} -body {
    controlwidget::radioMatrix .r -values {{A 1} {B 2} {C 3}} -rows 1
    .r.buttons.cb1 invoke
    .r get
} -cleanup {
    cleanupWidgets
} -result 2

test controlwidget-10.8 {radioMatrix: -command} -setup {
    set ::cwcmd {}
} -body {
    controlwidget::radioMatrix .r -values {a b c} -rows 1 \
	-command {lappend ::cwcmd [.r get]}
    .r.buttons.cb2 invoke
    .r.buttons.cb0 invoke
    set ::cwcmd
} -cleanup {
    cleanupWidgets
    unset ::cwcmd
} -result {c a}

test controlwidget-10.9 {radioMatrix: -variable} -constraints knownBug -setup {
    set ::cwvar b
} -body {
    controlwidget::radioMatrix .r -values {a b c} -rows 1 -variable ::cwvar
    .r get
} -cleanup {
    cleanupWidgets
    unset ::cwvar
} -result b

test controlwidget-10.10 {radioMatrix: neither -values nor -rows and -columns} -body {
    controlwidget::radioMatrix .r
} -cleanup {
    cleanupWidgets
} -returnCodes error -match glob -result {*If -values is not supplied, but -rows and -coumns must be.*}

test controlwidget-10.11 {radioMatrix: -values together with -rows and -columns} -body {
    controlwidget::radioMatrix .r -values {a b} -rows 1 -columns 2
} -cleanup {
    cleanupWidgets
} -returnCodes error -match glob -result {*If both -rows and -coumns were supplied, -values cannot be*}

test controlwidget-10.12 {radioMatrix: bad -orient} -body {
    controlwidget::radioMatrix .r -rows 1 -columns 2 -orient diagonal
} -cleanup {
    cleanupWidgets
} -returnCodes error -match glob -result {*Invalid -orient value: diagonal*}

test controlwidget-10.13 {radioMatrix: options are delegated to the frame} -body {
    controlwidget::radioMatrix .r -rows 1 -columns 2 -relief ridge
    .r cget -relief
} -cleanup {
    cleanupWidgets
} -result ridge

# -------------------------------------------------------------------------
# bindDown

test controlwidget-11.1 {bindDown: adds a bindtag to all descendants} -body {
    frame .f
    frame .f.a
    button .f.a.b
    bindDown .f mytag
    list [lrange [bindtags .f.a] end end] [lrange [bindtags .f.a.b] end end] \
	[lsearch [bindtags .f] mytag]
} -cleanup {
    cleanupWidgets
} -result {mytag mytag -1}

test controlwidget-11.2 {bindDown: bindings of the widget apply to its parts} -constraints knownBug -setup {
    # bindDown appends the tag twice, so the binding is invoked twice.
    set ::cwev {}
} -body {
    controlwidget::led .l
    pack .l
    update
    bind .l <<Test>> {lappend ::cwev %W}
    event generate .l.led <<Test>>
    set ::cwev
} -cleanup {
    cleanupWidgets
    unset ::cwev
} -result .l.led

test controlwidget-11.3 {bindDown: returns an empty string} -body {
    frame .f
    frame .f.a
    bindDown .f mytag
} -cleanup {
    cleanupWidgets
} -result {}

# -------------------------------------------------------------------------

interp bgerror {} $cwOldBgHandler
wm state . $cwMainState
unset cwMainState
unset cwOldBgHandler cwBgErrors
rename cleanupWidgets {}
rename canvasTexts {}
rename dragItem {}
rename uniq {}
rename segmentColors {}
rename buttonGrid {}
unset tk9Bug

::tcltest::cleanupTests
return
