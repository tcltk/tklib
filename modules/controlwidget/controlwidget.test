test controlwidget-7.3 {tachometer: -variable moves the needle} -setup {
    set ::cwvar 0
} -body {
    controlwidget::tachometer .t -width 200 -height 200 -variable ::cwvar
    set c0 [.t.c coords [.t cget -indexid]]
    set ::cwvar 50
    set c1 [.t.c coords [.t cget -indexid]]
    # at the middle value the needle points straight up
    list [expr {$c0 ne $c1}] [expr {abs([lindex $c1 2] - 100) < 1}] \
	[expr {[lindex $c1 3] < 100}] [.t get]
} -cleanup {
    cleanupWidgets
    unset ::cwvar c0 c1
} -result {1 1 1 50}

