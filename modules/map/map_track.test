# -*- tcl -*-
# Tests for the map::track::file package
#
# See the file "license.terms" for information on usage and redistribution
# of this file, and for a DISCLAIMER OF ALL WARRANTIES.

if {![package vsatisfies [package provide Tcl] 8.5-]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring Tcl 8.5, have [package present Tcl]"
    return
}

if {[catch { package require Tk 8.5- } msg]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring Tk 8.5, $msg"
    return
}

if {[lsearch [namespace children] ::tcltest] == -1} {
    package require tcltest 2.2
    namespace import ::tcltest::*
} else {
    if {![package vsatisfies [package present tcltest] 2.2]} {
	puts "    Aborting the tests found in \"[file tail [info script]]\"."
	puts "    Requiring tcltest 2.2, have [package present tcltest]"
	return
    }
}

::tcltest::testConstraint tk 1

lappend auto_path [file dirname [file dirname [file normalize [info script]]]]
package require map::track::file
package require map::track::store::fs
package require map::track::store::memory

# -------------------------------------------------------------------------


# The map manpages do not document any commands yet (empty API sections).
# These tests cover the behaviour described in the comments of the code.

# Scratch directory for data files.
set dataDir [makeDirectory mapTestData]

proc writeFile {name content} {
    set path [file join $::dataDir $name]
    set c [open $path w]
    puts -nonewline $c $content
    close $c
    return $path
}

proc readFile {path} {
    set c [open $path r]
    set d [read $c]
    close $c
    return $d
}

proc cleanData {} {
    foreach f [glob -nocomplain -directory $::dataDir *] {
	file delete -force $f
    }
}
test map::track-1.0 {package versions} -body {
    list [package present map::track::file] [package present map::track::store::fs] \
	[package present map::track::store::memory]
} -result {0.1 0.1 0.1}

test map::track-1.1 {ensembles} -body {
    list [namespace ensemble exists ::map::track] \
	[lsort [namespace eval ::map::track::file {namespace export}]] \
	[lsort [namespace eval ::map::track::store {namespace export}]]
} -result {1 {read write} {fs memory}}

# -------------------------------------------------------------------------
# map::track::file

test map::track-2.1 {file read: wrong # args} -body {
    map track file read
} -returnCodes error -result {wrong # args: should be "map track file read path"}

test map::track-2.2 {file write: wrong # args} -body {
    map track file write x
} -returnCodes error -result {wrong # args: should be "map track file write path gdata"}

test map::track-2.3 {file read: basic} -setup {
    set p [writeFile a.track "tklib/geo/track\nMy track\n10\n20\n30\n40\n50\n60\n"]
} -body {
    map track file read $p
} -cleanup {
    cleanData
    unset p
} -result {names {{My track}} geo {{10 20} {30 40} {50 60}}}

test map::track-2.4 {file read: no name, the file name is used} -setup {
    set p [writeFile mytrack.track "tklib/geo/track\n10\n20\n30\n40\n"]
} -body {
    map track file read $p
} -cleanup {
    cleanData
    unset p
} -result {names mytrack geo {{10 20} {30 40}}}

test map::track-2.5 {file read: single location} -setup {
    set p [writeFile a.track "tklib/geo/track\nx\n10\n20\n"]
} -body {
    map track file read $p
} -cleanup {
    cleanData
    unset p
} -result {names x geo {{10 20}}}

test map::track-2.6 {file read: several names, comments, blank lines, whitespace} -setup {
    set p [writeFile a.track "# comment\n// another\n\n  tklib/geo/track  \nfirst\n  second  \n10.5\n\n-20\n#x\n30\n 40 \n"]
} -body {
    map track file read $p
} -cleanup {
    cleanData
    unset p
} -result {names {first second} geo {{10.5 -20} {30 40}}}

test map::track-2.7 {file read: bad magic} -setup {
    set p [writeFile a.track "tklib/geo/OTHER\n10\n20\n30\n40\n"]
} -body {
    map track file read $p
} -cleanup {
    cleanData
    unset p
} -result {}

test map::track-2.8 {file read: odd number of coordinates, no coordinates} -setup {
    set p1 [writeFile a.track "tklib/geo/track\n10\n20\n30\n"]
    set p2 [writeFile b.track "tklib/geo/track\nname\n"]
} -body {
    list [map track file read $p1] [map track file read $p2]
} -cleanup {
    cleanData
    unset p1 p2
} -result {{} {}}

test map::track-2.9 {file read: invalid coordinates} -setup {
    set p [writeFile a.track "tklib/geo/track\n10\n20\n100\n40\n"]
} -body {
    map track file read $p
} -cleanup {
    cleanData
    unset p
} -result {}

test map::track-2.10 {file read: missing or empty file} -setup {
    set p [writeFile empty.track ""]
} -body {
    list [map track file read [file join $::dataDir nosuchfile.track]] \
	[map track file read $p]
} -cleanup {
    cleanData
    unset p
} -result {{} {}}

test map::track-2.11 {file write: format} -body {
    set p [file join $::dataDir w.track]
    list [map track file write $p {names {b a b} geo {{10 20} {30 40}}}] [readFile $p]
} -cleanup {
    cleanData
    unset p
} -result [list {} "tklib/geo/track\na\nb\n10\n20\n30\n40\n"]

test map::track-2.12 {file write and read round trip} -body {
    set p [file join $::dataDir rt.track]
    map track file write $p {names {{Some name} Other} geo {{-10.25 20.5} {30 40.75} {0 0}}}
    map track file read $p
} -cleanup {
    cleanData
    unset p
} -result {names {Other {Some name}} geo {{-10.25 20.5} {30 40.75} {0 0}}}

# -------------------------------------------------------------------------
# map::track::store::fs

proc mkStore {} {
    writeFile a.track "tklib/geo/track\nA\n10\n20\n30\n40\n20\n50\n"
    writeFile b.track "tklib/geo/track\nB\n-10\n-20\n-5\n-15\n"
    writeFile bad.track "tklib/geo/track\n1\n2\n3\n"
    writeFile c.txt "tklib/geo/track\nC\n10\n20\n30\n40\n"
    file mkdir [file join $::dataDir dir.track]
}

test map::track-3.1 {store fs: wrong # args} -body {
    map track store fs S
} -returnCodes error -match glob -result {Error in constructor: wrong # args: should be "*"}

test map::track-3.2 {store fs: ids are the paths of valid files} -setup mkStore -body {
    map track store fs S $::dataDir
    lmap id [S ids] {file tail $id}
} -cleanup {
    S destroy
    cleanData
} -result {a.track b.track}

test map::track-3.3 {store fs: get} -setup mkStore -body {
    map track store fs S $::dataDir
    S get [file join $::dataDir a.track]
} -cleanup {
    S destroy
    cleanData
} -result {names A geo {{10 20} {30 40} {20 50}}}

test map::track-3.4 {store fs: get unknown id} -setup mkStore -body {
    map track store fs S $::dataDir
    S get nosuchid
} -cleanup {
    S destroy
    cleanData
} -returnCodes error -result {key "nosuchid" not known in dictionary}

test map::track-3.5 {store fs: -pattern} -constraints {
    knownBug
} -setup mkStore -body {
    # -pattern is readonly, but the constructor accepts no options.
    map track store fs S $::dataDir -pattern *.txt
    list [lmap id [S ids] {file tail $id}] [S cget -pattern]
} -cleanup {
    catch {S destroy}
    cleanData
} -result {c.txt *.txt}

test map::track-3.6 {store fs: default -pattern, readonly} -setup mkStore -body {
    map track store fs S $::dataDir
    list [S cget -pattern] [catch {S configure -pattern *} m] $m
} -cleanup {
    S destroy
    cleanData
    unset -nocomplain m
} -result {*.track 1 {option -pattern can only be set at instance creation}}

test map::track-3.7 {store fs: visible: a location in the view} -setup mkStore -body {
    map track store fs S $::dataDir
    list [lmap id [S visible {0 0 50 50}] {file tail $id}] \
	[lmap id [S visible {-50 -50 50 50}] {file tail $id}] \
	[lmap id [S visible {25 35 35 45}] {file tail $id}] \
	[S visible {60 60 70 70}]
} -cleanup {
    S destroy
    cleanData
} -result {a.track {a.track b.track} a.track {}}

test map::track-3.8 {store fs: empty or missing directory} -body {
    map track store fs S $::dataDir
    map track store fs S2 [file join $::dataDir nosuchdir]
    list [S ids] [S visible {-90 -180 90 180}] [S2 ids]
} -cleanup {
    S destroy
    S2 destroy
} -result {{} {} {}}

# -------------------------------------------------------------------------
# map::track::store::memory

test map::track-4.1 {store memory: wrong # args} -body {
    map track store memory M
} -returnCodes error -match glob -result {Error in constructor: wrong # args: should be "*"}

test map::track-4.2 {store memory: ids and visible delegated} -setup {
    mkStore
    map track store fs S $::dataDir
} -body {
    map track store memory M S
    list [expr {[M ids] eq [S ids]}] \
	[expr {[M visible {0 0 50 50}] eq [S visible {0 0 50 50}]}]
} -cleanup {
    M destroy
    S destroy
    cleanData
} -result {1 1}

test map::track-4.3 {store memory: get adds derived attributes} -setup {
    mkStore
    map track store fs S $::dataDir
} -body {
    map track store memory M S
    set attr [M get [file join $::dataDir a.track]]
    set g {{10 20} {30 40} {20 50}}
    list [lsort [dict keys $attr]] [dict get $attr names] [dict get $attr geo] \
	[expr {[dict get $attr bbox] eq [map slippy geo bbox-list $g]}] \
	[expr {[dict get $attr center] eq [map slippy geo center-list $g]}] \
	[expr {[dict get $attr diameter] == [map slippy geo diameter-list $g]}] \
	[expr {[dict get $attr length] == [map slippy geo distance-list 0 $g]}] \
	[dict get $attr parts]
} -cleanup {
    M destroy
    S destroy
    cleanData
    unset attr g
} -result {{bbox center diameter geo length names parts} A {{10 20} {30 40} {20 50}} 1 1 1 1 2}

test map::track-4.4 {store memory: parts} -setup {
    writeFile one.track "tklib/geo/track\n10\n20\n"
    writeFile two.track "tklib/geo/track\n10\n20\n30\n40\n"
    map track store fs S $::dataDir
} -body {
    map track store memory M S
    lmap n {one two} {dict get [M get [file join $::dataDir $n.track]] parts}
} -cleanup {
    M destroy
    S destroy
    cleanData
} -result {0 1}

test map::track-4.5 {store memory: get is memoized} -setup {
    mkStore
    map track store fs S $::dataDir
    proc ::countingStore {args} {
	if {[lindex $args 0] eq "get"} {incr ::gets}
	S {*}$args
    }
    set ::gets 0
} -body {
    map track store memory M ::countingStore
    set id [file join $::dataDir a.track]
    M get $id
    M get $id
    set ::gets
} -cleanup {
    M destroy
    S destroy
    cleanData
    rename ::countingStore {}
    unset ::gets id
} -result 1

test map::track-4.6 {store memory: pixels (list of points) per zoom level, memoized} -setup {
    mkStore
    map track store fs S $::dataDir
} -body {
    map track store memory M S
    set id [file join $::dataDir a.track]
    set p3 [M pixels $id 3]
    set p10 [M pixels $id 10]
    list [expr {[llength $p3] >= 1 && [llength $p3] <= 3}] \
	[expr {$p10 eq [map slippy geo 2point-list 10 {{10 20} {30 40} {20 50}}]}] \
	[expr {[M pixels $id 3] eq $p3}]
} -cleanup {
    M destroy
    S destroy
    cleanData
    unset id p3 p10
} -result {1 1 1}

test map::track-4.7 {store memory: pixels simplify close points} -setup {
    writeFile a.track "tklib/geo/track\n10\n20\n10.0000001\n20.0000001\n30\n40\n"
    map track store fs S $::dataDir
} -body {
    map track store memory M S
    set id [file join $::dataDir a.track]
    expr {[llength [M pixels $id 2]] < 3}
} -cleanup {
    M destroy
    S destroy
    cleanData
    unset id
} -result 1

test map::track-4.8 {store memory: unknown id} -setup {
    mkStore
    map track store fs S $::dataDir
} -body {
    map track store memory M S
    M get nosuchid
} -cleanup {
    M destroy
    S destroy
    cleanData
} -returnCodes error -result {key "nosuchid" not known in dictionary}

# -------------------------------------------------------------------------

removeDirectory mapTestData
unset dataDir
foreach p {writeFile readFile cleanData mkStore} {rename $p {}}

::tcltest::cleanupTests
