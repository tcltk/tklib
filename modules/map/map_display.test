# -*- tcl -*-
# Tests for the map::display package
#
# See the file "license.terms" for information on usage and redistribution
# of this file, and for a DISCLAIMER OF ALL WARRANTIES.

if {![package vsatisfies [package provide Tcl] 8.5-]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring Tcl 8.5, have [package present Tcl]"
    return
}

if {[catch { package require Tk 8.5- } msg]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring Tk 8.5, $msg"
    return
}

if {[lsearch [namespace children] ::tcltest] == -1} {
    package require tcltest 2.2
    namespace import ::tcltest::*
} else {
    if {![package vsatisfies [package present tcltest] 2.2]} {
	puts "    Aborting the tests found in \"[file tail [info script]]\"."
	puts "    Requiring tcltest 2.2, have [package present tcltest]"
	return
    }
}

::tcltest::testConstraint tk 1

lappend auto_path [file dirname [file dirname [file normalize [info script]]]]
package require map::display


# -------------------------------------------------------------------------

# The tests need a mapped main window (sak withdraws it).
set mainState [wm state .]
wm deiconify .

# Collect background errors instead of showing the error dialog: callbacks
# of a destroyed map display may still run (they are not cancelled).
set oldBgHandler [interp bgerror {}]
interp bgerror {} [list apply {{msg opts} {lappend ::bgErrors $msg}}]

# A tile provider producing its tiles locally, without network access.
proc localtiles {method args} {
    switch -exact -- $method {
	levels     { return 6 }
	tilewidth  -
	tileheight { return 256 }
	get {
	    lassign $args tile donecmd
	    set image [image create photo -width 256 -height 256]
	    after idle [list {*}$donecmd set $tile $image]
	}
    }
}

proc mkmap {} {
    map display .m -provider ::localtiles \
	-initial-geo {48.137 11.575} -initial-zoom 2
    pack .m
    update
}

# The zoom level of the current view.
proc zoom {} {
    update
    lindex [.m view] 0
}

test map::display-1.1 {zoom-to changes the zoom level} -setup {
    mkmap
} -body {
    .m zoom-to 4
    set z1 [zoom]
    .m zoom-to 1
    list $z1 [zoom]
} -cleanup {
    destroy .m
    unset -nocomplain z1
} -result {4 1}

test map::display-1.2 {zoom-to ignores levels outside the range} -setup {
    mkmap
} -body {
    .m zoom-to 3
    .m zoom-to -1
    .m zoom-to 6
    zoom
} -cleanup {
    destroy .m
} -result 3

# -------------------------------------------------------------------------

rename localtiles {}
rename mkmap {}
rename zoom {}
interp bgerror {} $oldBgHandler
unset -nocomplain oldBgHandler bgErrors
wm state . $mainState
unset mainState

::tcltest::cleanupTests
return
