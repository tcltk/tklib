[moddesc   {Map display support}]
[titledesc {Widget to display a single geo/area definition}]
[require Tcl 8.6-]
[require Tk  8.6-]
[require debug]
[require debug::caller]
[require map::slippy 0.8]
[require scrollutil]
[require snit]
