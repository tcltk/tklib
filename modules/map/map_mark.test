# -*- tcl -*-
# Tests for the map::mark package
#
# See the file "license.terms" for information on usage and redistribution
# of this file, and for a DISCLAIMER OF ALL WARRANTIES.

if {![package vsatisfies [package provide Tcl] 8.5-]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring Tcl 8.5, have [package present Tcl]"
    return
}

if {[catch { package require Tk 8.5- } msg]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring Tk 8.5, $msg"
    return
}

if {[lsearch [namespace children] ::tcltest] == -1} {
    package require tcltest 2.2
    namespace import ::tcltest::*
} else {
    if {![package vsatisfies [package present tcltest] 2.2]} {
	puts "    Aborting the tests found in \"[file tail [info script]]\"."
	puts "    Requiring tcltest 2.2, have [package present tcltest]"
	return
    }
}

::tcltest::testConstraint tk 1

lappend auto_path [file dirname [file dirname [file normalize [info script]]]]
package require map::mark

# -------------------------------------------------------------------------

# The manpage documents no commands yet.  These tests use a minimal fake
# map display providing the methods map::mark relies on (see mark.tcl):
# "canvas" and "at".

# The tests need a mapped main window (the test harness may withdraw it).
set mainWindowState [wm state .]
wm deiconify .
update

proc mkMap {} {
    canvas .c -width 100 -height 100
    pack .c
    update
    proc ::fakemap {method args} {
	switch -- $method {
	    canvas {return .c}
	    at     {return {12.5 -7.25}}
	}
    }
    set ::log {}
}

proc cleanMap {args} {
    foreach o $args {catch {$o destroy}}
    destroy .c
    rename ::fakemap {}
    unset -nocomplain ::log
}

proc logcb {args} {lappend ::log $args}

proc dclick {{state 0}} {
    # A click of another button breaks any previous multi-click sequence.
    event generate .c <ButtonPress-2> -x 50 -y 50
    event generate .c <ButtonRelease-2> -x 50 -y 50 -state 512
    event generate .c <ButtonPress-1> -x 50 -y 50 -state $state
    event generate .c <ButtonRelease-1> -x 50 -y 50 -state [expr {$state|256}]
    event generate .c <ButtonPress-1> -x 50 -y 50 -state $state
    event generate .c <ButtonRelease-1> -x 50 -y 50 -state [expr {$state|256}]
    update
}

test map::mark-1.0 {package version} -body {
    package present map::mark
} -result 0.1

test map::mark-1.1 {create: wrong # args} -body {
    map mark K
} -returnCodes error -match glob -result {Error in constructor: wrong # args: should be "*"}

test map::mark-1.2 {create: result, active, default options} -setup mkMap -body {
    list [map mark K ::fakemap] [K active] [K cget -command] [K cget -on-event]
} -cleanup {cleanMap K} -result {::K yes {} Double-Button-1}

test map::mark-1.3 {create: binding on the map canvas} -setup mkMap -body {
    map mark K ::fakemap
    bind .c
} -cleanup {cleanMap K} -result <Double-Button-1>

test map::mark-1.4 {create: unknown option} -setup mkMap -body {
    map mark K ::fakemap -foo 1
} -cleanup {cleanMap K} -returnCodes error -result {Error in constructor: unknown option "-foo"}

test map::mark-1.5 {-on-event is readonly} -setup mkMap -body {
    map mark K ::fakemap
    K configure -on-event Button-3
} -cleanup {cleanMap K} -returnCodes error -result {option -on-event can only be set at instance creation}

test map::mark-2.1 {double click reports the location} -setup mkMap -body {
    map mark K ::fakemap -command logcb
    dclick
    set ::log
} -cleanup {cleanMap K} -result {{{12.5 -7.25}}}

test map::mark-2.2 {single click does nothing} -setup mkMap -body {
    map mark K ::fakemap -command logcb
    event generate .c <ButtonPress-1> -x 50 -y 50
    event generate .c <ButtonRelease-1> -x 50 -y 50
    update
    set ::log
} -cleanup {cleanMap K} -result {}

test map::mark-2.3 {no -command: nothing happens} -setup mkMap -body {
    map mark K ::fakemap
    dclick
    set ::log
} -cleanup {cleanMap K} -result {}

test map::mark-2.4 {-command set after creation, multi-word prefix} -setup mkMap -body {
    map mark K ::fakemap
    K configure -command {logcb a {b c}}
    dclick
    set ::log
} -cleanup {cleanMap K} -result {{a {b c} {12.5 -7.25}}}

test map::mark-2.5 {-on-event: double click without Control is ignored} -setup mkMap -body {
    map mark K ::fakemap -command logcb -on-event Control-Button-1
    dclick
    set r [llength $::log]
    event generate .c <ButtonPress-1> -x 50 -y 50 -state 4
    event generate .c <ButtonRelease-1> -x 50 -y 50 -state 260
    update
    list $r $::log [bind .c]
} -cleanup {
    cleanMap K
    unset r
} -result {0 {{{12.5 -7.25}}} <Control-Button-1>}

test map::mark-3.1 {disable, enable} -setup mkMap -body {
    map mark K ::fakemap -command logcb
    set r [list [K disable] [K active] [bind .c]]
    dclick
    lappend r $::log [K enable] [K active] [bind .c]
    dclick
    lappend r $::log
} -cleanup {
    cleanMap K
    unset r
} -result {{} no {} {} {} yes <Double-Button-1> {{{12.5 -7.25}}}}

test map::mark-3.2 {disable and enable twice} -setup mkMap -body {
    map mark K ::fakemap
    K disable
    K disable
    set r [K active]
    K enable
    K enable
    lappend r [K active]
} -cleanup {
    cleanMap K
    unset r
} -result {no yes}

test map::mark-3.3 {destroy removes the binding} -setup mkMap -body {
    map mark K ::fakemap -command logcb
    K destroy
    list [bind .c] [info commands ::K]
} -cleanup {cleanMap} -result {{} {}}

test map::mark-3.4 {destroy after the canvas was destroyed} -setup mkMap -body {
    map mark K ::fakemap
    destroy .c
    list [K destroy] [info commands ::K]
} -cleanup {cleanMap} -result {{} {}}

# -------------------------------------------------------------------------

if {$mainWindowState eq "withdrawn"} {wm withdraw .}
unset mainWindowState
foreach p {mkMap cleanMap logcb dclick} {rename $p {}}

::tcltest::cleanupTests
