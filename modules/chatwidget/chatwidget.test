# -*- tcl -*-
# chatwidget.test --
#
#	Tests for the chatwidget package: widget creation, topic, name,
#	message, hook, names, entry and chat subcommands, and the entry
#	bindings (post, history, nick completion, chat state).
#
if {![package vsatisfies [package provide Tcl] 8.5-]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring Tcl 8.5, have [package present Tcl]"
    return
}

if {[catch { package require Tk 8.5- } msg]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring Tk 8.5, $msg"
    return
}

if {[lsearch [namespace children] ::tcltest] == -1} {
    package require tcltest 2.2
    namespace import ::tcltest::*
} else {
    if {![package vsatisfies [package present tcltest] 2.2]} {
	puts "    Aborting the tests found in \"[file tail [info script]]\"."
	puts "    Requiring tcltest 2.2, have [package present tcltest]"
	return
    }
}

::tcltest::testConstraint tk 1

lappend auto_path [file dirname [file dirname [file normalize [info script]]]]
package require chatwidget

# -------------------------------------------------------------------------
# Helpers

# The tklib test harness withdraws "."; the entry bindings need a
# mapped window with the focus.
set mainState [wm state .]
wm deiconify .
wm geometry . +0+0

proc mkchat {{w .c} args} {
    chatwidget::chatwidget $w {*}$args
    pack $w
    update
    return $w
}

proc rmchat {{w .c}} {
    destroy $w
    # The widget command alias outlives the widget (see chatwidget-1.6).
    catch {rename $w {}}
    # Cancel pending chat state and nick completion timers.
    foreach id [after info] {
	if {[string match *chatwidget* [lindex [after info $id] 0]]} {
	    after cancel $id
	}
    }
    unset -nocomplain ::trace
}

proc record {args} {
    lappend ::trace $args
    return [lindex $args 0]
}

# Type into the entry and send a key.
proc key {w keysym} {
    set e [$w entry]
    focus -force $e
    update
    event generate $e <Key-$keysym>
}

proc stamp {time} {
    clock format $time -format {[%H:%M]}
}

# -------------------------------------------------------------------------
# chatwidget::chatwidget

test chatwidget-1.1 {chatwidget: wrong # args} -body {
    chatwidget::chatwidget
} -returnCodes error -result {wrong # args: should be "chatwidget::chatwidget w ?arg ...?"}

test chatwidget-1.2 {chatwidget: returns the path, class Chatwidget} -body {
    list [chatwidget::chatwidget .c] [winfo class .c] [winfo exists .c]
} -cleanup {
    rmchat
} -result {.c Chatwidget 1}

test chatwidget-1.3 {chatwidget: exported command} -body {
    namespace eval chatwidget {namespace export}
} -result chatwidget

test chatwidget-1.4 {chatwidget: version} -body {
    package present chatwidget
} -result 1.1.4

test chatwidget-1.5 {chatwidget: text widgets for chat, names and entry} -setup {
    mkchat
} -body {
    list [winfo class [.c chat]] [winfo class [.c names]] [winfo class [.c entry]] \
	[string match .c.* [.c chat]] [string match .c.* [.c names]] \
	[string match .c.* [.c entry]]
} -cleanup {
    rmchat
} -result {Text Text Text 1 1 1}

test chatwidget-1.6 {chatwidget: widget command deleted with the widget} -constraints {
    knownBug
} -body {
    # The interp alias for the widget command is not removed when the
    # widget is destroyed.
    mkchat
    destroy .c
    info commands .c
} -cleanup {
    rmchat
} -result {}

test chatwidget-1.7 {chatwidget: recreate after destroy} -body {
    mkchat
    .c message hello -nick a
    destroy .c
    mkchat
    list [winfo class .c] [.c chat get 1.0 end-1c] [.c name list]
} -cleanup {
    rmchat
} -result {Chatwidget {} {}}

test chatwidget-1.8 {chatwidget: options go to the chat text widget} -constraints {
    knownBug
} -body {
    # The options are documented to be passed to the chat text
    # widget, but they are ignored.
    mkchat .c -background red -width 33
    list [.c chat cget -background] [.c chat cget -width]
} -cleanup {
    rmchat
} -result {red 33}

test chatwidget-1.9 {chatwidget: two independent widgets} -body {
    mkchat .c
    mkchat .d
    .c name add alice
    .d message hello -nick bob
    list [.c name list] [.d name list] [.c chat get 1.0 end-1c] \
	[expr {[.d chat get 1.0 end-1c] ne ""}]
} -cleanup {
    rmchat .c
    rmchat .d
} -result {alice {} {} 1}

test chatwidget-1.10 {chatwidget: chat text is read-only, entry is editable} -setup {
    mkchat
} -body {
    list [.c chat cget -state] [.c entry cget -state] [.c names cget -state]
} -cleanup {
    rmchat
} -result {disabled normal disabled}

# -------------------------------------------------------------------------
# topic

test chatwidget-2.1 {topic: wrong # args} -setup {
    mkchat
} -body {
    .c topic
} -cleanup {
    rmchat
} -returnCodes error -result {wrong # args: should be "::chatwidget::Topic self cmd ?arg ...?"}

test chatwidget-2.2 {topic: bad subcommand} -setup {
    mkchat
} -body {
    .c topic foo
} -cleanup {
    rmchat
} -returnCodes error -result {bad option "foo": must be show, hide or set}

test chatwidget-2.3 {topic: hidden by default} -setup {
    mkchat
} -body {
    winfo manager .c.topic
} -cleanup {
    rmchat
} -result {}

test chatwidget-2.4 {topic: show and hide} -setup {
    mkchat
} -body {
    .c topic show
    update
    set res [list [winfo manager .c.topic] [winfo ismapped .c.topic]]
    .c topic hide
    update
    lappend res [winfo manager .c.topic] [winfo ismapped .c.topic]
} -cleanup {
    rmchat
    unset -nocomplain res
} -result {grid 1 {} 0}

test chatwidget-2.5 {topic: show is above the chat} -setup {
    mkchat
} -body {
    .c topic show
    update
    expr {[winfo rooty .c.topic] < [winfo rooty [.c chat]]}
} -cleanup {
    rmchat
} -result 1

test chatwidget-2.6 {topic: set} -setup {
    mkchat
} -body {
    .c topic set "Chat widget demo"
    .c topic set "Second topic"
    list [.c.topic.text get 1.0 end-1c] [.c.topic.text cget -state]
} -cleanup {
    rmchat
} -result {{Second topic} disabled}

test chatwidget-2.7 {topic: set while shown} -setup {
    mkchat
    .c topic show
    update
} -body {
    .c topic set "Topic"
    update
    .c.topic.text get 1.0 end-1c
} -cleanup {
    rmchat
} -result Topic

test chatwidget-2.8 {topic: set without a topic clears it} -setup {
    mkchat
} -body {
    .c topic set foo
    .c topic set
    .c.topic.text get 1.0 end-1c
} -cleanup {
    rmchat
} -result {}

test chatwidget-2.9 {topic: long topic gets two lines and a scrollbar} -setup {
    mkchat
} -body {
    .c topic set [string repeat "long topic text " 100]
    .c topic show
    update
    list [.c.topic.text cget -height] [winfo exists .c.topic.vs]
} -cleanup {
    rmchat
} -result {2 1}

test chatwidget-2.10 {topic: short topic gets one line} -setup {
    mkchat
} -body {
    .c topic set short
    .c topic show
    update
    list [.c.topic.text cget -height] [winfo exists .c.topic.vs]
} -cleanup {
    rmchat
} -result {1 0}

