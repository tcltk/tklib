# -*- tcl -*-
# Test cases of the ctext package

if {![package vsatisfies [package provide Tcl] 8.5-]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring Tcl 8.5, have [package present Tcl]"
    return
}

if {[catch { package require Tk 8.5- } msg]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring Tk 8.5, $msg"
    return
}

package require tcltest 2.2
namespace import ::tcltest::*

source [file join [file dirname [info script]] ctext.tcl]

# -------------------------------------------------------------------------

test ctext-usertags-1.1 {insert keeps the user's tags} -setup {
    ctext .t -linemap 0
} -body {
    .t insert end "hello world" mytag
    .t insert 1.5 X
    .t tag ranges mytag
} -cleanup {
    destroy .t
} -result {1.0 1.12}

test ctext-usertags-1.2 {delete keeps the user's tags} -setup {
    ctext .t -linemap 0
} -body {
    .t insert end "hello world" mytag
    .t delete 1.5
    set r [.t tag ranges mytag]
    .t delete 1.0 1.2
    lappend r {*}[.t tag ranges mytag]
} -cleanup {
    destroy .t
} -result {1.0 1.10 1.0 1.8}

test ctext-usertags-1.3 {highlight tags are still updated on edit} -setup {
    ctext .t -linemap 0
    ctext::addHighlightClass .t kw red {foo}
} -body {
    .t insert end "foo bar" mytag
    .t highlight 1.0 end
    set r [.t tag ranges kw]
    .t insert 1.3 x
    update idletasks
    list $r [.t tag ranges kw] [.t tag ranges mytag]
} -cleanup {
    destroy .t
} -result {{1.0 1.3} {} {1.0 1.8}}

test ctext-usertags-1.4 {deleteHighlightClass removes its highlighting} -setup {
    ctext .t -linemap 0
    ctext::addHighlightClass .t kw red {foo}
} -body {
    .t insert end "foo bar"
    .t highlight 1.0 end
    ctext::deleteHighlightClass .t kw
    list [lsearch -exact [.t tag names] kw] [ctext::getHighlightClasses .t]
} -cleanup {
    destroy .t
} -result {-1 {}}

# -------------------------------------------------------------------------
::tcltest::cleanupTests
