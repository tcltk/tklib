    $mb menu.show open
} -cleanup {
    cleanupMenubar
} -returnCodes error -result {error: menu.show - tag 'open' not a menu.}

test menubar-9.10 {menu.hide: applies to all installed windows} -body {
    sampleMenubar
    toplevel .t2
    $mb install .t2 {}
    $mb menu.hide edit
