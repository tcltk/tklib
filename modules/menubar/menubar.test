# -*- tcl -*-
# Tests for the menubar package

if {![package vsatisfies [package provide Tcl] 8.6-]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring Tcl 8.6, have [package present Tcl]"
    return
}

if {[catch { package require Tk 8.6- } msg]} {
    puts "    Aborting the tests found in \"[file tail [info script]]\"."
    puts "    Requiring Tk 8.6, $msg"
    return
}

package require tcltest 2.2
namespace import ::tcltest::*

lappend auto_path [file dirname [file dirname [file normalize [info script]]]]
package require menubar

# -------------------------------------------------------------------------
# Helpers

# Collect background errors (from bindings) instead of showing a dialog.
set mbBgErrors {}
set mbOldBgHandler [interp bgerror {}]
interp bgerror {} [list apply {{msg opts} {lappend ::mbBgErrors $msg}}]

# Each menubar instance creates the named font "sfont" and never deletes
# it, so a second instance cannot be created (see menubar-1.4).  Delete
# the font before creating a new instance.
proc newMenubar {args} {
    catch {font delete sfont}
    menubar new {*}$args
}

proc cleanupMenubar {} {
    foreach w [winfo children .] {
	destroy $w
    }
    if {[info exists ::mb] && [info object isa object $::mb]} {
	$::mb destroy
    }
    catch {font delete sfont}
    unset -nocomplain ::mb ::cb ::m
    set ::mbBgErrors {}
    update
}

proc CB {args} {
    lappend ::cb $args
}

# Types and labels of the entries of a menu
proc entries {m} {
    set res {}
    if {[$m index end] eq "none"} {return {}}
    for {set i 0} {$i <= [$m index end]} {incr i} {
	set type [$m type $i]
	if {$type in {tearoff separator}} {
	    lappend res $type
	} else {
	    lappend res [list $type [$m entrycget $i -label]]
	}
    }
    return $res
}

# Entries of a menubar menu; the tear-off entry (only in Tk 8) is omitted.
proc bar {m} {
    lsearch -all -inline -not -exact [entries $m] tearoff
}

# Since Tk 9 menus have no tear-off entry by default; menus shown again
# with menu.show are inserted one position too far.
set tk9Bug [expr {[package vsatisfies [package provide Tk] 9-] ? "knownBug" : ""}]

# The menu of the cascade entry with the given label in menu $m
proc submenu {m label} {
    $m entrycget $label -menu
}

set sampleDef {
    File M:file {
	Open            C   open
	# a comment line
	Exit            C   exit
    }
    Edit M:edit+ {
	Cut             C   cut
	--              S   s1
	Options         S   s2
	Coffee          X   coffee+
	Donut           X@  donut
	Red             R   color
	Green           R   color+
	Blue            R   color
    }
    Recent M:recent {
	Files           G   grp
    }
    Help M:help {
	About           C   about
    }
}

# Create a menubar with the sample definition installed in .t
proc sampleMenubar {{script {}}} {
    set ::mb [newMenubar]
    $::mb define $::sampleDef
    toplevel .t
    $::mb install .t $script
    set ::m [.t cget -menu]
}

# -------------------------------------------------------------------------

test menubar-1.1 {package version} -body {
    package present menubar
} -result 0.5.1

test menubar-1.2 {menubar new returns an object} -body {
    set mb [newMenubar]
    info object class $mb
} -cleanup {
    cleanupMenubar
} -result ::menubar

test menubar-1.3 {menubar new with options} -body {
    set mb [newMenubar -background tan -relief groove -borderwidth 4 \
		-foreground black]
    $mb define {File M:file { Open C open }}
    toplevel .t
    $mb install .t {}
    set m [.t cget -menu]
    list [$m cget -background] [$m cget -relief] [$m cget -borderwidth] \
	[$m cget -foreground]
} -cleanup {
    cleanupMenubar
} -result {tan groove 4 black}

test menubar-1.4 {menubar new: several instances} -constraints knownBug -body {
    # The constructor creates the named font "sfont" unconditionally.
    set mb [newMenubar]
    set mb2 [menubar new]
    $mb2 destroy
    info object isa object $mb
} -cleanup {
    unset -nocomplain mb2
    cleanupMenubar
    destroy .temp
} -result 1

# -------------------------------------------------------------------------
# define

test menubar-2.1 {define: wrong # args} -body {
    set mb [newMenubar]
    $mb define
} -cleanup {
    cleanupMenubar
} -returnCodes error -match glob -result {wrong # args: should be "* define definition"}

test menubar-2.2 {define: returns an empty string} -body {
    set mb [newMenubar]
    $mb define $sampleDef
} -cleanup {
    cleanupMenubar
} -result {}

test menubar-2.3 {define: unknown entry type} -body {
    set mb [newMenubar]
    $mb define {A Q x}
} -cleanup {
    cleanupMenubar
} -returnCodes error -result {bug: 'A' - unknown item type (Q)}

test menubar-2.4 {define: duplicate tag} -body {
    set mb [newMenubar]
    $mb define {A M:a { B C b B2 C b }}
} -cleanup {
    cleanupMenubar
} -returnCodes error -result {bug: tag 'b' already used.}

test menubar-2.5 {define: menu without a tag} -body {
    set mb [newMenubar]
    $mb define {A M { B C b }}
} -cleanup {
    cleanupMenubar
} -returnCodes error -result {bug: menu (A M) has no tag name.}

test menubar-2.6 {define: tag that is not a simple string} -body {
    set mb [newMenubar]
    $mb define {A M:a { B C {b$c} }}
} -cleanup {
    cleanupMenubar
} -returnCodes error -result {bug: tag 'b$c' not a simple string.}

test menubar-2.7 {define: a second definition is ignored} -body {
    set mb [newMenubar]
    $mb define {File M:file { Open C open }}
    $mb define {Other M:other { X C x }}
    toplevel .t
    $mb install .t {}
    bar [.t cget -menu]
} -cleanup {
    cleanupMenubar
} -result {{cascade File}}

test menubar-2.8 {define: empty definition} -constraints knownBug -body {
    set mb [newMenubar]
    $mb define {}
    toplevel .t
    $mb install .t {}
    bar [.t cget -menu]
} -cleanup {
    cleanupMenubar
} -result {}

# -------------------------------------------------------------------------
# install

test menubar-3.1 {install: wrong # args} -body {
    set mb [newMenubar]
    $mb install .
} -cleanup {
    cleanupMenubar
} -returnCodes error -match glob -result {wrong # args: should be "* install win config"}

test menubar-3.2 {install: before define} -body {
    set mb [newMenubar]
    toplevel .t
    $mb install .t {}
} -cleanup {
    cleanupMenubar
} -returnCodes error -match glob -result {error: install - '*' not defined.}

test menubar-3.3 {install: menubar entries} -body {
    sampleMenubar
    list [winfo class $m] [bar $m]
} -cleanup {
    cleanupMenubar
} -result {Menu {{cascade File} {cascade Edit} {cascade Recent} {cascade Help}}}

test menubar-3.4 {install: menu entries of all types} -body {
    sampleMenubar
    list [entries [submenu $m File]] [entries [submenu $m Edit]] \
	[entries [submenu $m Recent]] [entries [submenu $m Help]]
} -cleanup {
    cleanupMenubar
} -result {{{command Open} {command Exit}} {tearoff {command Cut} separator {command {-- Options --}} {checkbutton Coffee} {checkbutton Donut} {radiobutton Red} {radiobutton Green} {radiobutton Blue}} separator {{command About}}}

test menubar-3.5 {install: tear-off menus} -body {
    sampleMenubar
    list [[submenu $m File] cget -tearoff] [[submenu $m Edit] cget -tearoff]
} -cleanup {
    cleanupMenubar
} -result {0 1}

test menubar-3.6 {install: the Help menu} -body {
    sampleMenubar
    submenu $m Help
} -cleanup {
    cleanupMenubar
} -result .t.m0.help

test menubar-3.7 {install: initial values of checkbuttons} -body {
    sampleMenubar
    set e [submenu $m Edit]
    list [set [$e entrycget Coffee -variable]] [set [$e entrycget Donut -variable]]
} -cleanup {
    cleanupMenubar
    unset e
} -result {1 0}

test menubar-3.8 {install: initial value of a radiobutton group} -constraints knownBug -body {
    # The radiobutton entries get an empty -variable until the group is
    # configured, so all groups share one variable.
    sampleMenubar
    set e [submenu $m Edit]
    list [set [$e entrycget Red -variable]] \
	[expr {[$e entrycget Red -variable] eq [$e entrycget Blue -variable]}]
} -cleanup {
    cleanupMenubar
    unset e
} -result {Green 1}

test menubar-3.17 {install: initial value of a configured radiobutton group} -body {
    sampleMenubar {$::mb menu.configure -command {color {CB radio}}}
    set e [submenu $m Edit]
    list [set [$e entrycget Red -variable]] \
	[expr {[$e entrycget Red -variable] eq [$e entrycget Blue -variable]}]
} -cleanup {
    cleanupMenubar
    unset e
} -result {Green 1}

test menubar-3.18 {install: radiobutton groups are independent} -constraints knownBug -body {
    set mb [newMenubar]
    $mb define {
	Edit M:edit {
	    Red R color+
	    Blue R color
	    Small R size
	    Large R size+
	}
    }
    toplevel .t
    $mb install .t {}
    set e [submenu [.t cget -menu] Edit]
    $e invoke Blue
    list [set [$e entrycget Blue -variable]] [set [$e entrycget Large -variable]]
} -cleanup {
    cleanupMenubar
    unset e
} -result {Blue Large}

test menubar-3.9 {install: the script is evaluated} -body {
    sampleMenubar {set ::installed 1}
    set ::installed
} -cleanup {
    cleanupMenubar
    unset ::installed
} -result 1

test menubar-3.10 {install: in a second toplevel} -body {
    sampleMenubar
    toplevel .t2
    $mb install .t2 {}
    list [bar [.t2 cget -menu]] [entries [submenu [.t2 cget -menu] Edit]]
} -cleanup {
    cleanupMenubar
} -result {{{cascade File} {cascade Edit} {cascade Recent} {cascade Help}} {tearoff {command Cut} separator {command {-- Options --}} {checkbutton Coffee} {checkbutton Donut} {radiobutton Red} {radiobutton Green} {radiobutton Blue}}}

test menubar-3.11 {install: global and local scope of checkbuttons} -body {
    sampleMenubar
    toplevel .t2
    $mb install .t2 {}
    set e1 [submenu $m Edit]
    set e2 [submenu [.t2 cget -menu] Edit]
    list [expr {[$e1 entrycget Coffee -variable] eq [$e2 entrycget Coffee -variable]}] \
	[expr {[$e1 entrycget Donut -variable] eq [$e2 entrycget Donut -variable]}]
} -cleanup {
    cleanupMenubar
    unset e1 e2
} -result {1 0}

test menubar-3.12 {install: local scope checkbutton state is per window} -body {
    sampleMenubar
    toplevel .t2
    $mb install .t2 {}
    set e1 [submenu $m Edit]
    set e2 [submenu [.t2 cget -menu] Edit]
    $e1 invoke Donut
    $e1 invoke Coffee
    list [set [$e1 entrycget Donut -variable]] [set [$e2 entrycget Donut -variable]] \
	[set [$e1 entrycget Coffee -variable]] [set [$e2 entrycget Coffee -variable]]
} -cleanup {
    cleanupMenubar
    unset e1 e2
} -result {1 0 0 0}

test menubar-3.13 {install: a second install in the same window is ignored} -body {
    sampleMenubar
    $mb install .t {set ::installed 1}
    list [info exists ::installed] [.t cget -menu]
} -cleanup {
    cleanupMenubar
    unset -nocomplain ::installed
} -result {0 .t.m0}

test menubar-3.14 {install: path of a child of a toplevel} -body {
    set mb [newMenubar]
    $mb define {File M:file { Open C open }}
    toplevel .t
    frame .t.f
    $mb install .t.f {}
    .t cget -menu
} -cleanup {
    cleanupMenubar
} -result .t.m0

test menubar-3.15 {install: menu after a radiobutton group} -constraints knownBug -body {
    # The cascade is inserted at the index of the tree node, which does not
    # account for the entries of radiobutton groups.
    set mb [newMenubar]
    $mb define {
	Edit M:edit+ {
	    Red R color
	    Green R color
	    Blue R color
	    Sub M:sub {
		Deep C deep
	    }
	}
    }
    toplevel .t
    $mb install .t {}
    entries [submenu [.t cget -menu] Edit]
} -cleanup {
    cleanupMenubar
} -result {tearoff {radiobutton Red} {radiobutton Green} {radiobutton Blue} {cascade Sub}}

test menubar-3.16 {install: cascading menus} -body {
    set mb [newMenubar]
    $mb define {
	Edit M:edit {
	    Cut C cut
	    Sub M:sub+ {
		Deep C deep
	    }
	}
    }
    toplevel .t
    $mb install .t {}
    set e [submenu [.t cget -menu] Edit]
    list [entries $e] [entries [submenu $e Sub]]
} -cleanup {
    cleanupMenubar
    unset e
} -result {{{command Cut} {cascade Sub}} {tearoff {command Deep}}}

# -------------------------------------------------------------------------
# Callbacks

test menubar-4.1 {callback: command entry} -body {
    sampleMenubar {
	$::mb menu.configure -command {
	    open {CB open}
	}
    }
    [submenu $m File] invoke Open
    set ::cb
} -cleanup {
    cleanupMenubar
} -result {{open .t}}

test menubar-4.2 {callback: checkbutton entry} -body {
    sampleMenubar {
	$::mb menu.configure -command {
	    coffee {CB check}
	    donut {CB check}
	}
    }
    set e [submenu $m Edit]
    $e invoke Coffee
    $e invoke Donut
    set ::cb
} -cleanup {
    cleanupMenubar
    unset e
} -result {{check .t coffee 0} {check .t donut 1}}

test menubar-4.3 {callback: radiobutton entry} -body {
    sampleMenubar {
	$::mb menu.configure -command {
	    color {CB radio}
	}
    }
    set e [submenu $m Edit]
    $e invoke Blue
    $e invoke Red
    set ::cb
} -cleanup {
    cleanupMenubar
    unset e
} -result {{radio .t color Blue} {radio .t color Red}}

test menubar-4.4 {callback: in the namespace of install} -setup {
    namespace eval ::mbtest {
	proc CB {args} {lappend ::cb ns $args}
    }
} -body {
    set mb [newMenubar]
    $mb define {File M:file { Open C open }}
    toplevel .t
    namespace eval ::mbtest {
	$::mb install .t {$::mb tag.configure .t open -command CB}
    }
    [submenu [.t cget -menu] File] invoke Open
    set ::cb
} -cleanup {
    cleanupMenubar
    namespace delete ::mbtest
} -result {ns .t}

test menubar-4.5 {callback: fully qualified command} -setup {
    namespace eval ::mbtest {
	proc CB {args} {lappend ::cb ns $args}
    }
} -body {
    set mb [newMenubar]
    $mb define {File M:file { Open C open }}
    toplevel .t
    namespace eval ::mbtest {
	$::mb install .t {$::mb tag.configure .t open -command ::CB}
    }
    [submenu [.t cget -menu] File] invoke Open
    set ::cb
} -cleanup {
    cleanupMenubar
    namespace delete ::mbtest
} -result {.t}

test menubar-4.6 {callback: menu.namespace} -setup {
    namespace eval ::mbtest {
	proc CB {args} {lappend ::cb ns $args}
    }
} -body {
    sampleMenubar {
	$::mb menu.namespace edit ::mbtest
	$::mb menu.configure -command {
	    open {CB open}
	    cut {CB cut}
	}
    }
    [submenu $m File] invoke Open
    [submenu $m Edit] invoke Cut
    set ::cb
} -cleanup {
    cleanupMenubar
    namespace delete ::mbtest
} -result {{open .t} ns {cut .t}}

test menubar-4.7 {callback: the toplevel of the invoking menu} -body {
    sampleMenubar {
	$::mb menu.configure -command {
	    open {CB open}
	}
    }
    toplevel .t2
    $mb install .t2 {}
    [submenu [.t2 cget -menu] File] invoke Open
    [submenu $m File] invoke Open
    set ::cb
} -cleanup {
    cleanupMenubar
} -result {{open .t2} {open .t}}

test menubar-4.8 {callback: key binding from -bind} -body {
    sampleMenubar {
	$::mb menu.configure -command {
	    open {CB open}
	} -bind {
	    open {0 Ctrl+O Control-Key-o}
	}
    }
    update
    focus -force .t
    event generate .t <Control-Key-o>
    list $::cb [[submenu $m File] entrycget Open -accelerator] \
	[[submenu $m File] entrycget Open -underline]
} -cleanup {
    cleanupMenubar
} -result {{{open .t}} Ctrl+O 0}

test menubar-4.9 {callback: disabled entries do not call back} -body {
    sampleMenubar {
	$::mb menu.configure -command {
	    open {CB open}
	}
    }
    $mb tag.configure .t open -state disabled
    [submenu $m File] invoke Open
    info exists ::cb
} -cleanup {
    cleanupMenubar
} -result 0

# -------------------------------------------------------------------------
# menu.configure

test menubar-5.1 {menu.configure: too few arguments} -body {
    sampleMenubar
    $mb menu.configure -command
} -cleanup {
    cleanupMenubar
} -returnCodes error -result {error: menu.configure - to few arguments.}

test menubar-5.2 {menu.configure: several options and tags} -body {
    sampleMenubar
    $mb menu.configure -background {
	# comment
	open red
	exit blue
    } -foreground {
	open white
    }
    set f [submenu $m File]
    list [$f entrycget Open -background] [$f entrycget Exit -background] \
	[$f entrycget Open -foreground]
} -cleanup {
    cleanupMenubar
    unset f
} -result {red blue white}

test menubar-5.3 {menu.configure: returns an empty string} -body {
    sampleMenubar
    $mb menu.configure -background {open red}
} -cleanup {
    cleanupMenubar
} -result {}

test menubar-5.4 {menu.configure: unknown tag} -body {
    sampleMenubar
    $mb menu.configure -background {nosuch red}
} -cleanup {
    cleanupMenubar
} -returnCodes error -result {error: tag.configure - tag 'nosuch' not found}

# -------------------------------------------------------------------------
# tag.configure and tag.cget

test menubar-6.1 {tag.configure: wrong # args} -body {
    sampleMenubar
    $mb tag.configure .t
} -cleanup {
    cleanupMenubar
} -returnCodes error -match glob -result {wrong # args: should be "* tag.configure wtop node ?arg ...?"}

test menubar-6.2 {tag.configure: before install} -body {
    set mb [newMenubar]
    $mb define {File M:file { Open C open }}
    $mb tag.configure . open -state disabled
} -cleanup {
    cleanupMenubar
} -returnCodes error -match glob -result {error: tag.configure - '*' not installed.}

test menubar-6.3 {tag.configure: unknown tag} -body {
    sampleMenubar
    $mb tag.configure .t nosuch -state disabled
} -cleanup {
    cleanupMenubar
} -returnCodes error -result {error: tag.configure - tag 'nosuch' not found}

test menubar-6.4 {tag.configure: standard options} -body {
    sampleMenubar
    $mb tag.configure .t open -state disabled -foreground red \
	-background blue -activebackground yellow -activeforeground green \
	-font {Courier 10} -columnbreak 1 -hidemargin 1
    set f [submenu $m File]
    lmap o {-state -foreground -background -activebackground -activeforeground
	    -font -columnbreak -hidemargin} {$f entrycget Open $o}
} -cleanup {
    cleanupMenubar
    unset f
} -result {disabled red blue yellow green {Courier 10} 1 1}

test menubar-6.5 {tag.configure: returns an empty string} -body {
    sampleMenubar
    $mb tag.configure .t open -state disabled
} -cleanup {
    cleanupMenubar
} -result {}

test menubar-6.6 {tag.configure: applies to all installed windows} -body {
    sampleMenubar
    toplevel .t2
    $mb install .t2 {}
    $mb tag.configure .t open -foreground red
    [submenu [.t2 cget -menu] File] entrycget Open -foreground
} -cleanup {
    cleanupMenubar
} -result red

test menubar-6.7 {tag.configure: -bind} -body {
    sampleMenubar
    $mb tag.configure .t exit -command {CB exit} -bind {1 Ctrl+Q Control-Key-q}
    set f [submenu $m File]
    update
    focus -force .t
    event generate .t <Control-Key-q>
    list [$f entrycget Exit -underline] [$f entrycget Exit -accelerator] \
	[expr {[bind .t <Control-Key-q>] eq [list $f invoke Exit]}] $::cb
} -cleanup {
    cleanupMenubar
    unset f
} -result {1 Ctrl+Q 1 {{exit .t}}}

test menubar-6.8 {tag.configure: -bind with an empty underline} -body {
    sampleMenubar
    $mb tag.configure .t exit -bind {{} Ctrl+Q}
    expr {[[submenu $m File] entrycget Exit -underline] in {-1 {}}}
} -cleanup {
    cleanupMenubar
} -result 1

test menubar-6.9 {tag.configure: -bind with a bad underline} -body {
    sampleMenubar
    $mb tag.configure .t exit -bind {x Ctrl+Q}
} -cleanup {
    cleanupMenubar
} -returnCodes error -result {tag.configure: underline value for tag (exit) not positive integer.}

test menubar-6.10 {tag.configure: -command} -body {
    sampleMenubar
    $mb tag.configure .t exit -command {CB bye}
    [submenu $m File] invoke Exit
    set ::cb
} -cleanup {
    cleanupMenubar
} -result {{bye .t}}

test menubar-6.11 {tag.configure: -label} -constraints knownBug -body {
    # The entry is looked up by the new label.
    sampleMenubar
    $mb tag.configure .t exit -label Quit
    entries [submenu $m File]
} -cleanup {
    cleanupMenubar
} -result {{command Open} {command Quit}}

test menubar-6.12 {tag.configure: menu entry options} -body {
    sampleMenubar
    $mb tag.configure .t edit -foreground red -state disabled
    list [$m entrycget Edit -foreground] [$m entrycget Edit -state]
} -cleanup {
    cleanupMenubar
} -result {red disabled}

test menubar-6.13 {tag.configure: checkbutton options} -body {
    sampleMenubar
    $mb tag.configure .t coffee -selectcolor red -indicatoron 0
    set e [submenu $m Edit]
    list [$e entrycget Coffee -selectcolor] [$e entrycget Coffee -indicatoron]
} -cleanup {
    cleanupMenubar
    unset e
} -result {red 0}

test menubar-6.14 {tag.configure: -image and -compound} -setup {
    image create photo mbTestImage -width 8 -height 8
} -body {
    sampleMenubar
    $mb tag.configure .t open -image mbTestImage -compound left
    set f [submenu $m File]
    list [$f entrycget Open -image] [$f entrycget Open -compound]
} -cleanup {
    cleanupMenubar
    image delete mbTestImage
    unset f
} -result {mbTestImage left}

test menubar-7.1 {tag.cget: wrong # args} -body {
    sampleMenubar
    $mb tag.cget .t
} -cleanup {
    cleanupMenubar
} -returnCodes error -match glob -result {wrong # args: should be "* tag.cget wtop tag ?opt?"}

test menubar-7.2 {tag.cget: entry options} -body {
    sampleMenubar
    $mb tag.configure .t open -foreground red -bind {0 Ctrl+O}
    list [$mb tag.cget .t open -foreground] [$mb tag.cget .t open -accelerator] \
	[$mb tag.cget .t open -label] [$mb tag.cget .t edit -label] \
	[$mb tag.cget .t coffee -label]
} -cleanup {
    cleanupMenubar
} -result {red Ctrl+O Open Edit Coffee}

test menubar-7.3 {tag.cget: radiobutton group -state is the selected label} -body {
    sampleMenubar {$::mb menu.configure -command {color {CB radio}}}
    set r [list [$mb tag.cget .t color -state]]
    [submenu $m Edit] invoke Blue
    lappend r [$mb tag.cget .t color -state]
} -cleanup {
    cleanupMenubar
    unset r
} -result {Green Blue}

test menubar-7.4 {tag.cget: separator} -body {
    sampleMenubar
    $mb tag.cget .t s1 -label
} -cleanup {
    cleanupMenubar
} -result separator

test menubar-7.5 {tag.cget: unknown tag} -body {
    sampleMenubar
    $mb tag.cget .t nosuch -label
} -cleanup {
    cleanupMenubar
} -returnCodes error -result {error: tag.cget - tag 'nosuch' not found}

test menubar-7.6 {tag.cget: before install} -body {
    set mb [newMenubar]
    $mb define {File M:file { Open C open }}
    $mb tag.cget . open -label
} -cleanup {
    cleanupMenubar
} -returnCodes error -match glob -result {error: tag.cget - '*' not installed.}

