# -------------------------------------------------------------------------
# group.xxx

test menubar-10.1 {group.add: adds entries to the group} -body {
    sampleMenubar
    list [$mb group.add grp file1 {CB file} Ctrl+1 Control-Key-1] \
	[$mb group.add grp file2 {CB file} {} Control-Key-2] \
	[entries [submenu $m Recent]] [$mb group.entries grp]
} -cleanup {
    cleanupMenubar
} -result {0 0 {separator {command file1} {command file2}} {file1 file2}}

test menubar-10.2 {group.add: without a bind sequence} -constraints knownBug -body {
    sampleMenubar
    list [$mb group.add grp file1 {CB file}] [$mb group.add grp file2] \
	[entries [submenu $m Recent]]
} -cleanup {
    cleanupMenubar
} -result {0 0 {separator {command file1} {command file2}}}

test menubar-10.3 {group.add: accelerator and state} -body {
    sampleMenubar
    $mb group.add grp file1 {CB file} Ctrl+1 Control-Key-1
    $mb group.add grp file2 {} {} Control-Key-2
    $mb group.add grp file3 {CB file} {} Control-Key-3 disabled
    set r [submenu $m Recent]
    list [$r entrycget file1 -accelerator] [$r entrycget file1 -state] \
	[$r entrycget file2 -state] [$r entrycget file3 -state]
} -cleanup {
    cleanupMenubar
    unset r
} -result {Ctrl+1 normal disabled disabled}

test menubar-10.4 {group.add: callback} -body {
    sampleMenubar {$::mb menu.namespace grp ::}
    $mb group.add grp file1 {CB file} {} Control-Key-1
    [submenu $m Recent] invoke file1
    set ::cb
} -cleanup {
    cleanupMenubar
} -result {{file .t}}

test menubar-10.5 {group.add: callback without menu.namespace} -constraints knownBug -body {
    # The callback namespace is only known for menus.
    sampleMenubar
    $mb group.add grp file1 {CB file} {} Control-Key-1
    [submenu $m Recent] invoke file1
    set ::cb
} -cleanup {
    cleanupMenubar
} -result {{file .t}}

test menubar-10.6 {group.add: key binding} -body {
    sampleMenubar {$::mb menu.namespace grp ::}
    $mb group.add grp file1 {CB file} {} Control-Key-1
    update
    focus -force .t
    event generate .t <Control-Key-1>
    list $::cb $::mbBgErrors
} -cleanup {
    cleanupMenubar
} -result {{{file .t}} {}}

test menubar-10.7 {group.add: duplicate name and not a group} -body {
    sampleMenubar
    list [$mb group.add grp file1 {CB file} {} Control-Key-1] \
	[$mb group.add grp file1 {CB file} {} Control-Key-1] \
	[$mb group.add cut x {CB x} {} Control-Key-x] \
	[entries [submenu $m Recent]]
} -cleanup {
    cleanupMenubar
} -result {0 1 1 {separator {command file1}}}

test menubar-10.8 {group.delete} -body {
    sampleMenubar
    $mb group.add grp file1 {CB file} {} Control-Key-1
    $mb group.add grp file2 {CB file} {} Control-Key-2
    list [$mb group.delete grp file1] [$mb group.delete grp nosuch] \
	[$mb group.delete cut file2] [entries [submenu $m Recent]] \
	[$mb group.entries grp] [bind .t <Control-Key-1>]
} -cleanup {
    cleanupMenubar
} -result {0 1 1 {separator {command file2}} file2 {}}

test menubar-10.9 {group.move} -body {
    sampleMenubar
    foreach f {file1 file2 file3} {
	$mb group.add grp $f {CB file} {} Control-Key-[string index $f end]
    }
    set r [submenu $m Recent]
    set res {}
    lappend res [$mb group.move up grp file2] [entries $r] [$mb group.entries grp]
    lappend res [$mb group.move down grp file2] [entries $r]
    lappend res [$mb group.move down grp file3] [entries $r]
    lappend res [$mb group.move up grp file2] [$mb group.move up grp file2] [entries $r]
} -cleanup {
    cleanupMenubar
    unset res r f
} -result {0 {separator {command file2} {command file1} {command file3}} {file2 file1 file3} 0 {separator {command file1} {command file2} {command file3}} 0 {separator {command file1} {command file2} {command file3}} 0 0 {separator {command file2} {command file1} {command file3}}}

test menubar-10.10 {group.move: bad direction, unknown entry, not a group} -body {
    sampleMenubar
    $mb group.add grp file1 {CB file} {} Control-Key-1
    list [$mb group.move sideways grp file1] [$mb group.move up grp nosuch] \
	[$mb group.move up cut file1]
} -cleanup {
    cleanupMenubar
} -result {1 1 1}

test menubar-10.11 {group.configure} -body {
    sampleMenubar
    $mb group.add grp file1 {CB file} {} Control-Key-1
    set r [list [$mb group.configure grp file1 -foreground red -state disabled]]
    set rm [submenu $m Recent]
    lappend r [$rm entrycget file1 -foreground] [$rm entrycget file1 -state] \
	[$mb group.configure grp nosuch -foreground red] \
	[$mb group.configure cut file1 -foreground red]
} -cleanup {
    cleanupMenubar
    unset r rm
} -result {0 red disabled 1 1}

test menubar-10.12 {group.configure: -command and -bind} -body {
    sampleMenubar {$::mb menu.namespace grp ::}
    $mb group.add grp file1 {} {} Control-Key-1
    $mb group.configure grp file1 -command {CB new} -state normal \
	-bind {0 Ctrl+9 Control-Key-9}
    set rm [submenu $m Recent]
    $rm invoke file1
    list $::cb [$rm entrycget file1 -accelerator]
} -cleanup {
    cleanupMenubar
    unset rm
} -result {{{new .t}} Ctrl+9}

test menubar-10.13 {group.configure: -label} -constraints knownBug -body {
    sampleMenubar
    $mb group.add grp file1 {CB file} {} Control-Key-1
    $mb group.configure grp file1 -label F1
    entries [submenu $m Recent]
} -cleanup {
    cleanupMenubar
} -result {separator {command F1}}

test menubar-10.14 {group.serialize} -body {
    sampleMenubar
    $mb group.add grp file1 {CB file} Ctrl+1 Control-Key-1
    $mb group.add grp file2 {CB file} {} Control-Key-2
    set s [$mb group.serialize grp]
    list [llength $s] [lindex $s 0] [dict get [lindex $s 1] +type] \
	[llength [lindex $s 2]] [lindex $s 2 0] [lindex $s 2 3] \
	[dict get [lindex $s 2 1] -accelerator] [lindex $s 2 2]
} -cleanup {
    cleanupMenubar
    unset s
} -result {3 grp commandgroup 6 file1 file2 Ctrl+1 {}}

test menubar-10.15 {group.serialize: not a group} -body {
    sampleMenubar
    $mb group.serialize cut
} -cleanup {
    cleanupMenubar
} -result 1

test menubar-10.16 {group.deserialize: restores the entries} -body {
    sampleMenubar {$::mb menu.namespace grp ::}
    $mb group.add grp file1 {CB file} Ctrl+1 Control-Key-1
    $mb group.add grp file2 {CB file} {} Control-Key-2
    set s [$mb group.serialize grp]
    $mb group.delete grp file1
    $mb group.add grp file3 {CB file} {} Control-Key-3
    set r [list [$mb group.deserialize grp $s] [$mb group.entries grp] \
	       [entries [submenu $m Recent]]]
    [submenu $m Recent] invoke file1
    lappend r $::cb
} -cleanup {
    cleanupMenubar
    unset s r
} -result {0 {file1 file2} {separator {command file1} {command file2}} {{file .t}}}

test menubar-10.17 {group.deserialize: into a fresh menubar} -body {
    sampleMenubar
    $mb group.add grp file1 {CB file} Ctrl+1 Control-Key-1
    set s [$mb group.serialize grp]
    cleanupMenubar
    sampleMenubar
    $mb group.deserialize grp $s
    list [$mb group.entries grp] [entries [submenu $m Recent]] \
	[[submenu $m Recent] entrycget file1 -accelerator]
} -cleanup {
    cleanupMenubar
    unset s
} -result {file1 {separator {command file1}} Ctrl+1}

test menubar-10.18 {group.deserialize: not a group} -body {
    sampleMenubar
    $mb group.deserialize cut {}
} -cleanup {
    cleanupMenubar
} -result 1

test menubar-10.19 {group.add: entries in all installed windows} -body {
    sampleMenubar
    toplevel .t2
    $mb install .t2 {}
    $mb group.add grp file1 {CB file} {} Control-Key-1
    entries [submenu [.t2 cget -menu] Recent]
} -cleanup {
    cleanupMenubar
} -result {separator {command file1}}

test menubar-10.20 {group.add: group in a hidden menu} -body {
    sampleMenubar
    $mb menu.hide recent
    $mb group.add grp file1 {CB file} {} Control-Key-1
    $mb menu.show recent
    entries [submenu $m Recent]
} -cleanup {
    cleanupMenubar
} -result {separator {command file1}}

# -------------------------------------------------------------------------
# notebook.xxx

set notebookDef {
    View M:view {
	Wrap    X=  wrap
	Small   R=  size+
	Large   R=  size
    }
}

proc notebookMenubar {} {
    set ::mb [newMenubar]
    $::mb define $::notebookDef
    toplevel .t
    ttk::notebook .t.nb
    frame .t.nb.tab1
    frame .t.nb.tab2
    .t.nb add .t.nb.tab1
    .t.nb add .t.nb.tab2
    $::mb install .t {
	$::mb menu.configure -command {wrap CB size CB}
	$::mb notebook.addTabStore .t.nb.tab1
	$::mb notebook.addTabStore .t.nb.tab2
    }
    set ::m [.t cget -menu]
}

test menubar-11.1 {notebook: tab scope buttons} -body {
    notebookMenubar
    set v [submenu $m View]
    set [$v entrycget Wrap -variable]
} -cleanup {
    cleanupMenubar
    unset v
} -result 0

test menubar-11.2 {notebook: values are saved and restored per tab} -body {
    notebookMenubar
    set v [submenu $m View]
    set wrap [$v entrycget Wrap -variable]
    # change the value for tab 1
    $v invoke Wrap
    $mb notebook.setTabValue .t.nb.tab1 wrap
    # tab 2 still has the initial value
    $mb notebook.restoreTabValues .t.nb.tab2
    set r [list [set $wrap]]
    $mb notebook.restoreTabValues .t.nb.tab1
    lappend r [set $wrap]
    $mb notebook.restoreTabValues .t.nb.tab2
    lappend r [set $wrap]
} -cleanup {
    cleanupMenubar
    unset v wrap r
} -result {0 1 0}

test menubar-11.5 {notebook: tab scope radiobuttons} -constraints knownBug -body {
    # The radiobutton entries of a tab scope group get no variable.
    notebookMenubar
    set v [submenu $m View]
    $v invoke Large
    list [expr {[$v entrycget Small -variable] ne {}}] [set [$v entrycget Small -variable]]
} -cleanup {
    cleanupMenubar
    unset v
} -result {1 Large}

test menubar-11.3 {notebook: deleting a tab store keeps the others} -constraints knownBug -body {
    # deleteTabStore removes the stores of all tabs of the window.
    notebookMenubar
    set v [submenu $m View]
    set wrap [$v entrycget Wrap -variable]
    $v invoke Wrap
    $mb notebook.setTabValue .t.nb.tab1 wrap
    $mb notebook.deleteTabStore .t.nb.tab2
    set $wrap 0
    $mb notebook.restoreTabValues .t.nb.tab1
    set $wrap
} -cleanup {
    cleanupMenubar
    unset v wrap
} -result 1

test menubar-11.4 {notebook: setTabValue for a tab without a store does nothing} -body {
    notebookMenubar
    $mb notebook.setTabValue .t.nb wrap
} -cleanup {
    cleanupMenubar
} -result {}

# -------------------------------------------------------------------------

test menubar-12.1 {destroying the toplevel forgets the window} -body {
    sampleMenubar {$::mb tag.add out x}
    destroy .t
    list [catch {$mb tag.cget .t out} msg] $msg
} -cleanup {
    cleanupMenubar
    unset msg
} -result {1 {error: tag.cget - '*' not installed.}} -match glob

# -------------------------------------------------------------------------

interp bgerror {} $mbOldBgHandler
unset mbOldBgHandler mbBgErrors sampleDef notebookDef
foreach p {newMenubar cleanupMenubar CB entries submenu sampleMenubar
	   notebookMenubar} {
    rename $p {}
}
rename bar {}
unset p tk9Bug

::tcltest::cleanupTests
return
