# menu.namespace, menu.hide, menu.show

test menubar-9.1 {menu.namespace: outside install} -body {
    sampleMenubar
    $mb menu.namespace file ::foo
} -cleanup {
    cleanupMenubar
} -returnCodes error -result {error: menu.namespace - command used outside install}

test menubar-9.2 {menu.hide: hides a menu} -body {
    sampleMenubar
    $mb menu.hide edit
    bar $m
} -cleanup {
    cleanupMenubar
} -result {{cascade File} {cascade Recent} {cascade Help}}

test menubar-9.3 {menu.show: shows a hidden menu again} -constraints $tk9Bug -body {
    sampleMenubar
    $mb menu.hide edit
    $mb menu.show edit
    list [bar $m] [lindex [entries [submenu $m Edit]] 1]
} -cleanup {
    cleanupMenubar
} -result {{{cascade File} {cascade Edit} {cascade Recent} {cascade Help}} {command Cut}}

test menubar-9.4 {menu.hide: in the install script} -body {
    sampleMenubar {$::mb menu.hide recent}
    bar $m
} -cleanup {
    cleanupMenubar
} -result {{cascade File} {cascade Edit} {cascade Help}}

test menubar-9.5 {menu.show: a menu that is not hidden} -body {
    sampleMenubar
    $mb menu.show edit
    bar $m
} -cleanup {
    cleanupMenubar
} -result {{cascade File} {cascade Edit} {cascade Recent} {cascade Help}}

