    toplevel .t2
    $mb install .t2 {$::mb tag.add out .t2.text}
    list [$mb tag.cget .t out] [$mb tag.cget .t2 out]
} -cleanup {
    cleanupMenubar
} -result {.t.text .t2.text}

test menubar-8.2 {tag.add: outside install} -body {
    sampleMenubar
    $mb tag.add out x
} -cleanup {
    cleanupMenubar
} -returnCodes error -result {error: tag - command used outside install}

test menubar-8.3 {tag.add: undefined user tag} -body {
    sampleMenubar
    $mb tag.cget .t out
} -cleanup {
    cleanupMenubar
} -returnCodes error -result {error: tag(out) - not defined for toplevel(.t)}

