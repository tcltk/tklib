    $mb menu.hide nosuch
} -cleanup {
    cleanupMenubar
} -returnCodes error -result {error: menu.hide - tag 'nosuch' doesn't exist.}

test menubar-9.7 {menu.hide: not a menu} -body {
    sampleMenubar
    $mb menu.hide open
} -cleanup {
    cleanupMenubar
} -returnCodes error -result {error: menu.hide - tag 'open' not a menu.}

